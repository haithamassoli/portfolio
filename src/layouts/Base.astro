---
import { Font, getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import { canonical as canonicalUrl, dirOf, useT, type Lang } from '../i18n';
import { profile } from '../../content/profile';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Reveal from '../designs/_shared/Reveal.astro';
import DesignSwitch from '../designs/_shared/DesignSwitch.astro';
import { byId } from '../designs/registry';
import { gateSource } from '../designs/boot';
import '../styles/global.css';

interface Props {
	lang: Lang;
	title?: string;
	description?: string;
	accent?: string;
	/** Overrides the default share card. Project pages pass their cover. */
	image?: ImageMetadata;
	/** Error pages set this so they never turn up in a search result. */
	noindex?: boolean;
}

const { lang, title, description, accent, image, noindex } = Astro.props;
const t = useT(lang);
const dir = dirOf(lang);
const siteName = lang === 'ar' ? t('name.arabic') : t('name.latin');
const pageTitle = title ? `${title} · ${siteName}` : t('meta.title');
const desc = description ?? t('meta.desc');

/* Crawlers and chat apps only accept absolute URLs, so everything below is
   resolved against `site`. Trailing slashes are dropped so a page has one
   canonical spelling. */
const site = Astro.site ?? Astro.url.origin;
const abs = (path: string) => canonicalUrl(path, site);
const bare = Astro.url.pathname.replace(/^\/ar(?=\/|$)/, '') || '/';
const canonical = abs(Astro.url.pathname);
/* Cropped to the 1.91:1 every social card assumes. A full-size cover is
   megabytes of PNG that Twitter would crop badly anyway. */
const card =
	image &&
	(await getImage({
		src: image,
		width: 1200,
		height: 630,
		fit: 'cover',
		format: 'jpeg',
	}));
const ogImage = new URL(card?.src ?? '/og.png', site).href;

/* The gate only stands on the two home pages: anywhere else it would re-run on
   every navigation inside a design. */
const isHome =
	Astro.url.pathname.replace(/\/$/, '') === (lang === 'ar' ? '/ar' : '');

/* One Person record, on the home page only, because repeating it on eighty pages
   tells Google nothing it did not already know. */
const person = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: profile.name[lang],
	alternateName: profile.name[lang === 'ar' ? 'en' : 'ar'],
	jobTitle: profile.title[lang],
	url: abs('/'),
	image: ogImage,
	email: `mailto:${profile.email}`,
	address: { '@type': 'PostalAddress', addressLocality: profile.location.en },
	sameAs: Object.values(profile.links),
	knowsLanguage: ['ar', 'en'],
};
---

<!doctype html>
<html
	lang={lang}
	dir={dir}
	data-design="main"
	style={accent ? `--accent:${accent}` : undefined}
>
	<head>
		<meta charset="utf-8" />
		{
			/* Blocking, before first paint, so a returning visitor never sees the
			   main design flash past on the way to theirs. Crawlers do not run it,
			   which is why `/` stays the canonical page. */
			isHome && <script is:inline set:html={gateSource()} />
		}
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={desc} />
		<meta name="theme-color" content="#16183a" />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={desc} />
		<meta property="og:type" content={title ? 'article' : 'website'} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content={lang === 'ar' ? 'ar_JO' : 'en_US'} />
		<meta
			property="og:locale:alternate"
			content={lang === 'ar' ? 'en_US' : 'ar_JO'}
		/>
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title ?? siteName} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={desc} />
		<meta name="twitter:image" content={ogImage} />

		<link rel="alternate" hreflang="en" href={abs(bare)} />
		<link
			rel="alternate"
			hreflang="ar"
			href={abs(`/ar${bare === '/' ? '' : bare}`)}
		/>
		<link rel="alternate" hreflang="x-default" href={abs(bare)} />
		{
			bare === '/' && (
				<script
					type="application/ld+json"
					set:html={JSON.stringify(person)}
					is:inline
				/>
			)
		}
		<Font
			cssVariable="--font-thmanyah"
			preload={[{ weight: 400 }, { weight: 900 }]}
		/>
		<Font cssVariable="--font-mono" preload={[{ weight: 400 }]} />
		<ClientRouter />
		<Reveal />
	</head>
	<body>
		<a class="skip mono" href="#main">{t('nav.skip')}</a>
		<Nav lang={lang} />
		<main id="main" tabindex="-1">
			<slot />
			{
				/* Sub-pages get the same switch, kept at the foot of the content:
				   the hero already carries it on the home page. */
				!isHome && (
					<DesignSwitch
						design={byId('main')}
						lang={lang}
						class="dsw-row--tail"
					/>
				)
			}
		</main>
		<Footer lang={lang} />
	</body>
</html>
