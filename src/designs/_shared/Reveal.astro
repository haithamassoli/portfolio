---
/* The circular reveal, and the small amount of state that crosses a design
   jump. One copy for all eight shells.

   The browser does the work: a cross-document view transition, with the new
   page clipped to a circle that opens from wherever the switch was pressed.
   Firefox has no cross-document transitions yet, so it gets a wipe of the same
   colour on the same curve — 25 lines, and nobody stares at a white flash. */
import { KEY } from '../boot';

const ORIGIN = 'vx-reveal';
---

<script is:inline define:vars={{ KEY, ORIGIN }}>
	(function () {
		const root = document.documentElement;
		const cross = 'onpagereveal' in window && 'onpageswap' in window;

		function store(k, v) {
			try {
				sessionStorage.setItem(k, JSON.stringify(v));
			} catch {
				/* private mode: no reveal, still a working link */
			}
		}

		function take(k) {
			try {
				const raw = sessionStorage.getItem(k);
				sessionStorage.removeItem(k);
				const v = raw ? JSON.parse(raw) : null;
				/* A middle-click leaves the note behind; five seconds is long
				   enough for a real navigation and short enough to go stale. */
				return v && Date.now() - v.t < 5000 ? v : null;
			} catch {
				return null;
			}
		}

		/* Where the visitor is now, so the gate on `/` stays sticky and a shared
		   /bento link becomes their design too. */
		function remember(pin, id) {
			try {
				const here = root.getAttribute('data-design');
				if (!here && !id) return;
				const prev = JSON.parse(localStorage.getItem(KEY) || 'null');
				localStorage.setItem(
					KEY,
					JSON.stringify({
						id: id || here,
						/* Seeing a design counts as having seen it, however they
						   got here, so the tour does not offer it again. */
						queue: (prev ? prev.queue : []).filter(function (q) {
							return q !== (id || here);
						}),
						at: Date.now(),
						pinned: pin || (prev ? !!prev.pinned : false),
						seed:
							prev && prev.seed
								? prev.seed
								: (Math.random() * 4294967296) >>> 0,
					}),
				);
			} catch {
				/* nothing to remember with */
			}
		}

		remember(false);
		document.addEventListener('astro:page-load', function () {
			remember(false);
		});

		function circle(a, e) {
			const r = a.getBoundingClientRect();
			/* Open from the point they actually pressed. A keyboard activation
			   reports detail 0 and clientX 0, so it falls back to the middle. */
			const x = e.detail ? e.clientX : r.left + r.width / 2;
			const y = e.detail ? e.clientY : r.top + r.height / 2;
			return {
				x: x,
				y: y,
				r: Math.hypot(
					Math.max(x, innerWidth - x),
					Math.max(y, innerHeight - y),
				),
				accent: a.getAttribute('data-accent') || 'currentColor',
				t: Date.now(),
			};
		}

		document.addEventListener('click', function (e) {
			const a = e.target.closest && e.target.closest('a[data-design-switch]');
			if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.button > 0) return;
			const o = circle(a, e);
			store(ORIGIN, o);
			/* Choosing is pinning: `/` should keep handing back what they picked. */
			remember(true, a.getAttribute('data-to'));
			if (cross) return;
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			e.preventDefault();
			wipe(a.href, o);
		});

		/* Firefox and anything else without cross-document transitions. */
		function wipe(href, o) {
			const el = document.createElement('div');
			el.style.cssText =
				'position:fixed;inset:0;z-index:2147483647;pointer-events:none;background:' +
				o.accent +
				';clip-path:circle(0 at ' +
				o.x +
				'px ' +
				o.y +
				'px);transition:clip-path .42s cubic-bezier(.22,.61,.36,1)';
			document.body.appendChild(el);
			let done = false;
			function go() {
				if (done) return;
				done = true;
				location.href = href;
			}
			requestAnimationFrame(function () {
				el.style.clipPath =
					'circle(' + o.r + 'px at ' + o.x + 'px ' + o.y + 'px)';
			});
			el.addEventListener('transitionend', go);
			setTimeout(go, 500);
		}

		if (!cross) return;

		window.addEventListener('pagereveal', function (e) {
			if (!e.viewTransition) return;
			const o = take(ORIGIN);
			/* Every other cross-document navigation — the gate's redirect, a
			   reload, a link from outside — gets no animation at all. The seam
			   belongs to same-document swaps. */
			if (!o || matchMedia('(prefers-reduced-motion: reduce)').matches) {
				e.viewTransition.skipTransition();
				return;
			}
			root.style.setProperty('--rx', o.x + 'px');
			root.style.setProperty('--ry', o.y + 'px');
			root.style.setProperty('--rr', o.r + 'px');
			root.style.setProperty('--to', o.accent);
			root.setAttribute('data-reveal', '');
			e.viewTransition.finished.finally(function () {
				root.removeAttribute('data-reveal');
			});
		});
	})();
</script>

<style is:global>
	/* Cross-document transitions, so a real navigation between two designs is
	   animated by the browser rather than by a router. */
	@view-transition {
		navigation: auto;
	}

	/* Scoped to [data-reveal] so it outranks the seam wipe that global.css and
	   Seam.astro give same-document swaps, and only for a design switch. */
	html[data-reveal]::view-transition-old(root) {
		z-index: 0;
		/* The page being left drifts a little towards the viewer as the new one
		   opens through it, so the circle reads as depth and not as a hole cut in
		   a flat image. It scales up, never down: down would expose the edges. */
		animation: design-part 620ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
		transform-origin: var(--rx, 50vw) var(--ry, 50vh);
	}

	@keyframes design-part {
		to {
			scale: 1.035;
			opacity: 0.75;
		}
	}

	html[data-reveal]::view-transition-new(root) {
		z-index: 1;
		animation: design-reveal 620ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
		/* drop-shadow follows the clipped silhouette, so the incoming circle
		   carries a leading edge in the destination's own colour — the same
		   colour the switch was already showing. */
		filter: drop-shadow(0 0 14px var(--to, transparent));
	}

	@keyframes design-reveal {
		from {
			clip-path: circle(0 at var(--rx, 50vw) var(--ry, 50vh));
		}
		to {
			clip-path: circle(var(--rr, 100vmax) at var(--rx, 50vw) var(--ry, 50vh));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		html[data-reveal]::view-transition-old(root),
		html[data-reveal]::view-transition-new(root) {
			animation: none;
			filter: none;
		}
	}
</style>
