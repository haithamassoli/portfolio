---
import { Image } from 'astro:assets';
import type { Design } from '../registry';
import type { Lang } from '../../i18n';
import { url } from '../routes';
import { pair, yearPair } from '../../data/variant-ui';
import { profile } from '../../../content/profile';
import { featured, projects } from '../../data/projects';
import photo from '../../assets/images/profile.png';
import Shell from './Shell.astro';
import Sculpture from './Sculpture.astro';
import Glyph from './Glyph.astro';
import ProjectCard from './ProjectCard.astro';
const { design, lang } = Astro.props as { design: Design; lang: Lang };
const t = (en: string, ar: string) => pair(en, ar)[lang];
const u = (path = '') => url(design, lang, path);
const services = [
	{
		kind: 'weave' as const,
		name: pair('Web experiences', 'تجارب الويب'),
		detail: pair(
			'Fast interfaces. Thoughtful systems. The whole journey, from the first click to the database.',
			'واجهات سريعة وأنظمة مدروسة. الرحلة كاملة، من النقرة الأولى إلى قاعدة البيانات.',
		),
		stack: 'REACT / NEXT.JS / ASTRO',
	},
	{
		kind: 'wave' as const,
		name: pair('Mobile products', 'منتجات الجوال'),
		detail: pair(
			'Apps that feel at home in your hand. Built, polished, and shipped to the stores.',
			'تطبيقات مريحة في يدك. أبنيها وأصقل تفاصيلها وأطلقها على المتاجر.',
		),
		stack: 'REACT NATIVE / EXPO / SWIFT',
	},
	{
		kind: 'spark' as const,
		name: pair('Applied intelligence', 'ذكاء عملي'),
		detail: pair(
			'Useful AI, close to your data. Private, on-device tools that solve everyday problems.',
			'ذكاء اصطناعي مفيد، قريب من بياناتك. أدوات خاصة تعمل على جهازك لحل مشكلات يومية.',
		),
		stack: 'ONNX / WHISPER / TRANSFORMERS.JS',
	},
];
---

<Shell {design} {lang}>
	<section class="hero wrap">
		<div class="hero-top mono">
			<span
				><i class="status-dot"></i>{
					t('OPEN TO GOOD CONVERSATIONS', 'كل فكرة جميلة تبدأ بحديث')
				}</span
			><span dir="ltr">PORTFOLIO — {new Date().getFullYear()}</span>
		</div>
		<div class="hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">
					<span class="accent">↳</span>
					{t('ENGINEERING × IMAGINATION', 'هندسة × خيال')}
				</p>
				<h1>
					<span>{t('Code with', 'شيفرة لها')}</span><em
						>{t('character.', 'شخصيّة.')}</em
					>
				</h1>
				<div class="hero-description">
					<span class="hero-small-cross" aria-hidden="true">+</span><p>
						{
							t(
								'I’m Haitham. I turn complex ideas into digital products that feel effortless. Built with precision. Made to be used.',
								'أنا هيثم. أحوّل الأفكار المعقّدة إلى منتجات رقمية سهلة الاستخدام. أبنيها بإتقان، وأعتني بأصغر تفاصيلها.',
							)
						}
					</p>
				</div>
				<div class="actions">
					<a class="button" href="#work"
						>{t('Explore the work', 'اكتشف أعمالي')}
						<span aria-hidden="true">↗</span></a
					><a class="text-link" href={u('/hire')}
						>{t('Have an idea?', 'عندك فكرة؟')}
						<span aria-hidden="true">↗</span></a
					>
				</div>
			</div>
			<Sculpture {lang} />
		</div>
		<div class="hero-foot mono">
			<span
				>{
					t('WEB · MOBILE · ON-DEVICE AI', 'ويب · جوال · ذكاء على الجهاز')
				}</span
			><a href="#work"
				>{t('SCROLL TO DISCOVER', 'مرّر لتكتشف')}
				<span aria-hidden="true">↓</span></a
			><span dir="ltr">01 — 04</span>
		</div>
	</section>
	<div class="principles" aria-hidden="true">
		<div class="principles-track">
			{
				[0, 1].map(() => (
					<div>
						<>
							<span>THINK DEEPLY</span>
							<Glyph />
							<span>BUILD CAREFULLY</span>
							<Glyph />
							<span>MAKE IT MATTER</span>
							<Glyph />
						</>
					</div>
				))
			}
		</div>
	</div>
	<section class="section wrap" id="work">
		<header class="section-head reveal">
			<div>
				<p class="eyebrow">01 / {t('SELECTED WORK', 'أعمال مختارة')}</p><h2>
					{t('Ideas, out in', 'أفكار صارت')}<br /><em
						>{t('the real world.', 'واقعًا.')}</em
					>
				</h2>
			</div><div class="section-aside">
				<p>
					{
						t(
							'A few things I’ve built, shipped, and cared about. Each one started with a better question.',
							'بعض ما بنيته وأطلقته واعتنيت به. وراء كل مشروع سؤال يستحق الإجابة.',
						)
					}
				</p><a class="text-link" href={u('/work')}
					>{
						t(
							`View all ${projects.length} projects`,
							`شاهد المشاريع الـ${projects.length}`,
						)
					}
					<span aria-hidden="true">↗</span></a
				>
			</div>
		</header>
		<div class="project-grid">
			{
				featured
					.slice(0, 4)
					.map((project, index) => (
						<ProjectCard {project} {index} {design} {lang} />
					))
			}
		</div>
	</section>
	<section class="about-section" id="about">
		<div class="wrap about-grid">
			<div class="about-portrait reveal">
				<div class="portrait-frame">
					<Image
						src={photo}
						alt={profile.name[lang]}
						widths={[400, 700]}
						sizes="(min-width: 900px) 30vw, 80vw"
						loading="lazy"
					/><span class="portrait-corner" aria-hidden="true">↗</span>
				</div><p class="mono">
					{t('THE HUMAN BEHIND THE CODE', 'الإنسان خلف الشيفرة')}
					<span>↳</span>
				</p>
			</div>
			<div class="about-copy reveal">
				<p class="eyebrow">02 / {t('A LITTLE ABOUT ME', 'قليل عنّي')}</p><h2>
					{t('A curious mind.', 'فضول لا يهدأ.')}<br /><em
						>{t('A maker at heart.', 'وشغف بالبناء.')}</em
					>
				</h2><p class="lede">
					{
						t(
							'I like the space where a difficult problem becomes a simple experience.',
							'أحبّ اللحظة التي تتحوّل فيها مشكلة صعبة إلى تجربة بسيطة.',
						)
					}
				</p><p class="muted">{profile.about[lang][0]}</p><div
					class="about-stats"
				>
					<div>
						<strong>{projects.length}<span>↗</span></strong><span
							>{t('Projects shipped', 'مشروعًا أُطلق')}</span
						>
					</div><div>
						<strong
							>{
								projects.filter((p) => p.links.appStore || p.links.playGoogle)
									.length
							}</strong
						><span>{t('Apps on the stores', 'تطبيقًا على المتاجر')}</span>
					</div><a class="text-link" href={profile.links.resume}
						>{t('My résumé', 'سيرتي الذاتية')} ↗</a
					>
				</div>
			</div>
		</div>
	</section>
	<section class="section wrap">
		<header class="section-head reveal">
			<div>
				<p class="eyebrow">03 / {t('WHAT I BRING', 'ما أقدّمه')}</p><h2>
					{t('From the first spark', 'من أول شرارة')}<br /><em
						>{t('to the final detail.', 'لآخر تفصيلة.')}</em
					>
				</h2>
			</div><p class="section-aside">
				{
					t(
						'One developer. The complete picture. I connect the interface, the systems, and all the small things in between.',
						'مطوّر واحد يرى الصورة كاملة. أربط الواجهة بالأنظمة، وأعتني بكل التفاصيل بينهما.',
					)
				}
			</p>
		</header>
		<div class="services">
			{
				services.map((service, i) => (
					<article class="service reveal">
						<>
							<div class="service-top">
								<>
									<span class="mono">0{i + 1} /</span>
									<Glyph kind={service.kind} />
								</>
							</div>
							<h3>{service.name[lang]}</h3>
							<p>{service.detail[lang]}</p>
							<span class="mono service-stack" dir="ltr">
								{service.stack}
							</span>
						</>
					</article>
				))
			}
		</div>
		<div class="experience">
			<p class="eyebrow">
				{t('SOME STOPS ALONG THE WAY', 'محطّات في الرحلة')}
			</p>{
				profile.experience.slice(0, 3).map((job) => (
					<div class="experience-row reveal">
						<>
							<h3>{job.company[lang]}</h3>
							<span>{job.role[lang]}</span>
							<span class="mono">{yearPair(job.period)[lang]}</span>
						</>
					</div>
				))
			}
		</div>
	</section>
	<section class="contact-section">
		<div class="wrap">
			<p class="eyebrow">
				04 / {t('SOMETHING GOOD STARTS HERE', 'من هنا يبدأ شيء جميل')}
			</p><a class="contact-link" href={u('/hire')}
				><h2>
					{t('Let’s make', 'لنصنع شيئًا')}<br /><em
						>{t('some resonance.', 'يترك أثرًا.')}</em
					>
				</h2><span aria-hidden="true">↗</span></a
			><div class="contact-bottom">
				<p>
					{
						t(
							'A new idea. A tricky problem. A simple hello.',
							'فكرة جديدة. مشكلة صعبة. أو حتى مرحبًا.',
						)
					}
				</p><a href={`mailto:${profile.email}`}>{profile.email}</a><Glyph />
			</div>
		</div>
	</section>
</Shell>
