---
import type { Design } from '../registry';
import type { Lang } from '../../i18n';
import Shell from './Shell.astro';
import Glyph from './Glyph.astro';
import T from '../../components/T.astro';
import HireCompose from '../../components/HireCompose.astro';
import { profile } from '../../../content/profile';
import { pair, s } from '../../data/variant-ui';
interface Props {
	design: Design;
	lang: Lang;
}
const { design, lang } = Astro.props;
const deals = ['part', 'full', 'contract', 'freelance', 'hourly'] as const;
const places = ['remote', 'onsite'] as const;
const stacks = ['frontend', 'backend', 'mobile', 'other'] as const;
---

<Shell
	{design}
	{lang}
	title={pair('Let’s talk — Haitham Assoli', 'لنتحدّث — هيثم العسولي')[lang]}
	description={s('hire.lede')[lang]}
>
	<HireCompose />
	<div class="wrap">
		<header class="page-head">
			<p class="eyebrow mono">
				<span>04 /</span><T v={pair('A good place to start', 'هنا نبدأ')} />
			</p><h1>
				<T v={pair('Your idea.', 'فكرتك.')} /><br /><span class="muted"
					><T v={pair('Our next chapter.', 'حكايتنا القادمة.')} /></span
				>
			</h1>
		</header>
		<div class="hire-layout">
			<aside class="hire-aside">
				<Glyph kind="wave" /><T
					as="h2"
					v={pair('Tell me what’s on your mind.', 'احكِ لي عمّا في بالك.')}
				/><T as="p" v={s('hire.lede')} /><a
					href={`mailto:${profile.email}`}
					dir="ltr">{profile.email} ↗</a
				>
			</aside><div>
				<form class="form" data-hire>
					<div class="field">
						<label for="fullName"><T v={s('hire.fullName')} /></label>
						<input
							class="f__i"
							id="fullName"
							name="fullName"
							type="text"
							autocomplete="name"
							required
						/>
					</div>
					<div class="field">
						<label for="email"><T v={s('hire.email')} /></label>
						<input
							class="f__i"
							id="email"
							name="email"
							type="email"
							autocomplete="email"
							dir="ltr"
							required
						/>
					</div>
					<div class="field">
						<label for="phone"><T v={s('hire.phone')} /></label>
						<input
							class="f__i"
							id="phone"
							name="phone"
							type="tel"
							autocomplete="tel"
							dir="ltr"
							required
						/>
					</div>

					<fieldset class="field">
						<legend><T v={s('hire.deal')} /></legend>
						<div class="options">
							{
								deals.map((d, i) => (
									<label class="opt">
										<input
											type="radio"
											name="deal"
											value={d}
											required={i === 0}
										/>
										<T v={s(`deal.${d}`)} />
									</label>
								))
							}
						</div>
					</fieldset>

					<fieldset class="field">
						<legend><T v={s('hire.location')} /></legend>
						<div class="options">
							{
								places.map((l, i) => (
									<label class="opt">
										<input
											type="radio"
											name="location"
											value={l}
											required={i === 0}
										/>
										<T v={s(`loc.${l}`)} />
									</label>
								))
							}
						</div>
					</fieldset>

					<fieldset class="field">
						<legend><T v={s('hire.techStack')} /></legend>
						<div class="options">
							{
								stacks.map((t) => (
									<label class="opt">
										<input type="checkbox" name="techStack" value={t} />
										<T v={s(`tech.${t}`)} />
									</label>
								))
							}
						</div>
					</fieldset>

					<div class="field">
						<label for="budget"><T v={s('hire.budget')} /></label>
						<input
							class="f__i"
							id="budget"
							name="budget"
							type="text"
							placeholder={s('hire.budgetPlaceholder')[lang]}
							required
						/>
					</div>
					<div class="field field-wide">
						<label for="summary"><T v={s('hire.summary')} /></label>
						<textarea
							class="f__i f__t"
							id="summary"
							name="summary"
							rows="5"
							placeholder={s('hire.summaryPlaceholder')[lang]}
							required></textarea>
					</div>

					<div class="field-wide">
						<button class="button" type="submit"
							><T v={s('hire.submit')} /></button
						>
						<T as="p" class="form-note" role="status" v={s('hire.sent')} />
					</div>
				</form>
				<p class="form-disclosure">
					<T
						v={pair(
							'This opens a draft in your email app. Review it, then send it when you’re ready.',
							'يفتح هذا مسودة في تطبيق بريدك. راجعها وأرسلها عندما تكون جاهزًا.',
						)}
					/>
				</p>
				<noscript
					><p>
						<T
							v={pair(
								'Please email your project details directly to',
								'أرسل تفاصيل مشروعك مباشرة إلى',
							)}
						/>
						<a href={`mailto:${profile.email}`}>{profile.email}</a>.
					</p></noscript
				>
			</div>
		</div>
	</div></Shell
>
