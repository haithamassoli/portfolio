---
import type { Design } from '../registry';
import { url as designUrl } from '../routes';
import type { Lang } from '../../i18n';
/* Every project, one directory per category, one sheet per directory. */
import Shell from './Shell.astro';
import T from '../../components/T.astro';
import { projects } from '../../data/projects';
import { catWord, pair, s, statusWord } from '../../data/variant-ui';

interface Props {
	design: Design;
	lang: Lang;
}

const { design, lang } = Astro.props;
const u = (page = '') => designUrl(design, lang, page);

const yearOf = (y: string) =>
	Math.max(...(y.match(/\d{4}/g) ?? ['0']).map(Number));
const cats = ['web', 'mobile', 'ai', 'client', 'desktop', 'extension'] as const;
const dirs = cats.map((cat) => ({
	cat,
	items: projects
		.filter((p) => p.category === cat)
		.sort(
			(a, b) =>
				Number(b.featured) - Number(a.featured) ||
				yearOf(b.year) - yearOf(a.year),
		),
}));
const pad = (n: number) => String(n).padStart(2, '0');
---

<Shell
	design={design}
	lang={lang}
	title={pair('All projects — Haitham Assoli', 'كل المشاريع — هيثم العسولي')[
		lang
	]}
	description={s('work.allLede')[lang]}
	job="JOB 0002"
>
	<section class="sec">
		<T as="h1" v={s('work.all')} />
		<T as="p" class="lede idx__lede" v={s('work.allLede')} />
		<p class="m idx" lang="en" dir="ltr">
			<span class="dim">$</span> ls ~/work/
			{dirs.map((d) => <a href={`#cat-${d.cat}`}>{d.cat}/</a>)}
		</p>
	</section>

	{
		dirs.map((d, i) => (
			<>
				<div class="fold">FOLD</div>
				<p class="sheet-head" id={`cat-${d.cat}`}>
					<span lang="en">ASSOLI</span>
					<T v={catWord[d.cat]} />
					<span lang="en">
						SHEET {pad(i + 1)} / {pad(dirs.length)}
					</span>
				</p>
				<section class="sec sec--tight">
					<p class="m ls__cmd" lang="en" dir="ltr">
						<span class="dim">$</span> ls -la ~/work/{d.cat}{' '}
						<span class="dim">· {d.items.length}</span>
					</p>
					<ol class="ls">
						{d.items.map((p) => (
							<li class="ls__row">
								<span class="ls__perm" lang="en">
									{p.featured ? '-rwxr--r--' : '-rw-r--r--'}
								</span>
								<span class="ls__size" lang="en">
									{p.year.replace(/\D/g, '').slice(0, 4)}
								</span>
								<a
									class="ls__name"
									href={u(`/work/${p.slug}`)}
									lang="en"
									dir="ltr"
								>
									{p.slug}.md
								</a>
								<T as="span" class="ls__tag" v={p.tagline} />
								<T as="span" class="ls__st" v={statusWord[p.status]} />
							</li>
						))}
					</ol>
				</section>
			</>
		))
	}
</Shell>

<style is:global>
	.idx__lede {
		margin-block: var(--line);
	}

	.idx {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1rem;
		font-size: 0.95rem;
		max-width: none;
	}

	.idx a {
		text-decoration: none;
		font-weight: 700;
	}

	.idx a:hover {
		color: var(--red);
	}
</style>
