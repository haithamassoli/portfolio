		     run it again: a script it has already executed is otherwise
		     skipped for the rest of the session. Held in a function because a
		     second run at the top level would redeclare its own names. -->
		<script data-astro-rerun>
			(function () {
				const targets = document.querySelectorAll('.rise');
				const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

				if (reduce.matches || !('IntersectionObserver' in window)) {
					targets.forEach((el) => el.classList.add('is-in'));
				} else {
					const io = new IntersectionObserver(
						(entries) => {
							entries.forEach((entry) => {
								if (!entry.isIntersecting) return;
								entry.target.classList.add('is-in');
								io.unobserve(entry.target);
							});
						},
						{ rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
					);
					targets.forEach((el) => io.observe(el));
				}
			})();
