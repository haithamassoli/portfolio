					0 0 0 1.5px var(--shu),
					0 0 0 3.5px rgba(200, 69, 44, 0.16);
				transform: rotate(-7deg);
				animation: stamp 0.9s 0.5s both cubic-bezier(0.2, 0.9, 0.3, 1);
			}

			.hanko__col {
				writing-mode: vertical-rl;
				direction: ltr;
				text-orientation: upright;
				font-family: var(--jp);
				font-size: 0.95rem;
				font-weight: 600;
				letter-spacing: 0.06em;
			}

			/* .hanko is direction:ltr so its two columns keep seal order, which
			   also pins its own inline axis to ltr. Under a right-to-left page
			   the seal therefore has to be told, in so many words, to move. */
			html[dir='rtl'] .hanko {
				inset-inline-end: auto;
				inset-inline-start: 0.5rem;
			}

			@keyframes stamp {
				0% {
					opacity: 0;
					transform: rotate(-16deg) scale(1.45);
				}
				60% {
					opacity: 1;
					transform: rotate(-7deg) scale(0.96);
				}
				100% {
					opacity: 1;
					transform: rotate(-7deg) scale(1);
				}
			}

			/* ── folds and section heads ──────────────────────── */

			.fold {
				height: 2.75rem;
				border-top: 1px solid var(--rule);
				background: linear-gradient(
					to bottom,
					rgba(30, 37, 43, 0.075),
					rgba(30, 37, 43, 0) 62%
				);
			}

			.band {
				padding-block: clamp(3rem, 7vw, 6.5rem);
			}

			.head {
				display: grid;
				grid-template-columns: 3.5rem minmax(0, 1fr);
				gap: clamp(1rem, 3vw, 2.5rem);
				margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
			}

			.marker {
				margin: 0;
				justify-self: center;
				font-size: 1.1rem;
				font-weight: 600;
				letter-spacing: 0.4em;
				color: var(--ai);
			}

			.head__text {
				max-width: 46rem;
			}

			.head__title {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0.9rem;
				font-family: var(--body);
				font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3rem);
				font-weight: 300;
				line-height: 1.1;
				letter-spacing: -0.01em;
			}

			.head__title [data-l='ar'] {
				font-family: var(--ar);
				font-size: 0.9em;
				font-weight: 400;
				line-height: 1.5;
			}

			.head__ja {
				font-family: var(--jp);
				font-size: 0.42em;
				font-weight: 400;
				letter-spacing: 0.3em;
				color: var(--usuzumi);
			}

			.head__lede {
				margin-top: 1.1rem;
				max-width: 36em;
				color: #3a4249;
			}

			.head__lede[lang='ar'] {
				max-width: 34em;
			}

			/* ── 作品 grid ────────────────────────────────────── */

			.grid {
				display: grid;
				grid-template-columns: repeat(12, minmax(0, 1fr));
				gap: clamp(3rem, 7vw, 5.5rem) var(--gap);
			}

			.card {
				grid-column: span var(--span, 6);
				display: flex;
				flex-direction: column;
				position: relative;
			}

			/* 間: the short cards drop, so no row ever lines up flat */
			.card:nth-child(2),
			.card:nth-child(5),
			.card:nth-child(8) {
				margin-top: clamp(0rem, 5vw, 4.5rem);
			}

			.card__link {
				display: block;
				text-decoration: none;
				order: 2;
			}

			.card__hit {
				position: absolute;
				inset: 0;
			}

			.card__titles {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				justify-content: space-between;
				gap: 0.75rem;
				margin-top: 1.35rem;
			}

			.card__title {
				font-family: var(--body);
				font-size: clamp(1.35rem, 1.1rem + 1vw, 1.85rem);
				font-weight: 400;
				line-height: 1.15;
				background-image: linear-gradient(var(--sumi), var(--sumi));
				background-size: 0% 1px;
				background-repeat: no-repeat;
				background-position: 0 100%;
				transition: background-size 0.35s ease;
			}

			.card__title [lang='ar'] {
				font-family: var(--ar);
				line-height: 1.5;
			}

			.card:hover .card__title,
			.card__link:focus-visible .card__title {
				background-size: 100% 1px;
			}

			.card__more {
				display: inline-flex;
				align-items: baseline;
				gap: 0.45rem;
				font-family: var(--gothic);
				font-size: 0.7rem;
				font-weight: 500;
				letter-spacing: 0.12em;
				color: var(--ai);
				opacity: 0.45;
				transition: opacity 0.3s;
			}

			.card__more [lang='ja'] {
				font-family: var(--jp);
				letter-spacing: 0.16em;
			}

			.card__more [lang='ar'] {
				font-family: var(--ar);
				font-size: 0.9rem;
				font-weight: 400;
			}

			.card:hover .card__more,
			.card__link:focus-visible .card__more {
				opacity: 1;
			}

			/* Nothing to hover on a touch screen: the affordance is just on. */
			@media (hover: none) {
				.card__more {
					opacity: 1;
				}

				.card__title {
					background-size: 100% 1px;
				}
			}

			.card__link:focus-visible {
				outline: 2px solid var(--ai);
				outline-offset: 6px;
			}

			.card__paper {
				order: 1;
				position: relative;
				display: flex;
				gap: 0.9rem;
				padding: 0.9rem;
				background: var(--washi);
				border: 1px solid var(--rule-soft);
				box-shadow:
					0 1px 0 rgba(255, 255, 255, 0.7) inset,
					0 14px 28px -22px rgba(30, 37, 43, 0.55);
			}

			.card__rail {
				flex: 0 0 auto;
				display: flex;
				align-items: center;
				gap: 0.4rem;
				margin: 0;
				padding-block: 0.15rem;
				font-size: 0.72rem;
				letter-spacing: 0.12em;
				color: var(--usuzumi);
			}

			.card__status {
				color: var(--ai);
			}

			.card__shot {
				flex: 1 1 auto;
				min-width: 0;
				overflow: hidden;
				background: #dedbd2;
			}

			.card__shot img {
				width: 100%;
				aspect-ratio: 16 / 10;
				object-fit: cover;
				object-position: top center;
				filter: saturate(0.86) contrast(1.02);
				transition:
					transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
					filter 0.5s ease;
			}

			.card:hover .card__shot img {
				transform: scale(1.025);
				filter: saturate(1) contrast(1.02);
			}

			/* A phone shot is a tall plate; cropping it to a landscape band
			   throws away the screen. Mount it whole instead. */
			.card__shot[data-frame='phone'] {
				display: grid;
				place-items: center;
				padding: clamp(0.75rem, 3vw, 1.6rem);
				background: linear-gradient(180deg, #e4e1d8, #dcd9d0);
			}

			.card__shot[data-frame='phone'] img {
				width: 100%;
				height: auto;
				max-height: 26rem;
				aspect-ratio: auto;
				object-fit: contain;
				box-shadow: 0 12px 26px -18px rgba(30, 37, 43, 0.8);
			}

			.card__noshot {
				display: grid;
				place-items: center;
				aspect-ratio: 16 / 10;
				font-family: var(--jp);
				font-size: 0.85rem;
				letter-spacing: 0.3em;
				color: var(--usuzumi);
			}

			.card__cat {
				order: 3;
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0.4rem 0.7rem;
				margin-top: 0.7rem;
				font-family: var(--gothic);
				font-size: 0.72rem;
				font-weight: 500;
				letter-spacing: 0.08em;
				color: var(--usuzumi);
			}

			.card__cat [lang='ja'] {
				font-family: var(--jp);
				font-size: 0.82rem;
				letter-spacing: 0.18em;
				color: var(--ai);
			}

			.card__cat [lang='ar'] {
				font-family: var(--ar);
				font-size: 0.88rem;
				font-weight: 400;
			}

			.card__st {
				color: var(--ai);
			}

			/* The rail says the year in bare numerals; this says it in the
			   reader's own language, horizontally, so Arabic is never set
			   vertically inside a rail pinned ltr for the Japanese. */
			.card__yr {
				margin-inline-start: auto;
				font-variant-numeric: tabular-nums;
			}

			.card__tagline {
				order: 4;
				margin-top: 0.9rem;
				font-size: 1.02rem;
				font-style: italic;
			}

			.card__summary {
				order: 5;
				margin-top: 0.6rem;
				max-width: 40em;
				font-size: 0.96rem;
				line-height: 1.7;
				color: #3d454c;
			}

			.card__summary[lang='ar'] {
				line-height: 1.95;
			}

			.card__stack {
				order: 6;
				margin-top: 1rem;
				font-family: var(--gothic);
				font-size: 0.74rem;
				line-height: 2;
				color: var(--usuzumi);
			}

			.card__stack .sep {
				font-family: var(--jp);
				color: rgba(30, 37, 43, 0.35);
			}

			.card__links {
				order: 7;
				position: relative;
				z-index: 2;
				display: flex;
				flex-wrap: wrap;
				gap: 1.15rem;
				margin-top: 0.9rem;
			}

			.lnk {
				display: inline-flex;
				align-items: baseline;
				gap: 0.4rem;
				font-family: var(--gothic);
				font-size: 0.74rem;
				font-weight: 500;
				letter-spacing: 0.09em;
				color: var(--ai);
				text-decoration: none;
				border-bottom: 1px solid rgba(46, 66, 87, 0.32);
				padding-bottom: 0.1rem;
				transition: border-color 0.25s;
			}

			.lnk [lang='ja'] {
				font-family: var(--jp);
				letter-spacing: 0.16em;
				color: var(--usuzumi);
			}

			.lnk [lang='ar'] {
				font-family: var(--ar);
				font-size: 0.9rem;
				font-weight: 400;
			}

			.lnk:hover {
				border-bottom-color: var(--ai);
			}

			/* The catalogue, offered once the eight are read */
			.allwork {
				margin-top: clamp(2.5rem, 6vw, 4rem);
				padding-top: 1.5rem;
				border-top: 1px solid var(--rule);
			}

			.allwork__a {
				display: inline-flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0.9rem;
				text-decoration: none;
			}

			.allwork__ja {
				font-family: var(--jp);
				font-size: clamp(1.15rem, 1rem + 0.7vw, 1.5rem);
				letter-spacing: 0.14em;
				color: var(--ai);
				border-bottom: 1px solid transparent;
				transition: border-color 0.25s;
			}

			.allwork__a:hover .allwork__ja {
				border-bottom-color: var(--ai);
			}

			.allwork__lat {
				font-family: var(--gothic);
				font-size: 0.72rem;
				font-weight: 500;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--usuzumi);
			}

			.allwork__lat[lang='ar'] {
				font-family: var(--ar);
				font-size: 0.95rem;
				font-weight: 400;
			}

			/* ── 経歴 ─────────────────────────────────────────── */

			.about {
				display: grid;
				grid-template-columns: 16rem minmax(0, 1fr);
				gap: clamp(2rem, 5vw, 4.5rem);
				align-items: start;
			}

			.portrait {
				position: sticky;
				top: 2.5rem;
			}

			/* torn from the sheet rather than cropped */
			.portrait img {
				width: 100%;
				filter: grayscale(1) contrast(1.06);
				mix-blend-mode: multiply;
				clip-path: polygon(
					0% 1.5%,
					13% 0%,
					27% 2%,
					41% 0.4%,
					56% 2.2%,
					70% 0.6%,
					86% 2.4%,
					100% 1%,
					99% 15%,
					100% 32%,
					98.6% 51%,
					100% 68%,
					98.8% 86%,
					100% 99%,
					84% 97.6%,
					69% 100%,
					54% 97.8%,
					38% 99.6%,
					23% 97.6%,
					9% 99.8%,
					0% 98%,
					1.4% 80%,
					0% 62%,
					1.6% 44%,
					0% 26%
				);
			}

			.portrait figcaption {
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
				margin-top: 1rem;
				font-family: var(--gothic);
				font-size: 0.72rem;
				letter-spacing: 0.09em;
				color: var(--usuzumi);
			}

			.portrait figcaption [lang='ja'] {
				font-family: var(--jp);
				font-size: 0.8rem;
				letter-spacing: 0.2em;
				color: var(--sumi);
			}

			.portrait figcaption [lang='ar'] {
				font-family: var(--ar);
				font-size: 0.9rem;
			}

			.prose p {
				max-width: 38em;
			}

			.prose p[lang='ar'] {
				max-width: 36em;
			}

			.prose p + p {
				margin-top: 1.15rem;
			}

			.pull {
				display: flex;
				align-items: flex-start;
				gap: clamp(1rem, 3vw, 2rem);
				margin-top: clamp(2rem, 5vw, 3.25rem);
				padding-inline-start: clamp(1rem, 3vw, 2rem);
				border-inline-start: 2px solid var(--rule);
			}

			.pull__ja {
				margin: 0;
				height: 22rem;
				font-size: clamp(1.05rem, 0.95rem + 0.6vw, 1.4rem);
				font-weight: 600;
				letter-spacing: 0.1em;
			}

			.pull__en {
				max-width: 18em;
				padding-top: 0.35rem;
				font-size: 1.02rem;
				font-style: italic;
				color: #3d454c;
			}

			.pull__en[lang='ar'] {
				font-size: 1.15rem;
			}

			.track {
				grid-column: 2;
				margin-top: clamp(2.5rem, 5vw, 3.5rem);
				border-top: 1px solid var(--rule);
			}

			.track__row {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
				gap: 0.5rem 1.5rem;
				padding-block: 0.85rem;
				border-bottom: 1px solid var(--rule-soft);
			}

			.track__co {
				font-size: 1.02rem;
			}

			.track__meta {
				display: flex;
				flex-wrap: wrap;
				justify-content: space-between;
				gap: 0.5rem 1rem;
				font-family: var(--gothic);
				font-size: 0.76rem;
				letter-spacing: 0.05em;
				color: var(--usuzumi);
			}

			.track__meta [lang='ar'] {
				font-family: var(--ar);
				font-size: 0.92rem;
			}

			.track__yr {
				white-space: nowrap;
			}

			/* ── 道具 ─────────────────────────────────────────── */

			.dogu {
				display: flex;
				flex-direction: row-reverse; /* columns read right to left */
				flex-wrap: wrap;
				justify-content: flex-start;
				gap: clamp(0.9rem, 2.4vw, 1.7rem);
				padding-block: 1.5rem;
				border-block: 1px solid var(--rule);
			}

			.dogu__item {
				height: 9.5rem;
				font-family: var(--gothic);
				font-size: 0.92rem;
				font-weight: 400;
				letter-spacing: 0.06em;
				color: #3d454c;
			}

			.dogu__item:nth-child(3n) {
				color: var(--ai);
			}

			/* ── 数字 ─────────────────────────────────────────── */

			.ledger {
				display: grid;
				grid-template-columns: 3.5rem minmax(0, 1fr);
				gap: clamp(1rem, 3vw, 2.5rem);
				margin-top: clamp(3rem, 7vw, 5rem);
			}

			.marker--inline {
				justify-self: center;
				align-self: start;
			}

			.ledger__rows {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
				gap: clamp(1.5rem, 4vw, 3rem);
			}

			.ledger__row {
				display: flex;
				align-items: flex-start;
				gap: 1rem;
				padding-top: 1rem;
				border-top: 1px solid var(--rule);
			}

			.ledger__ja {
				margin: 0;
				display: flex;
				align-items: center;
				gap: 0.9rem;
				height: 9.5rem;
			}

			.ledger__name {
				font-size: 0.85rem;
				letter-spacing: 0.3em;
				color: var(--usuzumi);
			}

			.ledger__count {
				font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.2rem);
				font-weight: 600;
				letter-spacing: 0.04em;
			}

			.ledger__body {
				flex: 1 1 auto;
			}

			.ledger__label {
				display: block;
				margin-bottom: 0.35rem;
				font-family: var(--gothic);
				font-size: 0.66rem;
				font-weight: 500;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--ai);
			}

			.ledger__label[lang='ar'] {
				font-family: var(--ar);
				font-size: 0.9rem;
				font-weight: 400;
			}

			.ledger__en {
				font-size: 0.94rem;
				line-height: 1.65;
				color: #3d454c;
			}

			.ledger__en[lang='ar'] {
				line-height: 1.95;
			}

			/* ── 連絡 ─────────────────────────────────────────── */

			.renraku {
				margin-top: clamp(2rem, 6vw, 4rem);
				padding-block: clamp(3.5rem, 8vw, 6.5rem);
				background: var(--washi);
				/* torn along the top, as if lifted off the block */
				clip-path: polygon(
					0 14px,
					4% 5px,
					9% 15px,
					15% 6px,
					22% 17px,
					29% 5px,
					36% 14px,
					44% 3px,
					51% 13px,
					58% 6px,
					66% 16px,
					73% 5px,
					80% 14px,
					87% 4px,
					94% 15px,
					100% 6px,
					100% 100%,
					0 100%
				);
			}

			.renraku__in {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				gap: clamp(2rem, 6vw, 4rem);
				align-items: center;
			}

			.renraku__lede {
				margin-top: 1.25rem;
				max-width: 34em;
				font-size: clamp(1.02rem, 0.98rem + 0.3vw, 1.15rem);
			}

			.renraku__lede[lang='ar'] {
				max-width: 32em;
			}

			.cta {
				display: inline-flex;
				flex-direction: column;
				gap: 0.4rem;
				margin-top: clamp(1.75rem, 4vw, 2.5rem);
				padding-bottom: 0.5rem;
				border-bottom: 2px solid var(--shu);
				text-decoration: none;
			}

			.cta__en {
				font-family: var(--body);
				font-size: clamp(1.25rem, 1rem + 1.4vw, 2rem);
				font-weight: 300;
				line-height: 1.1;
				word-break: break-word;
			}

			.cta__ja {
				font-family: var(--jp);
				font-size: 0.82rem;
				letter-spacing: 0.2em;
				color: var(--usuzumi);
				transition: color 0.25s;
			}

			.cta__lat {
				font-family: var(--gothic);
				font-size: 0.68rem;
				font-weight: 500;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--usuzumi);
			}

			.cta__lat[lang='ar'] {
				font-family: var(--ar);
				font-size: 0.92rem;
				font-weight: 400;
			}

			.cta:hover .cta__ja {
				color: var(--shu);
			}

			.renraku__form {
				margin-top: 1.5rem;
			}

			.elsewhere {
				display: flex;
				flex-wrap: wrap;
				gap: 0.85rem 1.5rem;
				margin-top: clamp(1.75rem, 4vw, 2.5rem);
			}

			.renraku__seal {
				display: grid;
				place-items: center;
			}

			.hanko--static {
				position: static;
				animation: none;
				padding: 0.85rem 0.75rem;
				gap: 0.2rem;
				transform: rotate(4deg);
			}

			.hanko--static .hanko__col {
				font-size: 1.5rem;
			}

			/* ── footer ───────────────────────────────────────── */

			.foot {
				padding-block: clamp(2.5rem, 5vw, 3.5rem) 1rem;
			}

			.foot__in {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				padding-top: 1.25rem;
				border-top: 1px solid var(--rule-soft);
			}

			.foot__ja {
				font-family: var(--jp);
				font-size: 0.95rem;
				letter-spacing: 0.5em;
				color: var(--ai);
			}

			.foot__en {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0.4rem;
				font-family: var(--gothic);
				font-size: 0.72rem;
				letter-spacing: 0.06em;
				color: var(--usuzumi);
			}

			.foot__en [lang='ja'] {
				font-family: var(--jp);
				letter-spacing: 0.2em;
				color: var(--sumi);
			}

			.foot__en [lang='ar'] {
				font-family: var(--ar);
				font-size: 0.9rem;
			}

			/* ── entrances ────────────────────────────────────── */

			.rise {
				opacity: 0;
				transform: translateY(14px);
				transition:
					opacity 0.75s ease,
					transform 0.75s cubic-bezier(0.2, 0.7, 0.2, 1);
			}

			.rise.is-in {
				opacity: 1;
				transform: none;
			}

			/* ── narrower than a hand ─────────────────────────── */

			@media (max-width: 62rem) {
				.about {
					grid-template-columns: minmax(0, 1fr);
				}

				.portrait {
					position: static;
					max-width: 11rem;
				}

				.track {
					grid-column: 1;
				}

				.card {
					grid-column: span 12;
				}

				.card:nth-child(2),
				.card:nth-child(5),
				.card:nth-child(8) {
					margin-top: 0;
				}
			}

			@media (max-width: 48rem) {
				.nav__lat,
				.mark__ja {
					display: none;
				}

				.head,
				.ledger {
					grid-template-columns: minmax(0, 1fr);
				}

				/* The section marker lies down where there is no gutter to hold it. */
				.marker {
					writing-mode: horizontal-tb;
					justify-self: start;
					margin-bottom: 0.5rem;
					font-size: 0.95rem;
					letter-spacing: 0.45em;
				}

				.sanpo__rows {
					grid-template-columns: minmax(0, 1fr);
				}

				.spec--tate {
					grid-column: 1;
					grid-row: auto;
					grid-template-columns: 1fr 1.5rem;
					justify-items: start;
					padding-inline-start: 0;
					padding-top: 1.25rem;
					border-inline-start: 0;
					border-top: 1px solid var(--rule-soft);
				}

				.spec--tate .spec__note {
					justify-content: flex-start;
				}

				.spec__line--ja {
					height: 17rem;
				}

				/* 19 rotated tool names would run off a phone: lay them flat. */
				.dogu__item {
					writing-mode: horizontal-tb;
					height: auto;
					font-size: 0.85rem;
				}

				.dogu {
					flex-direction: row;
					gap: 0.5rem 1.1rem;
				}

				.pull__ja {
					height: 17rem;
				}

				.renraku__in {
					grid-template-columns: minmax(0, 1fr);
				}

				.renraku__seal {
					justify-items: start;
					place-items: start;
				}
			}

			@media (max-width: 30rem) {
				.hero__in {
					gap: 0.9rem;
				}

				.hero__thesis {
					font-size: 1.5rem;
					letter-spacing: 0.04em;
				}

				.card__paper {
					flex-direction: column-reverse;
					gap: 0.7rem;
				}

				.card__rail {
					writing-mode: horizontal-tb;
					align-items: baseline;
				}

				.ledger__ja {
					writing-mode: horizontal-tb;
					height: auto;
					align-items: baseline;
				}

				.ledger__row {
					flex-direction: column;
					gap: 0.4rem;
				}

				.hanko {
					inset-inline: auto 0;
					inset-block-start: auto;
					inset-block-end: -1.5rem;
				}

				html[dir='rtl'] .hanko {
					inset-inline: 0 auto;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}

				*,
				*::before,
				*::after {
					animation-duration: 0.001ms !important;
					animation-iteration-count: 1 !important;
					transition-duration: 0.001ms !important;
				}

				.rise {
					opacity: 1;
					transform: none;
				}

				.hanko {
					animation: none;
				}
			}
		</style>
	</body>
</html>
