---
import type { Design } from '../registry';
import { otherLang, url as designUrl } from '../routes';
import { dirOf, type Lang } from '../../i18n';
import { Image } from 'astro:assets';
import { profile } from '../../../content/profile';
import type { I18n } from '../../../content/types';
import { featured, projects } from '../../data/projects';
import { toolbox } from '../../i18n';
import type { Key } from '../../i18n';
import { pair, s, yearPair } from '../../data/variant-ui';
import LangBoot from '../../components/LangBoot.astro';
import Seam from '../../components/Seam.astro';
import Reveal from '../_shared/Reveal.astro';
import Meta from '../_shared/Meta.astro';
import T from '../../components/T.astro';
import Logo from '../../components/Logo.astro';
import profilePhoto from '../../assets/images/profile.png';
interface Props {
	design: Design;
	lang: Lang;
}

import DesignSwitch from '../_shared/DesignSwitch.astro';
const { design, lang } = Astro.props;
/** A link inside this design, in this language: u('/work/aoun'). */
const u = (page = '') => designUrl(design, lang, page);

/* Category and status, said properly in Japanese rather than transliterated.
   受託 is the ordinary word for contract work; 端末内 means "inside the
   handset", which is exactly what the on-device work is. The Japanese is
   decoration that stays in both language modes; the reader's own language
   sits beside it, never instead of it. */
const categoryJa: Record<string, string> = {
	web: 'ウェブ',
	mobile: 'モバイル',
	desktop: 'デスクトップ',
	extension: '拡張機能',
	ai: '端末内AI',
	client: '受託',
};

const statusJa: Record<string, string> = {
	live: '公開中',
	shipped: '出荷済',
	delisted: '掲載終了',
	wip: '制作中',
	archived: '保管',
};

const catT = (c: string): I18n => s(`cat.${c}` as Key);
const statusT = (st: string): I18n => s(`status.${st}` as Key);

/* The card rail is Japanese, so its year stays bare numerals: 2025〜 for an
   open span, 2023〜2026 for a closed one. 波ダッシュ carries the sense without
   a word in it, and the digits rotate with the rail the way 算用数字 do in
   any 縦組み. Not 縦中横: a four-digit year squeezed into one em at this size
   is unreadable, and 縦中横 is for two digits. "Since" and «منذ» are said in
   .card__cat instead, horizontally, where Arabic can be set the right way
   round rather than dragged into a rail pinned ltr for the Japanese. */
const railYear = (y: string): string =>
	y.replace(/^Since (\d+)$/, '$1〜').replace(/^(\d+) to (\d+)$/, '$1〜$2');

/* Uneven on purpose: the empty half of a row is 間, not a gap to be filled. */
const spans = [7, 5, 5, 7, 6, 6, 7, 5];

/* Counters matter in Japanese: 件 for items of work, 本 for released apps,
   編 for written pieces. Digits stay Arabic and get 縦中横 when set vertically. */
const ledger = [
	{
		ja: '作品',
		n: String(projects.length),
		unit: '件',
		label: s('nav.work'),
		line: pair(
			'Products taken from data model to store listing.',
			'منتجات من نموذج البيانات حتى صفحة المتجر.',
		),
	},
	{
		ja: '公開',
		n: '13',
		unit: '本',
		label: pair('Released', 'منشور'),
		line: pair(
			'Of them live on the App Store or Google Play.',
			'منها يعمل الآن على آب ستور أو جوجل بلاي.',
		),
	},
	{
		ja: '事例',
		n: '8',
		unit: '編',
		label: pair('Case studies', 'دراسات حالة'),
		line: pair(
			'Written up in full, decisions and all.',
			'مشروحة بالكامل، بقراراتها كلها.',
		),
	},
	{
		ja: '経験',
		n: '4',
		unit: '年',
		label: pair('Years', 'سنوات'),
		line: pair(
			'Roughly, building for the web and phones.',
			'تقريبًا، في البناء للويب والهواتف.',
		),
	},
];

const nav = [
	{ href: '#sakuhin', ja: '作品', t: s('nav.work') },
	{ href: '#keireki', ja: '経歴', t: s('nav.about') },
	{ href: '#dogu', ja: '道具', t: pair('Tools', 'الأدوات') },
	{ href: '#renraku', ja: '連絡', t: pair('Contact', 'التواصل') },
];

const pages = [
	{ href: u('/work'), ja: '目録', t: pair('Catalogue', 'الفهرس') },
	{ href: u('/hire'), ja: '依頼', t: s('nav.hire') },
];

const about = [
	pair(
		'I take products from data model to store listing, including the API, interface, deployment, review, and the support that follows release.',
		'أتولى المنتجات من نموذج البيانات حتى صفحة المتجر، بما يشمل واجهة API والواجهة والنشر والمراجعة والدعم بعد الإطلاق.',
	),
	pair(
		'I take on work with clear constraints: models that run on the handset, search indexes that answer in milliseconds, and booking flows that prevent double bookings. The constraint shapes the build.',
		'أتولى أعمالًا ذات قيود واضحة: نماذج تعمل على الهاتف، وفهارس بحث تجيب في أجزاء من الثانية، ومسارات حجز تمنع حجز الساعة نفسها مرتين. القيد هو ما يشكّل البناء.',
	),
	pair(
		"My recent work uses on-device AI. Video and audio processing finishes on the user's phone or laptop, without cloud processing or telemetry. I also bring four years of client work, a product I founded, and a volunteer app used by several student cohorts.",
		'تستخدم أعمالي الحديثة الذكاء الاصطناعي على الجهاز. تنتهي معالجة الفيديو والصوت على هاتف المستخدم أو حاسوبه، من دون معالجة سحابية أو تتبّع. وأحمل أيضًا أربع سنوات من عمل العملاء، ومنتجًا أسّسته، وتطبيقًا تطوعيًا استخدمته عدة دفعات من الطلبة.',
	),
];

const mailto = `mailto:${profile.email}?subject=${encodeURIComponent('Project enquiry')}`;
---

<!doctype html>
<html lang={lang} dir={dirOf(lang)} data-design={design.id}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>
			{
				pair(
					'Haitham Assoli — 丁寧につくられた画面。',
					'هيثم العسولي — 丁寧につくられた画面。',
				)[lang]
			}
		</title>
		<meta
			name="description"
			content={pair(
				'Haitham Assoli builds web and mobile products in Amman. Thirty-nine shipped projects, including thirteen on the app stores.',
				'يبني هيثم العسولي تطبيقات ويب وجوال في عمّان. تسعة وثلاثون مشروعًا صدر، منها ثلاثة عشر على متاجر التطبيقات.',
			)[lang]}
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;1,6..72,300&family=Shippori+Mincho:wght@400;600&family=Zen+Kaku+Gothic+New:wght@400;500&display=swap"
		/>
		<LangBoot />
		<Seam />
		<Reveal />
		<Meta design={design} lang={lang} />
	</head>

	<body>
		<a class="skip" href="#main"><T v={s('nav.skip')} /></a>

		<header class="topbar">
			<div class="wrap topbar__in">
				<a class="mark" href="#main">
					<span class="mark__ja" lang="ja">ハイサム</span>
					<T v={pair('Haitham Assoli', 'هيثم العسولي')} class="mark__en" />
				</a>
				<nav class="nav" aria-label="Sections">
					{
						nav.map((item) => (
							<a class="nav__a" href={item.href}>
								<span lang="ja">{item.ja}</span>
								<T v={item.t} class="nav__lat" />
							</a>
						))
					}
					<span class="nav__sep" aria-hidden="true"></span>
					{
						pages.map((item) => (
							<a class="nav__a nav__a--page" href={item.href}>
								<span lang="ja">{item.ja}</span>
								<T v={item.t} class="nav__lat" />
							</a>
						))
					}
				</nav>
			</div>
		</header>

		<main id="main">
			<!-- 序 — the thesis, stated on three axes -->
			<section class="hero" aria-labelledby="h1">
				<div class="wrap hero__in">
					<p class="hero__thesis tate" lang="ja">丁寧につくられた画面。</p>

					<div class="hero__body">
						<p class="eyebrow">
							<span lang="ja">職業</span>
							<T
								v={pair(
									'Web & mobile engineer · Amman, Jordan',
									'مهندس ويب وتطبيقات جوّال · عمّان، الأردن',
								)}
							/>
						</p>

						<!-- The cover mark: هيثم written once, in sumi on an indigo
						     rule, exactly as the sub-pages set it — only at a cover's
						     scale. Nothing is written out under it; the name stays in
						     the heading, clipped, so it is announced in the language
						     being read and nothing visible rests on a glyph. -->
						<h1 class="hero__name" id="h1">
							<Logo class="hero__logo" labelled={false} />
							<T v={pair('Haitham Assoli', 'هيثم العسولي')} class="sr-only" />
							<span class="hero__kana" lang="ja">ハイサム・アッソーリ</span>
						</h1>

						<T
							as="p"
							class="hero__deck"
							v={pair(
								'I build complete products. Each screen serves a person and handles a real constraint.',
								'أبني منتجات مكتملة. تخدم كل شاشة شخصًا وتعالج قيدًا حقيقيًا.',
							)}
						/>

						<!-- 三方 — one sentence, three voices. The two horizontal
						     voices are the language switch: whichever one you are not
						     reading in offers itself. The vertical Japanese is the
						     constant third voice and never moves. -->
						<div class="sanpo rise">
							<p class="sanpo__label">
								<span lang="ja">三方</span>
								<T
									v={pair(
										'The same principle, presented three ways.',
										'المبدأ نفسه، معروض بثلاث صيغ.',
									)}
								/>
							</p>

							<div class="sanpo__rows">
								<div class="spec spec--en" dir="ltr">
									<span class="spec__axis" aria-hidden="true">→</span>
									<p class="spec__line spec__line--en" lang="en">
										Every screen should earn its place.
									</p>
									<p class="spec__note">
										<span class="spec__script" lang="en">English edition</span>
										<span class="spec__state" data-l="en" lang="en"
											>reading now</span
										>
										<a
											href={otherLang(Astro.url.pathname)}
											class="voice"
											data-lang-link
											data-l="ar"
											lang="en"
											dir="ltr"
										>
											<span class="voice__ja" lang="ja" aria-hidden="true"
												>語</span
											>
											Read in English
										</a>
									</p>
								</div>

								<div class="spec spec--ar" dir="rtl">
									<span class="spec__axis" aria-hidden="true">←</span>
									<p class="spec__line spec__line--ar" lang="ar">
										كل شاشة يجب أن تستحق مكانها.
									</p>
									<p class="spec__note">
										<span class="spec__script" lang="ar">النسخة العربية</span>
										<span class="spec__state" data-l="ar" lang="ar"
											>تقرأ الآن</span
										>
										<a
											href={otherLang(Astro.url.pathname)}
											class="voice"
											data-lang-link
											data-l="en"
											lang="ar"
											dir="rtl"
										>
											<span class="voice__ja" lang="ja" aria-hidden="true"
												>語</span
											>
											اقرأ بالعربية
										</a>
									</p>
								</div>

								<div class="spec spec--tate" dir="ltr">
									<span class="spec__axis" aria-hidden="true">↓</span>
									<p class="spec__line spec__line--ja tate" lang="ja">
										すべての画面には、理由が必要だ。
									</p>
									<p class="spec__note">
										<span class="spec__script" lang="ja"
											>日本語 · 上から下へ</span
										>
									</p>
								</div>
							</div>
						</div>

						<DesignSwitch design={design} lang={lang} class="rise" />

						<div class="hanko" aria-hidden="true">
							<span class="hanko__col" lang="ja">ハイ</span>
							<span class="hanko__col" lang="ja">サム</span>
						</div>
					</div>
				</div>
			</section>

			<div class="fold" aria-hidden="true"></div>

			<!-- 作品 -->
			<section class="band" id="sakuhin" aria-labelledby="sakuhin-h">
				<div class="wrap">
					<div class="head">
						<p class="marker tate" lang="ja" aria-hidden="true">作品</p>
						<div class="head__text">
							<h2 class="head__title" id="sakuhin-h">
								<T v={s('nav.work')} />
								<span class="head__ja" lang="ja">作品</span>
							</h2>
							<T
								as="p"
								class="head__lede"
								v={pair(
									`Eight of ${projects.length}, chosen because each one had a constraint worth solving. Every card opens onto the long version.`,
									`ثمانية من ${projects.length}، اخترتها لأن في كل واحد منها قيدًا يستحق الحل. كل بطاقة تفتح على النسخة الطويلة.`,
								)}
							/>
						</div>
					</div>

					<ol class="grid">
						{
							featured.map((p, i) => (
								<li class="card rise" style={`--span:${spans[i] ?? 6}`}>
									<a class="card__link" href={u(`/work/${p.slug}`)}>
										<span class="card__hit" />
										<span class="card__titles">
											<span class="card__title">
												<T v={p.title} />
											</span>
											<span class="card__more" aria-hidden="true">
												<span lang="ja">詳しく見る</span>
												<T v={s('work.read')} />
											</span>
										</span>
									</a>

									<div class="card__paper">
										<p class="card__rail tate" lang="ja">
											<span class="card__year">{railYear(p.year)}</span>
											<span class="card__dot" aria-hidden="true">
												・
											</span>
											<span class="card__status">
												{statusJa[p.status] ?? p.status}
											</span>
										</p>

										<div class="card__shot" data-frame={p.frame}>
											{p.image ? (
												<Image
													src={p.image}
													alt={`${pair('Screen from', 'لقطة من')[lang]} ${p.title[lang]}`}
													widths={[420, 840]}
													sizes="(min-width: 62rem) 42vw, 90vw"
													loading={i === 0 ? 'eager' : 'lazy'}
													decoding="async"
												/>
											) : (
												<span class="card__noshot" lang="ja">
													図版なし
												</span>
											)}
										</div>
									</div>

									<p class="card__cat">
										<span lang="ja">
											{categoryJa[p.category] ?? p.category}
										</span>
										<T v={catT(p.category)} />
										<T v={statusT(p.status)} class="card__st" />
										<T v={yearPair(p.year)} class="card__yr" />
									</p>

									<T as="p" class="card__tagline" v={p.tagline} />
									<T as="p" class="card__summary" v={p.summary} />

									<p class="card__stack" lang="en" dir="ltr">
										{p.stack.slice(0, 7).map((tool, j) => (
											<>
												{j > 0 && <span class="sep">、</span>}
												<span class="tool">{tool}</span>
											</>
										))}
									</p>

									{(p.links.live ||
										p.links.appStore ||
										p.links.playGoogle ||
										p.links.github) && (
										<p class="card__links">
											{p.links.live && (
												<a class="lnk" href={p.links.live} rel="noreferrer">
													<T v={s('project.live')} />
												</a>
											)}
											{p.links.appStore && (
												<a class="lnk" href={p.links.appStore} rel="noreferrer">
													<T v={s('project.apple')} />
												</a>
											)}
											{p.links.playGoogle && (
												<a
													class="lnk"
													href={p.links.playGoogle}
													rel="noreferrer"
												>
													<T v={s('project.play')} />
												</a>
											)}
											{p.links.github && (
												<a class="lnk" href={p.links.github} rel="noreferrer">
													<T v={s('project.github')} />
												</a>
											)}
										</p>
									)}
								</li>
							))
						}
					</ol>

					<p class="allwork">
						<a class="allwork__a" href={u('/work')}>
							<span class="allwork__ja" lang="ja"
								>目録 — 全{projects.length}件</span
							>
							<T v={s('work.all')} class="allwork__lat" />
						</a>
					</p>
				</div>
			</section>

			<div class="fold" aria-hidden="true"></div>

			<!-- 経歴 -->
			<section class="band" id="keireki" aria-labelledby="keireki-h">
				<div class="wrap">
					<div class="head">
						<p class="marker tate" lang="ja" aria-hidden="true">経歴</p>
						<div class="head__text">
							<h2 class="head__title" id="keireki-h">
								<T v={s('nav.about')} />
								<span class="head__ja" lang="ja">経歴</span>
							</h2>
						</div>
					</div>

					<div class="about">
						<figure class="portrait rise">
							<Image
								src={profilePhoto}
								alt="Haitham Assoli"
								widths={[260, 520]}
								sizes="(min-width: 62rem) 16rem, 9rem"
								loading="lazy"
							/>
							<figcaption>
								<span lang="ja">ハイサム・アッソーリ</span>
								<T v={profile.location} />
							</figcaption>
						</figure>

						<div class="prose rise">
							{about.map((p) => <T as="p" v={p} />)}

							<blockquote class="pull">
								<p class="pull__ja tate" lang="ja">
									制約のない仕事に、面白さはない。
								</p>
								<T
									as="p"
									class="pull__en"
									v={pair(
										'Work without a constraint holds nothing worth doing.',
										'العمل بلا قيد لا يحمل ما يستحق.',
									)}
								/>
							</blockquote>
						</div>

						<dl class="track rise">
							{
								profile.experience.slice(0, 5).map((job) => (
									<div class="track__row">
										<dt class="track__co">
											<T v={job.company} />
										</dt>
										<dd class="track__meta">
											<T v={job.role} />
											<T v={yearPair(job.period)} class="track__yr" />
										</dd>
									</div>
								))
							}
							{
								profile.education.slice(0, 1).map((ed) => (
									<div class="track__row">
										<dt class="track__co">
											<T v={ed.school} />
										</dt>
										<dd class="track__meta">
											<T v={ed.degree} />
											<T v={yearPair(ed.period)} class="track__yr" />
										</dd>
									</div>
								))
							}
						</dl>
					</div>
				</div>
			</section>

			<div class="fold" aria-hidden="true"></div>

			<!-- 道具 + 数字 -->
			<section class="band" id="dogu" aria-labelledby="dogu-h">
				<div class="wrap">
					<div class="head">
						<p class="marker tate" lang="ja" aria-hidden="true">道具</p>
						<div class="head__text">
							<h2 class="head__title" id="dogu-h">
								<T v={pair('Tools', 'الأدوات')} />
								<span class="head__ja" lang="ja">道具</span>
							</h2>
							<T
								as="p"
								class="head__lede"
								v={pair(
									'Set the way a craftsman lays out a bench: the things reached for daily, in the order they get reached for. Nothing here is on the list because it looked good on a list.',
									'مرتّبة كما يرتّب الحرفيّ عدّته: ما تمتد إليه اليد يوميًا، بالترتيب الذي تمتد به. لا شيء هنا لأنه يبدو حسنًا في قائمة.',
								)}
							/>
						</div>
					</div>

					<ul class="dogu rise" lang="en" dir="ltr">
						{
							toolbox.map((tool) => (
								<li class="dogu__item tate">
									<span>{tool}</span>
								</li>
							))
						}
					</ul>

					<div class="ledger">
						<h3 class="sr-only" id="suji-h">
							<T v={pair('Figures', 'أرقام')} />
						</h3>
						<p class="marker marker--inline tate" lang="ja" aria-hidden="true">
							数字
						</p>
						<dl class="ledger__rows" aria-labelledby="suji-h">
							{
								ledger.map((row) => (
									<div class="ledger__row rise">
										<dt class="ledger__ja tate" lang="ja">
											<span class="ledger__name">{row.ja}</span>
											<span class="ledger__count">
												<span class="tcy">{row.n}</span>
												{row.unit}
											</span>
										</dt>
