---
import type { Design } from '../registry';
import type { Project as ProjectData } from '../../data/projects';
import { url as designUrl } from '../routes';
import type { Lang } from '../../i18n';
/* One project, read the way a bound volume is read: title slip, plate,
   body, then the 奥付 colophon at the back. Problems and answers are set
   as 問 and 答 either side of a vertical gutter. */
import { Image } from 'astro:assets';
import type { I18n } from '../../../content/types';
import type { Key } from '../../i18n';
import { pair, s, yearPair } from '../../data/variant-ui';
import T from '../../components/T.astro';
import Shell from './Shell.astro';
interface Props {
	design: Design;
	lang: Lang;
	project: ProjectData;
	next: ProjectData;
}

const { design, lang } = Astro.props;
/** A link inside this design, in this language: u('/work/aoun'). */
const u = (page = '') => designUrl(design, lang, page);

const { project, next } = Astro.props;

const categoryJa: Record<string, string> = {
	web: 'ウェブ',
	mobile: 'モバイル',
	desktop: 'デスクトップ',
	extension: '拡張機能',
	ai: '端末内AI',
	client: '受託',
};

const statusJa: Record<string, string> = {
	live: '公開中',
	shipped: '出荷済',
	delisted: '掲載終了',
	wip: '制作中',
	archived: '保管',
};

const catT = (c: string): I18n => s(`cat.${c}` as Key);
const statusT = (st: string): I18n => s(`status.${st}` as Key);

/* Covers run from 1080×2340 handset grabs to wide desktop screens. A plate
   taller than it is wide gets mounted whole; nothing here is ever cropped. */
const isTall = (img: ImageMetadata) => img.height / img.width > 1.2;

/* The gallery repeats the cover in a few entries. Show it once. */
const gallery = project.shots.filter((shot) => shot.src !== project.image?.src);

const links = [
	{ href: project.links.live, t: s('project.live') },
	{ href: project.links.appStore, t: s('project.apple') },
	{ href: project.links.playGoogle, t: s('project.play') },
	{ href: project.links.vscode, t: s('project.vscode') },
	{ href: project.links.github, t: s('project.github') },
].filter((l) => Boolean(l.href));

const overview = project.overview.en.map((_, i) =>
	pair(
		project.overview.en[i],
		project.overview.ar[i] ?? project.overview.en[i],
	),
);

const outcomes = project.outcomes.en.map((_, i) =>
	pair(
		project.outcomes.en[i],
		project.outcomes.ar[i] ?? project.outcomes.en[i],
	),
);
---

<Shell
	design={design}
	lang={lang}
	title={`${project.title[lang]} — ${pair('Haitham Assoli', 'هيثم العسولي')[lang]}`}
	description={project.tagline[lang]}
	current="projects"
>
	<div class="wrap">
		<p class="crumb">
			<a class="lnk" href={u('/work')}>
				<span lang="ja">目録へ戻る</span>
				<T v={s('project.back')} />
			</a>
		</p>

		<div class="daisen">
			<p class="daisen__ja tate" lang="ja">
				{categoryJa[project.category] ?? project.category}
			</p>
			<div>
				<h1 class="daisen__h">
					<T v={project.title} />
				</h1>
				<T as="p" class="daisen__lede" v={project.tagline} />
				<p class="crest">
					<T v={yearPair(project.year)} class="crest__i" />
					<span class="crest__dot" aria-hidden="true">・</span>
					<span class="crest__ja" lang="ja"
						>{statusJa[project.status] ?? project.status}</span
					>
					<T v={statusT(project.status)} class="crest__i" />
					<span class="crest__dot" aria-hidden="true">・</span>
					<T v={catT(project.category)} class="crest__i" />
				</p>
			</div>
		</div>

		{
			project.image && (
				<figure
					class="plate rise"
					data-tall={isTall(project.image) ? '' : undefined}
				>
					<Image
						src={project.image}
						alt={`${pair('Cover screen from', 'لقطة الغلاف من')[lang]} ${project.title[lang]}`}
						widths={[640, 1080, 1600]}
						sizes="(min-width: 62rem) 60rem, 92vw"
						loading="eager"
						decoding="async"
					/>
				</figure>
			)
		}

		<div class="doc">
			<section class="sect" aria-labelledby="youshi-h">
				<p class="marker tate" lang="ja" aria-hidden="true">要旨</p>
				<div class="sect__body">
					<h2 class="sr-only" id="youshi-h">
						<T v={pair('Summary', 'الخلاصة')} />
					</h2>
					<T as="p" class="summary" v={project.summary} />
				</div>
			</section>

			<section class="sect" aria-labelledby="gaiyou-h">
				<p class="marker tate" lang="ja" aria-hidden="true">概要</p>
				<div class="sect__body">
					<h2 class="sect__h" id="gaiyou-h">
						<T v={pair('Overview', 'نظرة عامة')} />
						<span class="sect__hja" lang="ja">概要</span>
					</h2>
					<div class="prose">
						{overview.map((p) => <T as="p" v={p} />)}
					</div>
				</div>
			</section>

			{
				project.challenges.length > 0 && (
					<section class="sect" aria-labelledby="kadai-h">
						<p class="marker tate" lang="ja" aria-hidden="true">
							課題
						</p>
						<div class="sect__body">
							<h2 class="sect__h" id="kadai-h">
								<T v={s('project.challenges')} />
								<span class="sect__hja" lang="ja">
									課題
								</span>
							</h2>

							{project.challenges.map((c) => (
								<article class="mondai rise">
									<h3 class="mondai__h">
										<T v={c.title} />
									</h3>
									<div class="mondai__pair">
										<div class="mondai__side">
											<p class="mondai__mark tate" lang="ja" aria-hidden="true">
												問
											</p>
											<div class="mondai__text">
												<T
													v={pair('The problem', 'المشكلة')}
													class="mondai__label"
												/>
												<T as="p" v={c.problem} />
											</div>
										</div>
										<div class="mondai__side mondai__side--a">
											<p class="mondai__mark tate" lang="ja" aria-hidden="true">
												答
											</p>
											<div class="mondai__text">
												<T
													v={pair('What I did', 'ما فعلته')}
													class="mondai__label"
												/>
												<T as="p" v={c.solution} />
											</div>
										</div>
									</div>
								</article>
							))}
						</div>
					</section>
				)
			}

			{
				outcomes.length > 0 && (
					<section class="sect" aria-labelledby="seika-h">
						<p class="marker tate" lang="ja" aria-hidden="true">
							成果
						</p>
						<div class="sect__body">
							<h2 class="sect__h" id="seika-h">
								<T v={s('project.outcomes')} />
								<span class="sect__hja" lang="ja">
									成果
								</span>
							</h2>
							<ul class="seika">
								{outcomes.map((o) => (
									<li class="seika__row">
										<span class="seika__dot" aria-hidden="true">
											・
										</span>
										<T as="p" v={o} />
									</li>
								))}
							</ul>
						</div>
					</section>
				)
			}

			{
				gallery.length > 0 && (
					<section class="sect" aria-labelledby="zuhan-h">
						<p class="marker tate" lang="ja" aria-hidden="true">
							図版
						</p>
						<div class="sect__body">
							<h2 class="sect__h" id="zuhan-h">
								<T v={pair('Plates', 'اللوحات')} />
								<span class="sect__hja" lang="ja">
									図版
								</span>
							</h2>
							<ul class="zuhan">
								{gallery.map((shot, i) => (
									<li
										class="zuhan__cell rise"
										data-tall={isTall(shot) ? '' : undefined}
									>
										<Image
											src={shot}
											alt={`${project.title[lang]} — ${pair('plate', 'لوحة')[lang]} ${i + 1}`}
											widths={[480, 960]}
											sizes="(min-width: 62rem) 28rem, 88vw"
											loading="lazy"
											decoding="async"
										/>
									</li>
								))}
							</ul>
						</div>
					</section>
				)
			}

			<section class="sect" aria-labelledby="okuzuke-h">
				<p class="marker tate" lang="ja" aria-hidden="true">奥付</p>
				<div class="sect__body">
					<h2 class="sect__h" id="okuzuke-h">
						<T v={pair('Colophon', 'بيانات النشر')} />
						<span class="sect__hja" lang="ja">奥付</span>
					</h2>

					<dl class="oku">
						<div class="oku__row">
							<dt class="oku__k">
								<span lang="ja">役割</span>
								<T v={s('project.role')} />
							</dt>
							<dd class="oku__v"><T v={project.role} /></dd>
						</div>

						<div class="oku__row">
							<dt class="oku__k">
								<span lang="ja">年</span>
								<T v={s('project.year')} />
							</dt>
							<dd class="oku__v"><T v={yearPair(project.year)} /></dd>
						</div>

						<div class="oku__row">
							<dt class="oku__k">
								<span lang="ja">状態</span>
								<T v={s('project.status')} />
							</dt>
							<dd class="oku__v"><T v={statusT(project.status)} /></dd>
						</div>

						<div class="oku__row">
							<dt class="oku__k">
								<span lang="ja">分野</span>
								<T v={pair('Category', 'التصنيف')} />
							</dt>
							<dd class="oku__v"><T v={catT(project.category)} /></dd>
						</div>

						<div class="oku__row">
							<dt class="oku__k">
								<span lang="ja">道具</span>
								<T v={s('project.stack')} />
							</dt>
							<dd class="oku__v oku__stack" lang="en" dir="ltr">
								{
									project.stack.map((tool, j) => (
										<>
											{j > 0 && (
												<span class="sep" aria-hidden="true">
													、
												</span>
											)}
											<span>{tool}</span>
										</>
									))
								}
							</dd>
						</div>

						{
							links.length > 0 && (
								<div class="oku__row">
									<dt class="oku__k">
										<span lang="ja">所在</span>
										<T v={s('project.links')} />
									</dt>
									<dd class="oku__v oku__links">
										{links.map((l) => (
											<a class="lnk" href={l.href} rel="noreferrer">
												<T v={l.t} />
											</a>
										))}
									</dd>
								</div>
							)
						}
					</dl>
				</div>
			</section>
		</div>

		<nav class="tsugi" aria-labelledby="tsugi-h">
			<h2 class="tsugi__h" id="tsugi-h">
				<span lang="ja">次の作品</span>
				<T v={s('project.next')} />
			</h2>
			<a class="tsugi__a" href={u(`/work/${next.slug}`)}>
				<span class="tsugi__title"><T v={next.title} /></span>
				<T as="span" class="tsugi__tag" v={next.tagline} />
			</a>
		</nav>
	</div>

	<style is:global>
		.crumb {
			margin-top: clamp(1.5rem, 4vw, 2.5rem);
		}

		.crest {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: 0.5rem;
			margin-top: 1.25rem;
			padding-top: 1rem;
			border-top: 1px solid var(--rule-soft);
			font-family: var(--gothic);
			font-size: 0.72rem;
			font-weight: 500;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: var(--usuzumi);
		}

		.crest__ja {
			font-family: var(--jp);
			font-size: 0.85rem;
			letter-spacing: 0.18em;
			text-transform: none;
			color: var(--ai);
		}

		.crest__dot {
			color: var(--rule);
		}

		.crest__i[lang='ar'] {
			font-family: var(--ar);
			font-size: 0.92rem;
			font-weight: 400;
		}

		/* ── the plate ────────────────────────────────────── */

		.plate {
			margin-top: clamp(2rem, 5vw, 3.25rem);
			padding: clamp(0.75rem, 2.5vw, 1.4rem);
			background: var(--washi);
			border: 1px solid var(--rule-soft);
			box-shadow:
				0 1px 0 rgba(255, 255, 255, 0.7) inset,
				0 18px 34px -28px rgba(30, 37, 43, 0.6);
		}

		.plate img {
			width: 100%;
			height: auto;
			filter: saturate(0.88) contrast(1.02);
		}

		/* A handset grab is 1080×2340. Stand it up, do not stretch it. */
		.plate[data-tall] {
			display: grid;
			place-items: center;
			padding: clamp(1.25rem, 4vw, 2.5rem);
			background: linear-gradient(180deg, #efede6, #e2dfd6);
		}

		.plate[data-tall] img {
			width: auto;
			max-width: min(100%, 20rem);
			max-height: 38rem;
			box-shadow: 0 16px 34px -22px rgba(30, 37, 43, 0.8);
		}

		/* ── the body ─────────────────────────────────────── */

		.doc {
			margin-top: clamp(2.5rem, 6vw, 4rem);
		}

		.sect {
			display: grid;
			grid-template-columns: 3.5rem minmax(0, 1fr);
			gap: clamp(1rem, 3vw, 2.5rem);
			padding-block: clamp(2rem, 5vw, 3.5rem);
			border-top: 1px solid var(--rule);
		}

		.sect:first-child {
			border-top: 0;
			padding-top: 0;
		}

		.sect__body {
			min-width: 0;
			max-width: 52rem;
		}

		.sect__h {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: 0.8rem;
			margin-bottom: 1.5rem;
			font-family: var(--body);
			font-size: clamp(1.35rem, 1.1rem + 1vw, 1.8rem);
			font-weight: 300;
			line-height: 1.15;
		}

		.sect__h [data-l='ar'] {
			font-family: var(--ar);
			font-size: 0.92em;
			font-weight: 400;
			line-height: 1.5;
		}

		.sect__hja {
			font-family: var(--jp);
			font-size: 0.46em;
			letter-spacing: 0.28em;
			color: var(--usuzumi);
		}

		.summary {
			max-width: 40em;
			font-size: clamp(1.08rem, 1rem + 0.5vw, 1.32rem);
			line-height: 1.7;
		}

		.summary[lang='ar'] {
			max-width: 36em;
			line-height: 2.05;
		}

		.prose p {
			max-width: 40em;
		}

		.prose p[lang='ar'] {
			max-width: 37em;
		}

		.prose p + p {
			margin-top: 1.15rem;
		}

		/* ── 問 と 答 ─────────────────────────────────────── */

		.mondai + .mondai {
			margin-top: clamp(2rem, 5vw, 3rem);
			padding-top: clamp(2rem, 5vw, 3rem);
			border-top: 1px solid var(--rule-soft);
		}

		.mondai__h {
			font-family: var(--body);
			font-size: 1.15rem;
			font-weight: 400;
			line-height: 1.3;
			margin-bottom: 1.1rem;
		}

		.mondai__h [lang='ar'] {
			font-family: var(--ar);
			font-size: 1.2rem;
			line-height: 1.6;
		}

		.mondai__pair {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: clamp(1.25rem, 3vw, 2.25rem);
		}

		.mondai__side {
			display: grid;
			grid-template-columns: 1.6rem minmax(0, 1fr);
			gap: 0.8rem;
		}

		.mondai__mark {
			margin: 0;
			height: 2.4rem;
			justify-self: center;
			font-size: 1rem;
			font-weight: 600;
			letter-spacing: 0.2em;
			color: var(--usuzumi);
		}

		.mondai__side--a .mondai__mark {
			color: var(--ai);
		}

		.mondai__label {
			display: block;
			margin-bottom: 0.4rem;
			font-family: var(--gothic);
			font-size: 0.64rem;
			font-weight: 500;
			letter-spacing: 0.16em;
			text-transform: uppercase;
			color: var(--usuzumi);
		}

		.mondai__label[lang='ar'] {
			font-family: var(--ar);
			font-size: 0.9rem;
			font-weight: 400;
		}

		.mondai__text p {
			font-size: 0.98rem;
			line-height: 1.72;
			color: #3a4249;
		}

		.mondai__text p[lang='ar'] {
			line-height: 1.98;
		}

		.mondai__side--a .mondai__text p {
			color: var(--sumi);
		}

		/* ── 成果 ─────────────────────────────────────────── */

		.seika__row {
			display: grid;
			grid-template-columns: 1.25rem minmax(0, 1fr);
			gap: 0.5rem;
			padding-block: 0.8rem;
			border-bottom: 1px solid var(--rule-soft);
			max-width: 46em;
		}

		.seika__row:first-child {
			border-top: 1px solid var(--rule-soft);
		}

		.seika__dot {
			font-family: var(--jp);
			color: var(--ai);
			line-height: 1.6;
		}

		.seika__row p {
			font-size: 0.98rem;
			line-height: 1.7;
		}

		.seika__row p[lang='ar'] {
			line-height: 1.95;
		}

		/* ── 図版 ─────────────────────────────────────────── */

		.zuhan {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
			gap: clamp(1rem, 3vw, 1.75rem);
		}

		.zuhan__cell {
			padding: 0.6rem;
			background: var(--washi);
			border: 1px solid var(--rule-soft);
		}

		.zuhan__cell img {
			width: 100%;
			height: auto;
			filter: saturate(0.88) contrast(1.02);
		}

		.zuhan__cell[data-tall] {
			display: grid;
			place-items: center;
			padding: clamp(0.75rem, 2.5vw, 1.4rem);
			background: linear-gradient(180deg, #efede6, #e2dfd6);
		}

		.zuhan__cell[data-tall] img {
			width: auto;
			max-width: min(100%, 14rem);
			max-height: 30rem;
			box-shadow: 0 12px 26px -20px rgba(30, 37, 43, 0.8);
		}

		/* ── 奥付 ─────────────────────────────────────────── */

		.oku {
			border-top: 1px solid var(--rule);
		}

		.oku__row {
			display: grid;
			grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
			gap: 0.4rem clamp(1rem, 3vw, 2rem);
			padding-block: 0.9rem;
			border-bottom: 1px solid var(--rule-soft);
		}

		.oku__k {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: 0.5rem;
			font-family: var(--gothic);
			font-size: 0.68rem;
			font-weight: 500;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			color: var(--usuzumi);
		}

		.oku__k [lang='ja'] {
			font-family: var(--jp);
			font-size: 0.88rem;
			letter-spacing: 0.2em;
			text-transform: none;
			color: var(--ai);
		}

		.oku__k [lang='ar'] {
			font-family: var(--ar);
			font-size: 0.9rem;
			font-weight: 400;
		}

		.oku__v {
			font-size: 0.98rem;
			line-height: 1.7;
		}

		.oku__v [lang='ar'] {
			line-height: 1.95;
		}

		.oku__stack {
			font-family: var(--gothic);
			font-size: 0.8rem;
			line-height: 2;
			color: #3d454c;
		}

		.oku__stack .sep {
			font-family: var(--jp);
			color: rgba(30, 37, 43, 0.35);
		}

		.oku__links {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem 1.25rem;
		}

		/* ── 次 ───────────────────────────────────────────── */

		.tsugi {
			margin-top: clamp(2rem, 5vw, 3.5rem);
			padding-top: 1.5rem;
			border-top: 1px solid var(--rule);
		}

		.tsugi__h {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: 0.75rem;
			font-family: var(--jp);
			font-size: 0.95rem;
			font-weight: 400;
			letter-spacing: 0.24em;
			color: var(--ai);
		}

		.tsugi__h [data-l] {
			font-family: var(--gothic);
			font-size: 0.66rem;
			font-weight: 500;
			letter-spacing: 0.16em;
			text-transform: uppercase;
			color: var(--usuzumi);
		}

