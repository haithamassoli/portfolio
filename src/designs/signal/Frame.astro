---
import { Image } from 'astro:assets';
import type { Project } from '../../data/projects';
import type { Lang } from '../../i18n';

interface Props {
	project: Project;
	lang: Lang;
	/** Morph target for the card → project-page view transition. */
	name?: string;
	sizes?: string;
	loading?: 'eager' | 'lazy';
}

const {
	project: p,
	lang,
	name,
	sizes = '(min-width: 60rem) 50vw, 100vw',
	loading = 'lazy',
} = Astro.props;
const title = p.title[lang];
const site =
	p.links.live ?? p.links.playGoogle ?? p.links.appStore ?? p.links.github;
const host = site ? new URL(site).hostname.replace(/^www\./, '') : 'localhost';
const alt = `${title}: ${p.tagline[lang]}`;
---

<div
	class:list={['frame', `frame--${p.frame}`]}
	data-frame={p.frame}
	transition:name={name}
>
	{
		p.frame === 'browser' && (
			<>
				<div class="chrome chrome--browser">
					<span class="dots">
						<>
							<i />
							<i />
							<i />
						</>
					</span>
					<span class="url mono" dir="ltr">
						{host}
					</span>
				</div>
				{p.image && (
					<Image
						class="shot"
						src={p.image}
						alt={alt}
						sizes={sizes}
						loading={loading}
						widths={[480, 800, 1200, 1600]}
					/>
				)}
			</>
		)
	}

	{
		p.frame === 'phone' && (
			<>
				<div class="chrome chrome--store">
					<span class="icon" aria-hidden="true">
						{title.trim()[0]}
					</span>
					<span class="store-meta">
						<span class="store-name">{title}</span>
						<span class="stars mono" aria-hidden="true">
							★★★★★ <em>{p.year}</em>
						</span>
					</span>
					<span class="get mono">
						{p.links.appStore && p.links.playGoogle
							? 'iOS · Android'
							: p.links.appStore
								? 'iOS'
								: 'Android'}
					</span>
				</div>
				{p.image && (
					<Image
						class="shot"
						src={p.image}
						alt={alt}
						sizes={sizes}
						loading={loading}
						widths={[480, 800, 1200, 1600]}
					/>
				)}
			</>
		)
	}

	{
		p.frame === 'postcard' && (
			<>
				{p.image && (
					<Image
						class="shot"
						src={p.image}
						alt={alt}
						sizes={sizes}
						loading={loading}
						widths={[480, 800, 1200, 1600]}
					/>
				)}
				<span class="stamp mono" aria-hidden="true">
					{p.year}
				</span>
				<div class="caption mono">{p.stack[0]}</div>
			</>
		)
	}

	{
		p.frame === 'editor' && (
			<>
				<div class="chrome chrome--editor">
					<span class="tab mono">{p.slug}</span>
					<span class="dots dots--end">
						<>
							<i />
							<i />
							<i />
						</>
					</span>
				</div>
				{p.image && (
					<Image
						class="shot"
						src={p.image}
						alt={alt}
						sizes={sizes}
						loading={loading}
						widths={[480, 800, 1200, 1600]}
					/>
				)}
			</>
		)
	}
</div>

<style>
	.frame {
		position: relative;
		background: var(--ink-2);
		border: 1px solid var(--rule);
		border-radius: 0.9rem;
		overflow: hidden;
		transition:
			border-color 0.4s,
			transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
	}

	:global(a:hover) > .frame,
	:global(a:focus-visible) > .frame {
		border-color: color-mix(in oklab, var(--accent) 60%, transparent);
		transform: translateY(-4px);
	}

	/* ponytail: the archive projects have no screenshot, so the frame keeps its
	   chrome and an accent wash rather than collapsing to a bare bar.
	   Drop this once every project has an image. */
	.frame:not(:has(.shot)):not(.frame--editor) {
		min-block-size: 14rem;
		background-image: linear-gradient(
			160deg,
			color-mix(in oklab, var(--accent) 16%, transparent),
			transparent 65%
		);
	}

	.shot {
		display: block;
		inline-size: 100%;
		block-size: auto;
		aspect-ratio: 16 / 9;
		/* full-bleed cards would otherwise eat a whole screen */
		max-block-size: min(66svh, 32rem);
		object-fit: cover;
		/* Phone and logo shots are framed dead centre (scripts/frame-shots.mjs),
		   so a top-anchored crop would cut their feet off. */
		object-position: center;
		transition: scale 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	:global(a:hover) > .frame .shot {
		scale: 1.025;
	}

	/* ---- chrome, shared ---- */

	.chrome {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.55rem 0.85rem;
		background: color-mix(in oklab, var(--ink) 70%, var(--ink-3));
		border-bottom: 1px solid var(--rule);
	}

	.dots {
		display: inline-flex;
		gap: 0.3rem;
		flex: none;
	}

	.dots i {
		inline-size: 0.5rem;
		block-size: 0.5rem;
		border-radius: 50%;
		background: var(--rule-strong);
	}

	.dots--end {
		margin-inline-start: auto;
	}

	/* ---- browser ---- */

	.url {
		flex: 1;
		text-align: center;
		background: var(--ink);
		border-radius: 999px;
		padding: 0.2rem 0.9rem;
		color: var(--muted);
		text-transform: none;
		letter-spacing: 0;
		font-size: 0.66rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	/* ---- store listing ---- */

	.icon {
		display: grid;
		place-items: center;
		inline-size: 2.1rem;
		block-size: 2.1rem;
		flex: none;
		border-radius: 0.6rem;
		background: var(--accent);
		color: var(--ink);
		font-weight: 900;
		font-size: 1.1rem;
		line-height: 1;
	}

	.store-meta {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		margin-inline-end: auto;
		min-inline-size: 0;
	}

	.store-name {
		font-weight: 700;
		font-size: 0.9rem;
		line-height: 1.2;
	}

	.stars {
		color: var(--accent);
		font-size: 0.55rem;
		letter-spacing: 0.1em;
	}

	.stars em {
		color: var(--muted);
		font-style: normal;
	}

	.get {
		flex: none;
		border: 1px solid var(--rule-strong);
		border-radius: 999px;
		padding: 0.22rem 0.75rem;
		font-size: 0.6rem;
		color: var(--bone);
	}

	/* ---- postcard ---- */

	.frame--postcard .shot {
		aspect-ratio: 21 / 9;
	}

	/* Physical inset properties: `inset-inline-*` follows the vertical writing
	   mode, not the page direction, which stretches the stamp down the frame. */
	.stamp {
		position: absolute;
		top: 0.9rem;
		right: 0.9rem;
		background: var(--bone);
		color: var(--ink);
		padding: 0.85rem 0.55rem;
		font-size: 0.62rem;
		font-weight: 600;
		border-radius: 0.2rem;
		writing-mode: vertical-rl;
		box-shadow: 0 6px 24px -8px rgb(0 0 0 / 0.6);
	}

	:global([dir='rtl']) .stamp {
		right: auto;
		left: 0.9rem;
	}

	.caption {
		padding: 0.7rem 0.95rem;
		border-top: 1px solid var(--rule);
		color: var(--muted);
		font-size: 0.66rem;
		text-transform: none;
		letter-spacing: 0.02em;
	}

	/* ---- editor ---- */

	.frame--editor {
		background: #10122c;
	}

	.tab {
		background: var(--ink-2);
		border: 1px solid var(--rule);
		border-bottom-color: transparent;
		border-radius: 0.4rem 0.4rem 0 0;
		padding: 0.3rem 0.8rem;
		font-size: 0.6rem;
		text-transform: none;
		letter-spacing: 0;
		color: var(--bone);
	}
</style>
