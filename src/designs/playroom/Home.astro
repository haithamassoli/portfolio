---
import type { Design } from '../registry';
import { otherLang, url as designUrl } from '../routes';
import type { Lang } from '../../i18n';
import { Image } from 'astro:assets';
import Shell from './Shell.astro';
import T from '../../components/T.astro';
import { profile } from '../../../content/profile';
import { featured, onStores, projects, shipped } from '../../data/projects';
import { toolbox } from '../../i18n';
import { s, pair, yearPair } from '../../data/variant-ui';
import profilePhoto from '../../assets/images/profile.png';
import type {
	I18n,
	ProjectCategory,
	ProjectStatus,
} from '../../../content/types';
interface Props {
	design: Design;
	lang: Lang;
}

import DesignSwitch from '../_shared/DesignSwitch.astro';
const { design, lang } = Astro.props;
/** A link inside this design, in this language: u('/work/aoun'). */
const u = (page = '') => designUrl(design, lang, page);

/* The signature toy. Front faces spell HAITHAM left to right; back faces spell
   العسولي right to left. Seven tiles either way, so the board mirrors without
   changing shape. The lever no longer flips a demo: it changes the language of
   the whole page, and the tiles turn over because the page turned over. */
const tiles = [
	{ en: 'H', ar: 'ا', hue: 'melon' },
	{ en: 'A', ar: 'ل', hue: 'sky' },
	{ en: 'I', ar: 'ع', hue: 'bubble' },
	{ en: 'T', ar: 'س', hue: 'sun' },
	{ en: 'H', ar: 'و', hue: 'mint' },
	{ en: 'A', ar: 'ل', hue: 'melon' },
	{ en: 'M', ar: 'ي', hue: 'sky' },
];

/* Five counters, five true numbers. */
const counters = [
	{ n: String(shipped), label: s('stat.shipped'), hue: 'sun' },
	{ n: String(onStores), label: s('stat.stores'), hue: 'melon' },
	{
		n: String(featured.length),
		label: pair('written up in full', 'مشروحة بالكامل'),
		hue: 'bubble',
	},
	{ n: '4', label: s('stat.years'), hue: 'mint' },
	{
		n: '2',
		label: pair('scripts, both first-class', 'لغتان، كلتاهما أصلية'),
		hue: 'sky',
	},
];

/* Card colours come from this page's palette, not from the project accents,
   so eight loud cards still read as one set. */
const hues = ['melon', 'sky', 'bubble', 'sun', 'ink'];

const catLabel: Record<ProjectCategory, I18n> = {
	web: s('cat.web'),
	mobile: s('cat.mobile'),
	ai: s('cat.ai'),
	desktop: s('cat.desktop'),
	extension: s('cat.extension'),
	client: s('cat.client'),
};

const statusLabel: Record<ProjectStatus, I18n> = {
	live: s('status.live'),
	shipped: s('status.shipped'),
	delisted: s('status.delisted'),
	wip: s('status.wip'),
	archived: s('status.archived'),
};

const linkLabel: Record<string, I18n> = {
	live: s('project.live'),
	playGoogle: s('project.play'),
	appStore: s('project.apple'),
	vscode: s('project.vscode'),
	github: s('project.github'),
};

const about = profile.about.en.map((en, i) => ({
	en,
	ar: profile.about.ar[i] ?? en,
}));

const rest = projects.filter((p) => !p.featured);

const elsewhere = [
	{ label: pair('GitHub', 'GitHub'), href: profile.links.github, hue: 'sun' },
	{
		label: pair('LinkedIn', 'LinkedIn'),
		href: profile.links.linkedin,
		hue: 'mint',
	},
	{
		label: pair('assoli.site', 'assoli.site'),
		href: profile.links.website,
		hue: 'bubble',
	},
	{ label: s('nav.cv'), href: profile.links.resume, hue: 'sky' },
	{ label: s('project.play'), href: profile.links.playStore, hue: 'sun' },
];
---

<Shell
	design={design}
	lang={lang}
	title={pair(
		'Haitham Assoli — web & mobile engineer',
		'هيثم العسولي — مهندس تطبيقات جوال وويب',
	)[lang]}
	description={pair(
		'Haitham Assoli builds bilingual web and mobile products in Amman: React Native and Expo on both stores, Next.js and Astro on the web, and on-device AI that never phones home.',
		'يبني هيثم العسولي تطبيقات ويب وجوال بلغتين من عمّان: React Native وExpo على المتجرين، وNext.js وAstro على الويب، وذكاء اصطناعي يعمل على الجهاز نفسه.',
	)[lang]}
	active="home"
>
	<!-- ============================== HERO ============================== -->
	<section class="field field--sun hero" id="hero">
		<div class="hero__glow" aria-hidden="true"></div>

		<div class="wrap hero__grid">
			<div class="hero__text">
				<p class="whoami">
					<T
						v={pair('Haitham Assoli', 'هيثم العسولي')}
						as="span"
						class="whoami__sticker"
					/>
					<T v={s('hero.role')} as="span" class="whoami__role" />
				</p>

				<h1 class="thesis" data-l="en" lang="en">
					Every screen I build has to feel <span class="stretch">useful</span>.
				</h1>
				<h1 class="thesis" data-l="ar" lang="ar">
					كل شاشة أبنيها لا بد أن تكون <span class="stretch">مفيدة</span>.
				</h1>

				<T
					v={pair(
						'I build products that make hard tasks clear. Over four years, I have shipped 39 projects, including 13 on app stores, and built on-device AI for private media.',
						'أبني منتجات تجعل المهام الصعبة واضحة. خلال أربع سنوات، أصدرت 39 مشروعًا، منها 13 على متاجر التطبيقات، وبنيت ذكاءً اصطناعيًا على الجهاز للوسائط الخاصة.',
					)}
					as="p"
					class="lede"
				/>

				<div class="cta-row">
					<a class="btn btn--melon" href={u('/hire')}>
						<T v={s('hero.cta2')} />
					</a>
					<a class="btn btn--ghost" href="#work">
						<T v={s('hero.cta')} />
					</a>
				</div>

				<DesignSwitch design={design} lang={lang} />
			</div>

			<div class="hero__photo">
				<Image
					class="photo"
					src={profilePhoto}
					alt="Haitham Assoli"
					widths={[240, 480]}
					sizes="240px"
					loading="eager"
				/>
				<T
					v={pair("that's me", 'هذا أنا')}
					as="span"
					class="photo__tag"
					aria-hidden="true"
				/>
			</div>
		</div>

		<!-- ------------------------ the signature toy ------------------------ -->
		<div class="wrap">
			<section class="toy">
				<div class="toy__head">
					<T
						v={pair('Pull the lever', 'اسحب الذراع')}
						as="h2"
						class="toy__title"
					/>
					<T
						v={pair(
							'Use the lever to switch between Arabic and English.',
							'استخدم الذراع للتبديل بين العربية والإنجليزية.',
						)}
						as="p"
						class="toy__note"
					/>
				</div>

				<div class="toy__board">
					<ul class="tiles" aria-hidden="true">
						{
							tiles.map((t, i) => (
								<li class={`tile tile--${t.hue}`} style={`--i:${i}`}>
									<span class="tile__flip">
										<span class="tile__face tile__face--en">{t.en}</span>
										<span class="tile__face tile__face--ar">{t.ar}</span>
									</span>
								</li>
							))
						}
					</ul>

					<a
						href={otherLang(Astro.url.pathname)}
						class="lever lever--big"
						data-lang-link
					>
						<span class="vh" data-l="en" lang="en"
							>Read this page in Arabic</span
						>
						<span class="vh" data-l="ar" lang="ar"
							>اقرأ هذه الصفحة بالإنجليزية</span
						>
						<span class="lever__track" aria-hidden="true">
							<span class="lever__knob"></span>
							<span class="lever__side lever__side--en">EN</span>
							<span class="lever__side lever__side--ar">ع</span>
						</span>
					</a>
				</div>

				<p class="toy__caption">
					<span class="latin" dir="ltr">HAITHAM</span>
					<span class="toy__arrow" aria-hidden="true">⇄</span>
					<span class="arabic" lang="ar" dir="rtl">العسولي</span>
				</p>
			</section>
		</div>
	</section>

	<!-- ============================ COUNTERS ============================ -->
	<section class="field field--ink counters">
		<div class="wrap">
			<T
				v={pair('The scoreboard', 'لوحة النتائج')}
				as="h2"
				class="section__title counters__title"
			/>
			<ul class="counter-row">
				{
					counters.map((c, i) => (
						<li class={`counter counter--${c.hue}`} style={`--i:${i}`}>
							<span class="counter__n">{c.n}</span>
							<T v={c.label} as="span" class="counter__label" />
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- ============================== WORK ============================== -->
	<section class="field field--mint work" id="work">
		<div class="wrap">
			<header class="section__head">
				<T v={pair('The shelf', 'الرفّ')} as="p" class="eyebrow" />
				<T
					v={pair('Eight I would hand you first', 'ثمانية أقدّمها أولًا')}
					as="h2"
					class="section__title"
				/>
				<T
					v={pair(
						'Thirty-nine shipped in all. These eight carry the full write-up: what it had to do, what it cost, and what I would do differently.',
						'تسعة وثلاثون مشروعًا في المجموع. هذه الثمانية تحمل الشرح الكامل: ما كان مطلوبًا منها، وما كلّفته، وما كنت سأفعله على نحو آخر.',
					)}
					as="p"
					class="section__lede"
				/>
			</header>

			<ul class="cards">
				{
					featured.map((p, i) => (
						<li
							class={`card card--${hues[i % hues.length]}`}
							style={`--i:${i}`}
						>
							<div class="card__bar">
								<h3 class="card__title">
									<a href={u(`/work/${p.slug}`)}>
										<T v={p.title} />
									</a>
								</h3>
								<T v={yearPair(p.year)} as="span" class="card__year" />
							</div>

							<div class="card__body">
								{p.image && (
									<div class="card__shot">
										<Image
											src={p.image}
											alt={`${p.title[lang]}: ${p.tagline[lang]}`}
											widths={[360, 720]}
											sizes="(min-width: 860px) 38vw, 88vw"
											loading="lazy"
										/>
									</div>
								)}

								<T v={p.tagline} as="p" class="card__tagline" />
								<T v={p.summary} as="p" class="card__summary" />
								<T v={p.role} as="p" class="card__role" />

								<ul class="chips">
									{p.stack.slice(0, 5).map((tool) => (
										<li class="chip">{tool}</li>
									))}
								</ul>

								<div class="card__foot">
									<T v={statusLabel[p.status]} as="span" class="sticker" />
									<T
										v={catLabel[p.category]}
										as="span"
										class="sticker sticker--plain"
									/>
									{Object.entries(p.links).map(([k, url]) =>
										url ? (
											<a class="link-pill" href={url as string}>
												<T v={linkLabel[k] ?? pair(k, k)} />
											</a>
										) : null,
									)}
								</div>
							</div>
						</li>
					))
				}
			</ul>

			<div class="spill">
				<T
					v={pair(
						`The other ${rest.length}, tipped out of the box`,
						`البقية، وعددها ${rest.length}، مكبوبة من الصندوق`,
					)}
					as="h3"
					class="spill__title"
				/>
				<ul class="spill__list">
					{
						rest.map((p, i) => (
							<li style={`--i:${i}`}>
								<a class="spill__chip" href={u(`/work/${p.slug}`)}>
									<T v={p.title} />
								</a>
							</li>
						))
					}
				</ul>
				<a class="btn btn--ink" href={u('/work')}>
					<T v={pair('Open the whole shelf', 'افتح الرفّ كاملًا')} />
				</a>
			</div>
		</div>
	</section>

	<!-- ============================= ABOUT ============================= -->
	<section class="field field--bubble about" id="about">
		<div class="wrap about__grid">
			<div class="about__text">
				<T
					v={pair("Who's doing the building", 'من يبني')}
					as="p"
					class="eyebrow"
				/>
				<h2 class="section__title">
					<span class="latin" dir="ltr">{profile.name.en}</span>
					<span class="about__ar" lang="ar" dir="rtl">{profile.name.ar}</span>
				</h2>

				{about.map((para) => <T v={para} as="p" class="about__para" />)}

				<p class="about__where">
					<T v={profile.title} />
					<span aria-hidden="true"> · </span>
					<T v={profile.location} />
				</p>
			</div>

			<div class="about__stack">
				<T
					v={pair('Where the hours went', 'أين ذهبت الساعات')}
					as="h3"
					class="mini-title"
				/>
				<ul class="jobs">
					{
						profile.experience.map((job) => (
							<li class="job">
								<T v={job.company} as="span" class="job__co" />
								<T v={job.role} as="span" class="job__role" />
								<T v={yearPair(job.period)} as="span" class="job__when" />
							</li>
						))
					}
				</ul>

				<T v={pair('School', 'الدراسة')} as="h3" class="mini-title" />
				<ul class="jobs jobs--school">
					{
						profile.education.map((ed) => (
							<li class="job">
								<T v={ed.school} as="span" class="job__co" />
								<T v={ed.degree} as="span" class="job__role" />
								<T v={yearPair(ed.period)} as="span" class="job__when" />
								{ed.note && <T v={ed.note} as="span" class="job__when" />}
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<!-- ============================ TOOLBOX ============================ -->
	<section class="field field--sky toolbox">
		<div class="wrap">
			<header class="section__head">
				<T v={pair('The toy chest', 'صندوق العدّة')} as="p" class="eyebrow" />
				<T v={s('about.stackTitle')} as="h2" class="section__title" />
			</header>

			<ul class="tools">
				{
					toolbox.map((tool, i) => (
						<li class="tool" style={`--i:${i}`} dir="ltr">
							{tool}
						</li>
					))
				}
			</ul>

			<div class="lately">
				<T
					v={pair('And lately, on the device', 'ومؤخرًا، على الجهاز نفسه')}
					as="h3"
					class="mini-title mini-title--light"
				/>
				<ul class="tools tools--alt">
					{
						profile.skills.ai.map((tool, i) => (
							<li class="tool tool--alt" style={`--i:${i}`} dir="ltr">
								{tool}
							</li>
						))
					}
				</ul>
				<T
					v={pair(
						"Video and audio processed entirely on the user's phone or laptop. No cloud, no account, no telemetry.",
						'معالجة الفيديو والصوت تجري بالكامل على هاتف المستخدم أو حاسوبه. بلا سحابة، وبلا حساب، وبلا تتبّع.',
					)}
					as="p"
					class="lately__note"
				/>
			</div>
		</div>
	</section>

	<!-- ============================== HIRE ============================== -->
	<section class="field field--melon hire" id="hire">
		<div class="wrap hire__grid">
			<div>
				<T v={pair('Open box', 'الصندوق مفتوح')} as="p" class="eyebrow" />
				<T
					v={pair(
						'Got something that has to ship twice?',
						'عندك شيء لا بد أن يصدر بلغتين؟',
					)}
					as="h2"
					class="section__title"
				/>
				<T
					v={pair(
						'Tell me what it has to do and who reads it in which direction. I will tell you what I would build, how long it takes, and what I would cut.',
						'قل لي ما المطلوب منه، ومن يقرؤه وبأي اتجاه. وسأقول لك ما الذي سأبنيه، وكم يستغرق، وما الذي سأستغني عنه.',
					)}
					as="p"
					class="section__lede hire__lede"
				/>

				<div class="cta-row">
					<a class="btn btn--ink btn--big" href={u('/hire')}>
						<T v={pair('Fill in the brief', 'املأ الطلب')} />
					</a>
					<a class="btn btn--ghost ltr" href={`mailto:${profile.email}`}>
						{profile.email}
					</a>
				</div>
			</div>

			<ul class="elsewhere">
				{
					elsewhere.map((l, i) => (
						<li style={`--i:${i}`}>
							<a class={`slab slab--${l.hue}`} href={l.href}>
								<T v={l.label} />
								<span class="slab__arrow" aria-hidden="true">
									→
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Shell>

<script is:inline data-astro-rerun>
	/* The cursor moves the light: the hero glow follows the pointer. Everything
	   else on this page is CSS reacting to html[lang] and html[dir].
	   Rerun: the hero is a fresh element after every client-side navigation. */
	(function () {
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
		const hero = document.getElementById('hero');
		if (!hero || !window.matchMedia('(pointer: fine)').matches) return;
		hero.addEventListener('pointermove', function (e) {
			if (reduce.matches) return;
			const r = hero.getBoundingClientRect();
			hero.style.setProperty(
				'--mx',
				((e.clientX - r.left) / r.width).toFixed(3),
			);
			hero.style.setProperty(
				'--my',
				((e.clientY - r.top) / r.height).toFixed(3),
			);
		});
	})();
</script>

<style is:global>
	/* ================================ HERO ================================ */

	.hero {
		--mx: 0.5;
		--my: 0.3;
		padding-top: clamp(2.5rem, 6vw, 4.5rem);
		overflow: clip;
	}

	.hero__glow {
		position: absolute;
		inset: 0;
		background: radial-gradient(
			38rem 38rem at calc(var(--mx) * 100%) calc(var(--my) * 100%),
			rgba(255, 255, 255, 0.55),
			rgba(255, 255, 255, 0) 62%
		);
		pointer-events: none;
	}

	.hero__grid {
		position: relative;
		display: grid;
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: start;
	}

	@media (min-width: 880px) {
		.hero__grid {
			grid-template-columns: minmax(0, 1fr) 15rem;
		}
	}

	.whoami {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.4rem;
	}

	.whoami__sticker {
		display: inline-block;
		padding: 0.4rem 0.9rem;
		background: var(--ink);
		color: var(--sun);
		border-radius: var(--pill);
		font-family: var(--mono);
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		transform: rotate(-2deg);
		box-shadow: 0 0 0 4px var(--sun);
	}

	.whoami__sticker[lang='ar'] {
		font-family: var(--arabicDisplay);
		font-size: 1rem;
		letter-spacing: 0;
	}

	.whoami__role {
		font-family: var(--mono);
		font-size: 0.76rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.whoami__role[lang='ar'] {
		font-family: var(--arabicBody);
		font-weight: 600;
		font-size: 0.9rem;
		letter-spacing: 0;
		text-transform: none;
	}

	.thesis {
		font-size: clamp(2.6rem, 9.5vw, 6.4rem);
		font-variation-settings: 'wdth' 78;
		letter-spacing: -0.035em;
	}

	.thesis[lang='ar'] {
		font-size: clamp(2.2rem, 8vw, 5.4rem);
		line-height: 1.25;
	}

	.thesis .stretch {
		display: inline-block;
		padding-inline: 0.12em;
		background: var(--melon);
		border: var(--b) solid var(--ink);
		border-radius: var(--r2);
		box-shadow: var(--s2);
		transition:
			font-variation-settings 0.4s var(--spring),
			transform 0.4s var(--spring);
	}

	.thesis .stretch:hover,
	.hero:focus-within .thesis .stretch {
		font-variation-settings: 'wdth' 100;
		transform: rotate(-1.5deg) scale(1.02);
	}

	.lede {
		margin-top: 1.4rem;
		max-width: 54ch;
		font-size: clamp(1.02rem, 1.6vw, 1.2rem);
	}

	.hero__photo {
		position: relative;
		justify-self: start;
		width: min(15rem, 62vw);
		transform: rotate(3deg);
	}

	@media (min-width: 880px) {
		.hero__photo {
			justify-self: end;
		}

		.photo__tag {
			inset-inline-start: -0.9rem;
		}
	}

	.photo {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		border: var(--b) solid var(--ink);
		border-radius: var(--r3);
		background: var(--bubble);
		box-shadow: var(--s3);
	}

	.photo__tag {
		position: absolute;
