---
import type { Design } from '../registry';
import { otherLang, url as designUrl } from '../routes';
import type { Lang } from '../../i18n';
/* Variant 1 — "Quiet Room": a single ruled column with generous space. */
import { Image } from 'astro:assets';
import { profile } from '../../../content/profile';
import Shell from './Shell.astro';
import T from '../../components/T.astro';
import { featured, projects } from '../../data/projects';
import { pair, s, yearPair } from '../../data/variant-ui';
import { toolbox } from '../../i18n';
import profilePhoto from '../../assets/images/profile.png';
interface Props {
	design: Design;
	lang: Lang;
}

import DesignSwitch from '../_shared/DesignSwitch.astro';
const { design, lang } = Astro.props;
/** A link inside this design, in this language: u('/work/aoun'). */
const u = (page = '') => designUrl(design, lang, page);

const statusWord = {
	live: s('status.live'),
	shipped: s('status.shipped'),
	delisted: s('status.delisted'),
	wip: s('status.wip'),
	archived: s('status.archived'),
};

const categoryWord = {
	web: s('cat.web'),
	mobile: s('cat.mobile'),
	desktop: s('cat.desktop'),
	extension: s('cat.extension'),
	ai: s('cat.ai'),
	client: s('cat.client'),
};

const linkWord: Record<string, ReturnType<typeof s>> = {
	live: s('project.live'),
	github: s('project.github'),
	appStore: s('project.apple'),
	playGoogle: s('project.play'),
	vscode: s('project.vscode'),
};

const rest = projects.filter((p) => !p.featured);

const about = profile.about.en.map((en, i) => pair(en, profile.about.ar[i]));

const counts = [
	{ label: pair('Projects shipped', 'مشروعًا صدر'), value: '40' },
	{ label: pair('Live on the app stores', 'على متاجر التطبيقات'), value: '13' },
	{ label: pair('Written up in full', 'مشروحة بالكامل'), value: '8' },
	{ label: pair('Years building', 'سنوات في البناء'), value: '~4' },
	{ label: pair('Languages, every screen', 'لغتان في كل شاشة'), value: '2' },
];

const elsewhere = [
	{ label: pair('GitHub', 'GitHub'), href: profile.links.github },
	{ label: pair('LinkedIn', 'LinkedIn'), href: profile.links.linkedin },
	{ label: s('nav.cv'), href: profile.links.resume },
	{ label: pair('Google Play', 'Google Play'), href: profile.links.playStore },
	{ label: pair('assoli.site', 'assoli.site'), href: profile.links.website },
];
---

<Shell
	design={design}
	lang={lang}
	title={pair(
		'Haitham Assoli — web and mobile engineer, Amman',
		'هيثم العسولي — مهندس تطبيقات جوال وويب، عمّان',
	)[lang]}
	description={pair(
		'Haitham Assoli builds full-stack web and mobile products from Amman, Jordan. Forty shipped, including thirteen on the app stores.',
		'يبني هيثم العسولي منتجات متكاملة للويب والجوال من عمّان في الأردن. أطلق أربعين مشروعًا، منها ثلاثة عشر على متاجر التطبيقات.',
	)[lang]}
>
	<section class="band" id="hero">
		<p class="rail"><T v={pair('hello', 'أهلًا')} /></p>
		<div class="col col--hero">
			<p class="k rise" style="--d: 0ms">
				<T v={s('hero.role')} />
			</p>
			<T
				as="h1"
				id={undefined}
				class="rise"
				style="--d: 70ms"
				v={pair(
					'Software should hold up in the real world.',
					'البرمجيات الجيدة تصمد في العالم الحقيقي.',
				)}
			/>
			<T
				as="p"
				class="lede rise"
				style="--d: 140ms"
				v={pair(
					'For four years, I have built products from the first screen through release. I have shipped 40 projects, including 13 that are live on the app stores.',
					'على مدى أربع سنوات، بنيت منتجات من الشاشة الأولى حتى الإطلاق. أصدرت 40 مشروعًا، منها 13 مشروعًا متاحًا على متاجر التطبيقات.',
				)}
			/>
			<T
				as="p"
				class="rise"
				style="--d: 200ms"
				v={pair(
					'React Native and Expo on phones, Next.js and Astro on the web, NestJS, Convex and Supabase underneath. Lately the models run on the device itself, so the video never leaves the phone.',
					'React Native وExpo على الهواتف، وNext.js وAstro على الويب، وتحتها NestJS وConvex وSupabase. ومؤخرًا صارت النماذج تعمل على الجهاز نفسه، فلا يغادر الفيديو الهاتف.',
				)}
			/>
			<p class="hero__do rise" style="--d: 260ms">
				<a class="lnk" href={`mailto:${profile.email}`} lang="en" dir="ltr"
					>{profile.email}</a
				>
				<a class="lnk" href={profile.links.github} lang="en" dir="ltr">GitHub</a
				>
				<a class="lnk" href="#work"><T v={s('hero.cta')} /></a>
			</p>

			<DesignSwitch design={design} lang={lang} class="rise" />

			<div class="twice rise" style="--d: 340ms">
				<div class="twice__head">
					<p class="k">
						<T v={pair('A practical craft', 'حرفة عملية')} />
					</p>
					<a
						href={otherLang(Astro.url.pathname)}
						class="seg seg--lang"
						data-lang-link
					>
						<span class="seg__opt" data-for="en" lang="en" aria-hidden="true"
							>EN</span
						>
						<span class="seg__opt" data-for="ar" lang="ar" aria-hidden="true"
							>عربي</span
						>
						<span class="vh" data-l="en" lang="en"
							>Read this page in Arabic</span
						>
						<span class="vh" data-l="ar" lang="ar"
							>اقرأ هذه الصفحة بالإنجليزية</span
						>
					</a>
				</div>
				<div class="twice__lines">
					<p class="twice__line" lang="en" dir="ltr">
						From first sketch to final release.
					</p>
					<p class="twice__line" lang="ar" dir="rtl">
						من الفكرة الأولى إلى الإطلاق النهائي.
					</p>
				</div>
				<T
					as="p"
					class="twice__note"
					v={pair(
						'Good software makes someone’s day easier.',
						'البرمجيات الجيدة تجعل يوم الناس أسهل.',
					)}
				/>
			</div>
		</div>
	</section>

	<section class="band" id="work">
		<p class="rail"><T v={s('work.eyebrow')} /></p>
		<div class="col">
			<T as="h2" v={s('work.title')} />

			<div class="projs">
				{
					featured.map((p, i) => (
						<article class="proj">
							<p class="k proj__meta">
								<T v={yearPair(p.year)} />
								<span>
									<T v={statusWord[p.status]} />
								</span>
								<span>
									<T v={categoryWord[p.category]} />
								</span>
							</p>
							<div class="proj__body">
								<h3 class="proj__title">
									<a href={u(`/work/${p.slug}`)}>
										<T v={p.title} />
									</a>
								</h3>
								<T as="p" class="proj__tag" v={p.tagline} />
								<p class="k proj__stack" lang="en" dir="ltr">
									{p.stack.slice(0, 6).join('  ·  ')}
								</p>
								<p class="k proj__links">
									<a href={u(`/work/${p.slug}`)}>
										<T v={s('work.read')} />
									</a>
									{Object.entries(p.links).map(([key, url]) =>
										url ? (
											<a href={url} rel="noreferrer">
												<T v={linkWord[key]} />
											</a>
										) : null,
									)}
								</p>
							</div>
							{p.image && (
								<a
									class="proj__shot"
									href={u(`/work/${p.slug}`)}
									tabindex="-1"
									aria-hidden="true"
								>
									<Image
										src={p.image}
										alt=""
										widths={[300, 480, 720]}
										sizes="(min-width: 1040px) 16rem, (min-width: 640px) 13rem, calc(100vw - 5rem)"
										loading={i === 0 ? 'eager' : 'lazy'}
										decoding="async"
									/>
								</a>
							)}
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="band">
		<p class="rail"><T v={s('work.archive')} /></p>
		<div class="col">
			<T
				as="h2"
				id={undefined}
				v={pair(
					'Thirty-one more, and every one has a page.',
					'واحد وثلاثون غيرها، ولكل منها صفحة.',
				)}
			/>
			<T
				as="p"
				class="measure"
				v={pair(
					'Municipal service apps, tourism guides for Ajloun and Al-Jouf, a Qur’an memorisation platform, a browser extension, and client sites built for speed. Each began as a real assignment.',
					'تطبيقات خدمات بلدية، وأدلة سياحية لعجلون والجوف، ومنصة لحفظ القرآن، وإضافة متصفح، ومواقع للعملاء بُنيت لتكون سريعة. بدأ كل واحد منها بمهمة حقيقية.',
				)}
			/>
			<ul class="tools tools--quiet arch">
				{
					rest.map((p) => (
						<li>
							<a class="k" href={u(`/work/${p.slug}`)}>
								<T v={p.title} />
							</a>
						</li>
					))
				}
			</ul>
			<p class="arch__all">
				<a class="lnk k" href={u('/work')}><T v={s('work.all')} /></a>
			</p>
		</div>
	</section>

	<section class="band">
		<p class="rail"><T v={s('about.eyebrow')} /></p>
		<div class="col">
			<T as="h2" v={s('about.title')} />
			<div class="about">
				<figure class="about__pic">
					<Image
						src={profilePhoto}
						alt="Haitham Assoli"
						widths={[180, 320, 440]}
						sizes="(min-width: 720px) 11rem, 40vw"
						loading="lazy"
						decoding="async"
					/>
				</figure>
				<div class="about__text">
					{about.map((block) => <T as="p" v={block} />)}
				</div>
			</div>

			<p class="k sub"><T v={pair('where', 'أين عملت')} /></p>
			<ul class="cv">
				{
					profile.experience.map((job) => (
						<li class="cv__row">
							<span class="cv__co">
								<T v={job.company} />
							</span>
							<T v={yearPair(job.period)} as="span" class="k cv__when" />
							<T as="span" class="cv__role" v={job.role} />
						</li>
					))
				}
			</ul>

			<p class="k sub"><T v={pair('study', 'الدراسة')} /></p>
			<ul class="cv">
				{
					profile.education.map((ed) => (
						<li class="cv__row">
							<span class="cv__co">
								<T v={ed.school} />
							</span>
							<T v={yearPair(ed.period)} as="span" class="k cv__when" />
							<T
								as="span"
								class="cv__role"
								v={pair(
									ed.degree[lang] + (ed.note ? ` — ${ed.note[lang]}` : ''),
									ed.degree.ar + (ed.note ? ` — ${ed.note.ar}` : ''),
								)}
							/>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="band">
		<p class="rail"><T v={pair('toolbox', 'الأدوات')} /></p>
		<div class="col">
			<T as="h2" v={s('about.stackTitle')} />
			<ul class="tools" lang="en" dir="ltr">
				{toolbox.map((tool) => <li class="k">{tool}</li>)}
			</ul>

			<p class="k sub"><T v={pair('on the device', 'على الجهاز')} /></p>
			<ul class="tools tools--quiet" lang="en" dir="ltr">
				{profile.skills.ai.map((tool) => <li class="k">{tool}</li>)}
			</ul>

			<p class="k sub">
				<T v={pair('always on the checklist', 'دائمًا في القائمة')} />
			</p>
			<ul class="tools tools--quiet" lang="en" dir="ltr">
				{profile.skills.craft.map((tool) => <li class="k">{tool}</li>)}
			</ul>
		</div>
	</section>

	<section class="band">
		<p class="rail"><T v={s('stats.eyebrow')} /></p>
		<div class="col">
			<T
				as="h2"
				id={undefined}
				v={pair('Four years, added up.', 'أربع سنوات، مجموعة.')}
			/>
			<dl class="count">
				{
					counts.map((row) => (
						<div class="count__row">
							<dt>
								<T v={row.label} />
							</dt>
							<span class="count__lead" aria-hidden="true" />
							<dd class="k" lang="en" dir="ltr">
								{row.value}
							</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section class="band" id="hire">
		<p class="rail"><T v={pair('write to me', 'راسلني')} /></p>
		<div class="col">
			<T
				as="h2"
				id={undefined}
				v={pair(
					'Tell me what you are building and when it has to be live.',
					'أخبرني بما تبنيه ومتى يجب أن يكون جاهزًا.',
				)}
			/>
			<T
				as="p"
				class="measure"
				v={pair(
					'Contract or full time, Amman or remote. I have shipped thirteen products to the app stores already.',
					'بعقد أو بدوام كامل، من عمّان أو عن بُعد. أصدرت ثلاثة عشر منتجًا على متاجر التطبيقات بالفعل.',
				)}
			/>
			<p class="hire__mail">
				<a class="lnk" href={`mailto:${profile.email}`} lang="en" dir="ltr"
					>{profile.email}</a
				>
			</p>
			<p class="hire__tel">
				<a
					class="lnk k"
					href={`tel:${profile.phone.replace(/\s/g, '')}`}
					lang="en"
					dir="ltr">{profile.phone}</a
				>
			</p>
			<p class="hire__go">
				<a class="lnk" href={u('/hire')}><T v={s('hire.title')} /></a>
			</p>
			<ul class="tools tools--quiet">
				{
					elsewhere.map((l) => (
						<li>
							<a class="k" href={l.href} rel="noreferrer">
								<T v={l.label} />
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Shell>

<style is:global>
	/* ── Hero ──────────────────────────────────────────────────────────────*/
	.col--hero {
		padding-block-start: clamp(3.5rem, 12vw, 8.5rem);
	}

	.col--hero .lede {
		margin-block-start: 1.9rem;
	}

	.hero__do {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.75rem;
		margin-block-start: 1.9rem;
		max-width: none;
	}

	.hero__do .lnk {
		overflow-wrap: anywhere;
	}

	/* The signature: the same sentence in both languages, both of them on the
	   page at once, and the switch that decides which one is being read. */
	.twice {
		margin-block-start: clamp(3.25rem, 7vw, 5rem);
		max-width: 36rem;
		padding: 1.15rem 1.3rem 1.25rem;
		border: 1px solid var(--rule);
		border-radius: 3px;
		background: var(--raised);
	}

	.twice__head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1rem;
		margin-block-end: 1.1rem;
	}

	.twice__head .k {
		margin: 0;
	}

	.twice__lines {
		display: grid;
		gap: 0.45rem;
		margin-block-end: 1.15rem;
	}

	p.twice__line {
		margin: 0;
		max-width: none;
		font-size: var(--s-lede);
		line-height: 1.45;
		color: var(--ink);
		transition: color 0.3s ease;
	}

	p.twice__line[lang='ar'] {
		font-size: var(--s-lede-ar);
		line-height: 1.75;
	}

	/* The half you are not reading stays legible, just quieter. */
	html[lang='ar'] .twice__line[lang='en'],
	html[lang='en'] .twice__line[lang='ar'] {
		color: var(--graphite);
	}

	/* Both sentences hug the edge the page is currently read from. */
	html[lang='en'] .twice__line[lang='ar'] {
		text-align: left;
	}

	.twice__note {
		margin: 0;
		max-width: none;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--graphite);
	}

	.twice__note[lang='ar'] {
		font-size: 1.0625rem;
		line-height: 1.9;
	}

	/* ── Project rows ──────────────────────────────────────────────────────
	   No cards, no rules between them. Space is the separator. */
	.projs {
		display: grid;
		gap: clamp(3rem, 6vw, 4.75rem);
	}

	.proj {
		display: grid;
		gap: 1rem 2rem;
		grid-template-areas: 'shot' 'meta' 'body';
	}

	.proj__meta {
		grid-area: meta;
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.55rem;
		margin: 0;
		max-width: none;
	}

	.proj__meta span + span::before {
		content: '·';
		padding-inline-end: 0.5rem;
		color: var(--rule);
	}

	.proj__body {
		grid-area: body;
	}

	.proj__shot {
		grid-area: shot;
		display: block;
		border: 1px solid var(--rule);
		border-radius: 3px;
		background: var(--raised);
		overflow: hidden;
		align-self: start;
	}

	.proj__shot img {
		width: 100%;
		aspect-ratio: 16 / 11;
		object-fit: cover;
		object-position: 50% 50%;
		filter: saturate(0.94);
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.proj:hover .proj__shot img {
		transform: scale(1.018);
	}

	.proj__title a {
		text-decoration: none;
	}

	.proj__tag {
		margin: 0.5rem 0 0.85rem;
		max-width: 33rem;
		color: var(--graphite);
	}

	.proj__stack {
		margin: 0;
	}

	.proj__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 1.15rem;
		margin: 0.85rem 0 0;
		max-width: none;
	}

	.proj__links a {
		color: var(--ink);
		text-decoration: none;
		border-block-end: 1px solid var(--rule);
		padding-block-end: 0.1rem;
	}

	.proj__links a:hover {
		color: var(--signal);
		border-block-end-color: var(--signal);
	}

	@media (min-width: 640px) {
		.proj {
			grid-template-columns: minmax(0, 1fr) 13rem;
			grid-template-areas: 'meta shot' 'body shot';
			align-content: start;
		}
	}

	@media (min-width: 1040px) {
		.proj {
			grid-template-columns: 7.5rem minmax(0, 1fr) 16rem;
			grid-template-areas: 'meta body shot';
			gap: 0 2rem;
		}

		/* Wide enough to stack the three facts instead of letting them wrap. */
		.proj__meta {
			flex-direction: column;
			gap: 0.2rem;
			padding-block-start: 0.34rem;
		}

		.proj__meta span + span::before {
			content: none;
		}
	}

	/* ── The archive of the other thirty-one ───────────────────────────────*/
	.arch {
		margin-block-start: 2rem;
	}

	.arch__all {
		margin-block: 2.25rem 0;
	}

	/* ── About ─────────────────────────────────────────────────────────────*/
	.about {
		display: grid;
		gap: 1.75rem 2.25rem;
	}

	.about__pic {
		margin: 0;
		width: min(11rem, 42vw);
	}

	.about__pic img {
		width: 100%;
		border: 1px solid var(--rule);
		border-radius: 3px;
		filter: saturate(0.9);
	}

	:root[data-theme='dark'] .about__pic img {
		filter: saturate(0.8) brightness(0.88);
	}

	.about__text p:last-child {
		margin-block-end: 0;
	}

	@media (min-width: 720px) {
		.about {
			grid-template-columns: 11rem minmax(0, 1fr);
			align-items: start;
		}
	}

	.cv {
		display: grid;
		gap: 1.5rem;
		max-width: 36rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cv__row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 0.15rem 1.5rem;
		align-items: baseline;
	}

	.cv__co {
		font-weight: 500;
	}

	.cv__when {
		text-align: end;
		white-space: nowrap;
	}

	.cv__role {
		grid-column: 1 / -1;
		color: var(--graphite);
	}

	/* ── Hire ──────────────────────────────────────────────────────────────*/
	.hire__mail {
		margin-block: 2rem 0.75rem;
		font-size: var(--s-lede);
		max-width: none;
	}

	.hire__mail a {
		overflow-wrap: anywhere;
	}

	.hire__tel {
		margin-block-end: 1.4rem;
	}

	.hire__tel a {
		text-decoration: none;
	}

	.hire__go {
		margin-block-end: 1.9rem;
	}
</style>
