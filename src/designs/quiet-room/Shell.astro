---
import type { Design } from '../registry';
import { parse, otherLang, url as designUrl } from '../routes';
import { dirOf, type Lang } from '../../i18n';
/* The room itself. Head, tokens, the one hairline, the header and the footer:
   everything the four Quiet Room pages stand inside. Pages bring their own
   content and their own page-level CSS, nothing else.

   ponytail: no layout props beyond title and description. If a page needs a
   different room, it is a different variant. */
import LangBoot from '../../components/LangBoot.astro';
import Logo from '../../components/Logo.astro';
import Seam from '../../components/Seam.astro';
import Reveal from '../_shared/Reveal.astro';
import Meta from '../_shared/Meta.astro';
import T from '../../components/T.astro';
import { pair, s } from '../../data/variant-ui';
interface Props {
	design: Design;
	lang: Lang;
	title: string;
	description: string;
}

import DesignSwitch from '../_shared/DesignSwitch.astro';
const { design, lang } = Astro.props;
const { page } = parse(Astro.url.pathname);
/** A link inside this design, in this language: u('/work/aoun'). */
const u = (page = '') => designUrl(design, lang, page);

const { title, description } = Astro.props;
---

<!doctype html>
<html lang={lang} dir={dirOf(lang)} data-design={design.id}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Geist+Mono:wght@400..500&family=Newsreader:opsz,wght@6..72,300..500&family=Noto+Kufi+Arabic:wght@400&display=swap"
		/>
		<LangBoot />
		<script is:inline>
			/* Runs before first paint: no flash of the wrong room. */
			(function () {
				function apply() {
					try {
						let t = localStorage.getItem('qr-theme');
						if (t !== 'light' && t !== 'dark') {
							t = window.matchMedia('(prefers-color-scheme: dark)').matches
								? 'dark'
								: 'light';
						}
						document.documentElement.setAttribute('data-theme', t);
					} catch {
						document.documentElement.setAttribute('data-theme', 'light');
					}
				}
				apply();
				/* The router takes <html> off the incoming page, which knows nothing
				   of the theme, so it goes back on before that page paints. */
				document.addEventListener('astro:after-swap', apply);
			})();
		</script>
		<Seam />
		<Reveal />
		<Meta design={design} lang={lang} />
	</head>
	<body>
		<a class="skip" href="#main"><T v={s('nav.skip')} /></a>

		<div class="shell">
			<header class="top">
				<a class="top__name" href={u()}>
					<Logo labelled={false} />
					<T class="vh" v={pair('Haitham Assoli', 'هيثم العسولي')} />
				</a>
				<nav class="top__nav" aria-label={pair('Pages', 'الصفحات')[lang]}>
					<a href={u('/work')}><T v={s('work.all')} /></a>
					<a href={u('/hire')}><T v={s('nav.hire')} /></a>
				</nav>
				<div class="top__set">
					<button
						class="seg"
						type="button"
						data-toggle="theme"
						aria-label="Light or dark theme"
					>
						<span class="seg__opt" data-for="light" aria-hidden="true">
							<T v={pair('light', 'فاتح')} />
						</span>
						<span class="seg__opt" data-for="dark" aria-hidden="true">
							<T v={pair('dark', 'داكن')} />
						</span>
					</button>
					<a
						href={otherLang(Astro.url.pathname)}
						class="seg seg--lang"
						data-lang-link
					>
						<span class="seg__opt" data-for="en" lang="en" aria-hidden="true"
							>EN</span
						>
						<span class="seg__opt" data-for="ar" lang="ar" aria-hidden="true"
							>عربي</span
						>
						<span class="vh" data-l="en" lang="en"
							>Read this page in Arabic</span
						>
						<span class="vh" data-l="ar" lang="ar"
							>اقرأ هذه الصفحة بالإنجليزية</span
						>
					</a>
				</div>
			</header>

			<main id="main">
				<slot />
				{
					/* Sub-pages get the same switch, kept out of the way at the foot
				   of the content instead of at the top: the hero already carries
				   it on the home page, and one design gets one switch. */
					page !== '' && (
						<DesignSwitch design={design} lang={lang} class="dsw-row--tail" />
					)
				}
			</main>

			<footer class="foot">
				<p class="k">
					<T
						v={pair(
							'Haitham Assoli · Amman, Jordan',
							'هيثم العسولي · عمّان، الأردن',
						)}
					/>
				</p>
				<p class="k foot__set">
					<T
						v={pair(
							'Newsreader & Amiri · built with Astro',
							'Newsreader وAmiri · مبني بـ Astro',
						)}
					/>
					<button
						class="seg"
						type="button"
						data-toggle="theme"
						aria-label="Light or dark theme"
					>
						<span class="seg__opt" data-for="light" aria-hidden="true">
							<T v={pair('light', 'فاتح')} />
						</span>
						<span class="seg__opt" data-for="dark" aria-hidden="true">
							<T v={pair('dark', 'داكن')} />
						</span>
					</button>
					<a
						href={otherLang(Astro.url.pathname)}
						class="seg seg--lang"
						data-lang-link
					>
						<span class="seg__opt" data-for="en" lang="en" aria-hidden="true"
							>EN</span
						>
						<span class="seg__opt" data-for="ar" lang="ar" aria-hidden="true"
							>عربي</span
						>
						<span class="vh" data-l="en" lang="en"
							>Read this page in Arabic</span
						>
						<span class="vh" data-l="ar" lang="ar"
							>اقرأ هذه الصفحة بالإنجليزية</span
						>
					</a>
				</p>
			</footer>
		</div>

		<script is:inline>
			(function () {
				const el = document.documentElement;
				const names = {
					en: {
						light: 'Switch to the dark theme',
						dark: 'Switch to the light theme',
					},
					ar: {
						light: 'التبديل إلى الوضع الداكن',
						dark: 'التبديل إلى الوضع الفاتح',
					},
				};

				function sync() {
					const theme =
						el.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
					const lang = el.lang === 'ar' ? 'ar' : 'en';
					document.querySelectorAll('[data-toggle="theme"]').forEach((btn) => {
						btn.setAttribute('data-state', theme);
						btn.setAttribute('aria-label', names[lang][theme]);
					});
				}

				/* Every click, because the language switch is somebody else's script. */
				document.addEventListener('click', (event) => {
					const btn = event.target.closest?.('[data-toggle="theme"]');
					if (btn) {
						const theme =
							el.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
						el.setAttribute('data-theme', theme);
						try {
							localStorage.setItem('qr-theme', theme);
						} catch {
							/* private mode: this session only */
						}
					}
					sync();
				});

				sync();
				/* The swap brings fresh buttons in unstated; state them before they
				   paint. */
				document.addEventListener('astro:after-swap', sync);
			})();
		</script>
	</body>
</html>

<style is:global>
	/* ── Tokens ─────────────────────────────────────────────────────────────
	   Light: a cool grey-green paper stock, the colour of a laid sheet in
	   daylight. Dark: the same room at night, never pure black.
	   One accent for both: ink violet, the colour of a pen that bled. */
	:root {
		--paper: #edeee8;
		--raised: #f6f7f2;
		--ink: #1e2321;
		--graphite: #6b736c;
		--rule: #d5d8cf;
		--signal: #4a3ad1;
		--on-signal: #edeee8;
		--selection: #d9d6f6;

		--serif: 'Newsreader', 'Iowan Old Style', Georgia, serif;
		--mono: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		/* Arabic keeps the same two roles: a naskh for reading, a kufi for the
		   labels, because Arabic cannot be tracked out or set in small caps. */
		--serif-ar: 'Amiri', 'Noto Naskh Arabic', 'Geeza Pro', serif;
		--mono-ar: 'Noto Kufi Arabic', 'Geist Mono', ui-monospace, monospace;

		--s-hero: clamp(1.95rem, 4.6vw, 3.05rem);
		--s-hero-ar: clamp(2.05rem, 4.9vw, 3.2rem);
		--s-lede: clamp(1.0625rem, 0.98rem + 0.4vw, 1.1875rem);
		--s-lede-ar: clamp(1.1875rem, 1.09rem + 0.45vw, 1.3125rem);
		--s-body: 1.0625rem;
		--s-body-ar: 1.1875rem;
		--s-meta: 0.78125rem;
		--s-meta-ar: 0.8125rem;

		--gutter: clamp(1.25rem, 3vw, 2.75rem);
		--band: clamp(3.25rem, 7vw, 5.75rem);

		color-scheme: light;
	}

	:root[data-theme='dark'] {
		--paper: #171a17;
		--raised: #1e221e;
		--ink: #e5e8df;
		--graphite: #8b938a;
		--rule: #2c312c;
		--signal: #a99eff;
		--on-signal: #14161d;
		--selection: #2f2a55;

		color-scheme: dark;
	}

	@media (prefers-color-scheme: dark) {
		:root:not([data-theme]) {
			--paper: #171a17;
			--raised: #1e221e;
			--ink: #e5e8df;
			--graphite: #8b938a;
			--rule: #2c312c;
			--signal: #a99eff;
			--on-signal: #14161d;
			--selection: #2f2a55;

			color-scheme: dark;
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		background: var(--paper);
		transition:
			background-color 0.4s ease,
			color 0.4s ease;
		-webkit-text-size-adjust: 100%;
	}

	body {
		margin: 0;
		background: var(--paper);
		color: var(--ink);
		font-family: var(--serif);
		font-size: var(--s-body);
		font-weight: 400;
		line-height: 1.62;
		font-optical-sizing: auto;
		overflow-x: hidden;
		-webkit-font-smoothing: antialiased;
	}

	::selection {
		background: var(--selection);
		color: var(--ink);
	}

	:focus-visible {
		outline: 2px solid var(--signal);
		outline-offset: 3px;
		border-radius: 1px;
	}

	img {
		display: block;
		max-width: 100%;
		height: auto;
	}

	.vh {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		border: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.skip {
		position: absolute;
		inset-block-start: 0.5rem;
		inset-inline-start: 0.5rem;
		z-index: 5;
		padding: 0.5rem 0.85rem;
		border: 1px solid var(--rule);
		border-radius: 3px;
		background: var(--raised);
		font-family: var(--mono);
		font-size: var(--s-meta);
		text-decoration: none;
		transform: translateY(-200%);
	}

	.skip:focus {
		transform: none;
	}

	/* ── The Arabic half ────────────────────────────────────────────────────
	   Scoped off the element's own lang, never off :root, so a genuinely
	   English run inside an Arabic page keeps its Latin face. */
	[lang='ar']:where(:not(:root)) {
		font-family: var(--serif-ar);
		font-size: var(--s-body-ar);
		font-style: normal;
		font-weight: 400;
		letter-spacing: normal;
		line-height: 1.95;
	}

	.k[lang='ar'],
	.k [lang='ar'],
	[lang='ar'] .k,
	.seg [lang='ar'],
	.rail [lang='ar'] {
		font-family: var(--mono-ar);
		font-size: var(--s-meta-ar);
		letter-spacing: normal;
		line-height: 1.75;
	}

	h1[lang='ar'] {
		font-size: var(--s-hero-ar);
		line-height: 1.4;
	}

	h2[lang='ar'],
	h3[lang='ar'],
	.lede[lang='ar'] {
		font-size: var(--s-lede-ar);
		line-height: 1.62;
	}

	/* Amiri has no medium, so an Arabic heading marks itself with the bold. */
	h2[lang='ar'],
	h3[lang='ar'] {
		font-weight: 700;
	}

	/* Under rtl, an English block still reads forwards; it just hugs the
	   other edge, so its full stops stay where they belong. */
	html[dir='rtl'] [lang='en'] {
		direction: ltr;
		unicode-bidi: isolate;
		text-align: end;
	}

	/* ── Shell and the one continuous rule ─────────────────────────────────
	   Every band shares the same two-column grid, and the hairline is the
	   inline-start border of the content column. Vertical space is padding,
	   never margin, so the line never breaks from the top of the page to the
	   bottom of it. */
	.shell {
		max-width: 71rem;
		margin-inline: auto;
		padding-inline: clamp(1.15rem, 5vw, 4rem);
	}

	.band {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
	}

	.rail {
		margin: 0;
		display: none;
	}

	.col {
		border-inline-start: 1px solid var(--rule);
		padding-inline-start: var(--gutter);
		padding-block: var(--band);
	}

	.col > :first-child {
		margin-block-start: 0;
	}

	.col > :last-child {
		margin-block-end: 0;
	}

	.col--top {
		padding-block-start: clamp(2.75rem, 8vw, 5rem);
	}

	@media (min-width: 760px) {
		.band {
			grid-template-columns: 9.5rem minmax(0, 1fr);
			column-gap: 2.25rem;
		}

		.rail {
			display: block;
		}

		.rail > span {
			display: block;
			padding-block-start: calc(var(--band) + 0.42rem);
			font-family: var(--mono);
			font-size: var(--s-meta);
			font-weight: 400;
			letter-spacing: 0.07em;
			line-height: 1.4;
			color: var(--graphite);
			text-align: end;
		}

		.band--top .rail > span {
			padding-block-start: calc(clamp(2.75rem, 8vw, 5rem) + 0.42rem);
		}
	}

	/* ── Type roles ────────────────────────────────────────────────────────
	   Four sizes on the whole site. The hero is the only thing set large. */
	h1 {
		margin: 1.6rem 0 0;
		font-size: var(--s-hero);
		font-weight: 300;
		line-height: 1.08;
		letter-spacing: -0.018em;
		text-wrap: balance;
		max-width: 17ch;
	}

	h2 {
		margin: 0 0 1.7rem;
		font-size: var(--s-lede);
		font-weight: 500;
		line-height: 1.32;
		letter-spacing: -0.008em;
		max-width: 30ch;
		text-wrap: balance;
	}

	h3 {
		margin: 0;
		font-size: var(--s-lede);
		font-weight: 500;
		line-height: 1.3;
	}

	p {
		margin: 0 0 1.05rem;
		max-width: 36rem;
	}

	.lede {
		font-size: var(--s-lede);
		line-height: 1.55;
	}

	.measure {
		max-width: 34rem;
		color: var(--graphite);
	}

	.k {
		font-family: var(--mono);
		font-size: var(--s-meta);
		font-weight: 400;
		letter-spacing: 0.055em;
		line-height: 1.5;
		color: var(--graphite);
	}

	.sub {
		margin-block: 3.25rem 1.1rem;
		color: var(--graphite);
	}

	a {
		color: inherit;
		text-decoration-color: color-mix(in oklab, currentColor 32%, transparent);
		text-underline-offset: 0.22em;
		text-decoration-thickness: 1px;
	}

	a:hover {
		color: var(--signal);
		text-decoration-color: currentColor;
	}

	.lnk {
		text-decoration: none;
		border-block-end: 1px solid var(--rule);
		padding-block-end: 0.14rem;
		transition:
			color 0.18s ease,
			border-color 0.18s ease;
	}

	.lnk:hover {
		border-block-end-color: var(--signal);
	}

	/* ── Top bar ───────────────────────────────────────────────────────────*/
	.top {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem 1.25rem;
		padding-block: 1.6rem 0;
	}

	/* The wordmark signs the room: letters in ink, and under them the one
	   accent, the same violet the projects list marks an entry with. */
	.top__name {
		display: block;
		--logo-rule: var(--signal);
		color: var(--ink);
	}

	/* Three classes only to outweigh the component's own scoped `auto`. */
	.top .top__name .logo {
		block-size: 1.7rem;
	}

	.top__nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.25rem;
		font-family: var(--mono);
		font-size: var(--s-meta);
		letter-spacing: 0.055em;
		color: var(--graphite);
		margin-inline-end: auto;
	}

	.top__nav a {
		text-decoration: none;
	}

	.top__nav a[aria-current='page'] {
		color: var(--ink);
	}

	.top__set {
		display: flex;
		align-items: center;
		gap: 0.6rem 1rem;
	}

	/* ── The two switches ──────────────────────────────────────────────────*/
	.seg {
		display: inline-flex;
		align-items: center;
		gap: 0.1rem;
		margin: 0;
		padding: 0.22rem 0.3rem;
		border: 1px solid var(--rule);
		border-radius: 999px;
		background: transparent;
		font: inherit;
		font-family: var(--mono);
		font-size: var(--s-meta);
		letter-spacing: 0.05em;
		line-height: 1;
		color: var(--graphite);
		cursor: pointer;
		direction: ltr;
		transition: border-color 0.2s ease;
	}

	.seg:hover {
		border-color: var(--graphite);
	}

	.seg__opt {
		display: block;
		padding: 0.26rem 0.5rem 0.3rem;
		border-radius: 999px;
		transition:
			color 0.2s ease,
			background-color 0.2s ease;
	}

	.seg[data-state='light'] .seg__opt[data-for='light'],
	.seg[data-state='dark'] .seg__opt[data-for='dark'] {
		background: var(--ink);
		color: var(--paper);
	}

	/* The only place the accent lives by default: the switch that decides
	   which of the two pages you are reading. */
	html[lang='en'] .seg--lang .seg__opt[data-for='en'],
	html[lang='ar'] .seg--lang .seg__opt[data-for='ar'] {
		background: var(--signal);
		color: var(--on-signal);
	}

	.seg--lang .seg__opt[lang='ar'] {
		padding-block: 0.18rem 0.34rem;
	}

	/* ── Shared list devices ───────────────────────────────────────────────
	   One inline list, separated by a middle dot that trails its item so a
	   wrapped line never opens with a stray mark. */
	.tools {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem 0;
		max-width: 46rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tools li {
		color: var(--ink);
	}

	.tools li:not(:last-child)::after {
		content: '·';
		display: inline-block;
		padding-inline: 0.7rem;
		color: var(--rule);
	}

	.tools--quiet li {
		color: var(--graphite);
	}

	.tools a {
		text-decoration: none;
	}

	.tools a:hover {
		color: var(--signal);
	}

	/* A Latin list keeps reading left to right, but it still starts at the
	   edge the page is being read from. */
	html[dir='rtl'] .tools[lang='en'] {
		justify-content: flex-end;
	}

	/* A ledger row: label, dotted leader, figure. */
	.count {
		display: grid;
		gap: 0.95rem;
		margin: 0;
		max-width: 34rem;
	}

	.count__row {
		display: flex;
		align-items: baseline;
		gap: 0.7rem;
	}

	.count__row dt {
		flex: 0 1 auto;
	}

	.count__lead {
		flex: 1 1 2rem;
		min-width: 1.5rem;
		border-block-end: 1px dotted var(--rule);
		transform: translateY(-0.28em);
	}

	.count__row dd {
		margin: 0;
		/* Shrinkable: most values are a figure, but the role line is a
		   sentence and has to wrap rather than push the row off a phone. */
		flex: 0 1 auto;
		min-width: 0;
		color: var(--ink);
		font-size: var(--s-body);
		letter-spacing: 0.02em;
	}

	/* ── Footer ────────────────────────────────────────────────────────────*/
	.foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 1.5rem;
		padding-block: 1.6rem 7.5rem;
		border-block-start: 1px solid var(--rule);
	}

	.foot p {
		margin: 0;
		max-width: none;
	}

	.foot__set {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.7rem 0.9rem;
	}

	/* ── Motion ────────────────────────────────────────────────────────────*/
	.rise {
		animation: rise 0.75s cubic-bezier(0.2, 0.7, 0.2, 1) both;
		animation-delay: var(--d, 0ms);
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(0.7rem);
		}
		to {
			opacity: 1;
			transform: none;
