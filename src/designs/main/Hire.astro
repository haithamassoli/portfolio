---
import type { Design } from '../registry';
import type { Lang } from '../../i18n';
/* The brief, and a Jacquard card beside it.

   Jacquard looms read their pattern from a chain of punched cards — one row
   per pick, a hole for every thread that lifts. They are the first programs
   ever written for a machine, and the reason a loom sits at the top of this
   site. So the form is one: as each field of the brief is filled in, its row
   of the card is punched. The card is a plain SVG; a dozen lines of script
   check validity and toggle a class. The form itself posts nowhere: it opens
   a mail draft, through the same composer every design uses. */
import { profile } from '../../../content/profile';
import HireCompose from '../../components/HireCompose.astro';
import Shell from './Shell.astro';
import Stitch from './Stitch.astro';
import T from '../../components/T.astro';
import { pair, s } from '../../data/variant-ui';

interface Props {
	design: Design;
	lang: Lang;
}

const { design, lang } = Astro.props;

const deals = [
	{ value: 'part', label: s('deal.part') },
	{ value: 'full', label: s('deal.full') },
	{ value: 'contract', label: s('deal.contract') },
	{ value: 'freelance', label: s('deal.freelance') },
	{ value: 'hourly', label: s('deal.hourly') },
];

const places = [
	{ value: 'remote', label: s('loc.remote') },
	{ value: 'onsite', label: s('loc.onsite') },
];

const stacks = [
	{ value: 'frontend', label: s('tech.frontend') },
	{ value: 'backend', label: s('tech.backend') },
	{ value: 'mobile', label: s('tech.mobile') },
	{ value: 'other', label: s('tech.other') },
];

const takes = [
	{ title: s('skill.web'), body: s('skill.webDesc') },
	{ title: s('skill.mobile'), body: s('skill.mobileDesc') },
	{ title: s('skill.backend'), body: s('skill.backendDesc') },
	{ title: s('skill.other'), body: s('skill.otherDesc') },
];

/* The card's rows, in the order the form asks. */
const rows = [
	'fullName',
	'email',
	'phone',
	'deal',
	'location',
	'techStack',
	'budget',
	'summary',
];
const COLS = 14;
/* Which holes a row punches: a fixed pattern, so the card looks like a card
   and not like a progress bar. */
const punched = (r: number, c: number) => (r * 5 + c * 3) % 7 < 4;
---

<Shell
	design={design}
	lang={lang}
	title={s('hire.eyebrow')[lang]}
	description={s('hire.lede')[lang]}
	active="hire"
>
	<HireCompose />

	<section class="section hire-head">
		<div class="wrap">
			<T v={s('hire.eyebrow')} as="p" class="eyebrow" />
			<T v={s('hire.title')} as="h1" class="title" />
			<T v={s('hire.lede')} as="p" class="lede hire-head__lede" />
			<T v={s('hire.note')} as="p" class="mono hire-head__note" />
		</div>
	</section>

	<Stitch />

	<section class="section hire-body">
		<div class="wrap hire-grid">
			<form class="brief" data-hire novalidate={false}>
				<div class="f">
					<label class="f__l" for="fullName"><T v={s('hire.fullName')} /></label
					>
					<input
						class="f__i"
						id="fullName"
						name="fullName"
						type="text"
						autocomplete="name"
						required
						minlength="2"
					/>
				</div>

				<div class="f">
					<label class="f__l" for="email"><T v={s('hire.email')} /></label>
					<input
						class="f__i"
						id="email"
						name="email"
						type="email"
						autocomplete="email"
						dir="ltr"
						required
					/>
				</div>

				<div class="f">
					<label class="f__l" for="phone"><T v={s('hire.phone')} /></label>
					<input
						class="f__i"
						id="phone"
						name="phone"
						type="tel"
						autocomplete="tel"
						dir="ltr"
						required
						minlength="10"
					/>
				</div>

				<fieldset class="f">
					<legend class="f__l"><T v={s('hire.deal')} /></legend>
					<div class="opts">
						{
							deals.map((d, i) => (
								<label class="opt">
									<input
										type="radio"
										name="deal"
										value={d.value}
										required={i === 0}
									/>
									<T v={d.label} />
								</label>
							))
						}
					</div>
				</fieldset>

				<fieldset class="f">
					<legend class="f__l"><T v={s('hire.location')} /></legend>
					<div class="opts">
						{
							places.map((l, i) => (
								<label class="opt">
									<input
										type="radio"
										name="location"
										value={l.value}
										required={i === 0}
									/>
									<T v={l.label} />
								</label>
							))
						}
					</div>
				</fieldset>

				<fieldset class="f">
					<legend class="f__l"><T v={s('hire.techStack')} /></legend>
					<div class="opts">
						{
							stacks.map((t) => (
								<label class="opt">
									<input type="checkbox" name="techStack" value={t.value} />
									<T v={t.label} />
								</label>
							))
						}
					</div>
				</fieldset>

				<div class="f">
					<label class="f__l" for="budget"><T v={s('hire.budget')} /></label>
					<input
						class="f__i"
						id="budget"
						name="budget"
						type="text"
						required
						placeholder={s('hire.budgetPlaceholder')[lang]}
					/>
				</div>

				<div class="f">
					<label class="f__l" for="summary"><T v={s('hire.summary')} /></label>
					<textarea
						class="f__i f__t"
						id="summary"
						name="summary"
						rows="6"
						required
						minlength="20"
						placeholder={s('hire.summaryPlaceholder')[lang]}></textarea>
				</div>

				<div class="brief__end">
					<button class="btn" type="submit">
						<T v={s('hire.submit')} />
						<span class="arrow" aria-hidden="true">→</span>
					</button>
					<T v={s('hire.sent')} as="p" class="brief__sent" role="status" />
				</div>

				<p class="brief__alt">
					<T v={pair('Or write directly:', 'أو راسلني مباشرة:')} />
					<a href={`mailto:${profile.email}`} dir="ltr">{profile.email}</a>
				</p>
			</form>

			<aside class="side">
				<figure class="jacquard rise">
					<svg
						class="jacquard__card"
						viewBox="0 0 340 214"
						role="img"
						aria-label={pair(
							'A Jacquard punch card. Each row is punched as the matching field of the brief is filled in.',
							'بطاقة جاكار مثقّبة. يُثقب كل صف عند ملء الحقل المقابل له في الطلب.',
						)[lang]}
						data-card
					>
						<path class="jacquard__paper" d="M6 0 H322 L340 18 V214 H6 Z"
						></path>
						<line class="jacquard__edge" x1="30" y1="0" x2="30" y2="214"></line>
						{
							rows.map((name, r) => (
								<g
									class="row"
									data-row={name}
									transform={`translate(0 ${18 + r * 24})`}
								>
									<text class="row__n" x="12" y="4" text-anchor="middle">
										{r + 1}
									</text>
									{Array.from({ length: COLS }, (_, c) => (
										<circle
											class:list={['hole', punched(r, c) && 'hole--on']}
											cx={48 + c * 20}
											cy="0"
											r="5"
										/>
									))}
								</g>
							))
						}
					</svg>
					<figcaption class="jacquard__cap">
						<T
							v={pair(
								'A Jacquard card: one row per instruction, a hole for every thread that lifts. The first program ever written for a machine. Yours punches itself as the brief fills in.',
								'بطاقة جاكار: صف لكل تعليمة، وثقب لكل خيط يُرفع. أول برنامج كُتب لآلة. وبطاقتك تُثقَب من تلقاء نفسها كلما اكتمل الطلب.',
							)}
						/>
					</figcaption>
				</figure>

				<T v={s('skills.title')} as="h2" class="side__h" />
				<ul class="takes">
					{
						takes.map((t) => (
							<li class="take rise">
								<T v={t.title} as="h3" class="take__t" />
								<T v={t.body} as="p" class="take__p" />
							</li>
						))
					}
				</ul>
			</aside>
		</div>
	</section>
</Shell>

<script is:inline data-astro-rerun>
	/* Punch the card. A row is punched when its field would pass the form's
	   own validation; groups count when one is chosen. */
	(function () {
		const form = document.querySelector('form[data-hire]');
		const card = document.querySelector('[data-card]');
		if (!form || !card) return;
		function refresh() {
			card.querySelectorAll('[data-row]').forEach(function (g) {
				const el = form.elements[g.getAttribute('data-row')];
				let ok = false;
				if (!el) ok = false;
				else if (typeof el.length === 'number' && !el.tagName) {
					ok = Array.prototype.some.call(el, function (e) {
						return e.checked;
					});
				} else ok = el.value.trim() !== '' && el.checkValidity();
				g.classList.toggle('is-punched', ok);
			});
		}
		form.addEventListener('input', refresh);
		form.addEventListener('change', refresh);
		refresh();
	})();
</script>

<style is:global>
	.hire-head {
		padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2rem, 4vw, 3rem);
	}

	.hire-head__lede {
		margin-block-start: 1.4rem;
	}

	.hire-head__note {
		margin-block-start: 1.2rem;
		color: var(--thread);
	}

	.hire-grid {
		display: grid;
		gap: clamp(2.5rem, 6vw, 5rem);
	}

	@media (min-width: 62rem) {
		.hire-grid {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
			align-items: start;
		}

		/* The card stays in view while the brief is filled, so the punching
		   is seen. */
		.side {
			position: sticky;
			inset-block-start: 5rem;
		}
	}

	/* ------------------------------ the brief ------------------------------ */

	.brief {
		display: grid;
		gap: 1.9rem;
		max-width: 36rem;
	}

	.f {
		margin: 0;
		padding: 0;
		border: 0;
		min-width: 0;
	}

	.f__l {
		display: block;
		margin-block-end: 0.5rem;
		padding: 0;
		font-family: var(--mono);
		font-size: var(--t-1);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-2);
	}

	.f__l :lang(ar),
	.f__l:lang(ar) {
		font-family: var(--sans);
		font-weight: 500;
		font-size: 0.9rem;
		letter-spacing: 0;
		text-transform: none;
	}

	.f__i {
		display: block;
		width: 100%;
		padding: 0.6rem 0;
		border: 0;
		border-block-end: 1px solid var(--rule-2);
		border-radius: 0;
		background: transparent;
		color: var(--ink);
		font-size: var(--t0);
		transition: border-color 0.2s;
	}

	.f__i::placeholder {
		color: var(--ink-3);
	}

	.f__i:hover {
		border-color: var(--ink-2);
	}

	.f__i:focus {
		outline: none;
		border-block-end: 2px solid var(--thread);
		padding-block-end: calc(0.6rem - 1px);
	}

	/* The field's own thread, once it holds. */
	.f__i:not(:placeholder-shown):valid {
		border-block-end-color: var(--thread);
	}

	.f__t {
		resize: vertical;
		min-height: 7rem;
	}

	.opts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.opt {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.45rem 0.9rem;
		border: 1px solid var(--rule-2);
		border-radius: 999px;
		cursor: pointer;
		font-size: 0.92rem;
		transition:
			border-color 0.2s,
			background-color 0.2s,
			color 0.2s;
	}

	.opt input {
		margin: 0;
		width: 0.9rem;
		height: 0.9rem;
	}

	.opt:hover {
		border-color: var(--thread);
	}

	.opt:has(:checked) {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--linen);
	}

	.brief__end {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
	}

	.brief__sent {
		display: none;
		max-width: 22rem;
		font-size: 0.92rem;
		color: var(--thread);
	}

	.brief[data-sent] .brief__sent {
		display: block;
	}

	.brief__alt {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		color: var(--ink-2);
		font-size: 0.95rem;
	}

	.brief__alt a {
		overflow-wrap: anywhere;
	}

	/* ------------------------------ the card ------------------------------ */

	.jacquard {
		margin-block-end: 2.5rem;
	}

	.jacquard__card {
		width: 100%;
		height: auto;
		filter: drop-shadow(
			0 8px 24px color-mix(in oklab, var(--ink) 12%, transparent)
		);
	}

	.jacquard__paper {
		fill: #efe6d1;
		stroke: var(--rule-2);
	}

	.jacquard__edge {
		stroke: var(--rule-2);
		stroke-dasharray: 2 3;
	}

	.row__n {
		font-family: var(--mono);
		font-size: 8px;
		fill: var(--ink-3);
	}

	.hole {
		fill: none;
		stroke: color-mix(in oklab, var(--ink) 22%, transparent);
		stroke-width: 0.8;
		transition:
			fill 0.35s var(--ease),
			stroke 0.35s var(--ease),
			transform 0.35s var(--ease);
		transform-box: fill-box;
		transform-origin: center;
	}

	.row.is-punched .hole--on {
		fill: var(--ink);
		stroke: var(--ink);
	}

	.row.is-punched .hole--on:nth-child(3n) {
		fill: var(--thread);
		stroke: var(--thread);
	}

	.row.is-punched .row__n {
		fill: var(--thread);
		font-weight: 700;
	}

	@media (prefers-reduced-motion: no-preference) {
		.row.is-punched .hole--on {
			animation: punch 0.4s var(--ease);
		}
	}

	@keyframes punch {
		40% {
			transform: scale(1.5);
		}
	}

	.jacquard__cap {
		margin-block-start: 1rem;
		max-width: 44ch;
		font-size: 0.9rem;
		color: var(--ink-2);
	}

	.side__h {
		margin-block-end: 1.2rem;
		font-size: var(--t2);
	}

	.takes {
		display: grid;
		gap: 1.4rem;
	}

	.take {
		padding-inline-start: 1rem;
		border-inline-start: 2px solid var(--thread);
	}

	.take__t {
		font-size: var(--t1);
		margin-block-end: 0.35rem;
	}

	.take__p {
		color: var(--ink-2);
		font-size: 0.95rem;
	}
</style>
