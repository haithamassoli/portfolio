---
import type { Design } from '../registry';
import type { Lang } from '../../i18n';
/* /6/hire — the booking sheet.

   A call sheet is the one piece of paper a production actually runs on: who,
   where, what, and by when. This is that, for a project that has not started
   yet. The form posts nowhere; it chalks a slate and opens a draft. */
import Shell from './Shell.astro';
import HireCompose from '../../components/HireCompose.astro';
import T from '../../components/T.astro';
import { profile } from '../../../content/profile';
import { deals, locations, techStack } from '../../i18n';
import { s, pair } from '../../data/variant-ui';
import type { I18n } from '../../../content/types';
interface Props {
	design: Design;
	lang: Lang;
}

const { design, lang } = Astro.props;

const takes: [I18n, I18n][] = [
	[s('skill.web'), s('skill.webDesc')],
	[s('skill.mobile'), s('skill.mobileDesc')],
	[s('skill.backend'), s('skill.backendDesc')],
	[s('skill.other'), s('skill.otherDesc')],
];

const terms: [I18n, I18n][] = [
	[pair('Response', 'الرد'), s('hire.note')],
	[
		pair('Rates', 'الأجر'),
		pair(
			'Priced by scope, not by the hour. Tell me the budget you have and I will tell you what fits inside it.',
			'التسعير بحسب نطاق العمل لا بعدد الساعات. أخبرني بالميزانية المتاحة وأخبرك بما يتّسع لها.',
		),
	],
	[
		pair('Handover', 'التسليم'),
		pair(
			'Repository, release access, deployment notes, and a practical runbook are included.',
			'يشمل التسليم المستودع وصلاحيات الإصدار وملاحظات النشر ودليلًا عمليًا للتشغيل.',
		),
	],
	[
		pair('Availability', 'الجاهزية'),
		pair(
			'Remote from Amman, on site anywhere in Jordan. Part time, contract, or a build with a fixed scope.',
			'عن بُعد من عمّان، وفي الموقع في أي مكان داخل الأردن. دوام جزئي أو عقد أو عمل بنطاق محدد.',
		),
	],
];
---

<Shell
	design={design}
	lang={lang}
	title={pair(
		'Booking — Night Reel — Haitham Assoli',
		'الحجز — بكرة الليل — هيثم العسولي',
	)[lang]}
	description={pair(
		'Brief Haitham Assoli on a web or mobile project. The form opens a pre-written email in your own mail app; nothing is sent until you press send.',
		'اعرض على هيثم العسولي مشروع ويب أو جوال. يفتح النموذج رسالة مكتوبة مسبقًا في تطبيق بريدك، ولا يُرسل شيء حتى تضغط إرسال.',
	)[lang]}
	mark={pair('Call sheet', 'ورقة النداء')}
	current="booking"
>
	<HireCompose />

	<section class="band">
		<div class="wrap">
			<header class="head">
				<p class="eyebrow"><T v={pair('Booking', 'الحجز')} /></p>
				<h1 class="head__title" data-l="en" lang="en">
					Book the next production
				</h1>
				<h1 class="head__title" data-l="ar" lang="ar">احجز الإنتاج القادم</h1>
				<T v={s('hire.lede')} as="p" class="head__lede" />
			</header>

			<div class="booking">
				<aside class="booking__terms">
					<section class="term">
						<h2 class="term__head"><T v={s('skills.title')} /></h2>
						<dl class="term__list">
							{
								takes.map(([label, body]) => (
									<div class="term__row">
										<dt>
											<T v={label} />
										</dt>
										<dd>
											<T v={body} />
										</dd>
									</div>
								))
							}
						</dl>
					</section>

					<section class="term">
						<h2 class="term__head">
							<T v={pair('How it runs', 'كيف يجري العمل')} />
						</h2>
						<dl class="term__list">
							{
								terms.map(([label, body]) => (
									<div class="term__row">
										<dt>
											<T v={label} />
										</dt>
										<dd>
											<T v={body} />
										</dd>
									</div>
								))
							}
						</dl>
					</section>

					<p class="term__direct">
						<span data-l="en" lang="en">Rather just write? </span>
						<span data-l="ar" lang="ar">تفضّل أن تكتب مباشرة؟ </span>
						<a class="tail__link" href={`mailto:${profile.email}`}
							>{profile.email}</a
						>
					</p>
				</aside>

				<div class="callsheet">
					<span class="callsheet__sticks" aria-hidden="true"></span>

					<form class="sheetform" data-hire>
						<h2 class="sheetform__head"><T v={s('hire.title')} /></h2>

						<div class="field">
							<label class="field__label" for="hire-name">
								<T v={s('hire.fullName')} />
							</label>
							<input
								class="field__input"
								id="hire-name"
								name="fullName"
								type="text"
								autocomplete="name"
								required
							/>
						</div>

						<div class="field field--split">
							<div class="field">
								<label class="field__label" for="hire-email">
									<T v={s('hire.email')} />
								</label>
								<input
									class="field__input"
									id="hire-email"
									name="email"
									type="email"
									autocomplete="email"
									dir="ltr"
									required
								/>
							</div>

							<div class="field">
								<label class="field__label" for="hire-phone">
									<T v={s('hire.phone')} />
								</label>
								<input
									class="field__input"
									id="hire-phone"
									name="phone"
									type="tel"
									autocomplete="tel"
									dir="ltr"
									required
								/>
							</div>
						</div>

						<fieldset class="field field--set">
							<legend class="field__label"><T v={s('hire.deal')} /></legend>
							<div class="ticks">
								{
									deals.map((d) => (
										<label class="tick">
											<input type="radio" name="deal" value={d} required />
											<span class="tick__box" aria-hidden="true" />
											<span class="tick__text">
												<T v={s(`deal.${d}`)} />
											</span>
										</label>
									))
								}
							</div>
						</fieldset>

						<fieldset class="field field--set">
							<legend class="field__label"><T v={s('hire.location')} /></legend>
							<div class="ticks">
								{
									locations.map((l) => (
										<label class="tick">
											<input type="radio" name="location" value={l} required />
											<span class="tick__box" aria-hidden="true" />
											<span class="tick__text">
												<T v={s(`loc.${l}`)} />
											</span>
										</label>
									))
								}
							</div>
						</fieldset>

						<fieldset class="field field--set">
							<legend class="field__label"><T v={s('hire.techStack')} /></legend
							>
							<p class="field__help">
								<T
									v={pair(
										'Tick as many as apply.',
										'اختر ما ينطبق، ولو أكثر من واحد.',
									)}
								/>
							</p>
							<div class="ticks">
								{
									techStack.map((t) => (
										<label class="tick">
											<input type="checkbox" name="techStack" value={t} />
											<span
												class="tick__box tick__box--square"
												aria-hidden="true"
											/>
											<span class="tick__text">
												<T v={s(`tech.${t}`)} />
											</span>
										</label>
									))
								}
							</div>
						</fieldset>

						{
							/* The example goes in a visible bilingual line, not a placeholder:
						    a placeholder can only hold one language, and a hidden
						    duplicate of a required control cannot be focused to
						    report its own error. */
						}
						<div class="field">
							<label class="field__label" for="hire-budget">
								<T v={s('hire.budget')} />
							</label>
							<T v={s('hire.budgetPlaceholder')} as="p" class="field__help" />
							<input
								class="field__input"
								id="hire-budget"
								name="budget"
								type="text"
								required
							/>
						</div>

						<div class="field">
							<label class="field__label" for="hire-summary">
								<T v={s('hire.summary')} />
							</label>
							<T v={s('hire.summaryPlaceholder')} as="p" class="field__help" />
							<textarea
								class="field__input field__input--area"
								id="hire-summary"
								name="summary"
								rows="5"
								required></textarea>
						</div>

						<p class="sheetform__note">
							<T
								v={pair(
									'Nothing leaves this page. The button opens a draft in your own mail app, already filled in, and you press send.',
									'لا يغادر هذه الصفحة شيء. الزر يفتح مسودة في تطبيق بريدك، مملوءة مسبقًا، وأنت من يضغط إرسال.',
								)}
							/>
						</p>

						<button class="btn btn--key sheetform__go" type="submit">
							<T v={s('hire.submit')} />
						</button>

						<p class="sent" role="status">
							<span class="sent__mark" aria-hidden="true">✓</span>
							<T v={s('hire.sent')} />
						</p>
					</form>
				</div>
			</div>
		</div>
	</section>
</Shell>

<style is:global>
	.booking {
		display: grid;
		gap: clamp(2rem, 5vw, 3.5rem);
		align-items: start;
	}

	/* ── The terms ─────────────────────────────────────────────────────── */

	.term + .term {
		margin-top: 2.5rem;
	}

	.term__head {
		margin: 0 0 1.1rem;
		font-family: var(--display);
		font-stretch: 110%;
		font-variation-settings:
			'wdth' 110,
			'wght' 600;
		font-weight: 600;
		font-size: 1.15rem;
		line-height: 1.1;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--key);
		padding-bottom: 0.55rem;
		border-bottom: 1px solid rgba(255, 194, 122, 0.28);
	}

	.term__head [lang='ar'] {
		font-family: 'Cairo', sans-serif;
		font-weight: 700;
		font-variation-settings: 'wght' 700;
		line-height: 1.5;
	}

	.term__list {
		margin: 0;
	}

	.term__row {
		padding-block: 0.85rem;
		border-bottom: 1px solid rgba(163, 171, 189, 0.14);
	}

	.term__row dt {
		font-family: var(--credit);
		font-size: 0.76rem;
		font-weight: 600;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--print);
		margin-bottom: 0.25rem;
	}

	.term__row dt [lang='ar'] {
		font-family: 'Tajawal', sans-serif;
		font-weight: 700;
		font-size: 0.92rem;
	}

	.term__row dd {
		margin: 0;
		font-size: 0.98rem;
		line-height: 1.65;
		color: var(--mist);
	}

	.term__row dd [lang='ar'] {
		font-family: 'Amiri', serif;
		font-weight: 400;
		font-size: 1.06rem;
		line-height: 1.95;
	}

	.term__direct {
		margin: 1.75rem 0 0;
		font-family: var(--credit);
		font-size: 0.88rem;
		letter-spacing: 0.1em;
		color: var(--mist);
		word-break: break-word;
	}

	.term__direct [lang='ar'] {
		font-family: 'Tajawal', sans-serif;
		font-size: 0.98rem;
	}

	/* ── The call sheet ────────────────────────────────────────────────── */

	.callsheet {
		border: 1px solid rgba(242, 232, 219, 0.22);
		background:
			radial-gradient(
				110% 60% at 50% 0%,
				rgba(42, 53, 87, 0.4),
				transparent 70%
			),
			rgba(5, 6, 10, 0.62);
	}

	.callsheet__sticks {
		display: block;
		height: 0.8rem;
		background: repeating-linear-gradient(
			116deg,
			rgba(242, 232, 219, 0.8) 0 0.55rem,
			var(--crush) 0.55rem 1.1rem
		);
	}

	.sheetform {
		padding: clamp(1.25rem, 4vw, 2.25rem);
		display: grid;
		gap: 1.5rem;
	}

	.sheetform__head {
		margin: 0;
		font-weight: 600;
		font-family: var(--display);
		font-stretch: 104%;
		font-variation-settings:
			'wdth' 104,
			'wght' 600;
		font-weight: 600;
		font-size: 1.1rem;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: var(--print);
	}

	.sheetform__head [lang='ar'] {
		font-family: 'Cairo', sans-serif;
		font-weight: 700;
		font-variation-settings: 'wght' 700;
		font-size: 1.16rem;
		line-height: 1.6;
	}

	.field {
		display: grid;
		gap: 0.45rem;
		min-width: 0;
		border: 0;
		margin: 0;
		padding: 0;
	}

	.field--split {
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	.field__label {
		font-family: var(--credit);
		font-size: 0.76rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--mist);
		padding: 0;
	}

	.field__label [lang='ar'] {
		font-family: 'Tajawal', sans-serif;
		font-weight: 700;
		font-size: 0.9rem;
	}

	.field__help {
		margin: -0.15rem 0 0.1rem;
		font-size: 0.88rem;
		line-height: 1.5;
		color: rgba(163, 171, 189, 0.75);
	}

	.field__help [lang='ar'] {
		font-size: 0.98rem;
		line-height: 1.8;
	}

	.field__input {
		width: 100%;
		min-width: 0;
		padding: 0.6rem 0.15rem;
		border: 0;
		border-bottom: 1px solid rgba(163, 171, 189, 0.34);
		border-radius: 0;
		background: transparent;
		color: var(--print);
		/* Archivo has no Arabic, so anything typed in Arabic falls through to
		   Tajawal on its own. */
		font-family: 'Archivo', 'Tajawal', 'Helvetica Neue', Arial, sans-serif;
		font-variation-settings: 'wdth' 100;
		font-size: 1rem;
		line-height: 1.6;
		transition:
			border-color 0.25s,
			background-color 0.25s;
	}

	.field__input::placeholder {
		color: rgba(163, 171, 189, 0.5);
	}

	.field__input:hover {
		border-bottom-color: rgba(163, 171, 189, 0.6);
	}

	.field__input:focus {
		outline: none;
		border-bottom-color: var(--key);
		background: rgba(255, 194, 122, 0.05);
	}

	.field__input:focus-visible {
		outline: 2px solid var(--key);
		outline-offset: 3px;
	}

	.field__input--area {
		resize: vertical;
		padding: 0.6rem 0.7rem;
		border: 1px solid rgba(163, 171, 189, 0.34);
	}

	.field__input--area:focus {
		border-color: var(--key);
	}

	/* Only after the reader has had a go at the field, never on first paint. */
	.field__input:user-invalid {
		border-bottom-color: rgba(255, 140, 66, 0.75);
	}

	/* ── Ticks: the boxes a loader fills in ────────────────────────────── */

	.ticks {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 1.1rem;
	}

	.tick {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		cursor: pointer;
	}

	.tick input {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
	}

	.tick__box {
		flex: none;
		width: 0.95rem;
		height: 0.95rem;
		border: 1px solid rgba(163, 171, 189, 0.5);
		border-radius: 999px;
		background: transparent;
		transition:
			background-color 0.2s,
			border-color 0.2s,
			box-shadow 0.2s;
	}

	.tick__box--square {
		border-radius: 0;
	}

	.tick:hover .tick__box {
		border-color: var(--key);
	}

	.tick input:checked + .tick__box {
		background: var(--key);
		border-color: var(--key);
		box-shadow: inset 0 0 0 2px var(--crush);
	}

	.tick input:focus-visible + .tick__box {
		outline: 2px solid var(--key);
		outline-offset: 3px;
	}

	.tick__text {
		font-family: var(--credit);
		font-size: 0.9rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--print);
	}

	.tick__text [lang='ar'] {
		font-family: 'Tajawal', sans-serif;
		font-size: 1rem;
	}

	.sheetform__note {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.6;
		color: rgba(163, 171, 189, 0.8);
		border-inline-start: 2px solid rgba(255, 194, 122, 0.4);
		padding-inline-start: 0.85rem;
	}

	.sheetform__note [lang='ar'] {
		font-size: 1.02rem;
		line-height: 1.9;
	}

	.sheetform__go {
		justify-self: start;
	}

	.sheetform__go [lang='ar'] {
		font-family: 'Tajawal', sans-serif;
		letter-spacing: 0;
		font-size: 0.95rem;
	}

	/* ── The confirmation, chalked when the draft opens ────────────────── */

	.sent {
		display: none;
		margin: 0;
		gap: 0.6rem;
		padding: 0.85rem 1rem;
		border: 1px solid var(--key);
		background: rgba(255, 194, 122, 0.09);
		font-size: 0.98rem;
		line-height: 1.6;
		color: var(--print);
	}

	.sent [lang='ar'] {
		font-size: 1.06rem;
		line-height: 1.9;
	}

	.sent__mark {
		flex: none;
		color: var(--key);
		font-weight: 700;
	}

	form[data-sent] .sent {
		display: flex;
		align-items: flex-start;
	}

	@media (min-width: 34rem) {
		.field--split {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (min-width: 62rem) {
		.booking {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
			gap: 4rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.field__input,
		.tick__box {
			transition: none;
		}
	}
</style>
