---
import { Image } from 'astro:assets';
import profile from '../assets/images/profile.png';
import { featured, rest } from '../data/projects';
import { href, toolbox, useT, type Lang } from '../i18n';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);

/* The grid is deliberately uneven: a wide one, then a pair, then a wide one.
   Nothing here is a uniform three-up card wall. */
const spans = [12, 7, 5, 12, 5, 7, 7, 5];
---

<Hero lang={lang} />

<section class="section" id="work">
	<div class="wrap">
		<header class="head reveal-fast">
			<p class="mono eyebrow">{t('work.eyebrow')}</p>
			<h2 class="head__title">{t('work.title')}</h2>
			<p class="lede">{t('work.lede')}</p>
		</header>

		<div class="grid">
			{
				featured.map((p, i) => (
					<ProjectCard
						project={p}
						lang={lang}
						span={spans[i] ?? 6}
						loading={i === 0 ? 'eager' : 'lazy'}
					/>
				))
			}
		</div>
	</div>

	<div class="wrap">
		<details class="more reveal-fast">
			<summary class="mono more__btn">
				<span
					class="more__label"
					data-more={t('work.more')}
					data-less={t('work.less')}></span>
				<span class="arrow more__arrow" aria-hidden="true">→</span>
			</summary>

			<header class="head more__head">
				<p class="mono eyebrow">{t('work.archive')}</p>
				<p class="lede">{t('work.archiveLede')}</p>
			</header>

			<div class="grid">
				{rest.map((p) => <ProjectCard project={p} lang={lang} />)}
			</div>
		</details>
	</div>
</section>

<section class="section" id="about">
	<div class="wrap">
		<div class="about">
			<header class="head reveal-fast about__head">
				<p class="mono eyebrow">{t('about.eyebrow')}</p>
				<h2 class="head__title">{t('about.title')}</h2>
			</header>

			<figure class="portrait reveal-fast">
				<Image
					src={profile}
					alt={t('name.latin')}
					widths={[280, 560]}
					sizes="(min-width: 60rem) 18rem, 12rem"
				/>
			</figure>

			<div class="prose reveal-fast">
				<p>{t('about.p1')}</p>
				<p>{t('about.p2')}</p>
				<p>{t('about.p3')}</p>
			</div>
		</div>
	</div>

	<div class="toolbox reveal-fast">
		<div class="wrap toolbox__head">
			<p class="mono eyebrow">{t('about.stackTitle')}</p>
			<p class="toolbox__lede">{t('about.stackLede')}</p>
		</div>

		<div class="ticker" aria-hidden="true">
			<div class="ticker__track">
				{
					[0, 1].map(() => (
						<ul class="ticker__list mono">
							{toolbox.map((item) => (
								<li>
									{item}
									<span class="ticker__dot">·</span>
								</li>
							))}
						</ul>
					))
				}
			</div>
		</div>

		<ul class="sr-list">{toolbox.map((item) => <li>{item}</li>)}</ul>
	</div>

	<div class="wrap">
		<div class="closer reveal-fast">
			<p class="closer__text">{t('hire.lede')}</p>
			<a class="btn" href={href(lang, 'hire')}
				>{t('nav.hire')}<span class="arrow">→</span></a
			>
		</div>
	</div>
</section>

<style>
	.head {
		display: grid;
		gap: 1rem;
		max-width: 46rem;
		margin-block-end: clamp(2.5rem, 6vw, 4.5rem);
	}

	.head__title {
		font-size: var(--step-3);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		gap: clamp(2.5rem, 5vw, 4.5rem) clamp(1.5rem, 3vw, 2.5rem);
	}

	/* ---- show more ---- */
	/* <details> does the toggling; no JS, no state, no hydration. */

	.more {
		margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
	}

	.more__btn {
		display: inline-flex;
		align-items: center;
		gap: 0.7ch;
		cursor: pointer;
		list-style: none;
		color: var(--muted);
		padding: 0.8rem 1.4rem;
		border: 1px solid var(--rule);
		border-radius: 999px;
		transition:
			color 0.3s,
			border-color 0.3s;
	}

	.more__btn::-webkit-details-marker {
		display: none;
	}

	.more__btn:hover,
	.more__btn:focus-visible {
		color: var(--bone);
		border-color: var(--rule-strong);
	}

	.more__label::after {
		content: attr(data-more);
	}

	.more[open] .more__label::after {
		content: attr(data-less);
	}

	.more__arrow {
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.more[open] .more__arrow {
		transform: rotate(90deg);
	}

	.more__head {
		margin-block: clamp(2rem, 5vw, 3rem);
	}

	/* ---- about ---- */

	/* the grid gap spaces this one; the section-level head margin would double it */
	.about__head {
		margin-block-end: 0;
	}

	.about {
		display: grid;
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: start;
	}

	@media (min-width: 60rem) {
		.about {
			grid-template-columns: 1fr 18rem;
			/* the portrait spans both rows; without this it stretches row 1 */
			grid-template-rows: auto 1fr;
		}
		.about__head,
		.prose {
			grid-column: 1;
		}
		.portrait {
			grid-column: 2;
			grid-row: 1 / span 2;
		}
	}

	.portrait {
		margin: 0;
		max-inline-size: 12rem;
		border-radius: 0.9rem;
		overflow: hidden;
		border: 1px solid var(--rule-strong);
		/* the seam again, at portrait scale */
		box-shadow: -6px 6px 0 0 var(--signal);
	}

	:global([dir='rtl']) .portrait {
		box-shadow: 6px 6px 0 0 var(--signal);
	}

	@media (min-width: 60rem) {
		.portrait {
			max-inline-size: none;
		}
	}

	.prose {
		display: grid;
		gap: 1.2rem;
		max-width: var(--measure);
		font-size: var(--step-0);
		color: color-mix(in oklab, var(--bone) 88%, var(--muted));
	}

	/* ---- toolbox ticker ---- */

	.toolbox {
		margin-block: clamp(3rem, 7vw, 5.5rem);
		border-block: 1px solid var(--rule);
		padding-block: 1.75rem;
	}

	.toolbox__head {
		display: grid;
		gap: 0.4rem;
		margin-block-end: 1.5rem;
	}

	.toolbox__lede {
		color: var(--muted);
		font-size: var(--step--1);
	}

	.ticker {
		overflow: hidden;
		mask-image: linear-gradient(
			90deg,
			transparent,
			black 8%,
			black 92%,
			transparent
		);
	}

	.ticker__track {
		display: flex;
		inline-size: max-content;
	}

	@media (prefers-reduced-motion: no-preference) {
		.ticker__track {
			animation: ticker 42s linear infinite;
		}
	}

	@keyframes ticker {
		to {
			transform: translateX(-50%);
		}
	}

	:global([dir='rtl']) .ticker__track {
		animation-name: ticker-rtl;
	}

	/* ponytail: RTL lays the second copy to the left, so it scrolls the other way */
	@keyframes ticker-rtl {
		to {
			transform: translateX(50%);
		}
	}

	.ticker__list {
		display: flex;
		gap: 1.5rem;
		list-style: none;
		margin: 0;
		padding-inline: 0.75rem;
		font-size: clamp(1rem, 2.5vw, 1.6rem);
		text-transform: none;
		letter-spacing: -0.01em;
		color: var(--muted);
		white-space: nowrap;
	}

	.ticker__list li {
		display: flex;
		gap: 1.5rem;
	}

	.ticker__dot {
		color: var(--signal);
	}

	.sr-list {
		position: absolute;
		inline-size: 1px;
		block-size: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* ---- closer ---- */

	.closer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.5rem 2.5rem;
		justify-content: space-between;
		padding: clamp(1.5rem, 4vw, 2.5rem);
		border: 1px solid var(--rule);
		border-radius: 1rem;
		background: var(--ink-2);
	}

	.closer__text {
		max-width: 46ch;
		color: var(--muted);
	}
</style>
