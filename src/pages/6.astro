---
import { Image } from 'astro:assets';
import { profile } from '../../content/profile';
import { featured, projects } from '../data/projects';
import { toolbox } from '../i18n';
import StyleSwitcher from '../components/StyleSwitcher.astro';
import profilePhoto from '../assets/images/profile.png';

/* The bento is a tray, not a wall: every tile has its own job, its own
   material and its own internal composition. Sizes are assigned here, once,
   so the grid reads as a composition rather than a loop. */
const bySlug = (slug: string) => featured.find((p) => p.slug === slug)!;

const work = [
	{ p: bySlug('aoun'), w: 'w6', h: 'h3', shape: 'wide', tone: 'bone' },
	{ p: bySlug('malabji'), w: 'w3', h: 'h3', shape: 'tall', tone: 'bone' },
	{ p: bySlug('naqi'), w: 'w3', h: 'h3', shape: 'tall', tone: 'ink' },
	{
		p: bySlug('kashaf-alkulify'),
		w: 'w5',
		h: 'h3',
		shape: 'wide',
		tone: 'bone',
	},
	{ p: bySlug('pastehtml'), w: 'w3', h: 'h3', shape: 'tall', tone: 'bone' },
	{ p: bySlug('majalis'), w: 'w4', h: 'h3', shape: 'tall', tone: 'bone' },
	{ p: bySlug('eecommittee'), w: 'w3', h: 'h3', shape: 'tall', tone: 'bone' },
	{ p: bySlug('rooh-al-jouf'), w: 'w5', h: 'h3', shape: 'wide', tone: 'bone' },
];

const category: Record<string, string> = {
	web: 'Web',
	mobile: 'Mobile',
	desktop: 'Desktop',
	extension: 'Extension',
	ai: 'On-device AI',
	client: 'Client',
};

const status: Record<string, string> = {
	live: 'Live',
	shipped: 'On the stores',
	delisted: 'Delisted',
	wip: 'In progress',
	archived: 'Archived',
};

/* The archive tile names real projects and links to their write-ups. */
const archive = projects
	.filter((p) => !p.featured)
	.slice(0, 10)
	.map((p) => ({ slug: p.slug, title: p.title.en }));

const restCount = projects.length - featured.length;

/* 39 shipped, 13 of them on the App Store or Google Play. The matrix draws
   exactly that, one square per project. */
const shipped = 39;
const onStores = 13;
const squares = Array.from({ length: shipped }, (_, i) => i < onStores);

/* Rendered at build time so the tile is never blank; the clock in the page
   corrects it to the reader's own second. */
const ammanTime = new Intl.DateTimeFormat('en-GB', {
	timeZone: 'Asia/Amman',
	hour: '2-digit',
	minute: '2-digit',
}).format(new Date());
const nowISO = new Date().toISOString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Haitham Assoli — two scripts, two directions, one build</title>
		<meta
			name="description"
			content="Haitham Assoli builds Arabic-first web and mobile products from Amman: React Native on both app stores, Next.js and Astro on the web, and AI that runs on the phone."
		/>
		<meta name="color-scheme" content="light" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400;12..96,75..100,600;12..96,75..100,800&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Arabic:wght@400;500;600&display=swap"
		/>
	</head>

	<body>
		<div class="tray">
			<header class="topbar">
				<p class="topbar__name">
					Haitham Assoli <span class="topbar__ar" lang="ar" dir="rtl"
						>هيثم العسولي</span
					>
				</p>
				<p class="mono topbar__meta">
					Amman · UTC+3 · <a class="ilink" href="#hire">open to work</a>
				</p>
			</header>

			<main>
				<!-- ===================== BOARD ONE: THE POINT ===================== -->
				<section class="board board--hero" aria-label="Introduction">
					<!-- thesis -->
					<article class="tile tile--bone w8 h3 thesis" style="--i: 0">
						<p class="mono lbl">The point</p>
						<h1 class="thesis__h">
							A mirrored interface is <em>a different interface</em>, not a
							translation. I build both halves.
						</h1>
						<p class="thesis__sub">
							Four years of Arabic-first products out of Amman: React Native and
							Expo on both app stores, Next.js and Astro on the web, NestJS,
							Convex and Supabase underneath. Thirty-nine of them shipped.
						</p>
						<p class="mono thesis__tags">
							<span>Web</span><span>Mobile</span><span>On-device AI</span><span
								>RTL</span
							>
						</p>
					</article>

					<!-- portrait -->
					<article class="tile tile--cobalt w4 h3 who" style="--i: 1">
						<div class="who__photo">
							<Image
								src={profilePhoto}
								alt="Haitham Assoli"
								widths={[240, 480]}
								sizes="(min-width: 64rem) 15rem, 40vw"
								loading="eager"
							/>
						</div>
						<div class="who__plate">
							<p class="mono lbl lbl--on-dark">Who</p>
							<p class="who__name">Haitham Assoli</p>
							<p class="who__role">{profile.title.en}</p>
						</div>
					</article>

					<!-- signature: the mirror -->
					<article class="tile tile--bone w5 h4 mirror" style="--i: 2">
						<div class="mirror__head">
							<p class="mono lbl">Try it</p>
							<div class="mtoggle" role="group" aria-label="Interface language">
								<button
									type="button"
									class="mtoggle__btn is-on"
									data-set-lang="en"
									aria-pressed="true">EN · LTR</button
								>
								<button
									type="button"
									class="mtoggle__btn"
									data-set-lang="ar"
									lang="ar"
									aria-pressed="false">ع · RTL</button
								>
							</div>
						</div>

						<div class="mcard" id="mcard" dir="ltr" lang="en">
							<div class="mcard__bar">
								<span class="mcard__back" aria-hidden="true">
									<svg viewBox="0 0 24 24" width="16" height="16" fill="none"
										><path
											d="M15 5 8 12l7 7"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"></path></svg
									>
								</span>
								<span class="mcard__title"
									><span class="en">Book a pitch</span><span class="ar"
										>احجز ملعبًا</span
									></span
								>
								<span class="mcard__dots" aria-hidden="true"></span>
							</div>

							<div class="mcard__pitch" aria-hidden="true">
								<span class="mcard__badge">
									<span class="en">5-a-side</span><span class="ar">خماسي</span>
								</span>
								<span class="mcard__crew">
									<span class="mcard__face">HA</span>
									<span class="mcard__face">M</span>
									<span class="mcard__face">Z</span>
									<span class="mcard__face"
										><span class="en">+3</span><span class="ar">٣+</span></span
									>
								</span>
							</div>

							<div class="mcard__body">
								<p class="mcard__venue">
									<span class="en">Al-Hussein Pitch, Amman</span><span
										class="ar">ملعب الحسين، عمّان</span
									>
								</p>
								<p class="mcard__slot mono">
									<span class="en">Today 18:00 – 19:00</span><span class="ar"
										>اليوم ٦:٠٠ – ٧:٠٠ م</span
									>
								</p>

								<div class="mcard__row">
									<span class="mcard__players">
										<span class="en">6 of 10 players in</span><span class="ar"
											>٦ من ١٠ لاعبين</span
										>
									</span>
									<span class="mcard__price mono">
										<span class="en">12 JOD</span><span class="ar"
											>١٢ دينارًا</span
										>
									</span>
								</div>

								<div class="mcard__bar-track" aria-hidden="true">
									<i></i>
								</div>

								<span class="mcard__cta">
									<span class="en">Book the slot</span><span class="ar"
										>احجز الموعد</span
									>
									<span class="mcard__arrow" aria-hidden="true">
										<svg viewBox="0 0 24 24" width="15" height="15" fill="none"
											><path
												d="M5 12h13m-5-6 6 6-6 6"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"></path></svg
										>
									</span>
								</span>
							</div>
						</div>

						<p class="mirror__note">
							Nothing was translated by this button. The row order reverses, the
							chevron points the other way, the progress fills from the other
							edge, the numerals change system. That is the work.
						</p>
					</article>

					<!-- ledger -->
					<article class="tile tile--ink w4 h2 ledger" style="--i: 3">
						<p class="mono lbl lbl--on-dark">Ledger</p>
						<div class="matrix" aria-hidden="true">
							{
								squares.map((filled) => (
									<span class:list={['matrix__cell', filled && 'is-on']} />
								))
							}
						</div>
						<dl class="ledger__list">
							<div><dt>39</dt><dd>shipped</dd></div>
							<div><dt>13</dt><dd>on the stores</dd></div>
							<div><dt>8</dt><dd>written up</dd></div>
							<div><dt>~4</dt><dd>years</dd></div>
						</dl>
					</article>

					<!-- amman -->
					<article class="tile tile--marigold w3 h2 amman" style="--i: 4">
						<p class="mono lbl">Amman</p>
						<svg
							class="amman__map"
							viewBox="0 0 140 96"
							role="img"
							aria-label="Contour sketch of the hills Amman is built on"
						>
							<g class="amman__rings">
								<ellipse cx="44" cy="34" rx="34" ry="22"></ellipse>
								<ellipse cx="44" cy="34" rx="24" ry="15"></ellipse>
								<ellipse cx="44" cy="34" rx="14" ry="9"></ellipse>
								<ellipse cx="98" cy="62" rx="38" ry="24"></ellipse>
								<ellipse cx="98" cy="62" rx="27" ry="17"></ellipse>
								<ellipse cx="98" cy="62" rx="16" ry="10"></ellipse>
								<ellipse cx="18" cy="80" rx="26" ry="15"></ellipse>
							</g>
							<path
								class="amman__road"
								d="M0 58 C34 44 58 70 88 52 116 36 140 44 140 44"></path>
							<g class="amman__pin">
								<circle class="amman__pulse" cx="71" cy="49" r="9"></circle>
								<circle cx="71" cy="49" r="3.4"></circle>
							</g>
						</svg>
						<p class="amman__clock mono">
							<time id="clock" datetime={nowISO}>{ammanTime}</time>
							<span>31.95° N, 35.93° E</span>
						</p>
					</article>

					<!-- on-device -->
					<a
						class="tile tile--ink w7 h2 device"
						href="/work/naqi"
						style="--i: 5; --accent: #C6A02C"
					>
						<div class="device__phone" aria-hidden="true">
							<div class="device__screen">
								<span class="device__blur"></span>
								<span class="device__scan"></span>
								<span class="device__wave">
									{
										[9, 17, 28, 14, 22, 33, 19, 11, 25, 15, 30, 12].map((h) => (
											<i style={`--h:${h}px`} />
										))
									}
								</span>
							</div>
						</div>
						<div class="device__copy">
							<p class="mono lbl lbl--on-dark">On-device</p>
							<h2 class="device__h">The model runs on the phone.</h2>
							<p class="device__p">
								Naqi pulls the music out of a video and blurs what it must —
								separation and detection, both local. No upload, no account, no
								telemetry, and the original file is never touched.
							</p>
							<p class="mono device__go">Read the write-up →</p>
						</div>
					</a>
				</section>

				<!-- ===================== BOARD TWO: THE WORK ===================== -->
				<section class="board board--work" aria-labelledby="work-h">
					<div class="board__head">
						<h2 class="board__h" id="work-h">Eight I would show first</h2>
						<p class="board__lede">
							Each one shipped, each one still standing. Full write-ups behind
							every tile.
						</p>
					</div>

					{
						work.map(({ p, w, h, shape, tone }, i) => (
							<a
								class:list={[
									'tile',
									tone === 'ink' ? 'tile--ink' : 'tile--bone',
									w,
									h,
									'work',
									`work--${shape}`,
								]}
								href={`/work/${p.slug}`}
								style={`--i:${i + 6}; --accent:${p.accent}`}
							>
								<span class="work__shot">
									{p.image ? (
										<Image
											src={p.image}
											alt=""
											widths={[320, 640]}
											sizes="(min-width: 64rem) 22rem, 60vw"
											loading="lazy"
										/>
									) : (
										<span class="work__noshot mono">{p.title.en}</span>
									)}
								</span>
								<span class="work__meta">
									<span class="mono work__top">
										<span class="work__year">{p.year}</span>
										<span class="work__cat">{category[p.category]}</span>
									</span>
									<span class="work__title">{p.title.en}</span>
									<span class="work__line">{p.tagline.en}</span>
									<span class="mono work__foot">
										<span class="work__status">{status[p.status]}</span>
										<span class="work__stack">
											{p.stack.slice(0, 3).join(' · ')}
										</span>
									</span>
								</span>
							</a>
						))
					}

					<article class="tile tile--cobalt w4 h3 archive" style="--i: 14">
						<p class="mono lbl lbl--on-dark">The rest</p>
						<p class="archive__count">
							{restCount} more, from municipal apps to a five-platform desktop build.
						</p>
						<ul class="archive__list mono">
							{
								archive.map((a) => (
									<li>
										<a href={`/work/${a.slug}`}>{a.title}</a>
									</li>
								))
							}
						</ul>
					</article>
				</section>

				<!-- ===================== BOARD THREE: THE PERSON ===================== -->
				<section class="board board--about" aria-labelledby="about-h">
					<article class="tile tile--bone w7 h2 about" style="--i: 15">
						<p class="mono lbl">Working method</p>
						<h2 class="about__h" id="about-h">
							The interesting part is never the framework.
						</h2>
						<p>
							I build products end to end, from the data model to the last
							pixel, and most of them read right to left first, because most of
							the people using them read Arabic.
						</p>
						<p>
							What I look for is a constraint that is actually real: a model
							that has to fit on the device instead of a server, a search index
							that has to answer in milliseconds with no backend, a booking flow
							that can never sell the same hour twice.
						</p>
					</article>

					<article class="tile tile--bone w5 h2 record" style="--i: 16">
						<p class="mono lbl">Record</p>
						<ol class="record__list">
							{
								profile.experience.slice(0, 5).map((job) => (
									<li>
										<span class="mono record__when">{job.period}</span>
										<span class="record__what">
											{job.role.en}, <b>{job.company.en}</b>
										</span>
									</li>
								))
							}
						</ol>
						<p class="record__edu mono">
							BSc Computer Science, Irbid National University — excellent.
						</p>
					</article>

					<article class="tile tile--ink w12 h1 stack" style="--i: 17">
						<p class="mono lbl lbl--on-dark stack__lbl">Toolbox</p>
						<div class="ticker" aria-hidden="true">
							<div class="ticker__track">
								{
									[0, 1].map(() => (
										<ul class="ticker__list mono">
											{toolbox.map((item) => (
												<li>
													{item}
													<span class="ticker__dot">/</span>
												</li>
											))}
										</ul>
									))
								}
							</div>
						</div>
						<ul class="sr-only">{toolbox.map((item) => <li>{item}</li>)}</ul>
					</article>

					<article
						class="tile tile--marigold w8 h2 hire"
						id="hire"
						style="--i: 18"
					>
						<p class="mono lbl">Hire</p>
						<h2 class="hire__h">Tell me what you are shipping.</h2>
						<p class="hire__p">
							Contract or full-time, web or mobile, English or Arabic first.
							Fastest way in is email.
						</p>
						<a class="hire__mail" href={`mailto:${profile.email}`}
							>{profile.email}</a
						>
						<a class="mono hire__tel" href="tel:+962776193666"
							>{profile.phone}</a
						>
					</article>

					<article class="tile tile--ink w4 h2 links" style="--i: 19">
						<p class="mono lbl lbl--on-dark">Elsewhere</p>
						<ul class="links__list">
							<li><a href={profile.links.github}>GitHub</a></li>
							<li><a href={profile.links.linkedin}>LinkedIn</a></li>
							<li><a href={profile.links.resume}>CV</a></li>
							<li><a href={profile.links.playStore}>Google Play</a></li>
							<li><a href={profile.links.website}>assoli.site</a></li>
						</ul>
					</article>
				</section>
			</main>

			<footer class="foot">
				<p class="mono">
					Haitham Assoli — Amman, Jordan. Built in two directions.
				</p>
				<p class="mono foot__ar" lang="ar" dir="rtl">
					هيثم العسولي — عمّان، الأردن.
				</p>
			</footer>
		</div>

		<script is:inline>
			document.documentElement.classList.add('js');

			/* Cursor-tracked highlight: one listener for the whole tray. */
			const tray = document.querySelector('.tray');
			tray.addEventListener('pointermove', (e) => {
				const tile = e.target.closest('.tile');
				if (!tile) return;
				const r = tile.getBoundingClientRect();
				tile.style.setProperty('--mx', `${e.clientX - r.left}px`);
				tile.style.setProperty('--my', `${e.clientY - r.top}px`);
			});

			/* The mirror. Direction is a property of the card, not of the words. */
			const card = document.getElementById('mcard');
			const buttons = document.querySelectorAll('[data-set-lang]');
			buttons.forEach((btn) => {
				btn.addEventListener('click', () => {
					const lang = btn.dataset.setLang;
					card.setAttribute('lang', lang);
					card.setAttribute('dir', lang === 'ar' ? 'rtl' : 'ltr');
					card.classList.remove('is-flipping');
					void card.offsetWidth;
					card.classList.add('is-flipping');
					buttons.forEach((b) => {
						const on = b === btn;
						b.classList.toggle('is-on', on);
						b.setAttribute('aria-pressed', String(on));
					});
				});
			});

			/* Amman on the clock, corrected on load and kept honest each minute. */
			const clock = document.getElementById('clock');
			const fmt = new Intl.DateTimeFormat('en-GB', {
				timeZone: 'Asia/Amman',
				hour: '2-digit',
				minute: '2-digit',
			});
			const tick = () => {
				const now = new Date();
				clock.textContent = fmt.format(now);
				clock.setAttribute('datetime', now.toISOString());
			};
			tick();
			setInterval(tick, 20000);

			/* Boards settle in as they arrive. */
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				const io = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('is-in');
							io.unobserve(entry.target);
						});
					},
					{ rootMargin: '0px 0px -8% 0px' },
				);
				document.querySelectorAll('.board').forEach((b) => io.observe(b));
			}
			/* Whatever happens, nothing stays hidden. */
			const revealAll = () =>
				document
					.querySelectorAll('.board')
					.forEach((b) => b.classList.add('is-in'));
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) revealAll();
			else setTimeout(revealAll, 2000);
			document.addEventListener('visibilitychange', revealAll);
		</script>

		<StyleSwitcher n={6} />
	</body>
</html>

<style is:global>
	/* ============================================================
	   #6 BENTO — a clay tray of compartments, not nine grey cards.
	   Materials: bone paper, warm ink, ceramic cobalt, marigold.
	   ============================================================ */

	:root {
		--tray: #cdb79b;
		--tray-deep: #b79b7b;
		--bone: #fbf6ec;
		--ink: #1e1713;
		--cobalt: #17457f;
		--marigold: #e9a426;
		--pomegranate: #b8402f;

		--rule: rgba(30, 23, 19, 0.14);
		--row: 7.5rem;
		--gap: 0.7rem;
		--pad: clamp(1rem, 2vw, 1.5rem);
		--radius: 20px;

		--sans:
			'IBM Plex Sans Arabic', ui-sans-serif, system-ui, 'Segoe UI', sans-serif;
		--display: 'Bricolage Grotesque', var(--sans);
		--mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		-webkit-text-size-adjust: 100%;
	}

	body {
		margin: 0;
		background-color: var(--tray);
		background-image:
			radial-gradient(
				120% 80% at 12% 0%,
				rgba(255, 246, 232, 0.5),
				rgba(255, 246, 232, 0) 60%
			),
			radial-gradient(
				90% 60% at 95% 100%,
				rgba(23, 69, 127, 0.16),
				rgba(23, 69, 127, 0) 55%
			),
			repeating-linear-gradient(
				117deg,
				rgba(30, 23, 19, 0.035) 0 1px,
				rgba(30, 23, 19, 0) 1px 4px
			);
		color: var(--ink);
		font-family: var(--sans);
		font-size: clamp(0.95rem, 0.9rem + 0.2vw, 1.02rem);
		line-height: 1.55;
		overflow-x: hidden;
	}

	img,
	svg {
		display: block;
		max-width: 100%;
	}

	p {
		margin: 0;
	}

	a {
		color: inherit;
	}

	:focus-visible {
		outline: 3px solid var(--focus, var(--ink));
		outline-offset: 3px;
		border-radius: 6px;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0 0 0 0);
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}

	.mono {
		font-family: var(--mono);
		font-weight: 400;
	}

	.tray {
		max-width: 84rem;
		margin: 0 auto;
		padding: clamp(0.75rem, 2vw, 1.5rem) clamp(0.6rem, 2vw, 1.5rem) 7.5rem;
	}

	/* ---------------- top bar ---------------- */

	.topbar {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		padding: 0.35rem 0.6rem 0.9rem;
	}

	.topbar__name {
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.05rem;
		letter-spacing: -0.02em;
	}

	.topbar__ar {
		font-weight: 500;
		opacity: 0.55;
		margin-inline-start: 0.4rem;
	}

	.topbar__meta {
		font-size: 0.76rem;
		letter-spacing: 0.02em;
		color: rgba(30, 23, 19, 0.72);
	}

	.ilink {
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.ilink:hover {
		color: var(--pomegranate);
	}

	/* ---------------- the grid ---------------- */

	.board {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		grid-auto-rows: minmax(var(--row), auto);
		gap: var(--gap);
		margin-bottom: calc(var(--gap) * 3);
	}

	.board--work {
		--row: 7rem;
		/* the heading row is its own height; the tiles start on the next one */
		grid-template-rows: auto;
	}

	.board--about {
		--row: 7.75rem;
	}

	.board__head {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.3rem 1rem;
		padding: 0.9rem 0.6rem 0.1rem;
	}

	.board__h {
		margin: 0;
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.2rem);
		letter-spacing: -0.035em;
		line-height: 1;
	}

	.board__lede {
		font-size: 0.86rem;
		color: rgba(30, 23, 19, 0.7);
		max-width: 34ch;
	}

	.w3 {
		grid-column: span 3;
	}
	.w4 {
		grid-column: span 4;
	}
	.w5 {
		grid-column: span 5;
	}
	.w6 {
		grid-column: span 6;
	}
	.w7 {
		grid-column: span 7;
	}
	.w8 {
		grid-column: span 8;
	}
	.w12 {
		grid-column: span 12;
	}

	.h1 {
		grid-row: span 1;
	}
	.h2 {
		grid-row: span 2;
	}
	.h3 {
		grid-row: span 3;
	}
	.h4 {
		grid-row: span 4;
	}

	/* ---------------- the tile itself ---------------- */

	.tile {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		min-width: 0;
		padding: var(--pad);
		border-radius: var(--radius);
		background: var(--bone);
		box-shadow:
			inset 0 0 0 1px rgba(30, 23, 19, 0.09),
			0 1px 0 rgba(255, 250, 240, 0.4),
			0 12px 22px -18px rgba(30, 23, 19, 0.9);
		isolation: isolate;
		overflow: hidden;
	}

	.tile::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 3;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.25s ease;
		background: radial-gradient(
			14rem 14rem at var(--mx, 50%) var(--my, 50%),
			color-mix(in srgb, var(--accent, #ffffff) 34%, transparent),
			transparent 72%
		);
		mix-blend-mode: soft-light;
	}

	.tile:hover::before,
	.tile:focus-visible::before {
		opacity: 1;
	}

	.tile--ink {
		background: var(--ink);
		color: var(--bone);
		--focus: var(--marigold);
		box-shadow:
			inset 0 0 0 1px rgba(255, 246, 232, 0.1),
			0 14px 26px -18px rgba(30, 23, 19, 1);
	}

	.tile--cobalt {
		background: var(--cobalt);
		color: #eef4fb;
		--focus: var(--marigold);
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.14),
			0 14px 26px -18px rgba(11, 33, 61, 1);
	}

	.tile--marigold {
		background: var(--marigold);
		color: #2a1c06;
		--focus: var(--ink);
		box-shadow:
			inset 0 0 0 1px rgba(42, 28, 6, 0.18),
			0 14px 26px -18px rgba(120, 82, 12, 0.9);
	}

	a.tile {
		text-decoration: none;
		transition:
			transform 0.22s cubic-bezier(0.2, 0.7, 0.3, 1),
			box-shadow 0.22s ease;
	}

	a.tile:hover {
		transform: translateY(-3px);
	}

	a.tile::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 4;
		border-radius: inherit;
		pointer-events: none;
		box-shadow: inset 0 0 0 2px var(--accent, transparent);
		opacity: 0;
		transition: opacity 0.22s ease;
	}

	a.tile:hover::after,
	a.tile:focus-visible::after {
		opacity: 1;
	}

	.lbl {
		font-size: 0.63rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: rgba(30, 23, 19, 0.5);
	}

	.lbl--on-dark {
		color: rgba(251, 246, 236, 0.55);
	}

	.tile--marigold .lbl {
		color: rgba(42, 28, 6, 0.6);
	}

	/* ---------------- thesis ---------------- */

	.thesis {
		justify-content: space-between;
		background:
			radial-gradient(
				120% 130% at 100% 0%,
				rgba(233, 164, 38, 0.22),
				rgba(233, 164, 38, 0) 58%
			),
			var(--bone);
	}

	.thesis__h {
		margin: 0.2rem 0 0;
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(1.75rem, 1.05rem + 2.9vw, 3.35rem);
		line-height: 0.98;
		letter-spacing: -0.045em;
		text-wrap: balance;
	}

	/* Inline, not inline-block: the highlight has to be able to break across
	   lines at 380px like any other run of text. */
	.thesis__h em {
		font-style: normal;
		padding: 0 0.16em;
		background: var(--ink);
		color: var(--bone);
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
	}

	.thesis__sub {
		max-width: 46ch;
		font-size: clamp(0.9rem, 0.85rem + 0.25vw, 1.02rem);
		color: rgba(30, 23, 19, 0.78);
	}

	.thesis__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.thesis__tags span {
		padding: 0.22rem 0.55rem;
		border: 1px solid var(--rule);
		border-radius: 999px;
	}

	/* ---------------- who ---------------- */

	.who {
		padding: 0;
		justify-content: flex-end;
	}

	/* No z-index here: a stacking context would trap the blend and the
	   photo would never take the cobalt underneath it. */
	.who__photo {
		position: absolute;
		inset: 0;
	}

	.who__photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 22%;
		filter: grayscale(1) contrast(1.15);
		mix-blend-mode: multiply;
	}

	.who::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(
			to top,
			rgba(9, 27, 51, 0.95) 12%,
			rgba(9, 27, 51, 0.1) 62%
		);
	}

	.who__plate {
		position: relative;
		z-index: 2;
		padding: var(--pad);
	}

	.who__name {
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(1.3rem, 1rem + 1vw, 1.75rem);
		letter-spacing: -0.035em;
		line-height: 1.05;
		margin-top: 0.25rem;
	}

	.who__role {
		font-size: 0.82rem;
		color: rgba(238, 244, 251, 0.78);
	}

	/* ---------------- the mirror (signature) ---------------- */

	.mirror {
		gap: 0.7rem;
		background:
			linear-gradient(90deg, rgba(23, 69, 127, 0.07), rgba(233, 164, 38, 0.1)),
			var(--bone);
	}

	.mirror__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
	}

	.mtoggle {
		display: flex;
		padding: 3px;
		border-radius: 999px;
		background: rgba(30, 23, 19, 0.1);
	}

	.mtoggle__btn {
		appearance: none;
		border: 0;
		cursor: pointer;
		border-radius: 999px;
		padding: 0.28rem 0.65rem;
		background: transparent;
		color: rgba(30, 23, 19, 0.78);
		font-family: var(--mono);
		font-size: 0.68rem;
		letter-spacing: 0.06em;
		transition:
			background 0.2s ease,
			color 0.2s ease;
	}

	.mtoggle__btn:hover {
		color: var(--ink);
	}

	.mtoggle__btn.is-on {
		background: var(--ink);
		color: var(--bone);
	}

	.mcard {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 0.7rem;
		padding: 0.85rem;
		border-radius: 14px;
		background: #fff;
		box-shadow:
			inset 0 0 0 1px rgba(30, 23, 19, 0.1),
			0 10px 20px -16px rgba(30, 23, 19, 0.8);
		font-size: 0.86rem;
	}

	.mcard .ar {
		display: none;
	}

	.mcard[lang='ar'] .en {
		display: none;
	}

	.mcard[lang='ar'] .ar {
		display: inline;
	}

	.mcard.is-flipping {
		animation: mirror-flip 0.42s cubic-bezier(0.3, 0.8, 0.3, 1);
	}

	@keyframes mirror-flip {
		0% {
			transform: perspective(700px) rotateY(0deg);
		}
		45% {
			transform: perspective(700px) rotateY(6deg) scaleX(0.965);
		}
		100% {
			transform: perspective(700px) rotateY(0deg);
		}
	}

	.mcard__bar {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding-bottom: 0.55rem;
		border-bottom: 1px solid rgba(30, 23, 19, 0.1);
	}

	.mcard__back {
		display: grid;
		place-items: center;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 8px;
		background: rgba(30, 23, 19, 0.07);
		color: var(--ink);
	}

	.mcard[dir='rtl'] .mcard__back svg {
		transform: scaleX(-1);
	}

	.mcard__title {
		font-weight: 600;
	}

	.mcard__dots {
		margin-inline-start: auto;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 8px;
		background:
			radial-gradient(circle at 50% 30%, var(--ink) 1.6px, transparent 1.7px),
			radial-gradient(circle at 50% 50%, var(--ink) 1.6px, transparent 1.7px),
			radial-gradient(circle at 50% 70%, var(--ink) 1.6px, transparent 1.7px);
		opacity: 0.45;
	}

	.mcard__pitch {
		position: relative;
		flex: 1;
		min-height: 4.5rem;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		padding: 0.45rem;
		border-radius: 12px;
		overflow: hidden;
		background:
			linear-gradient(
				90deg,
				rgba(255, 255, 255, 0.16) 0 1px,
				transparent 1px 50%
			),
			repeating-linear-gradient(
				90deg,
				rgba(255, 255, 255, 0.05) 0 14px,
				rgba(255, 255, 255, 0) 14px 28px
			),
			linear-gradient(165deg, #2f6f4a, #1d4a31);
	}

	.mcard__pitch::before {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: 2.6rem;
		height: 2.6rem;
		margin: -1.3rem 0 0 -1.3rem;
		border: 1px solid rgba(255, 255, 255, 0.24);
		border-radius: 50%;
	}

	.mcard__badge {
		position: relative;
		padding: 0.14rem 0.45rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.9);
		font-family: var(--mono);
		font-size: 0.6rem;
		color: #1d4a31;
	}

	.mcard__crew {
		display: flex;
		align-items: center;
	}

	.mcard__face {
		display: grid;
		place-items: center;
		width: 1.7rem;
		height: 1.7rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--cobalt) 14%, #fff);
		box-shadow: 0 0 0 2px #fff;
		font-family: var(--mono);
		font-size: 0.6rem;
		color: var(--cobalt);
	}

	.mcard__face + .mcard__face {
		margin-inline-start: -0.5rem;
	}

	.mcard__face:last-child {
		background: var(--marigold);
		color: #2a1c06;
	}

	.mcard__body {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		text-align: start;
	}

	.mcard__venue {
		font-weight: 600;
	}

	.mcard__slot {
		font-size: 0.76rem;
		color: rgba(30, 23, 19, 0.62);
	}

	.mcard__row {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		font-size: 0.78rem;
	}

	.mcard__price {
		margin-inline-start: auto;
		font-weight: 500;
		color: var(--cobalt);
	}

	.mcard__bar-track {
		height: 6px;
		border-radius: 999px;
		background: rgba(30, 23, 19, 0.1);
		overflow: hidden;
		display: flex;
	}

	.mcard__bar-track i {
		display: block;
		width: 60%;
		background: var(--marigold);
		border-radius: 999px;
	}

	.mcard__cta {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		margin-top: 0.15rem;
		padding: 0.5rem 0.8rem;
		border-radius: 10px;
		background: var(--cobalt);
		color: #fff;
		font-weight: 600;
		font-size: 0.82rem;
	}

	.mcard[dir='rtl'] .mcard__arrow svg {
		transform: scaleX(-1);
	}

	/* The mono face carries no Arabic; in RTL the sans takes those lines. */
	.mcard[lang='ar'] .mcard__slot,
	.mcard[lang='ar'] .mcard__price {
		font-family: var(--sans);
	}

	.mirror__note {
		font-size: 0.76rem;
		line-height: 1.5;
		color: rgba(30, 23, 19, 0.68);
	}

	/* ---------------- ledger ---------------- */

	.ledger {
		justify-content: space-between;
	}

	.matrix {
		display: grid;
		grid-template-columns: repeat(10, 1fr);
		gap: 4px;
		max-width: 15rem;
	}

	.matrix__cell {
		aspect-ratio: 1;
		border-radius: 3px;
		box-shadow: inset 0 0 0 1px rgba(251, 246, 236, 0.28);
	}

	.matrix__cell.is-on {
		background: var(--marigold);
		box-shadow: none;
	}

	.ledger__list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.2rem;
		margin: 0;
	}

	.ledger__list div {
		display: flex;
		align-items: baseline;
		gap: 0.35rem;
	}

	.ledger__list dt {
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.35rem;
		letter-spacing: -0.03em;
	}

	.ledger__list dd {
		margin: 0;
		font-size: 0.72rem;
		color: rgba(251, 246, 236, 0.62);
	}

	/* ---------------- amman ---------------- */

	.amman {
		justify-content: space-between;
		overflow: hidden;
	}

	.amman__map {
		position: absolute;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		opacity: 0.9;
	}

	.amman__rings ellipse {
		fill: none;
		stroke: rgba(42, 28, 6, 0.35);
		stroke-width: 0.7;
	}

	.amman__road {
		fill: none;
		stroke: rgba(42, 28, 6, 0.55);
		stroke-width: 1.1;
		stroke-dasharray: 3 3;
	}

	.amman__pin circle {
		fill: var(--pomegranate);
	}

	.amman__pulse {
		fill: var(--pomegranate);
		opacity: 0.25;
		transform-box: fill-box;
		transform-origin: center;
		animation: pulse 3.2s ease-out infinite;
	}

	@keyframes pulse {
		0% {
			transform: scale(0.4);
			opacity: 0.4;
		}
		70% {
			transform: scale(1.4);
			opacity: 0;
		}
		100% {
			transform: scale(1.4);
			opacity: 0;
		}
	}

	.amman .lbl,
	.amman__clock {
		position: relative;
		z-index: 1;
	}

	.amman__clock {
		display: flex;
		flex-direction: column;
		font-size: 0.7rem;
	}

	.amman__clock time {
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.3rem);
		letter-spacing: -0.04em;
		line-height: 1;
	}

	.amman__clock span {
		color: rgba(42, 28, 6, 0.66);
	}

	/* ---------------- on-device ---------------- */

	.device {
		flex-direction: row;
		align-items: center;
		gap: 1.1rem;
	}

	.device__phone {
		flex: 0 0 auto;
		width: 6.2rem;
		aspect-ratio: 9 / 17;
		padding: 5px;
		border-radius: 16px;
		background: linear-gradient(160deg, #4a423c, #221b17);
		box-shadow: inset 0 0 0 1px rgba(251, 246, 236, 0.18);
	}

	.device__screen {
		position: relative;
		width: 100%;
		height: 100%;
		border-radius: 12px;
		overflow: hidden;
		background:
			linear-gradient(200deg, rgba(23, 69, 127, 0.9), rgba(30, 23, 19, 0.9)),
			var(--ink);
	}

	.device__blur {
		position: absolute;
		inset: 14% 22% auto;
		height: 22%;
		border-radius: 6px;
		background: repeating-linear-gradient(
			45deg,
			rgba(251, 246, 236, 0.5) 0 3px,
			rgba(251, 246, 236, 0.15) 3px 6px
		);
		filter: blur(1.2px);
	}

	.device__scan {
		position: absolute;
		inset-inline: 0;
		top: 0;
		height: 28%;
		background: linear-gradient(
			to bottom,
			rgba(233, 164, 38, 0),
			rgba(233, 164, 38, 0.42)
		);
		border-bottom: 1px solid var(--marigold);
		animation: scan 3.4s cubic-bezier(0.65, 0, 0.35, 1) infinite;
	}

	@keyframes scan {
		0%,
		100% {
			transform: translateY(-30%);
		}
		50% {
			transform: translateY(290%);
		}
	}

	.device__wave {
		position: absolute;
		inset-inline: 8%;
		bottom: 8%;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		height: 34px;
	}

	.device__wave i {
		display: block;
		width: 3px;
		height: var(--h);
		border-radius: 2px;
		background: rgba(251, 246, 236, 0.5);
		animation: bob 1.5s ease-in-out infinite alternate;
	}

	.device__wave i:nth-child(odd) {
		background: var(--marigold);
		animation-duration: 1.9s;
	}

	.device__wave i:nth-child(3n) {
		animation-delay: 0.25s;
	}

	.device__wave i:nth-child(3n + 1) {
		animation-delay: 0.5s;
	}

	@keyframes bob {
		to {
			transform: scaleY(0.35);
		}
	}

	.device__copy {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 0;
	}

	.device__h {
		margin: 0;
