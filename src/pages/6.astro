---
import { Image } from 'astro:assets';
import { profile } from '../../content/profile';
import { featured, projects } from '../data/projects';
import { toolbox } from '../i18n';
import LangBoot from '../components/LangBoot.astro';
import Logo from '../components/Logo.astro';
import Seam from '../components/Seam.astro';
import StyleSwitcher from '../components/StyleSwitcher.astro';
import T from '../components/T.astro';
import { s, pair, yearPair } from '../data/variant-ui';
import profilePhoto from '../assets/images/profile.png';
import type { I18n, ProjectCategory, ProjectStatus } from '../../content/types';

/* Plain words for the data. The film language lives in the type, not in
   euphemisms for what actually shipped. The one exception earns it: a build
   still in progress is "in production" in both languages, which is true twice
   over. */
const stateWord = (st: ProjectStatus): I18n =>
	st === 'wip' ? pair('In production', 'قيد الإنتاج') : s(`status.${st}`);

const catKey: Record<ProjectCategory, Parameters<typeof s>[0]> = {
	web: 'cat.web',
	mobile: 'cat.mobile',
	ai: 'cat.ai',
	desktop: 'cat.desktop',
	extension: 'cat.extension',
	client: 'cat.client',
};

const linkKey: Record<string, Parameters<typeof s>[0]> = {
	live: 'project.live',
	github: 'project.github',
	appStore: 'project.apple',
	playGoogle: 'project.play',
	vscode: 'project.vscode',
};

/* Every still is framed by the same gate. Portrait phone captures stand
   inside the frame, lit; landscape captures fill it. */
const isPortrait = (img?: ImageMetadata) => !!img && img.height > img.width;

const pad = (n: number) => String(n).padStart(2, '0');

const specs: [I18n, I18n][] = [
	[
		pair('Running time', 'مدة العرض'),
		pair('About four years', 'نحو أربع سنوات'),
	],
	[pair('Titles', 'الأعمال'), pair('39 shipped', '39 عملًا صدرت')],
	[
		pair('In distribution', 'في التوزيع'),
		pair('13 on the app stores', '13 على متاجر التطبيقات'),
	],
	[
		pair('Written up', 'التوثيق'),
		pair('8 full cases', '8 مشاريع مشروحة بالكامل'),
	],
	[
		pair('Format', 'الصيغة'),
		pair('Web and mobile, end to end', 'ويب وجوّال، من طرف إلى طرف'),
	],
	[
		pair('Sound', 'الصوت'),
		pair(
			'On device. No cloud, no telemetry',
			'على الجهاز. بلا سحابة وبلا تتبّع',
		),
	],
	[pair('Shot in', 'موقع التصوير'), profile.location],
];

const booking: [I18n, string, string][] = [
	[pair('Mail', 'البريد'), profile.email, `mailto:${profile.email}`],
	[
		pair('Phone', 'الهاتف'),
		profile.phone,
		`tel:${profile.phone.replace(/\s/g, '')}`,
	],
	[pair('GitHub', 'GitHub'), 'haithamassoli', profile.links.github],
	[pair('LinkedIn', 'LinkedIn'), 'haithamassoli', profile.links.linkedin],
	[pair('Site', 'الموقع'), 'assoli.site', profile.links.website],
	[s('nav.cv'), 'cv.assoli.site', profile.links.resume],
	[s('project.play'), 'Developer page', profile.links.playStore],
];
---

<!doctype html>
<html lang="en" dir="ltr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Haitham Assoli — Night Reel</title>
		<meta
			name="description"
			content="Haitham Assoli, web and mobile full-stack engineer in Amman. Thirty-nine shipped products, including thirteen on the app stores."
		/>
		<LangBoot />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=Barlow+Condensed:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&family=Cairo:wght@500..900&family=Tajawal:wght@400;500;700&family=Amiri:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<Seam />
	</head>

	<body>
		<script is:inline>
			/* The router copies <html> off the incoming page, so the flag goes
			   back on before that page paints. */
			document.documentElement.classList.add('js');
			document.addEventListener('astro:after-swap', () =>
				document.documentElement.classList.add('js'),
			);
		</script>

		<a class="skip" href="#reel">
			<T v={s('nav.skip')} />
		</a>

		<div class="shutter" aria-hidden="true">
			<span class="shutter__leaf shutter__leaf--top"></span>
			<span class="shutter__leaf shutter__leaf--bottom"></span>
		</div>

		<div class="key" aria-hidden="true"></div>
		<div class="grain" aria-hidden="true"></div>
		<div class="vignette" aria-hidden="true"></div>

		<div class="gate gate--top">
			<a class="gate__brand" href="#top">
				<Logo labelled={false} />
				<T class="vh" v={pair('Haitham Assoli', 'هيثم العسولي')} />
			</a>

			<button class="slate" type="button" data-lang-toggle>
				<span class="slate__sticks" aria-hidden="true"></span>
				<span class="slate__fields" aria-hidden="true">
					<span class="slate__field slate__field--en">EN</span>
					<span class="slate__field slate__field--ar">ع</span>
				</span>
				<span class="vh" data-l="en" lang="en">Read this reel in Arabic</span>
				<span class="vh" data-l="ar" lang="ar">اقرأ هذه البكرة بالإنجليزية</span
				>
			</button>
		</div>

		<div class="gate gate--bottom" aria-hidden="true">
			<span class="gate__mark" data-now>
				<span data-l="en" lang="en">Reel 2022 — 2026</span>
				<span data-l="ar" lang="ar">بكرة 2022 — 2026</span>
			</span>
			<span class="gate__mark gate__mark--end">
				<T v={profile.location} />
			</span>
		</div>

		<main>
			<section class="card" id="top">
				<div class="wrap">
					<p class="eyebrow rise" style="--d: 0.1s">
						<T v={pair('Reel 2022 — 2026', 'بكرة 2022 — 2026')} />
						<span aria-hidden="true"> · </span>
						<T v={profile.location} />
					</p>

					<h1 class="card__title rise" style="--d: 0.2s" data-l="en" lang="en">
						Useful software<br /> holds up
					</h1>
					<h1 class="card__title rise" style="--d: 0.2s" data-l="ar" lang="ar">
						البرمجيات المفيدة<br /> تصمد
					</h1>

					<T
						v={pair('made for real use', 'مصمّمة للاستخدام الحقيقي')}
						as="p"
						class="card__sub rise"
					/>

					<p class="logline rise" style="--d: 0.45s" data-l="en" lang="en">
						Haitham Assoli builds web and mobile products for real constraints:
						slow networks, small screens, private media, and the people who rely
						on them.
					</p>
					<p class="logline rise" style="--d: 0.45s" data-l="ar" lang="ar">
						يبني هيثم العسولي منتجات ويب وموبايل لقيود واقعية: شبكة بطيئة،
						وشاشات صغيرة، ووسائط خاصة، والناس الذين يعتمدون عليها.
					</p>

					<div class="billing rise" style="--d: 0.55s">
						<T
							v={pair(
								'Written, designed and shipped by',
								'كتابةً وتصميمًا وإطلاقًا',
							)}
							as="p"
							class="billing__role"
						/>
						<T
							v={pair('Haitham Assoli', 'هيثم العسولي')}
							as="p"
							class="billing__name"
						/>
						<p class="billing__role" data-l="en" lang="en">
							{profile.title.en} · 39 titles · 13 on the app stores
						</p>
						<p class="billing__role" data-l="ar" lang="ar">
							{profile.title.ar} · 39 عملًا · 13 على متاجر التطبيقات
						</p>
					</div>

					<div class="cta rise" style="--d: 0.65s">
						<a class="btn btn--key" href="#reel">
							<T v={pair('Run the reel', 'أدر البكرة')} />
						</a>
						<a class="btn" href="/6/hire">
							<T v={s('hero.cta2')} />
						</a>
					</div>
				</div>
			</section>

			<section class="band" id="reel">
				<div class="wrap">
					<header class="head">
						<T
							v={pair(
								'Reel one · selected work',
								'البكرة الأولى · أعمال مختارة',
							)}
							as="p"
							class="eyebrow"
						/>
						<h2 class="head__title" data-l="en" lang="en">
							Eight shots, lit one at a time
						</h2>
						<h2 class="head__title" data-l="ar" lang="ar">
							ثماني لقطات، تُضاء واحدة تلو الأخرى
						</h2>
						<p class="head__lede" data-l="en" lang="en">
							Eight of the thirty-nine, written up in full. Move the light over
							a still to bring it up; the rest of the filmography runs after the
							credits.
						</p>
						<p class="head__lede" data-l="ar" lang="ar">
							ثمانية من التسعة والثلاثين، مشروحة بالكامل. حرّك الضوء فوق أي لقطة
							لترفعها، وبقية الأعمال تمرّ بعد التترات.
						</p>
					</header>
				</div>

				<ol class="reel">
					{
						featured.map((p, i) => (
							<li
								class="shot"
								style={`--gel: ${p.accent}`}
								data-shot
								data-title-en={p.title.en}
								data-title-ar={p.title.ar}
							>
								<a
									class={
										isPortrait(p.image)
											? 'shot__plate plate plate--stand'
											: 'shot__plate plate'
									}
									href={`/6/work/${p.slug}`}
									tabindex="-1"
									aria-hidden="true"
								>
									<span class="plate__gel" aria-hidden="true" />
									{p.image ? (
										<Image
											class={
												isPortrait(p.image)
													? 'plate__img plate__img--stand'
													: 'plate__img'
											}
											src={p.image}
											alt=""
											widths={
												isPortrait(p.image) ? [320, 480, 720] : [560, 900, 1440]
											}
											sizes={
												isPortrait(p.image)
													? '(min-width: 980px) 20vw, 44vw'
													: '(min-width: 980px) 56vw, 94vw'
											}
											loading={i === 0 ? 'eager' : 'lazy'}
											decoding="async"
										/>
									) : (
										<span class="plate__empty">
											<T v={pair('No still on file', 'لا لقطة محفوظة')} />
										</span>
									)}
									<span class="plate__slate" aria-hidden="true">
										{`${pad(i + 1)} / ${pad(featured.length)}`}
									</span>
								</a>

								<div class="shot__meta">
									<p class="shot__slug">
										<span class="shot__no">
											<T v={pair(`Shot ${pad(i + 1)}`, `لقطة ${pad(i + 1)}`)} />
										</span>
										<span class="shot__dot" aria-hidden="true">
											·
										</span>
										<T v={yearPair(p.year)} />
										<span class="shot__dot" aria-hidden="true">
											·
										</span>
										<span class={`state state--${p.status}`}>
											<T v={stateWord(p.status)} />
										</span>
									</p>

									<h3 class="shot__title">
										<a href={`/6/work/${p.slug}`}>
											<T v={p.title} />
										</a>
									</h3>
									<T v={p.tagline} as="p" class="shot__line" />
									<T v={p.summary} as="p" class="shot__body" />

									<dl class="credits">
										<dt>
											<T v={s('project.role')} />
										</dt>
										<dd>
											<T v={p.role} />
										</dd>
										<dt>
											<T v={pair('Kind', 'النوع')} />
										</dt>
										<dd>
											<T v={s(catKey[p.category])} />
										</dd>
										<dt>
											<T v={s('project.stack')} />
										</dt>
										<dd class="credits__stack">{p.stack.join(' · ')}</dd>
									</dl>

									<p class="ends">
										<a
											class="ends__link ends__link--case"
											href={`/6/work/${p.slug}`}
										>
											<T v={s('work.read')} />
										</a>
										{Object.entries(p.links).map(([k, url]) =>
											url ? (
												<a
													class="ends__link"
													href={url}
													rel="noopener"
													target="_blank"
												>
													<T v={linkKey[k] ? s(linkKey[k]) : pair(k, k)} />
												</a>
											) : null,
										)}
									</p>
								</div>
							</li>
						))
					}
				</ol>
			</section>

			<section class="band" id="crew">
				<div class="wrap crew">
					<div class="crew__portrait plate plate--tall">
						<span class="plate__gel" aria-hidden="true"></span>
						<Image
							class="plate__img"
							src={profilePhoto}
							alt="Haitham Assoli"
							data-l="en"
							lang="en"
							widths={[280, 420, 560]}
							sizes="(min-width: 980px) 24vw, 60vw"
							loading="lazy"
							decoding="async"
						/>
						<Image
							class="plate__img"
							src={profilePhoto}
							alt="هيثم العسولي"
							data-l="ar"
							lang="ar"
							widths={[280, 420, 560]}
							sizes="(min-width: 980px) 24vw, 60vw"
							loading="lazy"
							decoding="async"
						/>
						<span class="plate__slate" aria-hidden="true">
							<T v={pair('Crew', 'الطاقم')} />
						</span>
					</div>

					<div class="crew__text">
						<T
							v={pair('Behind the camera', 'خلف الكاميرا')}
							as="p"
							class="eyebrow"
						/>
						<h2 class="head__title" data-l="en" lang="en">
							Crew of one, most days
						</h2>
						<h2 class="head__title" data-l="ar" lang="ar">
							طاقم من شخص واحد، في أغلب الأيام
						</h2>
						{
							profile.about.en.map((para, i) => (
								<>
									<p class="prose" data-l="en" lang="en">
										{para}
									</p>
									<p class="prose" data-l="ar" lang="ar">
										{profile.about.ar[i]}
									</p>
								</>
							))
						}

						<dl class="credits credits--wide">
							{
								profile.experience.map((job) => (
									<>
										<T v={yearPair(job.period)} as="dt" />
										<dd>
											<span data-l="en" lang="en">
												<span class="credits__lead">{job.role.en}</span>
												<span class="credits__at"> at </span>
												{job.company.en}
											</span>
											<span data-l="ar" lang="ar">
												<span class="credits__lead">{job.role.ar}</span>
												<span class="credits__at"> في </span>
												{job.company.ar}
											</span>
										</dd>
									</>
								))
							}
							{
								profile.education.map((school) => (
									<>
										<T v={yearPair(school.period)} as="dt" />
										<dd>
											<span data-l="en" lang="en">
												<span class="credits__lead">{school.degree.en}</span>
												<span class="credits__at"> · </span>
												{school.school.en}
											</span>
											<span data-l="ar" lang="ar">
												<span class="credits__lead">{school.degree.ar}</span>
												<span class="credits__at"> · </span>
												{school.school.ar}
											</span>
										</dd>
									</>
								))
							}
						</dl>
					</div>
				</div>
			</section>

			<section class="band" id="specs">
				<div class="wrap specs">
					<div class="specs__head">
						<T
							v={pair('Tech specs', 'المواصفات الفنية')}
							as="p"
							class="eyebrow"
						/>
						<h2 class="head__title" data-l="en" lang="en">
							The print, in numbers
						</h2>
						<h2 class="head__title" data-l="ar" lang="ar">النسخة، بالأرقام</h2>
						<T
							v={pair(
								'No dashboard, no gradient. Just what is on the can.',
								'لا لوحة مؤشرات ولا تدرّج ألوان. فقط ما هو مكتوب على العلبة.',
							)}
							as="p"
							class="head__lede"
						/>
					</div>
					<dl class="spec">
						{
							specs.map(([k, v]) => (
								<div class="spec__row">
									<dt>
										<T v={k} />
									</dt>
									<dd>
										<T v={v} />
									</dd>
								</div>
							))
						}
					</dl>
				</div>

				<div class="wrap">
					<T
						v={pair('Gear list', 'قائمة المعدات')}
						as="p"
						class="eyebrow gear__eyebrow"
					/>
					<ul class="gear">
						{toolbox.map((tool) => <li class="gear__item">{tool}</li>)}
					</ul>
				</div>
			</section>

			<section class="band" id="filmography">
				<div class="wrap">
					<header class="head">
						<T
							v={pair('Filmography', 'قائمة الأعمال')}
							as="p"
							class="eyebrow"
						/>
						<h2 class="head__title" data-l="en" lang="en">
							Thirty-nine titles
						</h2>
						<h2 class="head__title" data-l="ar" lang="ar">
							تسعة وثلاثون عملًا
						</h2>
						<p class="head__lede" data-l="en" lang="en">
							Everything shipped, in order, including the ones that were taken
							down. Each one opens its own page, and the contact sheet prints
							them all on one.
						</p>
						<p class="head__lede" data-l="ar" lang="ar">
							كل ما صدر، بالترتيب، بما فيه ما أُزيل من المتاجر. لكل عمل صفحته،
							وورقة اللقطات تطبعها كلها على ورقة واحدة.
						</p>
						<p class="head__more">
							<a class="ends__link ends__link--case" href="/6/projects">
								<T v={pair('Open the contact sheet', 'افتح ورقة اللقطات')} />
							</a>
						</p>
					</header>

					<ul class="films">
						{
							projects.map((p) => (
								<li class="film">
									<a class="film__link" href={`/6/work/${p.slug}`}>
										<span class="film__title">
											<T v={p.title} />
										</span>
										<span class="film__rule" aria-hidden="true" />
										<span class="film__meta">
											<T v={s(catKey[p.category])} />
											<span aria-hidden="true"> · </span>
											<T v={yearPair(p.year)} />
										</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<section class="band band--end" id="booking">
				<div class="wrap booking">
					<div class="booking__pitch">
						<T v={pair('Booking', 'الحجز')} as="p" class="eyebrow" />
						<h2 class="head__title" data-l="en" lang="en">Next production</h2>
						<h2 class="head__title" data-l="ar" lang="ar">الإنتاج القادم</h2>
						<p class="head__lede" data-l="en" lang="en">
							Open to work that ships cleanly and holds up under real use. The
							call sheet is the fastest route; the CV has the long version.
						</p>
						<p class="head__lede" data-l="ar" lang="ar">
							مستعدٌّ لعمل يصدر بسلاسة ويصمد في الاستخدام الحقيقي. ورقة النداء
							أسرع طريق، والسيرة الذاتية فيها النسخة الطويلة.
						</p>

						<p class="cta">
							<a class="btn btn--key" href="/6/hire">
								<T v={pair('Fill the call sheet', 'املأ ورقة النداء')} />
							</a>
							<a
								class="btn"
								href={`mailto:${profile.email}?subject=Project%20booking`}
								>{profile.email}</a
							>
						</p>
					</div>

					<dl class="credits credits--wide booking__list">
						{
							booking.map(([label, value, url]) => (
								<>
									<dt>
										<T v={label} />
									</dt>
									<dd>
										<a class="booking__link" href={url} rel="noopener">
											{value}
										</a>
									</dd>
								</>
							))
						}
					</dl>
				</div>
			</section>
		</main>

		<footer class="tail" data-tail>
			<div class="wrap">
				<T v={pair('The end', 'النهاية')} as="p" class="tail__end" />
				<p class="tail__line" data-l="en" lang="en">
					© 2026 Haitham Assoli. {profile.tagline.en}
				</p>
				<p class="tail__line" data-l="ar" lang="ar">
					© 2026 هيثم العسولي. {profile.tagline.ar}
				</p>
				<p class="tail__line tail__line--fine" data-l="en" lang="en">
					Shot in Amman. Set in Archivo, Newsreader and Barlow Condensed.
				</p>
				<p class="tail__line tail__line--fine" data-l="ar" lang="ar">
					صُوِّر في عمّان. صُفّ بخطوط Cairo وTajawal وAmiri.
				</p>
			</div>
		</footer>

		<script is:inline>
			(function () {
				const root = document.documentElement;
				const still = matchMedia('(prefers-reduced-motion: reduce)');

				/* One key light. Pointer moves it; nothing else in the page moves. */
				let px = window.innerWidth / 2;
				let py = window.innerHeight * 0.35;
				let queued = 0;
				const place = () => {
					queued = 0;
					root.style.setProperty('--mx', px + 'px');
					root.style.setProperty('--my', py + 'px');
				};
				place();
				window.addEventListener(
					'pointermove',
					(e) => {
						if (e.pointerType === 'touch') return;
						px = e.clientX;
						py = e.clientY;
						if (!queued) queued = requestAnimationFrame(place);
					},
					{ passive: true },
				);
				/* The router overwrites the <html> style attribute, so the key
				   is put back before the incoming page paints. */
				document.addEventListener('astro:after-swap', place);

				/* The timecode is the scroll position, read as film. */
				let tc = null;
				let ticking = 0;
				const readHead = () => {
					ticking = 0;
					const span =
						document.documentElement.scrollHeight - window.innerHeight;
					const p = span > 0 ? Math.min(1, window.scrollY / span) : 0;
					const frames = Math.round(p * 264 * 24);
					const f = frames % 24;
					const s = Math.floor(frames / 24) % 60;
					const m = Math.floor(frames / 1440);
					const two = (n) => String(n).padStart(2, '0');
					if (tc) tc.textContent = '00:' + two(m) + ':' + two(s) + ':' + two(f);
				};
				window.addEventListener(
					'scroll',
					() => {
						if (!ticking) ticking = requestAnimationFrame(readHead);
					},
					{ passive: true },
				);

				/* Everything under here is wiring for the page that is on screen
				   right now. An inline script is not run again after a swap, so the
				   router calls this on every navigation — and on the first load too.
				   ponytail: no teardown. The old observers lose their last reference
				   on the next call and leave with the old DOM. */
				function wire() {
					tc = document.querySelector('[data-tc]');
					readHead();

					/* The reveal: the gate opens on each shot as it reaches the light. */
					const shots = Array.from(document.querySelectorAll('[data-shot]'));
					const marker = document.querySelector('[data-now]');
					const markEn = marker && marker.querySelector('[data-l="en"]');
					const markAr = marker && marker.querySelector('[data-l="ar"]');
					const plates = document.querySelectorAll('.plate');

					if (!('IntersectionObserver' in window) || still.matches) {
						plates.forEach((el) => el.classList.add('is-lit'));
					} else {
						const lighting = new IntersectionObserver(
							(entries) => {
								entries.forEach((entry) => {
									/* Anything the reader has already scrolled past counts as
									   lit, so a jump never leaves a still in the dark. */
									if (
										entry.isIntersecting ||
										entry.boundingClientRect.bottom < 0
									) {
										entry.target.classList.add('is-lit');
										lighting.unobserve(entry.target);
									}
								});
							},
							/* The plate is clipped shut before it is lit, so the visible
							   band is tiny: any intersection at all counts. */
							{ rootMargin: '0px 0px -10% 0px', threshold: 0 },
						);
						plates.forEach((el) => lighting.observe(el));

						/* The bottom gate names the shot under the light, in both
						   languages at once — the CSS decides which one is on screen, so
						   the marker does not have to know what the reader is reading. */
						const naming = new IntersectionObserver(
							(entries) => {
								entries.forEach((entry) => {
									if (!entry.isIntersecting || !markEn || !markAr) return;
									const no = String(shots.indexOf(entry.target) + 1).padStart(
										2,
										'0',
									);
									markEn.textContent =
										'Shot ' + no + ' — ' + entry.target.dataset.titleEn;
									markAr.textContent =
										'لقطة ' + no + ' — ' + entry.target.dataset.titleAr;
								});
							},
							{ rootMargin: '-45% 0px -45% 0px' },
						);
						shots.forEach((el) => naming.observe(el));
					}

					/* The bars close again when the credits roll. */
					const tail = document.querySelector('[data-tail]');
					if (tail && 'IntersectionObserver' in window) {
						new IntersectionObserver(
							(entries) => {
								entries.forEach((entry) =>
									document.body.classList.toggle(
										'is-end',
										entry.isIntersecting,
									),
								);
							},
							{ threshold: 0.35 },
						).observe(tail);
					}
				}

				document.addEventListener('astro:page-load', wire);
			})();
		</script>

		<StyleSwitcher n={6} />
	</body>
</html>

<style is:global>
	/* ── Night Reel ────────────────────────────────────────────────────────
	   Crushed cool black, a tungsten key, an indigo shadow. Light is the
