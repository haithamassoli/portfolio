		--indigo: #2a3557; /* the cool shadow */
		--key: #ffc27a; /* tungsten highlight, the beam */
		--sodium: #ff8c42; /* the one saturated source */
		--print: #f2e8db; /* warm print white */
		--mist: #a3abbd; /* secondary type */

		--gel: var(--key);
		--bar: 2rem;
		--mx: 50vw;
		--my: 35vh;
		--upos: 0%; /* underline growth origin; flipped under RTL */

		--display: 'Archivo', 'Helvetica Neue', Arial, sans-serif;
		--credit: 'Barlow Condensed', 'Arial Narrow', Arial, sans-serif;
		--prose: 'Newsreader', Georgia, 'Times New Roman', serif;
	}

