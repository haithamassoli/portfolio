	.tail__link:hover {
		color: var(--key);
		border-color: var(--key);
	}

	/* ── The Arabic voice ──────────────────────────────────────────────────
	   Archivo's `wdth` axis is the loudness ladder on the Latin side: 125 on
	   the title card, 118 on a section head, 104 on a slate field, 96 on a
	   spec line. No Arabic face has a width axis, so the ladder is carried by
	   two families instead of one axis — and the families really are different
	   widths, which is the point.

	   Tajawal is the default: narrow, geometric, the answer to Barlow
	   Condensed, and it takes every label and field on the page. Cairo, wider
	   and heavier, is promoted onto anything that would have gone extended in
	   Latin, and runs a weight ramp (900 → 600) where Latin ran a width ramp.
	   Amiri, a naskh, answers Newsreader for the long read and stands in for
	   the italic that Arabic does not have.

	   No letterspacing anywhere: it breaks the joins. */

	[lang='ar'] {
		font-family: 'Tajawal', 'Segoe UI', sans-serif;
		font-weight: 500;
		line-height: 1.75;
		letter-spacing: 0 !important;
		font-style: normal !important;
		font-variant: normal;
	}

	/* Promoted to Cairo: the loud voice. */
	[lang='ar'].head__title,
	.head__title [lang='ar'],
	[lang='ar'].tail__end,
	.tail__end [lang='ar'] {
		font-family: 'Cairo', 'Segoe UI', sans-serif;
		font-variation-settings: 'wght' 800;
		font-weight: 800;
		font-stretch: normal;
		line-height: 1.3;
		word-spacing: 0.03em;
	}

	[lang='ar'].tail__end,
	.tail__end [lang='ar'] {
		font-variation-settings: 'wght' 900;
		font-weight: 900;
	}

	/* Promoted to Amiri: anything read for longer than a line. */
	[lang='ar'].head__lede,
	[lang='ar'].prose {
		font-family: 'Amiri', 'Times New Roman', serif;
		font-weight: 400;
		font-size: 1.12rem;
		line-height: 2;
	}

	[lang='ar'].eyebrow,
	.eyebrow [lang='ar'] {
		font-weight: 700;
		font-size: 0.9rem;
	}

	[lang='ar'].tab,
	[lang='ar'].btn,
	[lang='ar'].gate__mark,
	.gate__mark [lang='ar'],
	[lang='ar'].tail__line,
	.credits dt [lang='ar'],
	.credits dd [lang='ar'],
	.tail__contact dt [lang='ar'],
	.tail__contact dd [lang='ar'],
	[lang='ar'].plate__empty,
	.plate__empty [lang='ar'] {
		font-size: 0.9rem;
	}

	/* Under RTL the underline has to grow from the right edge. */
	html[dir='rtl'] {
		--upos: 100%;
	}

	/* ── Wider frames ──────────────────────────────────────────────────── */

	@media (min-width: 62rem) {
		:root {
			--bar: 2.25rem;
		}

		.tail__grid {
			grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
			gap: 3rem;
		}
	}

	@media (max-width: 40rem) {
		.gate--bottom .gate__mark {
			display: none;
		}
	}

	@media (max-width: 30rem) {
		.credits {
			grid-template-columns: 1fr;
			row-gap: 0.2rem;
		}

		.credits dt {
			text-align: start;
			padding-top: 0.65rem;
		}

		.tail__contact {
			grid-template-columns: 1fr;
			row-gap: 0.2rem;
		}

		.tail__contact dt {
			text-align: start;
			padding-top: 0.5rem;
		}
	}

	/* ── Touch: the key light is rigged, not carried ───────────────────── */

	@media (hover: none) {
		.key {
			width: 140vw;
			height: 80vh;
			transform: translate3d(-20vw, -16vh, 0);
			background: radial-gradient(
				50% 50% at 50% 50%,
				rgba(255, 194, 122, calc(0.16 * var(--rig))),
				rgba(255, 140, 66, calc(0.05 * var(--rig))) 40%,
				transparent 70%
			);
		}

		.plate__img {
			filter: brightness(0.94) saturate(0.98) contrast(1.01);
		}
	}

	/* ── Stillness ─────────────────────────────────────────────────────── */

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		.grain {
			animation: none;
			opacity: 0.07;
		}

		.slate__sticks,
		.gate__brand,
		.plate::after,
		.plate__img,
		.plate__gel,
		.tab,
		.btn,
		.tail__link,
		.skip {
			transition: none;
		}
	}

	@media print {
		.key,
		.grain,
		.vignette,
		.gate,
		.rack,
		.skip {
			display: none;
		}
	}
</style>

<script is:inline>
	/* One key light, carried by the pointer. Nothing else on these pages
	   moves; the rig is at half power so long copy stays readable. */
	(function () {
		const root = document.documentElement;
		let px = window.innerWidth / 2;
		let py = window.innerHeight * 0.3;
		let queued = 0;
		const place = () => {
			queued = 0;
			root.style.setProperty('--mx', px + 'px');
			root.style.setProperty('--my', py + 'px');
		};
		place();
		window.addEventListener(
			'pointermove',
			(e) => {
				if (e.pointerType === 'touch') return;
				px = e.clientX;
				py = e.clientY;
				if (!queued) queued = requestAnimationFrame(place);
			},
			{ passive: true },
		);
	})();
</script>
