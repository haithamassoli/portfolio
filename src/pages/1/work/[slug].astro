---
/* One project, read top to bottom in a single column: what it is, what it is
   built out of, what went wrong, and what came of it. */
import { Image } from 'astro:assets';
import Shell from '../_shell.astro';
import T from '../../../components/T.astro';
import { projects } from '../../../data/projects';
import { pair, s, yearPair } from '../../../data/variant-ui';

export function getStaticPaths() {
	return projects.map((project, i) => ({
		params: { slug: project.slug },
		props: { project, next: projects[(i + 1) % projects.length] },
	}));
}

const { project: p, next } = Astro.props;

const statusWord = {
	live: s('status.live'),
	shipped: s('status.shipped'),
	delisted: s('status.delisted'),
	wip: s('status.wip'),
	archived: s('status.archived'),
};

const catWord = {
	web: s('cat.web'),
	mobile: s('cat.mobile'),
	ai: s('cat.ai'),
	client: s('cat.client'),
	desktop: s('cat.desktop'),
	extension: s('cat.extension'),
};

const linkWord: Record<string, ReturnType<typeof s>> = {
	live: s('project.live'),
	github: s('project.github'),
	appStore: s('project.apple'),
	playGoogle: s('project.play'),
	vscode: s('project.vscode'),
};

/* Several covers are 1080×2340 phone screenshots. They get a narrow column
   instead of being cropped into a landscape slot. */
const tall = (img: ImageMetadata) => img.height / img.width > 1.1;

const overview = p.overview.en.map((en, i) => pair(en, p.overview.ar[i]));
const outcomes = p.outcomes.en.map((en, i) => pair(en, p.outcomes.ar[i]));
const gallery = p.shots.filter((shot) => shot.src !== p.image?.src);
---

<Shell title={`${p.title.en} — Haitham Assoli`} description={p.tagline.en}>
	<section class="band band--top">
		<p class="rail"><T v={pair('the project', 'المشروع')} /></p>
		<div class="col col--top">
			<p class="k back">
				<a href="/1/projects"><T v={s('project.back')} /></a>
			</p>
			<T as="h1" v={p.title} />
			<T as="p" class="lede case__tag" v={p.tagline} />
			<T as="p" class="case__sum" v={p.summary} />

			{
				p.image && (
					<figure class={`cover${tall(p.image) ? ' cover--tall' : ''}`}>
						<Image
							src={p.image}
							alt={p.title.en}
							widths={tall(p.image) ? [280, 560] : [480, 720, 1080]}
							sizes={
								tall(p.image)
									? '(min-width: 640px) 17rem, 60vw'
									: '(min-width: 1040px) 36rem, calc(100vw - 4rem)'
							}
							loading="eager"
							decoding="async"
						/>
					</figure>
				)
			}
		</div>
	</section>

	<section class="band">
		<p class="rail"><T v={pair('the facts', 'الحقائق')} /></p>
		<div class="col">
			<dl class="count">
				<div class="count__row">
					<dt class="k"><T v={s('project.role')} /></dt>
					<span class="count__lead" aria-hidden="true"></span>
					<dd><T v={p.role} /></dd>
				</div>
				<div class="count__row">
					<dt class="k"><T v={s('project.year')} /></dt>
					<span class="count__lead" aria-hidden="true"></span>
					<T v={yearPair(p.year)} as="dd" />
				</div>
				<div class="count__row">
					<dt class="k"><T v={s('project.status')} /></dt>
					<span class="count__lead" aria-hidden="true"></span>
					<dd><T v={statusWord[p.status]} /></dd>
				</div>
				<div class="count__row">
					<dt class="k"><T v={pair('Category', 'التصنيف')} /></dt>
					<span class="count__lead" aria-hidden="true"></span>
					<dd><T v={catWord[p.category]} /></dd>
				</div>
			</dl>

			<p class="k sub"><T v={s('project.stack')} /></p>
			<ul class="tools" lang="en" dir="ltr">
				{p.stack.map((tool) => <li class="k">{tool}</li>)}
			</ul>

			{
				Object.values(p.links).some(Boolean) && (
					<>
						<p class="k sub">
							<T v={s('project.links')} />
						</p>
						<p class="case__links">
							{Object.entries(p.links).map(([key, url]) =>
								url ? (
									<a class="lnk" href={url} rel="noreferrer">
										<T v={linkWord[key]} />
									</a>
								) : null,
							)}
						</p>
					</>
				)
			}
		</div>
	</section>

	<section class="band">
		<p class="rail"><T v={pair('overview', 'نظرة عامة')} /></p>
		<div class="col">
			<T
				as="h2"
				v={pair('What it is, and why it exists.', 'ما هو، ولماذا وُجد.')}
			/>
			{overview.map((block) => <T as="p" v={block} />)}
		</div>
	</section>

	{
		p.challenges.length > 0 && (
			<section class="band">
				<p class="rail">
					<T v={pair('problems', 'المشكلات')} />
				</p>
				<div class="col">
					<T as="h2" v={s('project.challenges')} />
					<div class="chals">
						{p.challenges.map((c) => (
							<article class="chal">
								<T as="h3" class="chal__h" v={c.title} />
								<p class="k chal__lbl">
									<T v={pair('the problem', 'المشكلة')} />
								</p>
								<T as="p" class="chal__p" v={c.problem} />
								<p class="k chal__lbl">
									<T v={pair('what I did', 'ما فعلته')} />
								</p>
								<T as="p" class="chal__p chal__p--fix" v={c.solution} />
							</article>
						))}
					</div>
				</div>
			</section>
		)
	}

	<section class="band">
		<p class="rail"><T v={pair('after', 'بعد ذلك')} /></p>
		<div class="col">
			<T as="h2" v={s('project.outcomes')} />
			<ul class="outs">
				{outcomes.map((block) => <T as="li" v={block} />)}
			</ul>
		</div>
	</section>

	{
		gallery.length > 0 && (
			<section class="band">
				<p class="rail">
					<T v={pair('screens', 'لقطات')} />
				</p>
				<div class="col">
					<T as="h2" v={pair('A few screens.', 'بعض الشاشات.')} />
					<div class="shots">
						{gallery.map((shot, i) => (
							<figure class={`shot${tall(shot) ? ' shot--tall' : ''}`}>
								<Image
									src={shot}
									alt={`${p.title.en} — ${i + 1}`}
									widths={tall(shot) ? [280, 560] : [480, 720, 1080]}
									sizes={
										tall(shot)
											? '(min-width: 640px) 14rem, 44vw'
											: '(min-width: 1040px) 36rem, calc(100vw - 4rem)'
									}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))}
					</div>
				</div>
			</section>
		)
	}

	<section class="band">
		<p class="rail"><T v={pair('next', 'التالي')} /></p>
		<div class="col">
			<p class="k"><T v={s('project.next')} /></p>
			<p class="nextp">
				<a class="lnk" href={`/1/work/${next.slug}`}>
					<T v={next.title} />
				</a>
			</p>
			<T as="p" class="measure" v={next.tagline} />
		</div>
	</section>
</Shell>

<style is:global>
	.back {
		margin-block-end: 1.4rem;
	}

	.back a {
		text-decoration: none;
	}

	.case__tag {
		margin-block: 1.5rem 0;
		color: var(--graphite);
	}

	.case__sum {
		margin-block-start: 1.4rem;
	}

	.cover {
		margin: 2.75rem 0 0;
		max-width: 36rem;
	}

	.cover--tall {
		max-width: 17rem;
	}

	.cover img,
	.shot img {
		width: 100%;
		height: auto;
		border: 1px solid var(--rule);
		border-radius: 3px;
		background: var(--raised);
		filter: saturate(0.94);
	}

	:root[data-theme='dark'] .cover img,
	:root[data-theme='dark'] .shot img {
		filter: saturate(0.85) brightness(0.9);
	}

	.case__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.5rem;
		max-width: none;
	}

	.chals {
		display: grid;
		gap: 3.5rem;
		max-width: 36rem;
		margin-block-start: 0.6rem;
	}

	.chal__h {
		margin-block-end: 1rem;
	}

	.chal__lbl {
		margin: 0 0 0.35rem;
	}

	.chal__p {
		margin: 0 0 1.15rem;
		color: var(--graphite);
	}

	.chal__p--fix {
		margin-block-end: 0;
		color: var(--ink);
	}

	.outs {
		display: grid;
		gap: 0.9rem;
		margin: 0;
		padding: 0;
		max-width: 36rem;
		list-style: none;
	}

	.outs li {
		position: relative;
		padding-inline-start: 1.4rem;
	}

	.outs li::before {
		content: '';
		position: absolute;
		inset-block-start: 0.68em;
		inset-inline-start: 0;
		width: 0.3rem;
		height: 0.3rem;
		background: var(--signal);
	}

	.shots {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		max-width: 36rem;
	}

	.shot {
		margin: 0;
		flex: 1 1 100%;
	}

	.shot--tall {
		flex: 0 1 14rem;
	}

	.nextp {
		margin-block: 0.6rem 0.9rem;
		font-size: var(--s-lede);
	}
</style>
