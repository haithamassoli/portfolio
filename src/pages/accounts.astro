---
import Base from '../layouts/Base.astro';
import { AccountsForm } from '../components/AccountsForm';
---

<Base
	lang="en"
	title="Account portfolio"
	description="Edit the account book and watch revenue against retention move with it."
>
	<section class="mx-auto max-w-5xl px-6 py-16">
		<h1 class="text-3xl font-black">Account portfolio</h1>
		<p class="mt-3 max-w-2xl text-[color:var(--muted)]">
			Every edit below rewrites the chart above it. Revenue runs along x, net
			retention along y, seats set the point area, and segment sets the colour.
		</p>

		<div class="mt-10 rounded-xl bg-white p-6 text-neutral-900 shadow-lg">
			<AccountsForm client:load />
		</div>
	</section>
</Base>
