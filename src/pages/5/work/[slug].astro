---
/* One project, unpacked into its compartments: the cover in its own frame,
   the facts in a lacquer box, the prose in a wide tray, and every challenge
   split into a recessed problem and a raised solution. */
import { Image } from 'astro:assets';
import { projects } from '../../../data/projects';
import type { Key } from '../../../i18n';
import { pair, s } from '../../../data/variant-ui';
import T from '../../../components/T.astro';
import Shell from '../_shell.astro';

export function getStaticPaths() {
	return projects.map((p, index) => ({
		params: { slug: p.slug },
		props: { index },
	}));
}

const { index } = Astro.props;
const p = projects[index];
const next = projects[(index + 1) % projects.length];

const cat = (c: string) => s(`cat.${c}` as Key);
const stat = (st: string) => s(`status.${st}` as Key);
const per = (v: string) =>
	pair(v, v.replace(/^Since /, 'منذ ').replace(/ to /, ' إلى '));

/* Covers arrive in three shapes: phone screenshots, laptop captures and
   square icons. Each gets its own frame instead of one landscape crop. */
const shapeOf = (img?: ImageMetadata) => {
	if (!img) return 'none';
	const r = img.width / img.height;
	if (r < 0.9) return 'tall';
	if (r < 1.2) return 'square';
	return 'wide';
};
const coverShape = shapeOf(p.image);

const linkRows = (
	[
		['live', 'project.live'],
		['playGoogle', 'project.play'],
		['appStore', 'project.apple'],
		['vscode', 'project.vscode'],
		['github', 'project.github'],
	] as const
)
	.map(([key, label]) => ({ href: p.links[key], label: s(label) }))
	.filter((l) => Boolean(l.href));

/* Gallery: phone screenshots go into one filmstrip compartment, wider shots
   each get a slot of their own, and an icon never gets blown up to a metre
   wide. The cover is already at the top, so it is not shown twice. */
const kindOf = (sh: ImageMetadata) => {
	const r = sh.width / sh.height;
	return r < 0.9 ? 'tall' : r < 1.2 ? 'square' : 'wide';
};
const gallery = p.shots.filter((sh) => sh.src !== p.image?.src);
const tall = gallery.filter((sh) => kindOf(sh) === 'tall');
const flat = gallery.filter((sh) => kindOf(sh) !== 'tall');
const flatSlots = flat.map((sh, i) => {
	if (kindOf(sh) === 'square') return 'w4';
	if (flat.length === 1) return 'w12';
	if (flat.length === 3) return 'w4';
	return i % 2 ? 'w5' : 'w7';
});

/* Two challenges side by side, then two the other way round: the pairs stop
   the page from settling into a column. A lone last one takes the full width. */
const chWidth = (i: number, n: number) => {
	if (i === n - 1 && n % 2 === 1) return 'w12';
	return i % 4 === 0 || i % 4 === 3 ? 'w7' : 'w5';
};
---

<Shell
	page="work"
	title={`${p.title.en} — Haitham Assoli`}
	description={p.tagline.en}
>
	<section class="board" aria-labelledby="p-h" style={`--accent:${p.accent}`}>
		<article class="tile tile--bone w8 h3 head" style="--i: 0">
			<p class="mono lbl">
				<T v={cat(p.category)} as="span" />
				<span aria-hidden="true"> · </span>
				<T v={per(p.year)} as="span" />
			</p>
			<h1 class="tile__h tile__h--big" id="p-h">
				<T v={p.title} as="span" />
			</h1>
			<T v={p.tagline} as="p" class="head__line" />
			<ul class="chips head__chips">
				<li><T v={stat(p.status)} as="span" class="chip chip--status" /></li>
				{
					p.featured && (
						<li>
							<T v={pair('Featured', 'مختار')} as="span" class="chip" />
						</li>
					)
				}
			</ul>
		</article>

		<article
			class:list={[
				'tile',
				'tile--ink',
				'w4',
				'h3',
				'cover',
				`cover--${coverShape}`,
			]}
			style="--i: 1"
		>
			{
				p.image ? (
					<>
						{(p.frame === 'browser' || p.frame === 'editor') && (
							<span class="cover__chrome" aria-hidden="true">
								<i />
								<i />
								<i />
							</span>
						)}
						<span class="cover__stage">
							<Image
								src={p.image}
								alt={`${p.title.en} — cover screenshot`}
								widths={[320, 640, 960]}
								sizes="(min-width: 64rem) 22rem, 80vw"
								loading="eager"
							/>
						</span>
					</>
				) : (
					<span class="cover__plate mono" lang="en">
						{p.title.en}
					</span>
				)
			}
		</article>
	</section>

	<section
		class="board"
		aria-labelledby="facts-h"
		style={`--accent:${p.accent}`}
	>
		<h2 class="sr-only" id="facts-h">
			<span data-l="en" lang="en">Project facts</span>
			<span data-l="ar" lang="ar">بيانات المشروع</span>
		</h2>

		<article class="tile tile--marigold w7 h2 summary" style="--i: 0">
			<p class="mono lbl"><T v={pair('In short', 'باختصار')} /></p>
			<T v={p.summary} as="p" class="summary__p" />
		</article>

		<article class="tile tile--ink w5 h2 facts" style="--i: 1">
			<p class="mono lbl lbl--on-dark">
				<T v={pair('The compartments', 'الخانات')} />
			</p>
			<dl class="facts__list">
				<div>
					<T v={s('project.role')} as="dt" class="mono" />
					<T v={p.role} as="dd" />
				</div>
				<div>
					<T v={s('project.year')} as="dt" class="mono" />
					<T v={per(p.year)} as="dd" />
				</div>
				<div>
					<T v={s('project.status')} as="dt" class="mono" />
					<T v={stat(p.status)} as="dd" />
				</div>
			</dl>
		</article>

		<article class="tile tile--bone w8 h2 stack" style="--i: 2">
			<p class="mono lbl"><T v={s('project.stack')} /></p>
			<ul class="chips">
				{
					p.stack.map((item) => (
						<li class="chip" lang="en" dir="ltr">
							{item}
						</li>
					))
				}
			</ul>
		</article>

		<article class="tile tile--cobalt w4 h2 links" style="--i: 3">
			<p class="mono lbl lbl--on-dark"><T v={s('project.links')} /></p>
			{
				linkRows.length ? (
					<ul class="links__list">
						{linkRows.map((l) => (
							<li>
								<a href={l.href}>
									<T v={l.label} as="span" />
								</a>
							</li>
						))}
					</ul>
				) : (
					<T
						v={pair(
							'Nothing public to link to. The write-up is the record.',
							'لا رابط عامًا له. هذه الصفحة هي سجلّه.',
						)}
						as="p"
						class="links__none"
					/>
				)
			}
		</article>
	</section>

	<section class="board board--flow" aria-labelledby="story-h">
		<div class="board__head">
			<h2 class="board__h" id="story-h">
				<span data-l="en" lang="en">What it is</span>
				<span data-l="ar" lang="ar">ما هو</span>
			</h2>
		</div>

		<article class="tile tile--bone w8 overview" style="--i: 0">
			<div class="prose" data-l="en" lang="en">
				{p.overview.en.map((t) => <p>{t}</p>)}
			</div>
			<div class="prose" data-l="ar" lang="ar">
				{p.overview.ar.map((t) => <p>{t}</p>)}
			</div>
		</article>

		<article class="tile tile--ink w4 outcomes" style="--i: 1">
			<p class="mono lbl lbl--on-dark"><T v={s('project.outcomes')} /></p>
			<ul class="ticks" data-l="en" lang="en">
				{p.outcomes.en.map((t) => <li>{t}</li>)}
			</ul>
			<ul class="ticks" data-l="ar" lang="ar">
				{p.outcomes.ar.map((t) => <li>{t}</li>)}
			</ul>
		</article>
	</section>

	{
		p.challenges.length > 0 && (
			<section class="board board--flow" aria-labelledby="ch-h">
				<div class="board__head">
					<h2 class="board__h" id="ch-h">
						<T v={s('project.challenges')} as="span" />
					</h2>
					<T
						v={pair(
							'Each one opens twice: what went wrong on the left, what I did on the right.',
							'كل خانة تُفتح مرتين: ما الذي تعثّر، ثم ما الذي فعلته.',
						)}
						as="p"
						class="board__lede"
					/>
				</div>

				{p.challenges.map((c, i) => (
					<article
						class:list={[
							'tile',
							'tile--bone',
							chWidth(i, p.challenges.length),
							'ch',
						]}
						style={`--i:${i}; --accent:${p.accent}`}
					>
						<p class="mono lbl">{String(i + 1).padStart(2, '0')}</p>
						<T v={c.title} as="h3" class="tile__h ch__h" />
						<div class="ch__split">
							<div class="ch__half ch__half--problem">
								<T v={pair('Problem', 'المشكلة')} as="p" class="mono ch__tag" />
								<T v={c.problem} as="p" class="ch__p" />
							</div>
							<div class="ch__half ch__half--solution">
								<T
									v={pair('What I did', 'ما فعلته')}
									as="p"
									class="mono ch__tag"
								/>
								<T v={c.solution} as="p" class="ch__p" />
							</div>
						</div>
					</article>
				))}
			</section>
		)
	}

	{
		gallery.length > 0 && (
			<section class="board" aria-labelledby="shots-h">
				<div class="board__head">
					<h2 class="board__h" id="shots-h">
						<span data-l="en" lang="en">
							Look at it
						</span>
						<span data-l="ar" lang="ar">
							انظر إليه
						</span>
					</h2>
				</div>

				{tall.length > 0 && (
					<article class="tile tile--ink w12 h3 strip" style="--i: 0">
						<p class="mono lbl lbl--on-dark" id="strip-h">
							<span data-l="en" lang="en">
								Screens, as shipped
							</span>
							<span data-l="ar" lang="ar">
								الشاشات كما صدرت
							</span>
						</p>
						<div
							class="strip__rail"
							tabindex="0"
							role="group"
							aria-labelledby="strip-h"
						>
							{tall.map((sh, i) => (
								<span class="strip__phone">
									<Image
										src={sh}
										alt={`${p.title.en} — screen ${i + 1}`}
										widths={[220, 440]}
										sizes="11rem"
										loading="lazy"
									/>
								</span>
							))}
						</div>
					</article>
				)}

				{flat.map((sh, i) => (
					<article
						class:list={[
							'tile',
							'tile--bone',
							flatSlots[i],
							'shot',
							kindOf(sh) === 'square' && 'shot--square',
						]}
						style={`--i:${i + 1}`}
					>
						<Image
							src={sh}
							alt={`${p.title.en} — screenshot ${i + 1}`}
							widths={[480, 960, 1440]}
							sizes={
								flatSlots[i] === 'w12'
									? '(min-width: 64rem) 78rem, 92vw'
									: '(min-width: 64rem) 40rem, 92vw'
							}
							loading="lazy"
						/>
					</article>
				))}
			</section>
		)
	}

	<section class="board" aria-labelledby="next-h">
		<h2 class="sr-only" id="next-h">
			<span data-l="en" lang="en">Keep going</span>
			<span data-l="ar" lang="ar">تابع</span>
		</h2>

		<a
			class="tile tile--ink w8 h2 next"
			href={`/5/work/${next.slug}`}
			style={`--i:0; --accent:${next.accent}`}
		>
			<p class="mono lbl lbl--on-dark"><T v={s('project.next')} /></p>
			<span class="tile__h next__title"><T v={next.title} as="span" /></span>
			<T v={next.tagline} as="span" class="next__line" />
			<span class="arrow">
				<span data-l="en" lang="en">Open it →</span>
				<span data-l="ar" lang="ar">افتحه ←</span>
			</span>
		</a>

		<a class="tile tile--cobalt w4 h2 back" href="/5/projects" style="--i: 1">
			<p class="mono lbl lbl--on-dark"><T v={pair('Shelf', 'الرفّ')} /></p>
			<span class="tile__h back__title"
				><T v={s('project.back')} as="span" /></span
			>
			<T
				v={pair('All 39, in six compartments.', 'الـ 39 كلها في ستّ خانات.')}
				as="span"
				class="next__line"
			/>
		</a>
	</section>
</Shell>

<style is:global>
	/* ---------------- head + cover ---------------- */

	.head {
		justify-content: center;
	}

	.head__line {
		max-width: 46ch;
		font-size: clamp(0.92rem, 0.86rem + 0.3vw, 1.08rem);
		color: rgba(30, 23, 19, 0.76);
	}

	.head__chips {
		margin-top: 0.35rem;
	}

	.cover {
		padding: 0.75rem;
		gap: 0.5rem;
		background:
			radial-gradient(
				120% 100% at 50% 0%,
				color-mix(in srgb, var(--accent) 26%, transparent),
				transparent 70%
			),
			var(--ink);
	}

	.cover__chrome {
		display: flex;
		gap: 5px;
		padding: 0.2rem 0.1rem;
	}

	.cover__chrome i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: rgba(251, 246, 236, 0.28);
	}

	.cover__stage {
		display: grid;
		place-items: center;
		flex: 1;
		min-height: 0;
		overflow: hidden;
		border-radius: 12px;
		background: rgba(0, 0, 0, 0.25);
	}

	.cover__stage img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	/* A phone screenshot keeps its bezel and its proportion. */
	.cover--tall .cover__stage {
		width: auto;
		max-width: 100%;
		aspect-ratio: 9 / 19.5;
		margin: 0 auto;
		padding: 4px;
		border-radius: 18px;
		background: linear-gradient(160deg, #4a423c, #221b17);
		box-shadow: inset 0 0 0 1px rgba(251, 246, 236, 0.18);
	}

	.cover--tall .cover__stage img {
		border-radius: 14px;
		object-fit: cover;
	}

	/* An icon is not a screenshot: it sits on a plate at its own size. */
	.cover--square .cover__stage {
		place-items: center;
		background: transparent;
	}

	.cover--square .cover__stage img {
		width: min(58%, 9rem);
		height: auto;
		border-radius: 22%;
		box-shadow: 0 18px 30px -18px rgba(0, 0, 0, 0.9);
	}

	.cover__plate {
		display: grid;
		place-items: center;
		flex: 1;
		border-radius: 12px;
		border: 1px dashed rgba(251, 246, 236, 0.25);
		font-size: 0.85rem;
		text-align: center;
		color: rgba(251, 246, 236, 0.6);
	}

	/* ---------------- facts ---------------- */

	.summary {
		justify-content: center;
	}

	.summary__p {
		max-width: 58ch;
		font-size: clamp(0.9rem, 0.85rem + 0.35vw, 1.1rem);
		line-height: 1.55;
		color: rgba(42, 28, 6, 0.88);
	}

	.facts__list {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin: 0;
	}

	.facts__list div {
		display: grid;
		grid-template-columns: 5.5rem minmax(0, 1fr);
		gap: 0.7rem;
		align-items: baseline;
		padding-bottom: 0.25rem;
		border-bottom: 1px solid rgba(251, 246, 236, 0.12);
	}

	.facts__list dt {
		font-size: 0.66rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(251, 246, 236, 0.5);
	}

	.facts__list dd {
		margin: 0;
		font-size: 0.84rem;
	}

	.stack .chips {
		align-content: flex-start;
	}

	.links__list {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.links__list a {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.3rem 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.16);
		font-size: 0.84rem;
		text-decoration: none;
		transition: color 0.18s ease;
	}

	.links__list a::after {
		content: '↗';
		font-size: 0.75rem;
		opacity: 0.55;
	}

	.links__list a:hover {
		color: var(--marigold);
	}

	.links__none {
		font-size: 0.82rem;
		color: rgba(238, 244, 251, 0.75);
	}

	/* ---------------- overview + outcomes ---------------- */

	.ticks {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.85rem;
		line-height: 1.5;
		color: rgba(251, 246, 236, 0.8);
	}

	.ticks li {
		position: relative;
		padding-inline-start: 1.1rem;
	}

	.ticks li::before {
		content: '';
		position: absolute;
		inset-inline-start: 0;
		top: 0.55em;
		width: 7px;
		height: 7px;
		border-radius: 2px;
		background: var(--marigold);
	}

	/* ---------------- challenges ---------------- */

	.ch__h {
		font-size: clamp(1rem, 0.9rem + 0.45vw, 1.3rem);
	}

	.ch__split {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 0.55rem;
		margin-top: 0.35rem;
	}

	.ch__half {
		padding: 0.8rem 0.9rem;
		border-radius: 14px;
	}

	/* Recessed: the problem sits below the surface of the tile. */
	.ch__half--problem {
		background: rgba(30, 23, 19, 0.07);
		box-shadow: inset 0 1px 3px rgba(30, 23, 19, 0.14);
	}

	/* Raised: the answer sits on top of it. */
	.ch__half--solution {
		background: #fff;
		box-shadow:
			inset 0 0 0 1px rgba(30, 23, 19, 0.08),
			0 8px 16px -14px rgba(30, 23, 19, 0.9);
	}

	.ch__tag {
		font-size: 0.62rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgba(30, 23, 19, 0.45);
		margin-bottom: 0.25rem;
	}

	.ch__half--solution .ch__tag {
		color: color-mix(in srgb, var(--accent) 70%, var(--ink));
	}

	.ch__p {
		font-size: 0.85rem;
		line-height: 1.6;
		color: rgba(30, 23, 19, 0.8);
	}

	/* ---------------- gallery ---------------- */

	.strip {
		gap: 0.7rem;
	}

	.strip__rail {
		display: flex;
		gap: 0.7rem;
		flex: 1;
		min-height: 0;
		padding-bottom: 0.4rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-color: rgba(251, 246, 236, 0.4) transparent;
	}

	.strip__phone {
		flex: 0 0 auto;
		scroll-snap-align: start;
		height: 18rem;
		width: auto;
		aspect-ratio: 9 / 19.5;
		padding: 4px;
		border-radius: 18px;
		background: linear-gradient(160deg, #4a423c, #221b17);
		box-shadow: inset 0 0 0 1px rgba(251, 246, 236, 0.18);
	}

	.strip__phone img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 14px;
	}

	.shot {
		padding: 0.5rem;
		overflow: hidden;
	}

	.shot img {
		width: 100%;
		height: auto;
		border-radius: 14px;
	}

	/* An icon is not a screenshot; it does not get to be a metre wide. */
	.shot--square img {
		max-width: 14rem;
		margin-inline: auto;
		border-radius: 22%;
	}

	/* ---------------- next ---------------- */

	.next,
	.back {
		justify-content: center;
	}

	.next__title,
	.back__title {
		color: var(--bone);
	}

	.next__line {
		font-size: 0.85rem;
		color: rgba(251, 246, 236, 0.72);
		max-width: 46ch;
	}

	.next .arrow {
		margin-top: 0.35rem;
	}

	@media (max-width: 46rem) {
		.cover {
			min-height: 16rem;
		}

		.strip__phone {
			height: 15rem;
		}
	}
</style>
