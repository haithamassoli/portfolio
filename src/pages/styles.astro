---
/* Contact sheet for the design variants. Each tile is the real page, scaled
   down in an iframe, so what you pick is what you saw.
   ponytail: delete alongside /1 … /7 once a direction is chosen. */
import Seam from '../components/Seam.astro';
import { styleVariants } from '../data/style-variants';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Design variants · Haitham Assoli</title>
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<Seam />
	</head>
	<body>
		<header class="head">
			<p class="kicker">Contact sheet</p>
			<h1>Seven directions for one portfolio</h1>
			<p class="sub">
				Every tile below is the page itself, running live. Open one, scroll it,
				then use the switcher at the bottom of any variant to jump between them
				&mdash; it keeps you on the same sub-page as you move across. Each
				direction carries the home page, the full project index, a project
				write-up and the hire form, all of them in Arabic and English.
			</p>
		</header>

		<ul class="grid">
			{
				styleVariants.map((v) => (
					<li class="card">
						<a class="hit" href={`/${v.n}`}>
							<span class="frame">
								<iframe
									src={`/${v.n}`}
									title={`${v.name} preview`}
									loading="lazy"
									tabindex="-1"
									scrolling="no"
								/>
							</span>
							<span class="meta">
								<span class="num">{String(v.n).padStart(2, '0')}</span>
								<span class="text">
									<span class="name">{v.name}</span>
									<span class="note">{v.note}</span>
								</span>
							</span>
						</a>
						<nav class="jump" aria-label={`${v.name} pages`}>
							<a href={`/${v.n}/projects`}>Projects</a>
							<a href={`/${v.n}/work/aoun`}>A project</a>
							<a href={`/${v.n}/hire`}>Hire me</a>
						</nav>
					</li>
				))
			}
		</ul>

		<footer class="foot">Prototypes. The live site is still at /.</footer>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
		/* A tile is a fixed width so the preview scale is a plain number:
		   --shot is --tile ÷ 1440, the width the iframe renders at. */
		--tile: 22rem;
		--shot: 0.2444;
	}

	@media (max-width: 30rem) {
		:root {
			--tile: 15rem;
			--shot: 0.1667;
		}
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		padding: clamp(2rem, 6vw, 5rem) clamp(1rem, 4vw, 3.5rem) 7rem;
		background: #0b0b0f;
		color: #e9e9ee;
		font-family:
			ui-sans-serif,
			system-ui,
			-apple-system,
			'Segoe UI',
			sans-serif;
		line-height: 1.6;
	}

	.head {
		max-width: 44rem;
		margin-bottom: clamp(2.5rem, 6vw, 4rem);
	}

	.kicker {
		margin: 0 0 1rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: #7c7c8a;
	}

	.head h1 {
		margin: 0 0 0.75rem;
		font-size: clamp(2rem, 5vw, 3.25rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.05;
	}

	.sub {
		margin: 0;
		color: #9c9caa;
		max-width: 36rem;
	}

	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: clamp(1rem, 2.5vw, 2rem);
		grid-template-columns: repeat(auto-fill, var(--tile));
		justify-content: center;
	}

	.hit {
		display: block;
		text-decoration: none;
		color: inherit;
		border-radius: 0.9rem;
	}

	.hit:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 4px;
	}

	.frame {
		display: block;
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border: 1px solid #24242e;
		border-radius: 0.9rem;
		background: #131319;
		transition:
			border-color 0.2s,
			transform 0.3s cubic-bezier(0.2, 0.9, 0.25, 1);
	}

	.hit:hover .frame {
		border-color: #4a4a5c;
		transform: translateY(-3px);
	}

	/* A desktop-width render, shrunk to the tile. pointer-events off so the
	   whole card stays one link. */
	.frame iframe {
		position: absolute;
		inset: 0;
		width: 1440px;
		height: 1080px;
		border: 0;
		transform-origin: 0 0;
		transform: scale(var(--shot));
		pointer-events: none;
	}

	.meta {
		display: flex;
		gap: 0.9rem;
		align-items: baseline;
		padding: 0.9rem 0.25rem 0;
	}

	.num {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.75rem;
		color: #63636f;
	}

	.text {
		display: flex;
		flex-direction: column;
	}

	.name {
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.note {
		font-size: 0.85rem;
		color: #8c8c9a;
	}

	.jump {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.9rem;
		padding: 0.55rem 0.25rem 0;
		font-size: 0.8rem;
	}

	.jump a {
		color: #8c8c9a;
		text-decoration: none;
		border-bottom: 1px solid #2b2b36;
		padding-bottom: 1px;
	}

	.jump a:hover {
		color: #e9e9ee;
		border-bottom-color: #6b6b80;
	}

	.jump a:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 3px;
	}

	.foot {
		margin-top: 3.5rem;
		font-size: 0.85rem;
		color: #63636f;
	}

	@media (prefers-reduced-motion: reduce) {
		.frame {
			transition: none;
		}
	}
</style>
