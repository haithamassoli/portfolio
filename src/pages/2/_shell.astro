---
/* 静けさ — the shell every /2 sub-page is set in.
   Head, tokens, the shared sheet, the top bar with the language switch,
   the footer with the seal. The pages themselves stay thin. */
import { profile } from '../../../content/profile';
import { pair, s } from '../../data/variant-ui';
import LangBoot from '../../components/LangBoot.astro';
import Seam from '../../components/Seam.astro';
import T from '../../components/T.astro';
import StyleSwitcher from '../../components/StyleSwitcher.astro';
import Logo from '../../components/Logo.astro';

interface Props {
	/** English, for the tab and for search. Both languages live in the body. */
	title: string;
	description: string;
	/** Which nav entry is the page you are on. */
	current?: 'home' | 'projects' | 'hire';
}

const { title, description, current } = Astro.props;

const nav = [
	{ key: 'home', href: '/2', ja: '表紙', t: s('nav.home') },
	{ key: 'projects', href: '/2/projects', ja: '目録', t: s('work.all') },
	{ key: 'hire', href: '/2/hire', ja: '依頼', t: s('nav.hire') },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;1,6..72,300&family=Shippori+Mincho:wght@400;600&family=Zen+Kaku+Gothic+New:wght@400;500&display=swap"
		/>
		<LangBoot />
		<Seam />
	</head>

	<body>
		<a class="skip" href="#main"><T v={s('nav.skip')} /></a>

		<header class="topbar">
			<div class="wrap topbar__in">
				<a class="mark" href="/2">
					<Logo class="mark__logo" />
					<span class="mark__ja" lang="ja" aria-hidden="true">ハイサム</span>
				</a>

				<nav class="nav" aria-label="Pages">
					{
						nav.map((item) => (
							<a
								class="nav__a"
								href={item.href}
								aria-current={item.key === current ? 'page' : undefined}
							>
								<span lang="ja">{item.ja}</span>
								<T v={item.t} class="nav__lat" />
							</a>
						))
					}
				</nav>

				<div class="switch">
					<button
						class="voice"
						type="button"
						data-lang-toggle
						data-l="en"
						lang="ar"
						dir="rtl"
					>
						<span class="voice__ja" lang="ja" aria-hidden="true">語</span>
						اقرأ بالعربية
					</button>
					<button
						class="voice"
						type="button"
						data-lang-toggle
						data-l="ar"
						lang="en"
						dir="ltr"
					>
						<span class="voice__ja" lang="ja" aria-hidden="true">語</span>
						Read in English
					</button>
				</div>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="foot">
			<div class="wrap foot__in">
				<p class="foot__ja" lang="ja">以上</p>
				<p class="foot__en">
					<span lang="ja">作</span>
					<T v={pair('Haitham Assoli', 'هيثم العسولي')} />
					<span aria-hidden="true">·</span>
					<T v={profile.location} />
					<span aria-hidden="true">·</span>
					<T
						v={pair(
							'Set in Shippori Mincho, Newsreader and Amiri',
							'بخطوط Shippori Mincho وNewsreader وAmiri',
						)}
					/>
				</p>
				<div class="foot__seal" aria-hidden="true">
					<div class="hanko">
						<span class="hanko__col" lang="ja">ハイ</span>
						<span class="hanko__col" lang="ja">サム</span>
					</div>
				</div>
			</div>
		</footer>

		<!-- Nothing but this page's own elements, so the router is told to
		     run it again: a script it has already executed is otherwise
		     skipped for the rest of the session. Held in a function because a
		     second run at the top level would redeclare its own names. -->
		<script data-astro-rerun>
			(function () {
				const targets = document.querySelectorAll('.rise');
				const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

				if (reduce.matches || !('IntersectionObserver' in window)) {
					targets.forEach((el) => el.classList.add('is-in'));
				} else {
					const io = new IntersectionObserver(
						(entries) => {
							entries.forEach((entry) => {
								if (!entry.isIntersecting) return;
								entry.target.classList.add('is-in');
								io.unobserve(entry.target);
							});
						},
						{ rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
					);
					targets.forEach((el) => io.observe(el));
				}
			})();
		</script>

		<StyleSwitcher n={2} />

		<style is:global>
			/* ── 静けさ ─────────────────────────────────────────────
			   Aoboku on kinari washi, indigo for the working type, and
			   vermilion twice a page: the edge of the title slip and the
			   seal at the foot. Everything else is 間. */

			:root {
				--kinari: #e7e4db;
				--washi: #f3f1ea;
				--sumi: #1e252b;
				--usuzumi: #6e747a;
				--ai: #2e4257;
				--shu: #c8452c;
				--rule: rgba(30, 37, 43, 0.16);
				--rule-soft: rgba(30, 37, 43, 0.09);

				--jp: 'Shippori Mincho', 'Hiragino Mincho ProN', 'Yu Mincho', serif;
				--body:
					'Newsreader', 'Shippori Mincho', 'Iowan Old Style', Georgia, serif;
				--gothic: 'Zen Kaku Gothic New', 'Hiragino Sans', system-ui, sans-serif;
				/* Amiri is a Naskh cut from the Bulaq press: the same unhurried,
				   pen-made stillness as a Mincho, and no geometry in it anywhere. */
				--ar: 'Amiri', 'Noto Naskh Arabic', 'Al Bayan', serif;

				--gap: clamp(1.5rem, 4vw, 3.25rem);
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html {
				-webkit-text-size-adjust: 100%;
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				padding-bottom: 7rem;
				background-color: var(--kinari);
				color: var(--sumi);
				font-family: var(--body);
				font-size: clamp(1rem, 0.97rem + 0.2vw, 1.075rem);
				font-weight: 300;
				line-height: 1.72;
				overflow-x: hidden;
				-webkit-font-smoothing: antialiased;
			}

			/* Washi is a woven sheet, not a flat colour. */
			body::before {
				content: '';
				position: fixed;
				inset: 0;
				z-index: 0;
				pointer-events: none;
				background-image:
					repeating-linear-gradient(
						93deg,
						rgba(30, 37, 43, 0.026) 0 1px,
						transparent 1px 5px
					),
					repeating-linear-gradient(
						3deg,
						rgba(30, 37, 43, 0.02) 0 1px,
						transparent 1px 8px
					);
			}

			body > * {
				position: relative;
				z-index: 1;
			}

			p,
			h1,
			h2,
			h3,
			h4,
			figure,
			blockquote,
			dl,
			dd,
			fieldset {
				margin: 0;
			}

			fieldset {
				padding: 0;
				border: 0;
				min-inline-size: 0;
			}

			legend {
				padding: 0;
			}

			ol,
			ul {
				margin: 0;
				padding: 0;
				list-style: none;
			}

			img {
				display: block;
				max-width: 100%;
				height: auto;
			}

			a {
				color: inherit;
			}

			:focus-visible {
				outline: 2px solid var(--ai);
				outline-offset: 3px;
			}

			.sr-only {
				position: absolute;
				width: 1px;
				height: 1px;
				margin: -1px;
				padding: 0;
				overflow: hidden;
				clip-path: inset(50%);
				white-space: nowrap;
			}

			/* Clipped rather than parked at -9999px: under dir=rtl an
			   off-canvas element on the left is scrollable, and the whole page
			   gains eleven thousand pixels of nothing. */
			.skip {
				position: absolute;
				inset-block-start: 0.75rem;
				inset-inline-start: 0.75rem;
				z-index: 40;
				padding: 0.6rem 1rem;
				background: var(--sumi);
				color: var(--washi);
				font-family: var(--gothic);
				font-size: 0.8rem;
				clip-path: inset(50%);
			}

			.skip:focus {
				clip-path: none;
			}

			.wrap {
				width: 100%;
				max-width: 78rem;
				margin-inline: auto;
				padding-inline: clamp(1.15rem, 5vw, 4rem);
			}

			/* ── the Arabic voice ─────────────────────────────────
			   Naskh needs air, joins that no tracking can prise apart, and
			   nothing italic or capitalised near it. Marking the element
			   itself keeps the reset off Latin children. */

			[lang='ar'] {
				font-family: var(--ar);
				font-style: normal;
				font-variant: normal;
				letter-spacing: normal;
				text-transform: none;
				line-height: 1.95;
			}

			[lang='ar'] em,
			[lang='ar'] i {
				font-style: normal;
			}

			/* ── vertical setting ─────────────────────────────────
			   In a vertical writing mode `direction` sets the inline
			   progression: rtl would run the Japanese bottom-to-top. Every
			   .tate is Japanese, so it is pinned ltr and survives dir=rtl. */

			.tate {
				writing-mode: vertical-rl;
				direction: ltr;
				text-orientation: mixed;
				font-family: var(--jp);
				font-feature-settings:
					'vkrn' 1,
					'vpal' 1;
				line-height: 1.5;
			}

			.tcy {
				-webkit-text-combine: horizontal;
				text-combine-upright: all; /* 縦中横 */
			}

			/* ── the language switch ──────────────────────────────
			   A 短冊 offered by the voice you are not reading in. Only one
			   of the two is ever in the page, so there is never a control
			   asking you to switch to where you already are. */

			.voice {
				display: inline-flex;
				align-items: baseline;
				gap: 0.45rem;
				margin: 0;
				padding: 0.32rem 0.75rem;
				border: 1px solid var(--rule);
				background: var(--washi);
				color: var(--ai);
				font-family: var(--gothic);
				font-size: 0.74rem;
				font-weight: 500;
				letter-spacing: 0.08em;
				line-height: 1.4;
				cursor: pointer;
				transition:
					border-color 0.25s,
					background-color 0.25s,
					color 0.25s;
			}

			.voice[lang='ar'] {
				font-size: 0.92rem;
				font-weight: 400;
				line-height: 1.6;
			}

			.voice__ja {
				font-family: var(--jp);
				font-size: 0.85em;
				letter-spacing: 0.1em;
				color: var(--usuzumi);
			}

			.voice:hover {
				border-color: var(--ai);
				background: var(--kinari);
			}

			.voice:hover .voice__ja {
				color: var(--ai);
			}

			/* ── top bar ──────────────────────────────────────── */

			.topbar {
				border-bottom: 1px solid var(--rule-soft);
			}

			.topbar__in {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5rem clamp(1rem, 3vw, 2rem);
				min-height: 3.75rem;
				padding-block: 0.6rem;
			}

			.mark {
				display: inline-flex;
				align-items: baseline;
				gap: 0.55rem;
				text-decoration: none;
			}

			/* The name written in sumi, on an indigo rule — the working line
			   the kana beside it sits on too. */
			.mark .mark__logo {
				block-size: clamp(1.05rem, 0.9rem + 0.5vw, 1.35rem);
				inline-size: auto;
				color: var(--sumi);
				--logo-rule: var(--ai);
			}

			.mark__ja {
				font-family: var(--jp);
				font-size: 0.95rem;
				letter-spacing: 0.12em;
				color: var(--ai);
			}

			.nav {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.35rem clamp(0.9rem, 2.6vw, 1.85rem);
				margin-inline-end: auto;
			}

			.nav__a {
				display: inline-flex;
				align-items: baseline;
				gap: 0.4rem;
				padding-block: 0.35rem;
				font-family: var(--jp);
				font-size: 0.95rem;
				white-space: nowrap;
				text-decoration: none;
				border-bottom: 1px solid transparent;
				transition:
					border-color 0.25s,
					color 0.25s;
			}

			.nav__a:hover {
				color: var(--ai);
				border-bottom-color: var(--ai);
			}

			.nav__a[aria-current='page'] {
				color: var(--ai);
				border-bottom-color: var(--ai);
			}

			.nav__lat {
				font-family: var(--gothic);
				font-size: 0.66rem;
				font-weight: 500;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--usuzumi);
			}

			.nav__lat[lang='ar'] {
				font-family: var(--ar);
				font-size: 0.85rem;
				font-weight: 400;
			}

			/* ── 題簽 — the title slip, pasted at the head of the page.
			   A bound book carries its title on a slip with a vermilion
			   edge. That edge is the first of the page's two reds. ── */

			.daisen {
				display: grid;
				grid-template-columns: auto minmax(0, 1fr);
				gap: clamp(1.25rem, 4vw, 2.75rem);
				align-items: start;
				margin-top: clamp(2rem, 5vw, 3.5rem);
				padding: clamp(1.4rem, 4vw, 2.5rem) clamp(1.25rem, 4vw, 2.5rem);
				background: var(--washi);
				border: 1px solid var(--rule-soft);
				border-inline-start: 2px solid var(--shu);
				box-shadow:
					0 1px 0 rgba(255, 255, 255, 0.7) inset,
					0 16px 30px -26px rgba(30, 37, 43, 0.6);
			}

			.daisen__ja {
				margin: 0;
				height: clamp(6rem, 16vw, 9.5rem);
				font-size: clamp(1.25rem, 1rem + 1.2vw, 1.75rem);
				font-weight: 600;
				letter-spacing: 0.3em;
				color: var(--ai);
			}

			.daisen__h {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0.85rem;
				font-family: var(--body);
				font-size: clamp(1.9rem, 1.25rem + 2.6vw, 3.15rem);
				font-weight: 300;
				line-height: 1.1;
				letter-spacing: -0.01em;
			}

			.daisen__h [data-l='ar'] {
				font-family: var(--ar);
				font-size: 0.9em;
				font-weight: 400;
				line-height: 1.4;
			}

			.daisen__hja {
				font-family: var(--jp);
				font-size: 0.4em;
				font-weight: 400;
				letter-spacing: 0.3em;
				color: var(--usuzumi);
			}

			.daisen__lede {
				margin-top: 1rem;
				max-width: 38em;
				color: #3a4249;
			}

			.daisen__lede[lang='ar'] {
				max-width: 34em;
			}

			/* ── shared section furniture ─────────────────────── */

			.band {
				padding-block: clamp(2.5rem, 6vw, 5rem);
			}

			.marker {
				margin: 0;
				justify-self: center;
				font-size: 1.1rem;
				font-weight: 600;
				letter-spacing: 0.4em;
				color: var(--ai);
			}

			.fold {
				height: 2.75rem;
				border-top: 1px solid var(--rule);
				background: linear-gradient(
					to bottom,
					rgba(30, 37, 43, 0.075),
					rgba(30, 37, 43, 0) 62%
				);
			}

			.lnk {
				display: inline-flex;
				align-items: baseline;
				gap: 0.4rem;
				font-family: var(--gothic);
				font-size: 0.74rem;
				font-weight: 500;
				letter-spacing: 0.09em;
				color: var(--ai);
				text-decoration: none;
				border-bottom: 1px solid rgba(46, 66, 87, 0.32);
				padding-bottom: 0.1rem;
				transition: border-color 0.25s;
			}

			.lnk [lang='ja'] {
				font-family: var(--jp);
				letter-spacing: 0.16em;
				color: var(--usuzumi);
			}

			.lnk [lang='ar'] {
				font-family: var(--ar);
				font-size: 0.9rem;
				font-weight: 400;
			}

			.lnk:hover {
				border-bottom-color: var(--ai);
			}

			/* ── 判子 — the seal, the page's second and last red ── */

			.hanko {
				display: flex;
				flex-direction: row-reverse;
				direction: ltr;
				gap: 0.2rem;
				padding: 0.6rem 0.55rem;
				background: var(--shu);
				color: var(--kinari);
				box-shadow:
					0 0 0 1.5px var(--shu),
					0 0 0 3.5px rgba(200, 69, 44, 0.16);
				transform: rotate(4deg);
			}

			.hanko__col {
				writing-mode: vertical-rl;
				direction: ltr;
				text-orientation: upright;
				font-family: var(--jp);
				font-size: 1.05rem;
				font-weight: 600;
				letter-spacing: 0.06em;
			}

			/* ── footer ───────────────────────────────────────── */

			.foot {
				padding-block: clamp(2.5rem, 5vw, 3.5rem) 1rem;
			}

			.foot__in {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding-top: 1.25rem;
				border-top: 1px solid var(--rule-soft);
			}

			.foot__ja {
				font-family: var(--jp);
				font-size: 0.95rem;
				letter-spacing: 0.5em;
				color: var(--ai);
			}

			.foot__en {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0.4rem;
				font-family: var(--gothic);
				font-size: 0.72rem;
				letter-spacing: 0.06em;
				color: var(--usuzumi);
			}

			.foot__en [lang='ja'] {
				font-family: var(--jp);
				letter-spacing: 0.2em;
				color: var(--sumi);
			}

			.foot__en [lang='ar'] {
				font-family: var(--ar);
				font-size: 0.9rem;
			}

			/* ── entrances ────────────────────────────────────── */

			.rise {
				opacity: 0;
				transform: translateY(14px);
				transition:
					opacity 0.75s ease,
					transform 0.75s cubic-bezier(0.2, 0.7, 0.2, 1);
			}

			.rise.is-in {
				opacity: 1;
				transform: none;
			}

			@media (max-width: 48rem) {
				.nav__lat,
				.mark__ja {
					display: none;
				}

				.daisen {
					grid-template-columns: minmax(0, 1fr);
					gap: 1rem;
				}

				/* No gutter to stand a column in: the slip's title lies down. */
				.daisen__ja {
					writing-mode: horizontal-tb;
					height: auto;
					font-size: 1.05rem;
					letter-spacing: 0.45em;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}

				*,
				*::before,
				*::after {
					animation-duration: 0.001ms !important;
					animation-iteration-count: 1 !important;
					transition-duration: 0.001ms !important;
				}

				.rise {
					opacity: 1;
					transform: none;
				}
			}
		</style>
	</body>
</html>
