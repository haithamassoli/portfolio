---
import { Image } from 'astro:assets';
import { profile } from '../../content/profile';
import { featured, projects } from '../data/projects';
import { toolbox } from '../i18n';
import StyleSwitcher from '../components/StyleSwitcher.astro';
import profilePhoto from '../assets/images/profile.png';

/* The hero toy. Front faces spell HAITHAM left to right; back faces spell
   العسولي right to left. Seven tiles either way, so the board mirrors without
   changing shape — which is the whole argument the page is making. */
const tiles = [
	{ en: 'H', ar: 'ا', hue: 'melon' },
	{ en: 'A', ar: 'ل', hue: 'sky' },
	{ en: 'I', ar: 'ع', hue: 'bubble' },
	{ en: 'T', ar: 'س', hue: 'sun' },
	{ en: 'H', ar: 'و', hue: 'mint' },
	{ en: 'A', ar: 'ل', hue: 'melon' },
	{ en: 'M', ar: 'ي', hue: 'sky' },
];

/* Five counters, five true numbers. */
const counters = [
	{ n: '39', label: 'things shipped', hue: 'sun' },
	{ n: '13', label: 'of them in the app stores', hue: 'melon' },
	{ n: '8', label: 'written up in full', hue: 'bubble' },
	{ n: '4', label: 'years of building, roughly', hue: 'mint' },
	{ n: '2', label: 'scripts, both first-class', hue: 'sky' },
];

/* Card colours come from this page's palette, not from the project accents,
   so eight loud cards still read as one set. Cycle of five: no two neighbours
   in the two-column grid land on the same colour. */
const hues = ['melon', 'sky', 'bubble', 'sun', 'ink'];

const statusLabel: Record<string, string> = {
	live: 'Live',
	shipped: 'Shipped',
	delisted: 'Delisted',
	wip: 'In progress',
	archived: 'Archived',
};

const linkLabel: Record<string, string> = {
	live: 'Visit',
	github: 'Code',
	appStore: 'App Store',
	playGoogle: 'Google Play',
	vscode: 'VS Code',
};

const rest = projects.filter((p) => !p.featured);

const mailto = `mailto:${profile.email}?subject=${encodeURIComponent('Building something together')}`;

const elsewhere = [
	{ label: 'GitHub', href: profile.links.github, hue: 'sun' },
	{ label: 'LinkedIn', href: profile.links.linkedin, hue: 'mint' },
	{ label: 'assoli.site', href: profile.links.website, hue: 'bubble' },
	{ label: 'The CV', href: profile.links.resume, hue: 'sky' },
	{ label: 'Google Play', href: profile.links.playStore, hue: 'sun' },
];
---

<!doctype html>
<html lang="en" dir="ltr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Haitham Assoli — every screen has to work twice</title>
		<meta
			name="description"
			content="Haitham Assoli builds bilingual web and mobile products in Amman: React Native and Expo on both stores, Next.js and Astro on the web, and on-device AI that never phones home."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@700&family=Lalezar&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>

	<body class="playroom">
		<a class="skip" href="#work">Skip to the work</a>

		<main id="top">
			<!-- ============================ HERO ============================ -->
			<header class="hero field field--sun" id="hero">
				<div class="hero__glow" aria-hidden="true"></div>

				<div class="wrap hero__grid">
					<div class="hero__text">
						<p class="whoami">
							<span class="whoami__sticker">Haitham Assoli</span>
							<span class="whoami__role"
								>Web &amp; mobile full-stack engineer, Amman, Jordan</span
							>
						</p>

						<h1 class="thesis">
							Every screen I build has to work <span class="stretch">twice</span
							>.
						</h1>

						<p class="lede">
							Once in English, running left to right. Once in Arabic, running
							right to left. Same product, flipped on its axis — and a mirrored
							interface is a <em>different</em> interface, not a translation. Four
							years of that: 39 shipped, 13 of them sitting in the app stores.
						</p>

						<div class="cta-row">
							<a class="btn btn--melon" href={mailto}>Email me</a>
							<a class="btn btn--ghost" href="#work">See the work</a>
						</div>
					</div>

					<div class="hero__photo">
						<Image
							class="photo"
							src={profilePhoto}
							alt="Haitham Assoli"
							widths={[240, 480]}
							sizes="240px"
							loading="eager"
						/>
						<span class="photo__tag" aria-hidden="true">that's me</span>
					</div>
				</div>

				<!-- ---------------------- the signature toy ---------------------- -->
				<div class="wrap">
					<section class="toy" aria-labelledby="toy-title">
						<div class="toy__head">
							<h2 class="toy__title" id="toy-title">Pull the lever</h2>
							<p class="toy__note">
								Seven tiles, two scripts, one board. Poke a tile to flip it, or
								throw the whole thing into right-to-left and watch the layout,
								the letters and the shadows change sides at once.
							</p>
						</div>

						<div class="toy__board" id="board">
							<div class="tiles" id="tiles">
								{
									tiles.map((t, i) => (
										<button
											type="button"
											class={`tile tile--${t.hue}`}
											style={`--i:${i}`}
											data-tile
											aria-pressed="false"
											aria-label={`Flip tile ${i + 1}: ${t.en} to ${t.ar}`}
										>
											<span
												class="tile__face tile__face--en"
												aria-hidden="true"
											>
												{t.en}
											</span>
											<span
												class="tile__face tile__face--ar"
												aria-hidden="true"
											>
												{t.ar}
											</span>
										</button>
									))
								}
							</div>

							<button
								type="button"
								class="lever"
								id="lever"
								aria-pressed="false"
								aria-controls="board"
							>
								<span class="lever__knob" aria-hidden="true"></span>
								<span
									class="lever__label"
									data-off="Mirror it"
									data-on="Put it back">Mirror it</span
								>
							</button>
						</div>

						<p class="toy__caption">
							<span class="latin">HAITHAM</span>
							<span class="toy__arrow" aria-hidden="true">⇄</span>
							<span class="arabic">العسولي</span>
						</p>
					</section>
				</div>
			</header>

			<!-- =========================== COUNTERS =========================== -->
			<section class="field field--ink counters" aria-labelledby="count-title">
				<div class="wrap">
					<h2 class="section__title" id="count-title">The scoreboard</h2>
					<ul class="counter-row">
						{
							counters.map((c, i) => (
								<li class={`counter counter--${c.hue}`} style={`--i:${i}`}>
									<span class="counter__n">{c.n}</span>
									<span class="counter__label">{c.label}</span>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- ============================= WORK ============================= -->
			<section
				class="field field--mint work"
				id="work"
				aria-labelledby="work-title"
			>
				<div class="wrap">
					<header class="section__head">
						<p class="eyebrow">The shelf</p>
						<h2 class="section__title" id="work-title">
							Eight I'd hand you first
						</h2>
						<p class="section__lede">
							Thirty-nine shipped in all. These eight have the full write-up:
							what it had to do, what it cost, and what I'd do differently.
						</p>
					</header>

					<ul class="cards">
						{
							featured.map((p, i) => (
								<li
									class={`card card--${hues[i % hues.length]}`}
									style={`--i:${i}`}
								>
									<div class="card__bar">
										<h3 class="card__title">
											<a href={`/work/${p.slug}`}>{p.title.en}</a>
										</h3>
										<span class="card__year">{p.year}</span>
									</div>

									<div class="card__body">
										{p.image && (
											<div class="card__shot">
												<Image
													src={p.image}
													alt={`${p.title.en} — ${p.tagline.en}`}
													widths={[360, 720]}
													sizes="(min-width: 860px) 38vw, 88vw"
													loading="lazy"
												/>
											</div>
										)}

										<p class="card__tagline">{p.tagline.en}</p>
										<p class="card__summary">{p.summary.en}</p>

										<p class="card__role">{p.role.en}</p>

										<ul class="chips">
											{p.stack.slice(0, 5).map((s) => (
												<li class="chip">{s}</li>
											))}
										</ul>

										<div class="card__foot">
											<span class="sticker sticker--sm">
												{statusLabel[p.status] ?? p.status}
											</span>
											<span class="sticker sticker--sm sticker--plain">
												{p.category}
											</span>
											{Object.entries(p.links).map(([k, url]) =>
												url ? (
													<a class="link-pill" href={url as string}>
														{linkLabel[k] ?? k}
													</a>
												) : null,
											)}
										</div>
									</div>
								</li>
							))
						}
					</ul>

					<div class="spill">
						<h3 class="spill__title">The other {rest.length}, tipped out</h3>
						<ul class="spill__list">
							{
								rest.map((p, i) => (
									<li style={`--i:${i}`}>
										<a class="spill__chip" href={`/work/${p.slug}`}>
											{p.title.en}
										</a>
									</li>
								))
							}
						</ul>
						<a class="btn btn--ink" href="/work">Open the whole shelf</a>
					</div>
				</div>
			</section>

			<!-- ============================ ABOUT ============================ -->
			<section
				class="field field--bubble about"
				id="about"
				aria-labelledby="about-title"
			>
				<div class="wrap about__grid">
					<div class="about__text">
						<p class="eyebrow">Who's doing the building</p>
						<h2 class="section__title" id="about-title">
							{profile.name.en}
							<span class="about__ar" lang="ar" dir="rtl"
								>{profile.name.ar}</span
							>
						</h2>

						{profile.about.en.map((para) => <p class="about__para">{para}</p>)}

						<p class="about__where">
							{profile.title.en} · {profile.location.en}
						</p>
					</div>

					<div class="about__stack">
						<h3 class="mini-title">Where the hours went</h3>
						<ul class="jobs">
							{
								profile.experience.map((job) => (
									<li class="job">
										<span class="job__co">{job.company.en}</span>
										<span class="job__role">{job.role.en}</span>
										<span class="job__when">{job.period}</span>
									</li>
								))
							}
						</ul>

						<h3 class="mini-title">School</h3>
						<ul class="jobs jobs--school">
							{
								profile.education.map((ed) => (
									<li class="job">
										<span class="job__co">{ed.school.en}</span>
										<span class="job__role">{ed.degree.en}</span>
										<span class="job__when">
											{ed.period}
											{ed.note ? ` · ${ed.note.en}` : ''}
										</span>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</section>

			<!-- =========================== TOOLBOX =========================== -->
			<section class="field field--sky toolbox" aria-labelledby="tools-title">
				<div class="wrap">
					<header class="section__head">
						<p class="eyebrow">The toy chest</p>
						<h2 class="section__title" id="tools-title">What I reach for</h2>
						<p class="section__lede">
							Roughly in the order it shows up in the work. TypeScript at the
							front because it is in nearly all of it.
						</p>
					</header>

					<ul class="tools">
						{
							toolbox.map((tool, i) => (
								<li class="tool" style={`--i:${i}`}>
									{tool}
								</li>
							))
						}
					</ul>

					<div class="lately">
						<h3 class="mini-title mini-title--light">And lately, on-device</h3>
						<ul class="tools tools--alt">
							{
								profile.skills.ai.map((tool, i) => (
									<li class="tool tool--alt" style={`--i:${i}`}>
										{tool}
									</li>
								))
							}
						</ul>
						<p class="lately__note">
							Video and audio processed entirely on the user's phone or laptop.
							No cloud, no account, no telemetry.
						</p>
					</div>
				</div>
			</section>

			<!-- ============================= HIRE ============================= -->
			<section
				class="field field--melon hire"
				id="hire"
				aria-labelledby="hire-title"
			>
				<div class="wrap hire__grid">
					<div>
						<p class="eyebrow">Open box</p>
						<h2 class="section__title" id="hire-title">
							Got something that has to ship twice?
						</h2>
						<p class="section__lede hire__lede">
							Tell me what it has to do and who reads it in which direction.
							I'll tell you what I'd build, how long it takes, and what I'd cut.
						</p>

						<div class="cta-row">
							<a class="btn btn--ink btn--big" href={mailto}>
								{profile.email}
							</a>
							<a
								class="btn btn--ghost"
								href={`tel:${profile.phone.replace(/\s/g, '')}`}
							>
								{profile.phone}
							</a>
						</div>
					</div>

					<ul class="elsewhere">
						{
							elsewhere.map((l, i) => (
								<li style={`--i:${i}`}>
									<a class={`slab slab--${l.hue}`} href={l.href}>
										{l.label}
										<span class="slab__arrow" aria-hidden="true">
											→
										</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</section>
		</main>

		<footer class="field field--ink foot">
			<div class="wrap foot__grid">
				<p class="foot__name">
					<span>Haitham Assoli</span>
					<span class="arabic" lang="ar" dir="rtl">هيثم العسولي</span>
				</p>
				<p class="foot__note">
					Built in Amman with Astro and hand-written CSS. Every colour on this
					page is one of six.
				</p>
				<ul class="foot__links">
					<li><a href="#top">Back to the top</a></li>
					<li><a href="/work">All 39 projects</a></li>
					<li><a href={profile.links.github}>GitHub</a></li>
					<li><a href={mailto}>Email</a></li>
				</ul>
			</div>
		</footer>

		<script is:inline>
			(function () {
				const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
				const board = document.getElementById('board');
				const lever = document.getElementById('lever');
				const tiles = Array.prototype.slice.call(
					document.querySelectorAll('[data-tile]'),
				);

				function setTile(el, on) {
					el.classList.toggle('is-flipped', on);
					el.setAttribute('aria-pressed', on ? 'true' : 'false');
				}

				tiles.forEach(function (el) {
					el.addEventListener('click', function () {
						setTile(el, el.getAttribute('aria-pressed') !== 'true');
					});
				});

				if (lever && board) {
					lever.addEventListener('click', function () {
						const on = lever.getAttribute('aria-pressed') !== 'true';
						lever.setAttribute('aria-pressed', on ? 'true' : 'false');
						board.classList.toggle('is-mirrored', on);
						board.setAttribute('dir', on ? 'rtl' : 'ltr');
						const label = lever.querySelector('.lever__label');
						if (label)
							label.textContent = label.dataset[on ? 'on' : 'off'] || '';
						tiles.forEach(function (el, i) {
							setTimeout(
								function () {
									setTile(el, on);
								},
								reduce.matches ? 0 : i * 55,
							);
						});
					});
				}

				/* The cursor moves the light: shadows on the hero lean away from it. */
				const hero = document.getElementById('hero');
				if (hero && window.matchMedia('(pointer: fine)').matches) {
					hero.addEventListener('pointermove', function (e) {
						if (reduce.matches) return;
						const r = hero.getBoundingClientRect();
						hero.style.setProperty(
							'--mx',
							((e.clientX - r.left) / r.width).toFixed(3),
						);
						hero.style.setProperty(
							'--my',
							((e.clientY - r.top) / r.height).toFixed(3),
						);
					});
				}
			})();
		</script>

		<StyleSwitcher n={7} />
	</body>
</html>

<style is:global>
	/* ==========================================================================
	   PLAYROOM — the system underneath the noise.
	   Six colours. One radius scale. One shadow scale (hard, offset, ink).
	   One motion curve with overshoot. Everything else is arrangement.
	   ========================================================================== */

	.playroom {
		--ink: #171033;
		--sun: #ffcf2d;
		--mint: #9befd0;
		--melon: #ff4b34;
		--sky: #2d5bff;
		--bubble: #ff6fb5;
		--paper: #ffffff;

		--r1: 10px;
		--r2: 20px;
		--r3: 34px;
		--pill: 999px;
		--b: 3px;

		--s1: 3px 3px 0 var(--ink);
		--s2: 6px 6px 0 var(--ink);
		--s3: 10px 10px 0 var(--ink);

		--spring: cubic-bezier(0.34, 1.56, 0.64, 1);
		--snap: cubic-bezier(0.2, 0.9, 0.25, 1);

		--display: 'Bricolage Grotesque', system-ui, sans-serif;
		--body: 'Space Grotesk', system-ui, sans-serif;
		--mono: 'Space Mono', ui-monospace, monospace;
		--arabic: 'Lalezar', 'Bricolage Grotesque', system-ui, sans-serif;

		--focus: var(--ink);
	}

	.playroom *,
	.playroom *::before,
	.playroom *::after {
		box-sizing: border-box;
	}

	html:has(.playroom),
	.playroom {
		overflow-x: clip;
	}

	.playroom {
		margin: 0;
		padding: 0;
		background: var(--ink);
		color: var(--ink);
		font-family: var(--body);
		font-size: clamp(1rem, 0.96rem + 0.2vw, 1.075rem);
		line-height: 1.55;
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}

	/* Resets stay at zero specificity (`:where`) so every class below wins
	   without a fight. */
	.playroom :where(h1, h2, h3) {
		font-family: var(--display);
		font-weight: 800;
		line-height: 0.95;
		letter-spacing: -0.02em;
		margin: 0;
		text-wrap: balance;
	}

	.playroom :where(p) {
		margin: 0;
	}

	.playroom :where(ul) {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.playroom :where(img) {
		display: block;
		max-width: 100%;
		height: auto;
	}

	.playroom :where(a) {
		color: inherit;
	}

	/* One focus ring, everywhere, tuned per field. */
	.playroom :is(a, button, summary, [tabindex]):focus-visible {
		outline: 3px solid var(--focus);
		outline-offset: 4px;
		border-radius: var(--r1);
	}

	.skip {
		position: absolute;
		left: -9999px;
		top: 0.5rem;
		z-index: 50;
		padding: 0.7rem 1.1rem;
		background: var(--ink);
		color: var(--sun);
		font-family: var(--mono);
		border-radius: var(--pill);
	}

	.skip:focus-visible {
		left: 0.75rem;
	}

	/* ---------------------------- fields + wrap ---------------------------- */

	.field {
		position: relative;
		padding-block: clamp(3.5rem, 8vw, 6.5rem);
	}

	.field--sun {
		background: var(--sun);
	}
	.field--mint {
		background: var(--mint);
	}
	.field--bubble {
		background: var(--bubble);
	}
	.field--melon {
		background: var(--melon);
	}
	.field--sky {
		background: var(--sky);
		color: var(--paper);
		--focus: var(--sun);
	}
	.field--ink {
		background: var(--ink);
		color: var(--paper);
		--focus: var(--sun);
	}

	/* A hard rule between fields, so the colour changes read as an edge. */
	.field + .field {
		border-top: var(--b) solid var(--ink);
	}

	.wrap {
		width: min(1180px, 100% - clamp(1.25rem, 5vw, 4rem));
		margin-inline: auto;
	}

	.eyebrow {
		font-family: var(--mono);
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		margin-bottom: 0.85rem;
	}

	.section__title {
		font-size: clamp(2rem, 5.4vw, 3.6rem);
		font-variation-settings: 'wdth' 92;
	}

	.section__head {
		max-width: 46ch;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	.section__lede {
		margin-top: 1rem;
		font-size: 1.05rem;
		max-width: 52ch;
	}

	.mini-title {
		font-family: var(--mono);
		font-size: 0.72rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		margin: 0 0 0.9rem;
	}

	/* ------------------------------- buttons ------------------------------- */

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.85rem 1.4rem;
		border: var(--b) solid var(--ink);
		border-radius: var(--pill);
		background: var(--paper);
		box-shadow: var(--s2);
		font-family: var(--display);
		font-weight: 700;
		font-size: 1.05rem;
		letter-spacing: -0.01em;
		text-decoration: none;
		cursor: pointer;
		transition:
			transform 0.22s var(--spring),
			box-shadow 0.22s var(--spring);
	}

	.btn:hover {
		transform: translate(-2px, -2px);
		box-shadow: var(--s3);
	}

	.btn:active {
		transform: translate(6px, 6px);
		box-shadow: 0 0 0 var(--ink);
	}

	.btn--melon {
		background: var(--melon);
	}
	.btn--ink {
		background: var(--ink);
		color: var(--sun);
	}
	.btn--ghost {
		background: transparent;
		box-shadow: var(--s1);
	}
	.btn--ghost:hover {
		box-shadow: var(--s2);
	}
	.btn--big {
		font-size: clamp(1rem, 2.6vw, 1.35rem);
		padding: 1rem 1.6rem;
		word-break: break-word;
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: 1.9rem;
	}

	/* ================================ HERO ================================ */

	.hero {
		--mx: 0.5;
		--my: 0.3;
		padding-top: clamp(2.5rem, 6vw, 4.5rem);
		overflow: clip;
	}

	.hero__glow {
		position: absolute;
		inset: 0;
		background: radial-gradient(
			38rem 38rem at calc(var(--mx) * 100%) calc(var(--my) * 100%),
			rgba(255, 255, 255, 0.55),
			rgba(255, 255, 255, 0) 62%
		);
		pointer-events: none;
	}

	.hero__grid {
		position: relative;
		display: grid;
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: start;
	}

	@media (min-width: 880px) {
		.hero__grid {
			grid-template-columns: minmax(0, 1fr) 15rem;
		}
	}

	.whoami {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.4rem;
	}

	.whoami__sticker {
		display: inline-block;
		padding: 0.4rem 0.9rem;
		background: var(--ink);
		color: var(--sun);
		border-radius: var(--pill);
		font-family: var(--mono);
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		transform: rotate(-2deg);
		box-shadow: 0 0 0 4px var(--sun);
	}

	.whoami__role {
		font-family: var(--mono);
		font-size: 0.76rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.thesis {
		font-size: clamp(2.6rem, 9.5vw, 6.4rem);
		font-variation-settings: 'wdth' 78;
		letter-spacing: -0.035em;
	}

	.thesis .stretch {
		display: inline-block;
		padding-inline: 0.12em;
		background: var(--melon);
		border: var(--b) solid var(--ink);
		border-radius: var(--r2);
		box-shadow: var(--s2);
		transition:
			font-variation-settings 0.4s var(--spring),
			transform 0.4s var(--spring);
	}

	.thesis .stretch:hover,
	.hero:focus-within .thesis .stretch {
		font-variation-settings: 'wdth' 100;
		transform: rotate(-1.5deg) scale(1.02);
	}

	.lede {
		margin-top: 1.4rem;
		max-width: 54ch;
		font-size: clamp(1.02rem, 1.6vw, 1.2rem);
	}

	.lede em {
		font-style: normal;
		background: var(--paper);
		box-shadow: 0 0 0 3px var(--paper);
		border-radius: 3px;
	}

	.hero__photo {
		position: relative;
		justify-self: start;
		width: min(15rem, 62vw);
		transform: rotate(3deg);
	}

	@media (min-width: 880px) {
		.hero__photo {
			justify-self: end;
		}

		.photo__tag {
			inset-inline-start: -0.9rem;
		}
	}

	.photo {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		border: var(--b) solid var(--ink);
		border-radius: var(--r3);
		background: var(--bubble);
		box-shadow: var(--s3);
	}

	.photo__tag {
		position: absolute;
		inset-block-end: -0.85rem;
		inset-inline-start: 0.6rem;
		padding: 0.35rem 0.8rem;
		background: var(--sky);
		color: var(--paper);
		border: var(--b) solid var(--ink);
		border-radius: var(--pill);
		font-family: var(--mono);
		font-size: 0.72rem;
		transform: rotate(-8deg);
	}

	/* ------------------------ the toy: flip board ------------------------ */

	/* The board is an enhancement: without scripting there is nothing to pull,
	   so it does not appear at all. Every fact it carries is elsewhere too. */
	.toy {
		display: none;
	}

	.js .toy {
		display: block;
		position: relative;
		margin-top: clamp(2.5rem, 6vw, 4rem);
		padding: clamp(1.25rem, 3.5vw, 2.25rem);
		background: var(--paper);
		border: var(--b) solid var(--ink);
		border-radius: var(--r3);
		box-shadow: var(--s3);
	}

	.toy__head {
		display: grid;
		gap: 0.6rem;
		max-width: 58ch;
		margin-bottom: 1.6rem;
	}

	.toy__title {
		font-size: clamp(1.5rem, 3.6vw, 2.2rem);
	}

	.toy__note {
		font-size: 0.95rem;
	}

	.toy__board {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: clamp(0.75rem, 2.5vw, 1.5rem);
	}

	.tiles {
		display: flex;
		gap: clamp(0.3rem, 1.1vw, 0.6rem);
		flex: 1 1 auto;
		min-width: 0;
	}

	/* `dir="rtl"` on the board already lays the tiles out right to left, so the
	   back faces read العسولي in the right order. Nothing else to reverse. */

	/* Mirror the light too: in RTL the shadows fall the other way. */
	.toy__board.is-mirrored .tile,
	.toy__board.is-mirrored .lever {
		box-shadow: -6px 6px 0 var(--ink);
	}

	.toy__board.is-mirrored .tile:hover,
	.toy__board.is-mirrored .lever:hover {
		box-shadow: -10px 10px 0 var(--ink);
	}

	.toy__board.is-mirrored .tile:active,
	.toy__board.is-mirrored .lever:active {
		box-shadow: -3px 3px 0 var(--ink);
	}

	.tile {
		position: relative;
		flex: 1 1 0;
		min-width: 0;
		aspect-ratio: 3 / 4;
		max-width: 5.5rem;
		padding: 0;
		border: var(--b) solid var(--ink);
		border-radius: var(--r1);
		background: var(--paper);
		box-shadow: var(--s2);
		cursor: pointer;
		transform-style: preserve-3d;
		transition:
			transform 0.55s var(--spring),
			box-shadow 0.3s var(--snap);
		animation: settle 0.7s var(--spring) backwards;
		animation-delay: calc(var(--i) * 60ms);
	}

	.tile:hover {
		box-shadow: var(--s3);
	}

	.tile:active {
		box-shadow: var(--s1);
	}

	.tile.is-flipped {
		transform: rotateY(180deg);
	}

	.tile__face {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		border-radius: 7px;
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
		font-size: clamp(1.4rem, 5.5vw, 3rem);
		line-height: 1;
		color: var(--ink);
	}

	.tile__face--en {
		font-family: var(--display);
		font-weight: 800;
		font-variation-settings: 'wdth' 82;
	}

	.tile__face--ar {
		font-family: var(--arabic);
		transform: rotateY(180deg);
		padding-bottom: 0.12em;
		font-size: clamp(1.7rem, 6.5vw, 3.4rem);
	}

	.tile--melon .tile__face--en {
		background: var(--melon);
	}
	.tile--sky .tile__face--en {
		background: var(--sky);
		color: var(--paper);
	}
	.tile--bubble .tile__face--en {
		background: var(--bubble);
	}
	.tile--sun .tile__face--en {
		background: var(--sun);
	}
	.tile--mint .tile__face--en {
		background: var(--mint);
	}

	.tile--melon .tile__face--ar {
		background: var(--sun);
	}
	.tile--sky .tile__face--ar {
		background: var(--mint);
	}
	.tile--bubble .tile__face--ar {
		background: var(--sun);
	}
	.tile--sun .tile__face--ar {
		background: var(--bubble);
	}
	.tile--mint .tile__face--ar {
		background: var(--melon);
	}

	.lever {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.6rem 1.1rem 0.6rem 0.6rem;
		border: var(--b) solid var(--ink);
		border-radius: var(--pill);
		background: var(--sun);
		box-shadow: var(--s2);
		font-family: var(--display);
		font-weight: 700;
		font-size: 1rem;
		cursor: pointer;
		transition:
			transform 0.25s var(--spring),
			box-shadow 0.25s var(--spring),
			background-color 0.25s var(--snap);
	}

	.lever__knob {
		width: 2.6rem;
		height: 1.5rem;
		border: var(--b) solid var(--ink);
		border-radius: var(--pill);
		background: var(--paper);
		position: relative;
	}

	.lever__knob::after {
		content: '';
		position: absolute;
		top: 1px;
		inset-inline-start: 1px;
		width: 1rem;
		height: 1rem;
		border-radius: 50%;
		background: var(--ink);
		transition: transform 0.35s var(--spring);
	}

	.lever[aria-pressed='true'] {
		background: var(--sky);
		color: var(--paper);
	}

	.lever[aria-pressed='true'] .lever__knob::after {
		transform: translateX(1.1rem);
	}

	.toy__board.is-mirrored .lever[aria-pressed='true'] .lever__knob::after {
		transform: translateX(-1.1rem);
	}

	.lever:hover {
		transform: translate(-2px, -2px);
		box-shadow: var(--s3);
	}

	.lever:active {
		transform: translate(4px, 4px);
		box-shadow: 0 0 0 var(--ink);
	}

	.toy__caption {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin-top: 1.3rem;
		font-size: 0.85rem;
	}

	.toy__caption .latin {
		font-family: var(--mono);
		letter-spacing: 0.24em;
	}

	.toy__caption .arabic,
	.foot__name .arabic {
		font-family: var(--arabic);
		font-size: 1.5em;
		line-height: 1;
	}

	.toy__arrow {
		font-size: 1.1rem;
	}

	/* ============================== COUNTERS ============================== */

	.counters .section__title {
		font-size: clamp(1.5rem, 3.4vw, 2.1rem);
		margin-bottom: 1.6rem;
		color: var(--paper);
	}

	.counter-row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
		gap: clamp(0.75rem, 2vw, 1.25rem);
	}

	.counter {
		display: grid;
		gap: 0.4rem;
		padding: 1.2rem 1.1rem 1.1rem;
		border: var(--b) solid var(--ink);
		border-radius: var(--r2);
		color: var(--ink);
		box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.14);
		transition: transform 0.3s var(--spring);
	}

	.counter:nth-child(even) {
		transform: rotate(-1.2deg);
	}
	.counter:nth-child(odd) {
		transform: rotate(1deg);
	}
	.counter:hover {
		transform: rotate(0deg) translateY(-6px);
	}

	.counter--sun {
		background: var(--sun);
	}
	.counter--melon {
		background: var(--melon);
	}
	.counter--bubble {
		background: var(--bubble);
	}
	.counter--mint {
		background: var(--mint);
	}
	.counter--sky {
		background: var(--sky);
		color: var(--paper);
	}

	.counter__n {
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(2.4rem, 6vw, 3.6rem);
		line-height: 0.85;
		font-variation-settings: 'wdth' 80;
	}

	.counter__label {
		font-family: var(--mono);
		font-size: 0.72rem;
		line-height: 1.35;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	/* ================================ WORK ================================ */

	.cards {
		display: grid;
		gap: clamp(1.5rem, 3.5vw, 2.5rem);
	}

	@media (min-width: 860px) {
		.cards {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		background: var(--paper);
		border: var(--b) solid var(--ink);
		border-radius: var(--r2);
		box-shadow: var(--s3);
		overflow: hidden;
		transition:
			transform 0.35s var(--spring),
			box-shadow 0.35s var(--spring);
	}

	@media (min-width: 860px) {
		.card:nth-child(odd) {
			transform: rotate(-0.9deg);
		}
		.card:nth-child(even) {
			transform: rotate(0.8deg);
		}
		.card:hover,
		.card:focus-within {
			transform: rotate(0deg) translateY(-8px);
			box-shadow: 14px 14px 0 var(--ink);
		}
	}

	.card__bar {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.85rem 1.1rem;
		border-bottom: var(--b) solid var(--ink);
	}

	.card--melon .card__bar {
		background: var(--melon);
	}
	.card--sky .card__bar {
		background: var(--sky);
		color: var(--paper);
	}
	.card--bubble .card__bar {
		background: var(--bubble);
	}
	.card--sun .card__bar {
		background: var(--sun);
	}
	.card--ink .card__bar {
		background: var(--ink);
		color: var(--sun);
	}

	.card__title {
		font-size: clamp(1.35rem, 3vw, 1.8rem);
		font-variation-settings: 'wdth' 88;
	}

	.card__title a {
		text-decoration: none;
	}

	/* The whole card is the hit area, but only the title is the link. */
	.card__title a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.card__year {
		font-family: var(--mono);
		font-size: 0.72rem;
		white-space: nowrap;
	}

	.card__body {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding: 1.1rem;
		flex: 1;
	}

	.card__shot {
		border: var(--b) solid var(--ink);
		border-radius: var(--r1);
		overflow: hidden;
		background: var(--mint);
	}

	.card__shot img {
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		object-position: top center;
	}

	.card__tagline {
		font-family: var(--display);
		font-weight: 700;
		font-size: 1.05rem;
		line-height: 1.25;
	}

	.card__summary {
		font-size: 0.92rem;
	}

	.card__role {
		font-family: var(--mono);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.07em;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.chip {
		padding: 0.2rem 0.55rem;
		border: 2px solid var(--ink);
		border-radius: var(--pill);
		font-family: var(--mono);
		font-size: 0.68rem;
	}

	.card__foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
		margin-top: auto;
		padding-top: 0.4rem;
	}

	.sticker {
		display: inline-block;
		padding: 0.25rem 0.7rem;
		background: var(--sun);
		border: var(--b) solid var(--ink);
		border-radius: var(--pill);
		font-family: var(--mono);
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		transform: rotate(-2deg);
		box-shadow: 0 0 0 3px var(--paper);
	}

	.sticker--plain {
		background: var(--paper);
		transform: rotate(1.5deg);
	}

	.link-pill {
		position: relative;
		z-index: 1;
		padding: 0.25rem 0.7rem;
		border: 2px solid var(--ink);
		border-radius: var(--pill);
		background: var(--ink);
		color: var(--sun);
		font-family: var(--mono);
		font-size: 0.68rem;
		text-decoration: none;
		transition: transform 0.2s var(--spring);
	}

	.link-pill:hover {
		transform: translateY(-2px) rotate(-2deg);
	}

	/* the other 31 */

	.spill {
		margin-top: clamp(2.5rem, 5vw, 3.5rem);
		padding: clamp(1.25rem, 3vw, 2rem);
		border: var(--b) dashed var(--ink);
		border-radius: var(--r3);
	}

	.spill__title {
		font-size: clamp(1.15rem, 2.6vw, 1.5rem);
		margin-bottom: 1rem;
	}

	.spill__list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-bottom: 1.4rem;
	}

	.spill__chip {
		display: inline-block;
		padding: 0.35rem 0.8rem;
		background: var(--paper);
		border: 2px solid var(--ink);
		border-radius: var(--pill);
		font-size: 0.82rem;
		text-decoration: none;
		transition: transform 0.25s var(--spring);
	}

	.spill__chip:hover {
		transform: rotate(-3deg) scale(1.06);
		background: var(--sun);
	}

	/* ================================ ABOUT ================================ */

	.about__grid {
		display: grid;
		gap: clamp(1.75rem, 4vw, 3rem);
	}

	@media (min-width: 900px) {
		.about__grid {
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		}
	}

	.about__ar {
		display: block;
		width: max-content;
		max-width: 100%;
		font-family: var(--arabic);
		font-size: 0.9em;
		line-height: 1.15;
		margin-top: 0.25rem;
	}

	.about__para {
		margin-top: 1.1rem;
		max-width: 56ch;
	}

	.about__where {
		margin-top: 1.4rem;
		display: inline-block;
		padding: 0.35rem 0.85rem;
		background: var(--ink);
		color: var(--sun);
		border-radius: var(--pill);
		font-family: var(--mono);
		font-size: 0.72rem;
	}

	.about__stack {
		padding: clamp(1.25rem, 3vw, 1.75rem);
		background: var(--paper);
		border: var(--b) solid var(--ink);
		border-radius: var(--r3);
		box-shadow: var(--s3);
	}

	.jobs {
		display: grid;
		gap: 0.9rem;
	}

	.jobs + .mini-title {
		margin-top: 1.75rem;
	}

	.job {
		display: grid;
		gap: 0.1rem;
		padding-left: 0.85rem;
		border-left: var(--b) solid var(--ink);
	}

	.job__co {
		font-family: var(--display);
		font-weight: 700;
		font-size: 1.05rem;
	}

	.job__role {
		font-size: 0.9rem;
	}

	.job__when {
		font-family: var(--mono);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	/* =============================== TOOLBOX =============================== */

	.toolbox .eyebrow,
	.toolbox .section__lede {
		color: var(--paper);
	}

	.tools {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
	}

	.tool {
		padding: 0.5rem 1rem;
		background: var(--paper);
		color: var(--ink);
		border: var(--b) solid var(--ink);
		border-radius: var(--pill);
		font-family: var(--display);
		font-weight: 700;
		font-size: 0.95rem;
		box-shadow: var(--s1);
		transition: transform 0.3s var(--spring);
	}

	.tool:nth-child(3n) {
		background: var(--sun);
	}
	.tool:nth-child(4n) {
		background: var(--mint);
	}
	.tool:nth-child(5n) {
		background: var(--bubble);
	}

	.tool:hover {
		transform: rotate(-4deg) translateY(-4px);
	}

	.tool--alt {
		background: var(--ink);
		color: var(--sun);
		box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.25);
	}

	.tool--alt:nth-child(3n),
	.tool--alt:nth-child(4n),
	.tool--alt:nth-child(5n) {
		background: var(--ink);
	}

	.lately {
		margin-top: clamp(2.25rem, 4vw, 3rem);
		padding-top: clamp(1.5rem, 3vw, 2rem);
		border-top: var(--b) solid rgba(255, 255, 255, 0.45);
