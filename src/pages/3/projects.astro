---
/* The archive as a prism. One beam of thirty-nine goes in; six bands come
   out, and each band is as wide as its share of the work. The widths are not
   decoration — they are the census. */
import { Image } from 'astro:assets';
import Layout from './_layout.astro';
import T from '../../components/T.astro';
import { projects } from '../../data/projects';
import { s, pair, yearPair } from '../../data/variant-ui';

/* Spectrum order, cyan through orange. Web is the widest band because most of
   the work is web; extension is one slat wide because there is one. */
const bands = [
	{ key: 'web', hue: '#1FB6C8' },
	{ key: 'mobile', hue: '#4E8AE8' },
	{ key: 'ai', hue: '#6B5BFF' },
	{ key: 'client', hue: '#FF5B8A' },
	{ key: 'desktop', hue: '#FF7360' },
	{ key: 'extension', hue: '#FF8A3D' },
] as const;

const catKey = {
	web: 'cat.web',
	mobile: 'cat.mobile',
	ai: 'cat.ai',
	client: 'cat.client',
	desktop: 'cat.desktop',
	extension: 'cat.extension',
} as const;

const statusKey = {
	live: 'status.live',
	shipped: 'status.shipped',
	delisted: 'status.delisted',
	wip: 'status.wip',
	archived: 'status.archived',
} as const;

/* Years read "2026", "Since 2025", "2023 to 2026". The last four digits are
   the one that decides recency. */
const recency = (year: string) => {
	const all = year.match(/\d{4}/g);
	return all ? Number(all[all.length - 1]) : 0;
};

const groups = bands.map((b) => ({
	...b,
	items: projects
		.filter((p) => p.category === b.key)
		.sort(
			(a, c) =>
				Number(c.featured) - Number(a.featured) ||
				recency(c.year) - recency(a.year) ||
				a.title.en.localeCompare(c.title.en),
		),
}));

const isTall = (img?: ImageMetadata) => !!img && img.height > img.width;
const widthsFor = (img: ImageMetadata) =>
	(img.height > img.width ? [200, 380] : [300, 560]).filter(
		(w) => w <= img.width,
	);
---

<Layout
	title="All 39 projects — Haitham Assoli"
	description="Every project Haitham Assoli has shipped, split by kind: 18 web, 9 mobile, 7 AI, 2 client, 2 desktop and 1 editor extension. Each one has its own write-up."
	here="projects"
>
	<header class="prism wrap">
		<p class="eyebrow">
			<span class="dot"></span>
			<T v={pair('The whole archive', 'الأرشيف كاملًا')} />
		</p>
		<h1 class="h1">
			<T v={pair('One beam, split six ways', 'شعاعٌ واحد ينكسر إلى ستة')} />
		</h1>
		<T
			v={pair(
				'Thirty-nine shipped projects, put through the glass and sorted by what they are. Every band below is as wide as its share of the work.',
				'تسعة وثلاثون مشروعًا صدرت، مرّت في الزجاج ورُتّبت بحسب نوعها. عرض كل شريط أدناه بقدر نصيبه من العمل.',
			)}
			as="p"
			class="lede prism__lede"
		/>

		<div class="spectrum" aria-hidden="true">
			{
				groups.map((g) => (
					<span
						class="spectrum__band"
						style={`--band:${g.hue}; flex-grow:${g.items.length}`}
					/>
				))
			}
		</div>

		<nav class="gels" aria-label="Jump to a band — انتقل إلى شريط">
			{
				groups.map((g) => (
					<a class="gel" href={`#band-${g.key}`} style={`--band:${g.hue}`}>
						<span class="gel__swatch" />
						<T v={s(catKey[g.key])} class="gel__name" />
						<span class="gel__n">{g.items.length}</span>
					</a>
				))
			}
		</nav>
	</header>

	{
		groups.map((g) => (
			<section
				class="band wrap"
				id={`band-${g.key}`}
				style={`--band:${g.hue}`}
				aria-labelledby={`band-${g.key}-h`}
			>
				<div class="band__head">
					<span class="band__edge" aria-hidden="true" />
					<h2 class="h2 band__name" id={`band-${g.key}-h`}>
						<T v={s(catKey[g.key])} />
					</h2>
					<p class="band__count mono">
						<span>{g.items.length}</span>
						<T
							v={pair(
								g.items.length === 1 ? 'project' : 'projects',
								g.items.length === 1 ? 'مشروع' : 'مشروعًا',
							)}
						/>
					</p>
				</div>

				<ol class="slats">
					{g.items.map((p) => (
						<li
							class="slat pane"
							data-featured={p.featured ? '' : undefined}
							data-shape={isTall(p.image) ? 'tall' : 'wide'}
						>
							<span class="slat__ray" aria-hidden="true" />

							{p.featured &&
								(p.image ? (
									<div class="slat__media">
										<Image
											src={p.image}
											alt={`${p.title.en} — ${p.tagline.en}`}
											widths={widthsFor(p.image)}
											sizes="(max-width: 700px) 90vw, 320px"
											loading="lazy"
											decoding="async"
										/>
									</div>
								) : null)}

							<div class="slat__body">
								<p class="slat__meta">
									<span class="pip" />
									<T v={yearPair(p.year)} />
									<span class="slat__sep" aria-hidden="true">
										/
									</span>
									<T v={s(statusKey[p.status])} />
								</p>
								<h3 class="h3 slat__title">
									<a href={`/3/work/${p.slug}`}>
										<T v={p.title} />
									</a>
								</h3>
								<T v={p.tagline} as="p" class="slat__tag" />
								{p.featured && (
									<p class="slat__flag">
										<T v={pair('Written up in full', 'مشروح بالكامل')} />
									</p>
								)}
							</div>
						</li>
					))}
				</ol>
			</section>
		))
	}

	<section class="wrap coda">
		<div class="pane coda__in">
			<T
				v={pair(
					'Not sure which one is closest to your problem? Describe the problem instead.',
					'لا تعرف أيّها أقرب إلى مشكلتك؟ صِف المشكلة بدلًا من ذلك.',
				)}
				as="p"
				class="lede"
			/>
			<a class="btn btn--go" href="/3/hire"><T v={s('hire.title')} /></a>
		</div>
	</section>
</Layout>

<style is:global>
	/* ══ the prism head ══════════════════════════════════════════════════ */
	.prism {
		padding-block: clamp(3rem, 9vw, 5.5rem) 0;
	}

	.prism__lede {
		margin-block-start: 1.4rem;
	}

	.spectrum {
		display: flex;
		gap: 3px;
		height: 14px;
		margin-block-start: clamp(2rem, 5vw, 3rem);
		border-radius: 999px;
		overflow: hidden;
	}

	.spectrum__band {
		flex-basis: 0;
		min-width: 12px;
		border-radius: 999px;
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--band) 92%, white),
			var(--band) 55%,
			color-mix(in srgb, var(--band) 62%, #05080f)
		);
		box-shadow: 0 0 18px -2px color-mix(in srgb, var(--band) 65%, transparent);
	}

	.gels {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-block-start: 0.9rem;
	}

	.gel {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.85rem;
		border-radius: 999px;
		text-decoration: none;
		border: 1px solid rgba(200, 230, 255, 0.16);
		background: rgba(255, 255, 255, 0.04);
		font-family: var(--mono);
		font-size: 0.74rem;
		letter-spacing: 0.04em;
		color: var(--haze);
		transition:
			background-color 0.2s,
			border-color 0.2s,
			color 0.2s;
	}

	.gel:hover {
		color: var(--frost);
		border-color: color-mix(in srgb, var(--band) 60%, transparent);
		background: color-mix(in srgb, var(--band) 14%, rgba(255, 255, 255, 0.04));
	}

	.gel__swatch {
		width: 8px;
		height: 8px;
		border-radius: 2px;
		background: var(--band);
		box-shadow: 0 0 10px 1px color-mix(in srgb, var(--band) 70%, transparent);
	}

	.gel__n {
		font-size: 0.68rem;
		color: var(--mute);
	}

	/* ══ a band ══════════════════════════════════════════════════════════ */
	.band {
		padding-block-start: clamp(2.75rem, 7vw, 4.5rem);
	}

	.band__head {
		display: flex;
		align-items: baseline;
		gap: 0.9rem;
		margin-block-end: clamp(1.1rem, 3vw, 1.6rem);
		padding-block-end: 0.9rem;
		border-block-end: 1px solid rgba(200, 230, 255, 0.12);
	}

	.band__edge {
		align-self: stretch;
		width: 4px;
		border-radius: 999px;
		background: var(--band);
		box-shadow: 0 0 16px 1px color-mix(in srgb, var(--band) 70%, transparent);
		flex: none;
	}

	.band__name {
		color: var(--frost);
	}

	.band__count {
		margin: 0;
		display: flex;
		gap: 0.4rem;
		color: var(--mute);
		margin-inline-start: auto;
		white-space: nowrap;
	}

	.slats {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
		gap: clamp(0.7rem, 1.6vw, 1.1rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.slat {
		--radius: 16px;
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		transition:
			transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
			box-shadow 0.3s ease;
	}

	.slat:hover,
	.slat:focus-within {
		transform: translateY(-3px);
		box-shadow:
			var(--glass-lift),
			0 0 34px -14px color-mix(in srgb, var(--band) 80%, transparent);
	}

	/* the caustic: a hairline of the band's own colour that fills as the
	   pointer arrives, and is simply always full where there is no pointer */
	.slat__ray {
		position: absolute;
		z-index: 5;
		inset-block-start: 0;
		inset-inline: 0;
		height: 2px;
		background: linear-gradient(
			90deg,
			transparent,
			var(--band),
			color-mix(in srgb, var(--band) 40%, white),
			transparent
		);
		transform: scaleX(0.18);
		transform-origin: center;
		opacity: 0.65;
		transition:
			transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
			opacity 0.35s ease;
	}

	.slat[data-featured] .slat__ray {
		transform: scaleX(0.62);
		opacity: 1;
	}

	.slat:hover .slat__ray,
	.slat:focus-within .slat__ray {
		transform: scaleX(1);
		opacity: 1;
	}

	@media (hover: none) {
		.slat__ray {
			transform: scaleX(1);
			opacity: 0.9;
		}
	}

	/* Featured covers are 1080×2340 phone shots as often as not: they stand in
	   an accent-lit chamber rather than being cropped into a letterbox. */
	.slat__media {
		position: relative;
		overflow: hidden;
		background: color-mix(in srgb, var(--band) 20%, #0a0f1c);
	}

	.slat[data-shape='wide'] .slat__media {
		aspect-ratio: 16 / 9;
	}

	.slat[data-shape='wide'] .slat__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		filter: saturate(0.92) brightness(0.86);
	}

	.slat[data-shape='tall'] .slat__media {
		height: 190px;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		padding: 0.9rem 0.9rem 0;
		background:
			radial-gradient(
				80% 90% at 50% 4%,
				color-mix(in srgb, var(--band) 50%, transparent),
				transparent 72%
			),
			#070c17;
	}

	.slat[data-shape='tall'] .slat__media img {
		max-height: 100%;
		width: auto;
		object-fit: contain;
		border-radius: 10px 10px 0 0;
		filter: drop-shadow(0 14px 22px rgba(2, 5, 12, 0.8));
	}

	.slat__body {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: clamp(0.85rem, 2vw, 1.15rem);
		flex: 1;
	}

	.slat__meta {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0;
		font-family: var(--mono);
		font-size: 0.66rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(234, 242, 255, 0.7);
	}

	.slat__sep {
		color: var(--mute);
	}

	.slat__title a {
		text-decoration: none;
	}

	.slat__title a::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 6;
	}

	.slat:hover .slat__title a {
		color: color-mix(in srgb, var(--band) 45%, #ffffff);
	}

	.slat__tag {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--haze);
	}

	.slat__flag {
		margin: auto 0 0;
		padding-block-start: 0.55rem;
		font-family: var(--mono);
		font-size: 0.62rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--band) 55%, var(--frost));
	}

	/* ══ coda ════════════════════════════════════════════════════════════ */
	.coda {
		padding-block-start: clamp(3rem, 8vw, 5rem);
	}

	.coda__in {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		padding: clamp(1.4rem, 3.5vw, 2.4rem);
	}

	/* Featured slats are twice as wide and lie down: the cover stands beside
	   the type instead of on top of it, so a featured row is not three times
	   the height of the one beneath it. */
	@media (min-width: 700px) {
		.slat[data-featured] {
			grid-column: span 2;
			flex-direction: row;
			min-height: 200px;
		}
		.slat[data-featured] .slat__media {
			flex: 0 0 42%;
			align-self: stretch;
			height: auto;
			aspect-ratio: auto;
		}
		.slat[data-featured][data-shape='wide'] .slat__media img {
			height: 100%;
		}
		/* a definite chamber, so one standing phone shot cannot make its whole
		   row three times the height of the next one */
		.slat[data-featured][data-shape='tall'] .slat__media {
			height: 270px;
			align-self: center;
		}
		.slat[data-featured][data-shape='tall'] .slat__media img {
			max-height: 100%;
		}
		.slat[data-featured] .slat__body {
			flex: 1 1 auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.slat,
		.slat__ray,
		.gel {
			transition: none !important;
		}
		.slat__ray {
			transform: scaleX(1);
		}
	}
</style>
