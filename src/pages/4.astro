---
/* Variant 4 — "Terminal". The session page: MANIFEST, the eight opened
   records, the project tree, and the man-page facts about the person.
   Chrome, tokens and the command line come from ./4/_shell.astro. */
import { Image } from 'astro:assets';
import Shell from './4/_shell.astro';
import T from '../components/T.astro';
import { pair, s } from '../data/variant-ui';
import { dateSpan } from './4/_dates';
import type { I18n } from '../../content/types';
import { profile } from '../../content/profile';
import { featured, projects } from '../data/projects';
import { toolbox } from '../i18n';
import profilePhoto from '../assets/images/profile.png';

/* The filesystem: 39 projects, grouped the way `tree` would group them. */
const catOrder = [
	'web',
	'mobile',
	'ai',
	'desktop',
	'extension',
	'client',
] as const;

const dirs = catOrder.map((c) => ({
	name: c,
	label: s(`cat.${c}` as 'cat.web'),
	items: projects.filter((p) => p.category === c),
}));

/* Colour in the toolbox listing encodes where the code actually runs. */
const runsOn: Record<string, string> = {
	'React Native': 'native',
	Expo: 'native',
	Reanimated: 'native',
	Skia: 'native',
	React: 'browser',
	'Next.js': 'browser',
	'Tailwind CSS': 'browser',
	'React Query': 'browser',
	Zustand: 'browser',
	Motion: 'browser',
	'Node.js': 'server',
	NestJS: 'server',
	Supabase: 'server',
	Convex: 'server',
	Firebase: 'server',
	PostgreSQL: 'server',
	TypeScript: 'both',
	Zod: 'both',
	Figma: 'none',
};

const legend = [
	{ key: 'native', label: pair('on the phone', 'على الهاتف') },
	{ key: 'browser', label: pair('in the browser', 'في المتصفح') },
	{ key: 'server', label: pair('on the server', 'على الخادم') },
	{ key: 'both', label: pair('both ends', 'على الطرفين') },
	{ key: 'none', label: pair('not shipped code', 'ليست شيفرة تُشحن') },
];

/* Static figures. dev-stats.ts is a network call at build time; not here. */
const figures = [
	{
		v: '39',
		k: pair('projects shipped', 'مشروعًا صدر'),
		n: pair('over four years', 'على مدى أربع سنوات'),
	},
	{
		v: '13',
		k: pair('on the app stores', 'على متاجر التطبيقات'),
		n: pair('iOS, Android, or both', 'iOS أو أندرويد أو كلاهما'),
	},
	{
		v: '8',
		k: pair('written up in full', 'مكتوبة بالكامل'),
		n: pair('problem, decision, outcome', 'المشكلة، والقرار، والنتيجة'),
	},
	{
		v: '4',
		k: pair('years building', 'سنوات في البناء'),
		n: pair('since 2022, freelance onward', 'منذ 2022، من العمل الحر فصاعدًا'),
	},
	{
		v: '2',
		k: pair('languages per release', 'لغتان في كل إصدار'),
		n: pair(
			'Arabic and English, from the first screen',
			'العربية والإنجليزية، من الشاشة الأولى',
		),
	},
];

/* `fixed` is a proper noun: it is spelled the same in both languages and is
   not tagged as Arabic, so a screen reader does not try to pronounce it as
   Arabic. `label` is an ordinary word and translates. */
const elsewhere: Array<{ fixed?: string; label?: I18n; href: string }> = [
	{ fixed: 'github', href: profile.links.github },
	{ fixed: 'linkedin', href: profile.links.linkedin },
	{ label: pair('website', 'الموقع'), href: profile.links.website },
	{ label: s('nav.cv'), href: profile.links.resume },
	{ label: s('project.play'), href: profile.links.playStore },
];

const linkOrder = [
	['live', s('project.live')],
	['appStore', s('project.apple')],
	['playGoogle', s('project.play')],
	['github', s('project.github')],
	['vscode', s('project.vscode')],
] as const;
---

<Shell
	title="haitham@amman — session"
	description="Haitham Assoli, web and mobile full-stack engineer in Amman. Bilingual Arabic-first apps, 39 shipped, 13 on the app stores."
	path="~/portfolio"
	tab="home"
>
	<!-- ── hero ───────────────────────────────────────────────── -->
	<section class="block--hero block" aria-labelledby="thesis">
		<p class="cmdline" data-type>
			<span class="cmdline__q">cat</span> MANIFEST
		</p>

		<h1 class="thesis" id="thesis">
			<T
				v={pair(
					'Every screen I ship has to survive being mirrored.',
					'كل شاشة أطلقها لا بد أن تصمد وهي معكوسة.',
				)}
			/>
		</h1>

		<p class="quote" data-l="en" lang="en">
			<span class="quote__hash" aria-hidden="true">#</span>
			A mirrored interface is a different interface, not a translation.
		</p>
		<p class="quote" data-l="ar" lang="ar">
			<span class="quote__hash" aria-hidden="true">#</span>
			الواجهة المعكوسة واجهة أخرى، لا ترجمة.
		</p>

		<dl class="kv">
			<div class="kv__row">
				<T v={pair('name', 'الاسم')} as="dt" />
				<dd><T v={profile.name} /></dd>
			</div>
			<div class="kv__row">
				<T v={pair('role', 'العمل')} as="dt" />
				<dd><T v={profile.title} /></dd>
			</div>
			<div class="kv__row">
				<T v={pair('host', 'المكان')} as="dt" />
				<dd><T v={profile.location} /></dd>
			</div>
			<div class="kv__row">
				<T v={pair('stack', 'الأدوات')} as="dt" />
				<dd>
					<T
						v={pair(
							'React Native and Expo on both stores, Next.js and Astro on the web, NestJS or Convex or Supabase behind them.',
							'React Native وExpo على المتجرين، وNext.js وAstro على الويب، وخلفها NestJS أو Convex أو Supabase.',
						)}
					/>
				</dd>
			</div>
			<div class="kv__row">
				<T v={pair('now', 'الآن')} as="dt" />
				<dd>
					<T
						v={pair(
							'On-device AI. Video and audio processed on the reader’s own phone: no upload, no cloud, no telemetry.',
							'ذكاء اصطناعي على الجهاز. معالجة الفيديو والصوت على هاتف المستخدم نفسه: بلا رفع، وبلا سحابة، وبلا تتبّع.',
						)}
					/>
				</dd>
			</div>
			<div class="kv__row">
				<T v={pair('shipped', 'المُنجَز')} as="dt" />
				<dd class="kv__tally">
					<span
						><span class="tty"><b>39</b></span>{' '}<T
							v={pair('projects', 'مشروعًا')}
						/></span
					>
					<span
						><span class="tty"><b>13</b></span>{' '}<T
							v={pair('on the app stores', 'على متاجر التطبيقات')}
						/></span
					>
					<span
						><span class="tty"><b>8</b></span>{' '}<T
							v={pair('written up in full', 'مكتوبة بالكامل')}
						/></span
					>
					<span
						><span class="tty"><b>4</b></span>{' '}<T
							v={pair('years', 'سنوات')}
						/></span
					>
				</dd>
			</div>
		</dl>

		<!-- The LANG control again, at length. The status bar carries the
		     switch; this is the paragraph that explains why it is there. -->
		<div class="env">
			<p class="cmdline cmdline--tight">
				<span class="cmdline__q">env</span> LANG=ar ./portfolio
			</p>
			<T
				v={pair(
					'Arabic is not a setting I add at the end. Set LANG and the session comes back in Arabic: the words, the alignment, the side the eye starts on. Paths, digits and the prompt stay exactly where they were, because a path is not prose.',
					'العربية ليست إعدادًا أضيفه في آخر الطريق. اضبط LANG فتعود الجلسة بالعربية: الكلمات، والمحاذاة، والجهة التي تبدأ منها العين. أمّا المسارات والأرقام وسطر الأمر فتبقى حيث هي، لأنّ المسار ليس نصًّا.',
				)}
				as="p"
				class="env__copy"
			/>
			<button class="env__btn tty" type="button" data-lang-toggle>
				<span data-l="en" aria-hidden="true">export LANG=ar</span>
				<span data-l="ar" aria-hidden="true">export LANG=en</span>
				<span class="sr-only" data-l="en">Run the session in Arabic</span>
				<span class="sr-only" data-l="ar" lang="ar"
					>شغّل الجلسة بالإنجليزية</span
				>
			</button>
			<T
				v={pair(
					'Both languages are already in the page. Nothing reloads, and nothing is fetched.',
					'اللغتان كلتاهما في الصفحة أصلًا. لا شيء يُعاد تحميله، ولا شيء يُجلب.',
				)}
				as="p"
				class="env__note"
			/>
		</div>
	</section>

	<!-- ── featured ───────────────────────────────────────────── -->
	<section class="block" id="work" aria-labelledby="work-h">
		<p class="cmdline">
			<span class="cmdline__q">ls</span> -l ~/work --featured
		</p>
		<h2 class="h2" id="work-h">
			<T v={pair('Eight records, opened', 'ثمانية سجلات، مفتوحة')} />
			<span class="h2__dim">
				<span class="tty" data-l="en">total 8</span>
				<span data-l="ar" lang="ar">المجموع <span class="tty">8</span></span>
			</span>
		</h2>
		<T
			v={pair(
				'These are the ones with a full write-up behind them: what the problem was, what I decided, what it cost. The other thirty-one are one section down.',
				'هذه المشاريع التي وراء كل منها كتابة كاملة: ما كانت المشكلة، وما الذي قرّرته، وكم كلّف. والواحد والثلاثون الباقية في القسم الذي يليه.',
			)}
			as="p"
			class="lede"
		/>

		<ol class="recs">
			{
				featured.map((p, i) => (
					<li class="rec">
						<p class="cmdline cmdline--tight">
							<span class="cmdline__q">open</span> ~/work/{p.slug}
						</p>

						<h3 class="rec__title">
							<a href={`/4/work/${p.slug}`}>
								<T v={p.title} />
							</a>
							<T
								v={s(`status.${p.status}` as 'status.live')}
								class={`st st--${p.status}`}
							/>
						</h3>

						<T v={p.tagline} as="p" class="rec__tag" />

						<div class="rec__body">
							{p.image && (
								<figure
									class={`pane${p.image.height > p.image.width ? ' pane--tall' : ''}`}
								>
									<figcaption class="pane__bar tty">
										<span class="pane__name">{p.cover.replace(/^\//, '')}</span>
										<span class="pane__meta">
											{p.image.width}×{p.image.height}
										</span>
									</figcaption>
									<div class="pane__view">
										<Image
											src={p.image}
											alt={`${p.title.en} interface`}
											widths={[360, 720]}
											sizes="(min-width: 62rem) 20rem, 88vw"
											loading={i === 0 ? 'eager' : 'lazy'}
										/>
									</div>
								</figure>
							)}

							<div class="rec__text">
								<T v={p.summary} as="p" class="rec__sum" />

								<dl class="kv kv--tight">
									<div class="kv__row">
										<T v={s('project.year')} as="dt" />
										<dd class="tty">{dateSpan(p.year)}</dd>
									</div>
									<div class="kv__row">
										<T v={s('project.role')} as="dt" />
										<dd>
											<T v={p.role} />
										</dd>
									</div>
									<div class="kv__row">
										<T v={pair('type', 'الفئة')} as="dt" />
										<dd>
											<T v={s(`cat.${p.category}` as 'cat.web')} />
										</dd>
									</div>
									<div class="kv__row">
										<T v={s('project.stack')} as="dt" />
										<dd class="chips">
											{p.stack.slice(0, 8).map((t) => (
												<span class="chip">{t}</span>
											))}
										</dd>
									</div>
								</dl>

								<p class="rec__links">
									<a class="go" href={`/4/work/${p.slug}`}>
										<T v={s('work.read')} />
									</a>
									{linkOrder.map(([k, label]) =>
										p.links[k] ? (
											<a
												class="go go--out"
												href={p.links[k]}
												rel="noopener noreferrer"
												target="_blank"
											>
												<T v={label} />
											</a>
										) : null,
									)}
								</p>
							</div>
						</div>
					</li>
				))
			}
		</ol>
	</section>

	<!-- ── the filesystem ─────────────────────────────────────── -->
	<section class="block" id="fs" aria-labelledby="fs-h">
		<p class="cmdline"><span class="cmdline__q">tree</span> ~/projects</p>
		<h2 class="h2" id="fs-h">
			<T
				v={pair(
					'Thirty-nine, as a directory',
					'تسعة وثلاثون، على هيئة مجلّدات',
				)}
			/>
		</h2>
		<T
			v={pair(
				'Grouped by what the thing runs on, not by how it looks in a grid. Every leaf has its own page. Colour here is status and nothing else.',
				'مجموعة بحسب ما يعمل عليه المشروع، لا بحسب شكله في شبكة. ولكل ورقة صفحتها. واللون هنا حالة، لا شيء غيرها.',
			)}
			as="p"
			class="lede"
		/>

		<ul class="tree">
			{
				dirs.map((d) => (
					<li class="tree__dir">
						<p class="tree__head">
							<T v={d.label} class="tree__folder" />
							<span class="tty">/</span>
							<span class="tree__count tty">{d.items.length}</span>
						</p>
						<ul class="tree__kids">
							{d.items.map((p) => (
								<li class="tree__file">
									<a class="tree__link" href={`/4/work/${p.slug}`}>
										<T v={p.title} />
									</a>
									{p.featured && (
										<span class="tree__star tty" aria-hidden="true">
											*
										</span>
									)}
									<span class="tree__year tty">{dateSpan(p.year)}</span>
									<T
										v={s(`status.${p.status}` as 'status.live')}
										class={`st st--${p.status}`}
									/>
								</li>
							))}
						</ul>
					</li>
				))
			}
		</ul>

		<p class="tree__total">
			<span class="tty">6</span>{' '}<T v={pair('directories,', 'مجلدات،')} />{
				' '
			}
			<span class="tty">39</span>{' '}<T v={pair('files ·', 'ملفًا ·')} />{' '}
			<span class="tree__star tty">*</span>{' '}<T
				v={pair('= written up in full', '= مكتوب بالكامل')}
			/>
		</p>

		<p class="tree__more">
			<a class="go" href="/4/projects">
				<T v={pair('ls -la — the long listing', 'ls -la — القائمة الطويلة')} />
			</a>
		</p>
	</section>

	<!-- ── whoami ─────────────────────────────────────────────── -->
	<section class="block" id="who" aria-labelledby="who-h">
		<p class="cmdline"><span class="cmdline__q">whoami</span> --long</p>
		<h2 class="h2" id="who-h"><T v={profile.name} /></h2>

		<div class="who">
			<figure class="pane pane--me">
				<figcaption class="pane__bar tty">
					<span class="pane__name">profile.png</span>
					<span class="pane__meta">uid 1000</span>
				</figcaption>
				<div class="pane__view">
					<Image
						src={profilePhoto}
						alt="Haitham Assoli"
						widths={[220, 440]}
						sizes="14rem"
						loading="lazy"
					/>
				</div>
			</figure>

			<div class="prose">
				{
					profile.about.en.map((_, i) => (
						<T
							v={{ en: profile.about.en[i], ar: profile.about.ar[i] }}
							as="p"
						/>
					))
				}

				<div class="prose__edu">
					<T v={pair('education', 'الدراسة')} class="prose__lbl" />
					{
						profile.education.map((e) => (
							<p class="prose__row">
								<T v={e.degree} />
								{', '}
								<T v={e.school} />
								<span class="prose__dim">
									<span class="tty"> · {dateSpan(e.period)}</span>
									{e.note && (
										<>
											{' · '}
											<T v={e.note} />
										</>
									)}
								</span>
							</p>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<!-- ── history ────────────────────────────────────────────── -->
	<section class="block" id="history" aria-labelledby="hist-h">
		<p class="cmdline"><span class="cmdline__q">history</span> --roles</p>
		<h2 class="h2" id="hist-h">
			<T v={pair('Where the hours went', 'أين ذهبت الساعات')} />
		</h2>

		<ol class="hist">
			{
				profile.experience.map((e) => (
					<li class="hist__row">
						<span class="hist__when tty">{dateSpan(e.period)}</span>
						<span class="hist__who">
							<T v={e.company} />
							<span class="hist__role">
								{' — '}
								<T v={e.role} />
								{e.location && (
									<>
										{' ('}
										<T v={e.location} />
										{')'}
									</>
								)}
							</span>
						</span>
						<T
							v={{ en: e.highlights.en[0], ar: e.highlights.ar[0] }}
							class="hist__what"
						/>
					</li>
				))
			}
		</ol>
	</section>

	<!-- ── toolbox ────────────────────────────────────────────── -->
	<section class="block" id="stack" aria-labelledby="stack-h">
		<p class="cmdline"><span class="cmdline__q">cat</span> ~/.toolbox</p>
		<h2 class="h2" id="stack-h"><T v={s('about.stackTitle')} /></h2>
		<T
			v={pair(
				'Highlighted by where the code actually executes, which is the only grouping that has ever helped me plan a build.',
				'ملوّنة بحسب المكان الذي تُنفَّذ فيه الشيفرة فعلًا، وهو التصنيف الوحيد الذي أفادني في التخطيط لأي بناء.',
			)}
			as="p"
			class="lede"
		/>

		<ul class="tools tty">
			{
				toolbox.map((t) => (
					<li class={`tool tool--${runsOn[t] ?? 'none'}`}>{t}</li>
				))
			}
		</ul>

		<ul class="legend">
			{
				legend.map((l) => (
					<li class={`legend__i tool--${l.key}`}>
						<span class="legend__sw" aria-hidden="true">
							■
						</span>
						<T v={l.label} />
					</li>
				))
			}
		</ul>
	</section>

	<!-- ── figures ────────────────────────────────────────────── -->
	<section class="block" id="stat" aria-labelledby="stat-h">
		<p class="cmdline"><span class="cmdline__q">stat</span> ~/portfolio</p>
		<h2 class="h2" id="stat-h">
			<T v={pair('The counts, plainly', 'الأرقام، بلا زخرفة')} />
		</h2>

		<dl class="stat">
			{
				figures.map((f) => (
					<div class="stat__row">
						<T v={f.k} as="dt" class="stat__k" />
						<dd class="stat__v">
							<b class="tty">{f.v}</b>
							<T v={f.n} class="stat__n" />
						</dd>
					</div>
				))
			}
		</dl>
	</section>

	<!-- ── hire ───────────────────────────────────────────────── -->
	<section class="block" id="hire" aria-labelledby="hire-h">
		<p class="cmdline"><span class="cmdline__q">hire</span> --brief</p>
		<h2 class="h2" id="hire-h">
			<T
				v={pair(
					'Send the brief, not the buzzwords',
					'أرسل الفكرة، لا المصطلحات',
				)}
			/>
		</h2>
		<T
			v={pair(
				'Tell me what has to be true when it ships and which language it ships in first. I answer from Amman within two business days, in Arabic or English.',
				'اكتب لي ما الذي يجب أن يتحقق يوم الإطلاق، وبأي لغة يصدر أولًا. أرد من عمّان خلال يومَي عمل، بالعربية أو بالإنجليزية.',
			)}
			as="p"
			class="lede"
		/>

		<p class="hire">
			<a class="hire__btn" href="/4/hire">
				<T v={s('hire.title')} />
			</a>
			<a class="go tty" href={`mailto:${profile.email}`}>{profile.email}</a>
			<a class="go tty" href={`tel:${profile.phone.replace(/\s/g, '')}`}
				>{profile.phone}</a
			>
		</p>

		<ul class="dots">
			{
				elsewhere.map((l) => (
					<li>
						<a class="go go--out" href={l.href} rel="noopener noreferrer">
							{l.fixed ? (
								<span class="tty">{l.fixed}</span>
							) : (
								<T v={l.label!} />
							)}
						</a>
					</li>
				))
			}
		</ul>
