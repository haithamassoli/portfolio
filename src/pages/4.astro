---
/* Variant 04 — "Press Sheet".
   Swiss systematic: a 12-column grid you can switch on, a title block, a
   spec register beside every plate, and a DIR control that mirrors the whole
   sheet the way a bilingual app has to mirror. Process cyan is the only ink
   besides registration black. */
import { Image } from 'astro:assets';
import { profile } from '../../content/profile';
import { featured, projects } from '../data/projects';
import { toolbox } from '../i18n';
import StyleSwitcher from '../components/StyleSwitcher.astro';
import profilePhoto from '../assets/images/profile.png';

const statusLabel: Record<string, string> = {
	live: 'Live',
	shipped: 'On the stores',
	delisted: 'Delisted',
	wip: 'In progress',
	archived: 'Archived',
};

const frameLabel: Record<string, string> = {
	phone: 'Phone',
	browser: 'Browser',
	editor: 'Editor',
	postcard: 'Card',
};

const categoryLabel: Record<string, string> = {
	web: 'Web',
	mobile: 'Mobile',
	desktop: 'Desktop',
	extension: 'Extension',
	ai: 'On-device AI',
	client: 'Client work',
};

const linkLabel: Record<string, string> = {
	live: 'Live site',
	github: 'Source',
	appStore: 'App Store',
	playGoogle: 'Google Play',
	vscode: 'VS Code',
};

const linkOrder = [
	'live',
	'appStore',
	'playGoogle',
	'vscode',
	'github',
] as const;

const linksOf = (links: Record<string, string | undefined>) =>
	linkOrder
		.filter((k) => links[k])
		.map((k) => ({ key: k, label: linkLabel[k], href: links[k] as string }));

/* Counted off the same data this page renders, so the register cannot drift. */
const total = projects.length;
const onStores = 13;
const plates = featured.length;

const register = [
	{
		value: String(total),
		of: total,
		label: 'Projects shipped',
		note: 'Every one is indexed at the foot of this sheet.',
	},
	{
		value: String(onStores),
		of: total,
		label: 'On the app stores',
		note: 'App Store, Google Play, or both.',
	},
	{
		value: String(plates).padStart(2, '0'),
		of: total,
		label: 'Pulled as plates',
		note: 'Written up in full, plates 01 to 08 below.',
	},
];

const bio = [
	'Full stack, end to end: the data model through to the last pixel. Four years of it. Currently at CartBuzz on multi-vendor commerce in NestJS, Next.js and React Native; before that at Bionl.Ai, on a no-code bioinformatics platform used by more than eight thousand researchers.',
	'The work worth taking has a hard constraint sitting in the middle of it. A model that has to run on the phone instead of a server. A search index that has to answer in milliseconds with nothing behind it. A booking flow that cannot sell the same hour twice. The framework is never the interesting part.',
	'Lately the constraint is on-device AI: video and audio processed entirely on the user’s own phone or laptop. No cloud, no account, no telemetry, and the original file is never touched.',
];

const marks = [
	{ k: 'Location', v: 'Amman, Jordan' },
	{ k: 'Discipline', v: 'Web and mobile, full stack' },
	{ k: 'Scripts', v: 'Arabic and English' },
	{ k: 'Directions', v: 'Right to left, left to right' },
	{ k: 'Degree', v: 'BSc Computer Science, Irbid National University, 2024' },
	{ k: 'Availability', v: 'Open to commissions' },
];

/* The full inventory comes from the profile. `toolbox` is the short list, so
   rather than printing it twice it is used as a mark on the inventory. */
const alias: Record<string, string> = {
	'react query': 'tanstack query',
	motion: 'framer motion',
};
const daily = new Set(
	toolbox.map((t) => alias[t.toLowerCase()] ?? t.toLowerCase()),
);

const bench = [
	{ k: 'Languages', v: profile.skills.languages },
	{ k: 'Front end', v: profile.skills.frontend },
	{ k: 'Mobile', v: profile.skills.mobile },
	{ k: 'Server', v: profile.skills.backend },
	{ k: 'Data', v: profile.skills.data },
	{ k: 'On device', v: profile.skills.ai },
	{ k: 'Infra', v: profile.skills.infra },
	{ k: 'Craft', v: profile.skills.craft },
];

const shortRoles = profile.experience.slice(0, 5);

/* Both lines are set from one size, taken off the longest line so the name
   fills the measure exactly. 6.22 is the measured em-width of "HAITHAM" in
   Archivo 800 at width 125 with the tracking below. */
const nameLines = ['Haitham', 'Assoli'];

const year = 2026;
---

<!doctype html>
<html lang="en" dir="ltr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Haitham Assoli — sheet 04, press</title>
		<meta
			name="description"
			content="Haitham Assoli builds web and mobile products in Amman that ship in Arabic and English. Thirty-nine shipped, thirteen on the app stores, eight drawn up in full."
		/>
		<meta name="robots" content="noindex" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=Martian+Mono:wdth,wght@75..112.5,300..700&family=Noto+Kufi+Arabic:wght@400..800&display=swap"
		/>
	</head>
	<body>
		<a class="skip" href="#sheet">Skip to the sheet</a>

		<!-- The grid, made visible. Toggled from the title block or with G. -->
		<div class="overlay" aria-hidden="true">
			<div class="sheet overlay-in">
				<div class="overlay-cols">
					{Array.from({ length: 12 }).map(() => <i />)}
				</div>
			</div>
		</div>

		<header class="block">
			<div class="sheet block-in">
				<p class="block-id">
					<b>Sheet 04</b><span class="sep">/</span>Press
				</p>
				<p class="block-sub">
					Haitham Assoli<span class="sep">·</span>Amman, Jordan<span class="sep"
						>·</span
					>31.95&deg;N 35.93&deg;E
				</p>
				<div class="block-ctl">
					<div class="ctl" role="group" aria-label="Sheet direction">
						<span class="ctl-k">Dir</span>
						<button
							type="button"
							class="ctl-b"
							data-dir="ltr"
							aria-pressed="true">LTR</button
						>
						<button
							type="button"
							class="ctl-b"
							data-dir="rtl"
							aria-pressed="false">RTL</button
						>
					</div>
					<div class="ctl">
						<button
							type="button"
							class="ctl-b ctl-wide"
							data-grid
							aria-pressed="false"
						>
							Grid <span class="ctl-key">G</span>
						</button>
					</div>
				</div>
			</div>
		</header>

		<div class="ruler" aria-hidden="true">
			<div class="sheet ruler-in">
				{
					Array.from({ length: 12 }).map((_, i) => (
						<span>{String(i + 1).padStart(2, '0')}</span>
					))
				}
			</div>
		</div>

		<main id="sheet">
			<!-- ── Plate 00 : the thesis ─────────────────────────────────── -->
			<section class="hero" aria-labelledby="nm">
				<div class="sheet">
					<h1 class="nm" id="nm">
						<span class="nm-lat">
							{nameLines.map((l) => <span class="nm-line">{l}</span>)}
						</span>
						<span class="nm-ar" lang="ar">{profile.name.ar}</span>
					</h1>

					<div class="hero-body grid12">
						<div class="hero-thesis">
							<p class="lede">
								I build web and mobile products from Amman, and nearly all of
								them ship in two scripts. That is the part most teams get wrong:
								a mirrored layout is a second design, not a translated one. It
								has to be as correct as the first.
							</p>
							<p class="lede-2">
								This sheet mirrors too. Use the DIR control in the title block
								and watch the columns renumber from the other edge.
							</p>
							<p class="cta-row">
								<a class="cta" href="#plates">Go to the plates</a>
								<a class="cta cta-ghost" href="#commission">Commission work</a>
							</p>
						</div>

						<dl class="callouts">
							<div class="callout">
								<dt>A</dt>
								<dd>
									Name set to measure: 100cqw &divide; 6.22em, the width of the
									longer line. It refits at every viewport, never wraps.
								</dd>
							</div>
							<div class="callout">
								<dt>B</dt>
								<dd>
									Archivo, weight 800, width 125, tracking &minus;0.03em,
									optically aligned &minus;0.048em against the rule.
								</dd>
							</div>
							<div class="callout">
								<dt>C</dt>
								<dd>
									Twelve columns, 8&nbsp;px baseline, one ink besides black.
								</dd>
							</div>
						</dl>
					</div>
				</div>
			</section>

			<!-- ── Register ──────────────────────────────────────────────── -->
			<section class="band" aria-labelledby="reg-h">
				<div class="sheet">
					<div class="head grid12">
						<p class="eyebrow">Register</p>
						<h2 class="h2" id="reg-h">The figures, measured</h2>
						<p class="head-note">
							Dimension lines drawn to one scale: the full rule is
							{' '}{total} projects.
						</p>
					</div>

					<div class="regtable">
						{
							register.map((r) => (
								<div class="regrow">
									<span class="reg-v">{r.value}</span>
									<span
										class="reg-dim"
										style={`--w:${((r.of ? Number(r.value) / r.of : 0) * 100).toFixed(1)}%`}
									/>
									<span class="reg-l">{r.label}</span>
									<span class="reg-n">{r.note}</span>
								</div>
							))
						}
						<div class="regrow regrow-plain">
							<span class="reg-v">04</span>
							<span class="reg-dim reg-dim-off">years</span>
							<span class="reg-l">Building, professionally</span>
							<span class="reg-n"
								>Off scale: measured in time, not in projects.</span
							>
						</div>
						<div class="regrow regrow-plain regrow-mark">
							<span class="reg-v">02</span>
							<span class="reg-dim reg-dim-off">scripts</span>
							<span class="reg-l">Two directions, one codebase</span>
							<span class="reg-n">The constant across all {total}.</span>
						</div>
					</div>
				</div>
			</section>

			<!-- ── Plates 01–08 ──────────────────────────────────────────── -->
			<section class="band" id="plates" aria-labelledby="pl-h">
				<div class="sheet">
					<div class="head grid12">
						<p class="eyebrow">
							Plates 01&ndash;{String(plates).padStart(2, '0')}
						</p>
						<h2 class="h2" id="pl-h">Eight, pulled in full</h2>
						<p class="head-note">
							Each plate carries its own spec block, and the frame sets how wide
							the cover is pulled: a phone runs three columns, a browser runs
							seven.
						</p>
					</div>

					<ol class="plates">
						{
							featured.map((p, i) => (
								<li class="plate" data-frame={p.frame}>
									<p class="plate-rule">
										<span class="plate-no">
											PL.{String(i + 1).padStart(2, '0')}
										</span>
										<span class="plate-tag">
											{categoryLabel[p.category]}
											<span class="sep">·</span>
											{statusLabel[p.status]}
											<span class="sep">·</span>
											{p.year}
										</span>
									</p>

									<div class="plate-grid grid12">
										<div class="plate-main">
											<h3 class="plate-t">
												<a href={`/work/${p.slug}`}>{p.title.en}</a>
											</h3>
											<p class="plate-line">{p.tagline.en}</p>
											{p.image && (
												<figure class="fig" data-frame={p.frame}>
													<div class="fig-mat">
														<Image
															src={p.image}
															alt={`${p.title.en}: ${p.tagline.en}`}
															widths={[420, 760, 1140]}
															sizes="(min-width: 1080px) 52vw, 92vw"
															loading="lazy"
															decoding="async"
														/>
													</div>
													<figcaption>
														Fig. {String(i + 1).padStart(2, '0')}
														<span class="sep">·</span>
														{frameLabel[p.frame]} frame
													</figcaption>
												</figure>
											)}
											<p class="plate-sum">{p.summary.en}</p>
										</div>

										<div class="plate-spec">
											<dl class="spec">
												<div class="spec-row">
													<dt>Year</dt>
													<dd>{p.year}</dd>
												</div>
												<div class="spec-row">
													<dt>Role</dt>
													<dd>{p.role.en}</dd>
												</div>
												<div class="spec-row">
													<dt>Frame</dt>
													<dd>{frameLabel[p.frame]}</dd>
												</div>
												<div class="spec-row">
													<dt>State</dt>
													<dd>{statusLabel[p.status]}</dd>
												</div>
												<div class="spec-row spec-row-stack">
													<dt>Built with</dt>
													<dd>
														<ul class="stack">
															{p.stack.map((s) => (
																<li>{s}</li>
															))}
														</ul>
													</dd>
												</div>
											</dl>

											<p class="plate-links">
												<a class="read" href={`/work/${p.slug}`}>
													Read the case
												</a>
												{linksOf(p.links).map((l) => (
													<a
														class="ext"
														href={l.href}
														rel="noopener noreferrer"
														target="_blank"
													>
														{l.label}
													</a>
												))}
											</p>
										</div>
									</div>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<!-- ── The engineer ──────────────────────────────────────────── -->
			<section class="band" id="about" aria-labelledby="ab-h">
				<div class="sheet">
					<div class="head grid12">
						<p class="eyebrow">Specimen</p>
						<h2 class="h2" id="ab-h">Who is setting this</h2>
					</div>

					<div class="about grid12">
						<figure class="portrait">
							<div class="fig-mat">
								<Image
									src={profilePhoto}
									alt="Haitham Assoli"
									widths={[240, 480]}
									sizes="(min-width: 1080px) 20vw, 55vw"
									loading="lazy"
									decoding="async"
								/>
							</div>
							<figcaption>Portrait<span class="sep">·</span>Amman</figcaption>
						</figure>

						<div class="about-text">
							{bio.map((b) => <p>{b}</p>)}
						</div>

						<dl class="marks">
							{
								marks.map((m) => (
									<div class="mark">
										<dt>{m.k}</dt>
										<dd>{m.v}</dd>
									</div>
								))
							}
						</dl>
					</div>

					<div class="roles grid12">
						<h3 class="sub" id="roles-h">Where the hours went</h3>
						<ol class="rolelist" aria-labelledby="roles-h">
							{
								shortRoles.map((r) => (
									<li class="role">
										<span class="role-co">{r.company.en}</span>
										<span class="role-rl">{r.role.en}</span>
										<span class="role-pd">{r.period}</span>
									</li>
								))
							}
						</ol>
					</div>
				</div>
			</section>

			<!-- ── Bench ─────────────────────────────────────────────────── -->
			<section class="band" aria-labelledby="bench-h">
				<div class="sheet">
					<div class="head grid12">
						<p class="eyebrow">Bench</p>
						<h2 class="h2" id="bench-h">What comes off the shelf</h2>
						<p class="head-note">
							The whole inventory, grouped by where it sits in the stack. A cyan
							mark flags the short list, the ones that come off the shelf most
							weeks.
						</p>
					</div>

					<div class="bench grid12">
						{
							bench.map((g) => (
								<div class="bench-col">
									<h3 class="bench-k">{g.k}</h3>
									<ul class="bench-l">
										{g.v.map((v) => (
											<li
												data-daily={
													daily.has(v.toLowerCase()) ? 'y' : undefined
												}
											>
												{v}
											</li>
										))}
									</ul>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- ── Index of all 39 ───────────────────────────────────────── -->
			<section class="band" aria-labelledby="idx-h">
				<div class="sheet">
					<div class="head grid12">
						<p class="eyebrow">Sheet index</p>
						<h2 class="h2" id="idx-h">All {total}, in order</h2>
						<p class="head-note">
							Plate numbers mark the eight drawn up above. Every entry has its
							own page.
						</p>
					</div>

					<ol class="index">
						{
							projects.map((p) => {
								const pl = featured.findIndex((f) => f.slug === p.slug);
								return (
									<li class="idx" data-plate={pl >= 0 ? 'y' : undefined}>
										<a href={`/work/${p.slug}`}>
											<span class="idx-n">
												{pl >= 0
													? `PL.${String(pl + 1).padStart(2, '0')}`
													: '—'}
											</span>
											<span class="idx-t">{p.title.en}</span>
											<span class="idx-y">{p.year}</span>
										</a>
									</li>
								);
							})
						}
					</ol>
				</div>
			</section>

			<!-- ── Commission: the one solid ink on the sheet ────────────── -->
			<section class="ink" id="commission" aria-labelledby="hire-h">
				<div class="sheet grid12">
					<div class="hire-main">
						<p class="eyebrow eyebrow-ink">Commission</p>
						<h2 class="hire" id="hire-h">Put it into production.</h2>
						<p class="hire-lede">
							Send the constraint, not the spec. If it has to run offline, in
							two scripts, or on a device that will not phone home, that is the
							interesting version of the brief.
						</p>
						<a class="mailto" href={`mailto:${profile.email}`}
							>{profile.email}</a
						>
						<ul class="hire-links">
							<li>
								<a href={`tel:${profile.phone.replace(/\s/g, '')}`}>
									{profile.phone}
								</a>
							</li>
							<li>
								<a
									href={profile.links.github}
									rel="noopener noreferrer"
									target="_blank">GitHub</a
								>
							</li>
							<li>
								<a
									href={profile.links.linkedin}
									rel="noopener noreferrer"
									target="_blank">LinkedIn</a
								>
							</li>
							<li>
								<a
									href={profile.links.resume}
									rel="noopener noreferrer"
									target="_blank">CV</a
								>
							</li>
							<li>
								<a
									href={profile.links.playStore}
									rel="noopener noreferrer"
									target="_blank">Play Store</a
								>
							</li>
							<li>
								<a
									href={profile.links.website}
									rel="noopener noreferrer"
									target="_blank">assoli.site</a
								>
							</li>
						</ul>
					</div>

					<dl class="hire-spec">
						<div class="hire-row">
							<dt>Based</dt>
							<dd>{profile.location.en}, GMT+3</dd>
						</div>
						<div class="hire-row">
							<dt>Works</dt>
							<dd>Remote, or on site in Amman</dd>
						</div>
						<div class="hire-row">
							<dt>Delivers</dt>
							<dd>Web, iOS and Android, front to back</dd>
						</div>
						<div class="hire-row">
							<dt>Ships in</dt>
							<dd>Arabic and English, both directions</dd>
						</div>
					</dl>
				</div>
			</section>
		</main>

		<footer class="colophon">
			<div class="sheet">
				<div class="bar" aria-hidden="true">
					<svg class="target" viewBox="0 0 24 24" fill="none">
						<circle cx="12" cy="12" r="7" stroke="currentColor" stroke-width="1"
						></circle>
						<path d="M12 0v24M0 12h24" stroke="currentColor" stroke-width="1"
						></path>
					</svg>
					<span class="patch" style="--p:#12130F"></span>
					<span class="patch" style="--p:#0092D0"></span>
					<span class="patch" style="--p:#3FADDD"></span>
					<span class="patch" style="--p:#7FC8E9"></span>
					<span class="patch" style="--p:#BFE3F4"></span>
					<svg class="target" viewBox="0 0 24 24" fill="none">
						<circle cx="12" cy="12" r="7" stroke="currentColor" stroke-width="1"
						></circle>
						<path d="M12 0v24M0 12h24" stroke="currentColor" stroke-width="1"
						></path>
					</svg>
				</div>

				<div class="colo grid12">
					<p class="colo-a">
						Set in Archivo and Martian Mono. Arabic in Noto Kufi. Drawn on
						twelve columns and an 8&nbsp;px baseline, one process ink besides
						registration black. Hand-written CSS, no framework on this sheet.
					</p>
					<p class="colo-b">
						{profile.name.en}<span class="sep">·</span>{profile.title.en}
						<br />
						&copy; {year}<span class="sep">·</span>Sheet 04 of 9
					</p>
				</div>
			</div>
		</footer>

		<script is:inline>
			(() => {
				const root = document.documentElement;

				const dirBtns = Array.from(document.querySelectorAll('[data-dir]'));
				const setDir = (d) => {
					root.setAttribute('dir', d);
					dirBtns.forEach((b) =>
						b.setAttribute('aria-pressed', String(b.dataset.dir === d)),
					);
				};
				dirBtns.forEach((b) =>
					b.addEventListener('click', () => setDir(b.dataset.dir)),
				);

				const gridBtn = document.querySelector('[data-grid]');
				const setGrid = (on) => {
					root.classList.toggle('is-grid', on);
					gridBtn.setAttribute('aria-pressed', String(on));
				};
				gridBtn.addEventListener('click', () =>
					setGrid(!root.classList.contains('is-grid')),
				);

				document.addEventListener('keydown', (e) => {
					if (e.key !== 'g' && e.key !== 'G') return;
