---
import { Image } from 'astro:assets';
import { profile } from '../../content/profile';
import { featured, projects } from '../data/projects';
import { toolbox } from '../i18n';
import LangBoot from '../components/LangBoot.astro';
import Logo from '../components/Logo.astro';
import Seam from '../components/Seam.astro';
import StyleSwitcher from '../components/StyleSwitcher.astro';
import T from '../components/T.astro';
import { s, pair, yearPair } from '../data/variant-ui';
import profilePhoto from '../assets/images/profile.png';

/* The grid is uneven on purpose, and the spans follow the covers: the three
   landscape screenshots get the wide slots, the five phone shots get narrow
   ones, and the last row stands them side by side like a shelf. */
const spans = [12, 6, 6, 7, 5, 4, 4, 4];

const statusKey = {
	live: 'status.live',
	shipped: 'status.shipped',
	delisted: 'status.delisted',
	wip: 'status.wip',
	archived: 'status.archived',
} as const;

const catKey = {
	web: 'cat.web',
	mobile: 'cat.mobile',
	ai: 'cat.ai',
	client: 'cat.client',
	desktop: 'cat.desktop',
	extension: 'cat.extension',
} as const;

const linkKey = {
	live: 'project.live',
	appStore: 'project.apple',
	playGoogle: 'project.play',
	github: 'project.github',
	vscode: 'project.vscode',
} as const;

const orderedLinks = [
	'live',
	'appStore',
	'playGoogle',
	'github',
	'vscode',
] as const;

const rest = projects.length - featured.length;

/* Static figures. dev-stats.ts fetches at build time and is deliberately not
   imported here. */
const figures = [
	{
		n: '39',
		label: s('stat.shipped'),
		note: pair(
			'web, mobile, desktop, extensions',
			'ويب، وجوّال، وسطح مكتب، وإضافات',
		),
	},
	{
		n: '13',
		label: s('stat.stores'),
		note: pair('App Store and Google Play', 'آب ستور وجوجل بلاي'),
	},
	{
		n: '08',
		label: pair('written up in full', 'مشروحة بالكامل'),
		note: pair('problem, decision, outcome', 'المشكلة، ثم القرار، ثم النتيجة'),
	},
	{
		n: '04',
		label: s('stat.years'),
		note: pair(
			'freelance, salaried and founder, since 2022',
			'عملًا حرًّا وبراتب ومؤسِّسًا، منذ 2022',
		),
	},
];

const ticks = [
	{ n: '39', l: pair('shipped', 'صدرت') },
	{ n: '13', l: pair('on the stores', 'على المتاجر') },
	{ n: '8', l: pair('written up', 'مشروحة') },
	{ n: '4', l: pair('years', 'سنوات') },
];

/* Five of the eight covers are phone screenshots. Cropping a 1080×2340 shot to
   a landscape card destroys it, so tall covers stand in the frame instead of
   filling it, lit from behind by the project accent. */
const isTall = (img?: ImageMetadata) => !!img && img.height > img.width;
const widthsFor = (img: ImageMetadata) =>
	(img.height > img.width ? [320, 560, 780] : [440, 760, 1120]).filter(
		(w) => w <= img.width,
	);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Haitham Assoli — two scripts, one build</title>
		<meta
			name="description"
			content="Haitham Assoli builds bilingual Arabic-first web and mobile products from Amman, Jordan. 39 shipped, 13 on the app stores, recent work in on-device AI."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..400&family=Azeret+Mono:wght@400;500&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap"
		/>
		<LangBoot />
		<Seam />
	</head>
	<body>
		<!-- The refraction filter. One turbulence field, displaced gently, used
		     by the hero lens and by the language switch: it is expensive and it
		     is the signature. -->
		<svg
			class="filters"
			aria-hidden="true"
			focusable="false"
			width="0"
			height="0"
		>
			<filter
				id="liquid"
				x="-25%"
				y="-25%"
				width="150%"
				height="150%"
				color-interpolation-filters="sRGB"
			>
				<feTurbulence
					type="fractalNoise"
					baseFrequency="0.011 0.017"
					numOctaves="2"
					seed="7"
					result="noise"></feTurbulence>
				<feGaussianBlur in="noise" stdDeviation="1.4" result="soft"
				></feGaussianBlur>
				<feDisplacementMap
					in="SourceGraphic"
					in2="soft"
					scale="26"
					xChannelSelector="R"
					yChannelSelector="G"></feDisplacementMap>
			</filter>
		</svg>

		<div class="field" aria-hidden="true">
			<div class="blobs"></div>
		</div>
		<div class="grain" aria-hidden="true"></div>

		<a class="skip" href="#work"><T v={s('nav.skip')} /></a>

		<!-- The switch is a lens on a rail: the glass slides to the other
		     language and bends the letter it lands on. -->
		<div class="dock">
			<nav class="dock__nav" aria-label="Pages — الصفحات">
				<a href="/3/projects"><T v={s('work.all')} /></a>
				<a href="/3/hire"><T v={s('nav.hire')} /></a>
			</nav>
			<button type="button" class="lang" data-lang-toggle>
				<span class="lang__slot" aria-hidden="true">
					<span class="lang__side lang__side--en">EN</span>
					<span class="lang__side lang__side--ar" lang="ar">ع</span>
					<span class="lang__puck">
						<span class="lang__glass"></span>
						<span class="lang__rim"></span>
					</span>
				</span>
				<span class="sr" data-l="en" lang="ar">اقرأ بالعربية</span>
				<span class="sr" data-l="ar" lang="en">Read in English</span>
			</button>
		</div>

		<main id="top">
			<!-- ── HERO ─────────────────────────────────────────────────────── -->
			<header class="hero" id="hero">
				<!-- The mark at cover scale: frost letters, lagoon rule and the same
				     lens the bar wears on every other /3 page. The wordmark stands
				     alone and is presentation; the h1 below carries the reading. -->
				<div class="mark">
					<span class="mark__lens" aria-hidden="true"></span>
					<Logo class="mark__logo" labelled={false} />
				</div>

				<p class="eyebrow">
					<T
						v={pair(
							'Amman, Jordan — web & mobile, full stack',
							'عمّان، الأردن — ويب وتطبيقات، full stack',
						)}
					/>
				</p>

				<!-- The English block sizes the stage in both languages, so the
				     second reading never overflows it. Everything visible is a
				     layer on top of it. -->
				<div class="stage" id="stage">
					<p class="type type--en sizer" aria-hidden="true">
						<span>Two scripts.</span>
						<span>Two directions.</span>
						<span>One build.</span>
					</p>

					<p
						class="type type--ar layer echo echo--ar"
						aria-hidden="true"
						lang="ar"
						dir="rtl"
					>
						<span>لغتان.</span>
						<span>اتجاهان.</span>
						<span>بناءٌ واحد.</span>
					</p>
					<p
						class="type type--en layer echo echo--en"
						aria-hidden="true"
						lang="en"
						dir="ltr"
					>
						<span>Two scripts.</span>
						<span>Two directions.</span>
						<span>One build.</span>
					</p>

					<h1 class="type type--en layer head" data-l="en" lang="en" dir="ltr">
						<span>Two scripts.</span>
						<span>Two directions.</span>
						<span>One build.</span>
					</h1>
					<h1 class="type type--ar layer head" data-l="ar" lang="ar" dir="rtl">
						<span>لغتان.</span>
						<span>اتجاهان.</span>
						<span>بناءٌ واحد.</span>
					</h1>

					<p
						class="type type--ar layer lit lit--ar"
						aria-hidden="true"
						lang="ar"
						dir="rtl"
					>
						<span>لغتان.</span>
						<span>اتجاهان.</span>
						<span>بناءٌ واحد.</span>
					</p>
					<p
						class="type type--en layer lit lit--en"
						aria-hidden="true"
						lang="en"
						dir="ltr"
					>
						<span>Two scripts.</span>
						<span>Two directions.</span>
						<span>One build.</span>
					</p>

					<div class="lens" id="lens" aria-hidden="true">
						<span class="lens__body"></span>
						<span class="lens__rim"></span>
					</div>
				</div>

				<p class="stage__hint">
					<T
						v={pair(
							'Move the pointer across the sentence. The glass finds the other reading of it — the same line, the other script, running the other way. That is the job.',
							'حرّك المؤشر فوق الجملة. يجد الزجاج قراءتها الأخرى — السطر نفسه، بالخط الآخر، وسائرًا في الاتجاه المعاكس. هذا هو العمل.',
						)}
						as="span"
						class="hint hint--fine"
					/>
					<T
						v={pair(
							'The glass travels across the sentence on its own. It finds the other reading — the same line, the other script, running the other way. That is the job.',
							'يعبر الزجاج الجملة من تلقاء نفسه فيجد قراءتها الأخرى — السطر نفسه، بالخط الآخر، وسائرًا في الاتجاه المعاكس. هذا هو العمل.',
						)}
						as="span"
						class="hint hint--coarse"
					/>
				</p>

				<div class="panel panel--thesis">
					<T
						v={pair(
							'A mirrored interface is not a translated one. It is a second interface, and it has to be as good as the first. I build products that are bilingual from the first commit — React Native and Expo on both app stores, Next.js and Astro on the web, NestJS, Convex and Supabase underneath.',
							'الواجهة المنعكسة ليست واجهة مترجمة. هي واجهة ثانية، ولا بد أن تكون بجودة الأولى. أبني منتجات ثنائية اللغة من أول commit — React Native وExpo على المتجرين، وNext.js وAstro على الويب، وNestJS وConvex وSupabase تحتها.',
						)}
						as="p"
						class="lede"
					/>
					<ul class="ticks">
						{
							ticks.map((t) => (
								<li>
									<b>{t.n}</b>
									<T v={t.l} />
								</li>
							))
						}
					</ul>
				</div>
			</header>

			<!-- ── WORK ─────────────────────────────────────────────────────── -->
			<section class="section" id="work" aria-labelledby="work-h">
				<div class="head-block">
					<p class="eyebrow">
						<T v={pair('Eight of thirty-nine', 'ثمانية من تسعة وثلاثين')} />
					</p>
					<h2 class="h2" id="work-h">
						<T v={pair('The ones worth the walkthrough', 'التي تستحق الشرح')} />
					</h2>
					<T
						v={pair(
							'Each of these has a full write-up behind it: what was actually hard, what I chose, and what it did once real people used it.',
							'خلف كل واحد منها شرح كامل: ما كان صعبًا فعلًا، وما اخترته، وماذا فعل حين استخدمه الناس.',
						)}
						as="p"
						class="sub"
					/>
				</div>

				<div class="grid">
					{
						featured.map((p, i) => (
							<article
								class="card panel"
								data-shape={isTall(p.image) ? 'tall' : 'wide'}
								data-span={spans[i] ?? 6}
								style={`--accent:${p.accent}; --span:${spans[i] ?? 6}`}
							>
								<div class="card__media">
									{p.image ? (
										<Image
											src={p.image}
											alt={`${p.title.en} — ${p.tagline.en}`}
											widths={widthsFor(p.image)}
											sizes="(max-width: 780px) 92vw, (max-width: 1180px) 46vw, 560px"
											loading={i === 0 ? 'eager' : 'lazy'}
											decoding="async"
											class="card__img"
										/>
									) : (
										<div class="card__void">
											<span>{p.title.en}</span>
										</div>
									)}
									<span class="card__scrim" />
								</div>

								<div class="card__body">
									<p class="card__meta">
										<span class="pip" />
										<T v={s(statusKey[p.status])} />
										<span class="card__sep" aria-hidden="true">
											·
										</span>
										<T v={yearPair(p.year)} />
										<span class="card__sep" aria-hidden="true">
											·
										</span>
										<T v={s(catKey[p.category])} />
									</p>
									<h3 class="card__title">
										<a href={`/3/work/${p.slug}`}>
											<T v={p.title} />
										</a>
									</h3>
									<T v={p.tagline} as="p" class="card__tag" />
									<T v={p.summary} as="p" class="card__sum" />
									<T v={p.role} as="p" class="card__role" />

									<ul class="chips">
										{p.stack.slice(0, 5).map((t) => (
											<li>{t}</li>
										))}
										{p.stack.length > 5 && (
											<li class="chips__more">+{p.stack.length - 5}</li>
										)}
									</ul>

									<div class="card__links">
										<a class="btn btn--go" href={`/3/work/${p.slug}`}>
											<T v={s('work.read')} />
										</a>
										{orderedLinks.map((k) =>
											p.links[k] ? (
												<a
													class="btn"
													href={p.links[k]}
													rel="noreferrer noopener"
													target="_blank"
												>
													<T v={s(linkKey[k])} />
												</a>
											) : null,
										)}
									</div>
								</div>
							</article>
						))
					}
				</div>

				<p class="aside">
					<T
						v={pair(
							`The other ${rest} live in the archive — municipal portals, tourism guides, charity platforms, a few extensions and a handful of things that only ever ran on my own machine.`,
							`الـ ${rest} الباقية في الأرشيف — بوابات بلدية، وأدلة سياحية، ومنصات خيرية، وبضع إضافات، وأشياء لم تعمل يومًا إلا على جهازي.`,
						)}
					/>
					{' '}
					<a class="aside__link" href="/3/projects">
						<T v={s('work.all')} />
					</a>
				</p>
			</section>

			<!-- ── WHO ──────────────────────────────────────────────────────── -->
			<section class="section" id="who" aria-labelledby="who-h">
				<div class="head-block">
					<p class="eyebrow"><T v={profile.location} /></p>
					<h2 class="h2" id="who-h">
						<T v={pair('Who is behind the glass', 'مَن خلف الزجاج')} />
					</h2>
				</div>

				<div class="who">
					<figure class="portrait panel">
						<Image
							src={profilePhoto}
							alt="Haitham Assoli"
							widths={[280, 480]}
							sizes="(max-width: 780px) 60vw, 300px"
							loading="lazy"
							decoding="async"
						/>
						<figcaption>
							<span data-l="en" lang="en">Haitham Assoli</span>
							<span data-l="ar" lang="ar">هيثم العسولي</span>
						</figcaption>
					</figure>

					<div class="who__text">
						{
							(['en', 'ar'] as const).map((l) => (
								<div class="who__prose" data-l={l} lang={l}>
									{profile.about[l].map((para) => (
										<p>{para}</p>
									))}
								</div>
							))
						}

						<ul class="track">
							{
								profile.experience.slice(0, 4).map((e) => (
									<li>
										<T v={yearPair(e.period)} class="track__when" />
										<span class="track__what">
											<T v={e.role} as="b" />
											<T v={e.company} as="i" />
										</span>
									</li>
								))
							}
						</ul>

						<p class="who__edu">
							<T v={profile.education[0].degree} />,{' '}
							<T v={profile.education[0].school} />,{' '}
							<T v={yearPair(profile.education[0].period)} />
							{
								profile.education[0].note && (
									<>
										{' ('}
										<T v={profile.education[0].note} />
										{')'}
									</>
								)
							}.
						</p>
					</div>
				</div>
			</section>

			<!-- ── TOOLBOX ──────────────────────────────────────────────────── -->
			<section class="section" id="stack" aria-labelledby="stack-h">
				<div class="head-block">
					<p class="eyebrow">
						<T
							v={pair(
								`${toolbox.length} tools, in order of how often`,
								`${toolbox.length} أداة، مرتّبة بحسب كثرة الاستخدام`,
							)}
						/>
					</p>
					<h2 class="h2" id="stack-h"><T v={s('about.stackTitle')} /></h2>
					<T v={s('about.stackLede')} as="p" class="sub" />
				</div>

				<ul class="tools">
					{
						toolbox.map((t, i) => (
							<li class="tool panel" style={`--i:${i}`}>
								<span class="tool__n">{String(i + 1).padStart(2, '0')}</span>
								{t}
							</li>
						))
					}
				</ul>
			</section>

			<!-- ── FIGURES ──────────────────────────────────────────────────── -->
			<section class="section" id="count" aria-labelledby="count-h">
				<div class="head-block">
					<p class="eyebrow"><T v={pair('The count', 'العدّ')} /></p>
					<h2 class="h2" id="count-h">
						<T
							v={pair(
								'Four numbers, none of them rounded up',
								'أربعة أرقام، لا واحد منها مُقرَّب',
							)}
						/>
					</h2>
				</div>

				<div class="figures panel">
					{
						figures.map((f) => (
							<div class="fig">
								<p class="fig__n">{f.n}</p>
								<T v={f.label} as="p" class="fig__label" />
								<T v={f.note} as="p" class="fig__note" />
							</div>
						))
					}
				</div>
			</section>

			<!-- ── HIRE ─────────────────────────────────────────────────────── -->
			<section class="section section--hire" id="hire" aria-labelledby="hire-h">
				<div class="hire panel">
					<p class="eyebrow"><T v={s('hire.eyebrow')} /></p>
					<h2 class="h2 h2--hire" id="hire-h">
						<T
							v={pair(
								'If it has to work in two directions, start here.',
								'إن كان لا بد أن يعمل في الاتجاهين، فابدأ من هنا.',
							)}
						/>
					</h2>
					<T
						v={pair(
							'Tell me the constraint and I will tell you whether I am the right person for it. Usually within a day.',
							'صِف لي القيد وسأخبرك إن كنت الشخص المناسب له. عادةً خلال يوم.',
						)}
						as="p"
						class="sub sub--hire"
					/>

					<div class="hire__acts">
						<a class="btn btn--go btn--big" href="/3/hire">
							<T v={pair('Fill in the brief', 'املأ الوصف')} />
						</a>
						<a class="mailto" href={`mailto:${profile.email}`}>
							<T
								v={pair('Or write to', 'أو راسلني على')}
								as="span"
								class="mailto__label"
							/>
							<span class="mailto__addr" dir="ltr">{profile.email}</span>
						</a>
					</div>

					<ul class="rail">
						<li>
							<a
								href={profile.links.github}
								rel="noreferrer noopener"
								target="_blank">GitHub</a
							>
						</li>
						<li>
							<a
								href={profile.links.linkedin}
								rel="noreferrer noopener"
								target="_blank">LinkedIn</a
							>
						</li>
						<li>
							<a
								href={profile.links.website}
								rel="noreferrer noopener"
								target="_blank">assoli.site</a
							>
						</li>
						<li>
							<a
								href={profile.links.resume}
								rel="noreferrer noopener"
								target="_blank"><T v={s('nav.cv')} /></a
							>
						</li>
						<li>
							<a
								href={profile.links.playStore}
								rel="noreferrer noopener"
								target="_blank"><T v={s('project.play')} /></a
							>
						</li>
						<li>
							<a href={`tel:${profile.phone.replace(/\s/g, '')}`} dir="ltr"
								>{profile.phone}</a
							>
						</li>
					</ul>
				</div>
			</section>
		</main>

		<footer class="foot">
			<p class="foot__name">
				<span data-l="en" lang="en">Haitham Assoli</span>
				<span data-l="ar" lang="ar">هيثم العسولي</span>
			</p>
			<p class="foot__line">
				<T v={profile.title} /> · <T v={profile.location} /> ·{' '}
				<T v={pair('variant 3, liquid glass', 'التصميم الثالث، زجاج سائل')} />
			</p>
			<p class="foot__back">
				<a href="#top"><T v={pair('Back to the top', 'عد إلى الأعلى')} /></a>
			</p>
		</footer>

		<script>
			/* A bundled script runs once per session and loses
			   `data-astro-rerun` on the way out, so the lens is rewired on
			   every navigation from the document instead. */
			const wire = () => {
				const stage = document.getElementById('stage');
				if (!stage) return;

				let raf = 0;
				let px = 0;
				let py = 0;

				const apply = () => {
					raf = 0;
					stage.style.setProperty('--lx', px + 'px');
					stage.style.setProperty('--ly', py + 'px');
				};

				/* Physical pixels from the box's left edge: the lens and the
				   clip-path both read this coordinate space, in either
				   direction. */
				const onMove = (e: PointerEvent) => {
					const r = stage.getBoundingClientRect();
					px = e.clientX - r.left;
					py = e.clientY - r.top;
					if (!stage.classList.contains('manual'))
						stage.classList.add('manual');
					if (!raf) raf = requestAnimationFrame(apply);
				};

				const host = stage.closest('.hero') ?? stage;
				host.addEventListener('pointermove', onMove as EventListener, {
					passive: true,
				});
				host.addEventListener('pointerleave', () => {
					stage.classList.remove('manual');
				});
			};

			/* Fires on the first load too, so this is the only hook needed. */
			document.addEventListener('astro:page-load', wire);
		</script>

