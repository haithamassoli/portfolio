---
/* The main design, in both languages, at `/` and `/ar`. Every other design
   has its own route file under src/pages/<design>/ — see src/designs/paths.ts
   for why. */
import Home from '../designs/main/Home.astro';
import Work from '../designs/main/Work.astro';
import Hire from '../designs/main/Hire.astro';
import Project from '../designs/main/Project.astro';
import { designPaths, resolve, type RouteProps } from '../designs/paths';
import { langs } from '../designs/routes';

export const getStaticPaths = () =>
	langs.flatMap((lang) =>
		designPaths('main', lang).map((p) => ({
			...p,
			params: {
				slug:
					[lang === 'ar' ? 'ar' : '', p.params.slug ?? '']
						.filter(Boolean)
						.join('/') || undefined,
			},
		})),
	);

const props = Astro.props as RouteProps;
const { design, project, next } = resolve(props);
const lang = props.lang;
---

{props.kind === 'home' && <Home design={design} lang={lang} />}
{props.kind === 'work' && <Work design={design} lang={lang} />}
{props.kind === 'hire' && <Hire design={design} lang={lang} />}
{
	props.kind === 'project' && project && next && (
		<Project design={design} lang={lang} project={project} next={next} />
	)
}
