				</p>
				<T v={s('footer.line')} as="p" class="mono" />
			</footer>
		</div>

		<script is:inline>
			document.documentElement.classList.add('js');

			/* Cursor-tracked highlight: one listener for the whole tray. */
			const tray = document.querySelector('.tray');
			tray.addEventListener('pointermove', (e) => {
				const tile = e.target.closest('.tile');
				if (!tile) return;
				const r = tile.getBoundingClientRect();
				tile.style.setProperty('--mx', `${e.clientX - r.left}px`);
				tile.style.setProperty('--my', `${e.clientY - r.top}px`);
			});

			/* The mirror. LangBoot owns the language; the card only reacts to it,
			   so it flips whichever control was pulled. */
			const card = document.getElementById('mcard');
			new MutationObserver(() => {
				card.classList.remove('is-flipping');
				void card.offsetWidth;
				card.classList.add('is-flipping');
			}).observe(document.documentElement, {
				attributes: true,
				attributeFilter: ['lang'],
			});

			/* Amman on the clock, corrected on load and kept honest each minute. */
			const clock = document.getElementById('clock');
			const fmt = new Intl.DateTimeFormat('en-GB', {
				timeZone: 'Asia/Amman',
				hour: '2-digit',
				minute: '2-digit',
			});
			const tick = () => {
				const now = new Date();
				clock.textContent = fmt.format(now);
				clock.setAttribute('datetime', now.toISOString());
			};
			tick();
			setInterval(tick, 20000);

			/* Boards settle in as they arrive. */
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				const io = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('is-in');
							io.unobserve(entry.target);
						});
					},
					{ rootMargin: '0px 0px -8% 0px' },
				);
				document.querySelectorAll('.board').forEach((b) => io.observe(b));
			}
			/* Whatever happens, nothing stays hidden. */
			const revealAll = () =>
				document
					.querySelectorAll('.board')
					.forEach((b) => b.classList.add('is-in'));
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) revealAll();
			else setTimeout(revealAll, 2000);
			document.addEventListener('visibilitychange', revealAll);
		</script>

		<StyleSwitcher n={5} />
