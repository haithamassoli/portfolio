---
/* Variant 5 — "Terminal". A tmux-flavoured session on warm amber phosphor.
   The signature is the LANG switch: it mirrors the whole page with a CSS
   checkbox, so the bilingual demo works with JavaScript switched off. */
import { Image } from 'astro:assets';
import { profile } from '../../content/profile';
import { featured, projects } from '../data/projects';
import { toolbox } from '../i18n';
import StyleSwitcher from '../components/StyleSwitcher.astro';
import profilePhoto from '../assets/images/profile.png';

/* The filesystem: 39 projects, grouped the way `tree` would group them. */
const catOrder = [
	'web',
	'mobile',
	'ai',
	'desktop',
	'extension',
	'client',
] as const;

const dirs = catOrder.map((c) => ({
	name: c,
	items: projects.filter((p) => p.category === c),
}));

/* Colour in the toolbox listing encodes where the code actually runs. */
const runsOn: Record<string, string> = {
	'React Native': 'native',
	Expo: 'native',
	Reanimated: 'native',
	Skia: 'native',
	React: 'browser',
	'Next.js': 'browser',
	'Tailwind CSS': 'browser',
	'React Query': 'browser',
	Zustand: 'browser',
	Motion: 'browser',
	'Node.js': 'server',
	NestJS: 'server',
	Supabase: 'server',
	Convex: 'server',
	Firebase: 'server',
	PostgreSQL: 'server',
	TypeScript: 'both',
	Zod: 'both',
	Figma: 'none',
};

const legend = [
	{ key: 'native', label: 'on the phone' },
	{ key: 'browser', label: 'in the browser' },
	{ key: 'server', label: 'on the server' },
	{ key: 'both', label: 'both ends' },
	{ key: 'none', label: 'not shipped code' },
];

/* Static figures. dev-stats.ts is a network call at build time; not here. */
const figures = [
	{ k: 'projects shipped', v: '39', n: 'four years of them' },
	{ k: 'on the app stores', v: '13', n: 'iOS, Android, or both' },
	{ k: 'written up in full', v: '8', n: 'problem, decision, outcome' },
	{ k: 'years building', v: '4', n: 'since 2022, freelance onward' },
	{ k: 'scripts supported', v: '2', n: 'Arabic and Latin' },
	{ k: 'writing directions', v: '2', n: 'RTL first, LTR second' },
];

const clock = new Intl.DateTimeFormat('en-GB', {
	timeZone: 'Asia/Amman',
	hour: '2-digit',
	minute: '2-digit',
}).format(new Date());

const links = [
	{ label: 'github', href: profile.links.github },
	{ label: 'linkedin', href: profile.links.linkedin },
	{ label: 'website', href: profile.links.website },
	{ label: 'resume', href: profile.links.resume },
	{ label: 'play store', href: profile.links.playStore },
];

const linkOrder: Array<
	['live' | 'github' | 'appStore' | 'playGoogle' | 'vscode', string]
> = [
	['live', 'open live'],
	['appStore', 'app store'],
	['playGoogle', 'play store'],
	['github', 'source'],
	['vscode', 'marketplace'],
];
---

<!doctype html>
<html lang="en" dir="ltr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>haitham@amman — session</title>
		<meta
			name="description"
			content="Haitham Assoli, web and mobile full-stack engineer in Amman. Bilingual Arabic-first apps, 39 shipped, 13 on the app stores."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans+Arabic:wght@400;600&family=IBM+Plex+Serif:ital,wght@1,400&display=swap"
		/>
	</head>

	<body>
		<a class="skip" href="#main">Skip to the content</a>

		<header class="chrome">
			<div class="chrome__inner">
				<div class="status">
					<span class="status__tag">haitham@amman</span>
					<span class="status__path">~/portfolio</span>
					<span class="status__sp"></span>
					<span class="status__dir" data-dir>dir=ltr</span>

					<input id="lang" class="langbox" type="checkbox" />
					<label class="lang" for="lang">
						<span class="lang__k">LANG=</span>
						<span class="lang__v lang__v--en">en</span>
						<span class="lang__v lang__v--ar">ar</span>
					</label>

					<span class="status__clock"><span data-clock>{clock}</span> +03</span>
				</div>

				<div class="cmd" data-cmd hidden>
					<form class="cmd__form" data-form>
						<label class="sr-only" for="cmdline">Run a command</label>
						<span class="cmd__caret" aria-hidden="true"></span>
						<input
							class="cmd__input"
							id="cmdline"
							type="text"
							autocomplete="off"
							autocapitalize="off"
							spellcheck="false"
							enterkeyhint="go"
							placeholder="type help"
						/>
					</form>
					<div class="cmd__out" data-out role="status" aria-live="polite"></div>
					<p class="cmd__hint">
						<kbd>/</kbd> focuses this line · <kbd>Esc</kbd> leaves it · every command
						below is real
					</p>
				</div>
			</div>
		</header>

		<main class="session" id="main">
			<!-- ── hero ───────────────────────────────────────────────── -->
			<section class="block--hero block" aria-labelledby="thesis">
				<p class="cmdline"><span class="cmdline__q">cat</span> MANIFEST</p>

				<h1 class="thesis" id="thesis">
					Every screen I ship has to survive being mirrored.
				</h1>

				<p class="quote">
					<span class="quote__hash" aria-hidden="true">#</span>
					A mirrored UI is a different UI, not a translation.
				</p>

				<dl class="kv">
					<div class="kv__row">
						<dt>name</dt>
						<dd>
							<span class="bi"
								><span class="bi__en">Haitham Assoli</span><span
									class="bi__ar"
									lang="ar"
									dir="rtl">هيثم العسولي</span
								></span
							>
						</dd>
					</div>
					<div class="kv__row">
						<dt>role</dt>
						<dd>Web &amp; mobile full-stack engineer</dd>
					</div>
					<div class="kv__row">
						<dt>host</dt>
						<dd>
							<span class="bi"
								><span class="bi__en">Amman, Jordan</span><span
									class="bi__ar"
									lang="ar"
									dir="rtl">عمّان، الأردن</span
								></span
							>
						</dd>
					</div>
					<div class="kv__row">
						<dt>stack</dt>
						<dd>
							React Native and Expo on both stores, Next.js and Astro on the
							web, NestJS or Convex or Supabase behind them.
						</dd>
					</div>
					<div class="kv__row">
						<dt>now</dt>
						<dd>
							On-device AI. Video and audio processed on the user's own phone:
							no upload, no cloud, no telemetry.
						</dd>
					</div>
					<div class="kv__row">
						<dt>shipped</dt>
						<dd>
							<b>39</b> projects · <b>13</b> on the app stores · <b>8</b> written
							up in full · <b>4</b> years
						</dd>
					</div>
				</dl>

				<div class="flip">
					<p class="cmdline cmdline--tight">
						<span class="cmdline__q">env</span> LANG=ar ./portfolio
					</p>
					<p class="flip__copy">
						Arabic is not a setting I add at the end. Flip the switch and the
						page mirrors: the column order, the alignment, the side the eye
						starts on. The commands stay left-to-right, because a command is not
						prose.
					</p>
					<label class="flip__btn" for="lang">
						<span class="flip__on">flip to ar · mirror the page</span>
						<span class="flip__off">flip back to en</span>
					</label>
				</div>

				<p class="rtl-note">
					<span aria-hidden="true">▸</span> Mirrored. Layout, indentation and the
					tree connectors all changed side. Project names switched script. The prompt,
					the digits and the file paths did not, and that mixed run is the part most
					sites get wrong.
				</p>
			</section>

			<!-- ── featured ───────────────────────────────────────────── -->
			<section class="block" id="work" aria-labelledby="work-h">
				<p class="cmdline">
					<span class="cmdline__q">ls</span> -l ~/work --featured
				</p>
				<h2 class="h2" id="work-h">
					Eight records, opened <span class="h2__dim">total 8</span>
				</h2>
				<p class="lede">
					These are the ones with a full write-up behind them: what the problem
					was, what I decided, what it cost. The other 31 are one section down.
				</p>

				<ol class="recs">
					{
						featured.map((p, i) => (
							<li class="rec" id={`rec-${p.slug}`}>
								<p class="cmdline cmdline--tight">
									<span class="cmdline__q">open</span> ~/work/{p.slug}
								</p>

								<h3 class="rec__title">
									<a href={`/work/${p.slug}`}>
										<span class="bi">
											<span class="bi__en">{p.title.en}</span>
											<span class="bi__ar" lang="ar" dir="rtl">
												{p.title.ar}
											</span>
										</span>
									</a>
									<span class={`st st--${p.status}`}>{p.status}</span>
								</h3>

								<p class="rec__tag">
									<span class="bi">
										<span class="bi__en">{p.tagline.en}</span>
										<span class="bi__ar" lang="ar" dir="rtl">
											{p.tagline.ar}
										</span>
									</span>
								</p>

								<div class="rec__body">
									{p.image && (
										<figure class="shot">
											<figcaption class="shot__bar">
												<span class="shot__name">
													{p.cover.replace(/^\//, '')}
												</span>
												<span class="shot__dim">
													{p.image.width}×{p.image.height}
												</span>
											</figcaption>
											<div class="shot__view">
												<Image
													src={p.image}
													alt={`${p.title.en} interface`}
													widths={[360, 720]}
													sizes="(min-width: 62rem) 20rem, 88vw"
													loading={i === 0 ? 'eager' : 'lazy'}
												/>
											</div>
										</figure>
									)}

									<div class="rec__text">
										<p class="rec__sum">{p.summary.en}</p>

										<dl class="kv kv--tight">
											<div class="kv__row">
												<dt>year</dt>
												<dd>{p.year}</dd>
											</div>
											<div class="kv__row">
												<dt>role</dt>
												<dd>{p.role.en}</dd>
											</div>
											<div class="kv__row">
												<dt>type</dt>
												<dd>
													{p.category} · {p.frame}
												</dd>
											</div>
											<div class="kv__row">
												<dt>stack</dt>
												<dd class="chips">
													{p.stack.slice(0, 8).map((s) => (
														<span class="chip">{s}</span>
													))}
												</dd>
											</div>
										</dl>

										<p class="rec__links">
											<a class="go" href={`/work/${p.slug}`}>
												read the case
											</a>
											{linkOrder.map(([k, label]) =>
												p.links[k] ? (
													<a
														class="go go--out"
														href={p.links[k]}
														rel="noopener noreferrer"
														target="_blank"
													>
														{label}
													</a>
												) : null,
											)}
										</p>
									</div>
								</div>
							</li>
						))
					}
				</ol>
			</section>

			<!-- ── the filesystem ─────────────────────────────────────── -->
			<section class="block" id="fs" aria-labelledby="fs-h">
				<p class="cmdline"><span class="cmdline__q">tree</span> ~/projects</p>
				<h2 class="h2" id="fs-h">Thirty-nine, as a directory</h2>
				<p class="lede">
					Sorted by what the thing runs on, not by how it looks in a grid. Every
					leaf is a real write-up. Colour is status, nothing else.
				</p>

				<ul class="tree">
					{
						dirs.map((d) => (
							<li class="tree__dir">
								<p class="tree__head">
									<span class="tree__folder">{d.name}/</span>
									<span class="tree__count">{d.items.length}</span>
								</p>
								<ul class="tree__kids">
									{d.items.map((p) => (
										<li class="tree__file" id={`f-${p.slug}`}>
											<a class="tree__link" href={`/work/${p.slug}`}>
												<span class="bi">
													<span class="bi__en">{p.title.en}</span>
													<span class="bi__ar" lang="ar" dir="rtl">
														{p.title.ar}
													</span>
												</span>
											</a>
											{p.featured && (
												<span class="tree__star" title="written up in full">
													*
												</span>
											)}
											<span class="tree__year">{p.year}</span>
											<span class={`st st--${p.status}`}>{p.status}</span>
										</li>
									))}
								</ul>
							</li>
						))
					}
				</ul>

				<p class="tree__total">
					6 directories, 39 files · <span class="tree__star">*</span> = written up
					in full
				</p>
			</section>

			<!-- ── whoami ─────────────────────────────────────────────── -->
			<section class="block" id="who" aria-labelledby="who-h">
				<p class="cmdline"><span class="cmdline__q">whoami</span> --long</p>
				<h2 class="h2" id="who-h">Haitham Assoli</h2>

				<div class="who">
					<figure class="shot shot--me">
						<figcaption class="shot__bar">
							<span class="shot__name">profile.png</span>
							<span class="shot__dim">uid 1000</span>
						</figcaption>
						<div class="shot__view">
							<Image
								src={profilePhoto}
								alt="Haitham Assoli"
								widths={[220, 440]}
								sizes="14rem"
								loading="lazy"
							/>
						</div>
					</figure>

					<div class="prose">
						<p>
							I build the whole product: the schema, the API, the app, the store
							listing, the support replies afterwards. Most of it ships in
							Arabic and English at once, because most of the people using it
							read Arabic, and right-to-left is where I start rather than where
							I patch.
						</p>
						<p>
							The work I want is the kind with a hard constraint in it. A model
							that has to fit on the device instead of a server. A search index
							that answers in milliseconds with no backend behind it. A booking
							flow that must never sell the same hour twice. The framework is
							never the interesting part.
						</p>
						<p>
							Right now that constraint is privacy. The recent apps do their
							video and audio work entirely on the user's phone or laptop:
							nothing uploaded, nothing logged, and the whole model running
							where the file already is.
						</p>
						<p class="prose__edu">
							<span class="prose__lbl">education</span>
							{
								profile.education.map((e) => (
									<span class="prose__row">
										{e.degree.en}, {e.school.en}
										<span class="prose__dim">
											{' '}
											· {e.period} · {e.note?.en}
										</span>
									</span>
								))
							}
						</p>
					</div>
				</div>
			</section>

			<!-- ── history ────────────────────────────────────────────── -->
			<section class="block" id="history" aria-labelledby="hist-h">
				<p class="cmdline"><span class="cmdline__q">history</span> --roles</p>
				<h2 class="h2" id="hist-h">Where the hours went</h2>

				<ol class="hist">
					{
						profile.experience.map((e) => (
							<li class="hist__row">
								<span class="hist__when">{e.period}</span>
								<span class="hist__who">
									{e.company.en}
									<span class="hist__role">
										{' '}
										— {e.role.en}
										{e.location ? ` (${e.location.en})` : ''}
									</span>
								</span>
								<span class="hist__what">{e.highlights.en[0]}</span>
							</li>
						))
					}
				</ol>
			</section>

			<!-- ── toolbox ────────────────────────────────────────────── -->
			<section class="block" id="stack" aria-labelledby="stack-h">
				<p class="cmdline"><span class="cmdline__q">cat</span> ~/.toolbox</p>
				<h2 class="h2" id="stack-h">What I reach for first</h2>
				<p class="lede">
					Highlighted by where the code actually executes, which is the only
					grouping that has ever helped me plan a build.
				</p>

				<ul class="tools">
					{
						toolbox.map((t) => (
							<li class={`tool tool--${runsOn[t] ?? 'none'}`}>{t}</li>
						))
					}
				</ul>

				<ul class="legend">
					{
						legend.map((l) => (
							<li class={`legend__i tool--${l.key}`}>
								<span class="legend__sw" aria-hidden="true">
									■
								</span>
								{l.label}
							</li>
						))
					}
				</ul>
			</section>

			<!-- ── figures ────────────────────────────────────────────── -->
			<section class="block" id="stat" aria-labelledby="stat-h">
				<p class="cmdline"><span class="cmdline__q">stat</span> ~/portfolio</p>
				<h2 class="h2" id="stat-h">The counts, plainly</h2>

				<dl class="stat">
					{
						figures.map((f) => (
							<div class="stat__row">
								<dt class="stat__k">{f.k}</dt>
								<dd class="stat__v">
									<b>{f.v}</b>
									<span class="stat__n">{f.n}</span>
								</dd>
							</div>
						))
					}
				</dl>
			</section>

			<!-- ── hire ───────────────────────────────────────────────── -->
			<section class="block" id="hire" aria-labelledby="hire-h">
				<p class="cmdline">
					<span class="cmdline__q">mail</span> -s "work" {profile.email}
				</p>
				<h2 class="h2" id="hire-h">Send the brief, not the buzzwords</h2>
				<p class="lede">
					Tell me what has to be true when it ships and which side the text
					starts on. I answer from Amman, within a day, in Arabic or English.
				</p>

				<p class="hire">
					<a
						class="hire__btn"
						href={`mailto:${profile.email}?subject=Project%20brief`}
					>
						{profile.email}
					</a>
					<a class="go" href={`tel:${profile.phone.replace(/\s/g, '')}`}>
						{profile.phone}
					</a>
				</p>

				<ul class="dots">
					{
						links.map((l) => (
							<li>
								<a class="go go--out" href={l.href} rel="noopener noreferrer">
									{l.label}
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>

		<footer class="foot">
			<p class="cmdline cmdline--tight"><span class="cmdline__q">exit</span></p>
			<p class="foot__line">
				<span class="foot__code">[0]</span> session ended · built with Astro, no trackers,
				no cookie wall · © {new Date().getFullYear()} Haitham Assoli
			</p>
		</footer>

		<script is:inline>
			(function () {
				const body = document.body;
				const box = document.getElementById('lang');
				const dirTag = document.querySelector('[data-dir]');
				const clockEl = document.querySelector('[data-clock]');
				const wrap = document.querySelector('[data-cmd]');
				const form = document.querySelector('[data-form]');
				const input = document.getElementById('cmdline');
				const out = document.querySelector('[data-out]');
				const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

				/* language: keep the dir attribute honest for assistive tech. */
				function syncLang() {
					const ar = box.checked;
					body.classList.toggle('is-ar', ar);
					document.documentElement.setAttribute('dir', ar ? 'rtl' : 'ltr');
					if (dirTag) dirTag.textContent = ar ? 'dir=rtl' : 'dir=ltr';
				}
				if (box) {
					box.addEventListener('change', syncLang);
					syncLang();
				}

				/* live clock in the status line */
				if (clockEl) {
					const fmt = new Intl.DateTimeFormat('en-GB', {
						timeZone: 'Asia/Amman',
						hour: '2-digit',
						minute: '2-digit',
					});
					const tick = function () {
						clockEl.textContent = fmt.format(new Date());
					};
					tick();
					setInterval(tick, 20000);
				}

				if (!wrap || !form || !input || !out) return;
				wrap.hidden = false;

				const slugs = {};
				document.querySelectorAll('[id^="f-"]').forEach(function (el) {
					slugs[el.id.slice(2)] = el;
				});
				const featuredIds = {};
				document.querySelectorAll('[id^="rec-"]').forEach(function (el) {
					featuredIds[el.id.slice(4)] = el;
				});

				const routes = {
					ls: '#work',
					tree: '#fs',
					whoami: '#who',
					history: '#history',
					stack: '#stack',
					stat: '#stat',
					hire: '#hire',
				};

				const HELP = [
					'ls            the 8 featured records',
					'tree          all 39 projects, by category',
					'open <slug>   jump to a project (try: open naqi)',
					'cat <slug>    go to its full write-up',
					'whoami        who Haitham is',
					'history       where he has worked',
					'stack         the toolbox',
					'stat          the figures',
					'hire          email, phone, links',
					'lang ar|en    mirror the page',
					'clear         empty this output',
				];

				function print(cmd, lines, tone) {
					const block = document.createElement('div');
					block.className = 'echo';
					const head = document.createElement('p');
					head.className = 'echo__cmd';
					head.textContent = '❯ ' + cmd;
					block.appendChild(head);
					lines.forEach(function (l) {
						const p = document.createElement('p');
						p.className = 'echo__line' + (tone ? ' echo__line--' + tone : '');
						p.textContent = l;
						block.appendChild(p);
					});
					out.appendChild(block);
					out.scrollTop = out.scrollHeight;
				}

				function goto(el) {
					/* the sticky header grows as output accumulates, so the
					   scroll offset has to be measured, not guessed. */
					const bar = document.querySelector('.chrome');
					if (bar)
						document.documentElement.style.setProperty(
							'--head',
							bar.offsetHeight + 16 + 'px',
						);
					el.scrollIntoView({
						behavior: calm.matches ? 'auto' : 'smooth',
						block: 'start',
					});
					el.classList.add('is-hit');
					setTimeout(function () {
						el.classList.remove('is-hit');
					}, 2000);
				}

				function run(raw) {
					const line = raw.trim().replace(/\s+/g, ' ');
					if (!line) return;
					const parts = line.split(' ');
					const cmd = parts[0].toLowerCase();
					const arg = (parts[1] || '').toLowerCase();

					if (cmd === 'help' || cmd === '?') return print(line, HELP);
					if (cmd === 'clear') {
						out.textContent = '';
						return;
					}
					if (cmd === 'lang') {
						if (arg !== 'ar' && arg !== 'en')
							return print(line, ['usage: lang ar | lang en'], 'err');
						box.checked = arg === 'ar';
						syncLang();
						return print(line, [
							arg === 'ar'
								? 'direction mirrored. names switched script.'
								: 'back to left-to-right.',
						]);
					}
					if (cmd === 'open' || cmd === 'cat') {
						if (!arg) return print(line, ['usage: ' + cmd + ' <slug>'], 'err');
						if (!slugs[arg])
							return print(line, ['no such file: ' + arg], 'err');
						if (cmd === 'cat') {
							print(line, ['opening /work/' + arg]);
							window.location.href = '/work/' + arg;
							return;
						}
						const target = featuredIds[arg] || slugs[arg];
						print(line, [
							featuredIds[arg]
								? 'record found in ~/work'
								: 'listed in ~/projects — cat ' + arg + ' for the write-up',
						]);
						goto(target);
						return;
					}
					if (routes[cmd]) {
						const sec = document.querySelector(routes[cmd]);
						print(line, ['→ ' + routes[cmd].slice(1)]);
						if (sec) goto(sec);
						return;
					}
					print(line, [cmd + ': command not found. try help'], 'err');
				}

				form.addEventListener('submit', function (e) {
					e.preventDefault();
					run(input.value);
					input.value = '';
				});

				/* "/" focuses the line, Esc leaves it. Nothing else is captured. */
				document.addEventListener('keydown', function (e) {
					const t = e.target;
					const typing =
						t &&
						(t.tagName === 'INPUT' ||
							t.tagName === 'TEXTAREA' ||
							t.isContentEditable);
					if (
						e.key === '/' &&
						!typing &&
						!e.metaKey &&
						!e.ctrlKey &&
						!e.altKey
					) {
						e.preventDefault();
						input.focus();
					} else if (e.key === 'Escape' && t === input) {
						input.blur();
					}
				});

				/* one small piece of theatre: the hero types its own command. */
				const hero = document.querySelector('.block--hero .cmdline');
				if (hero && !calm.matches) {
					const full = hero.textContent.trim();
					const q = hero.querySelector('.cmdline__q');
					const rest = full.slice(q ? q.textContent.length : 0);
					hero.classList.add('is-typing');
					const tail = document.createTextNode('');
					hero.textContent = '';
					if (q) hero.appendChild(q);
					hero.appendChild(tail);
					let i = 0;
					const type = function () {
						tail.textContent = rest.slice(0, ++i);
						if (i < rest.length) setTimeout(type, 45);
						else hero.classList.remove('is-typing');
					};
					setTimeout(type, 350);
				}
			})();
		</script>

		<StyleSwitcher n={5} />
	</body>
</html>

