---
import { Image } from 'astro:assets';
import { profile } from '../../content/profile';
import { featured, projects } from '../data/projects';
import { toolbox } from '../i18n';
import type { Key } from '../i18n';
import { pair, s } from '../data/variant-ui';
import LangBoot from '../components/LangBoot.astro';
import Logo from '../components/Logo.astro';
import T from '../components/T.astro';
import StyleSwitcher from '../components/StyleSwitcher.astro';
import profilePhoto from '../assets/images/profile.png';

/* The bento is a tray, not a wall: every tile has its own job, its own
   material and its own internal composition. Sizes are assigned here, once,
   so the grid reads as a composition rather than a loop. */
const bySlug = (slug: string) => featured.find((p) => p.slug === slug)!;

const work = [
	{ p: bySlug('aoun'), w: 'w6', h: 'h3', shape: 'wide', tone: 'bone' },
	{ p: bySlug('malabji'), w: 'w3', h: 'h3', shape: 'tall', tone: 'bone' },
	{ p: bySlug('naqi'), w: 'w3', h: 'h3', shape: 'tall', tone: 'ink' },
	{
		p: bySlug('kashaf-alkulify'),
		w: 'w5',
		h: 'h3',
		shape: 'wide',
		tone: 'bone',
	},
	{ p: bySlug('pastehtml'), w: 'w3', h: 'h3', shape: 'tall', tone: 'bone' },
	{ p: bySlug('majalis'), w: 'w4', h: 'h3', shape: 'tall', tone: 'bone' },
	{ p: bySlug('eecommittee'), w: 'w3', h: 'h3', shape: 'tall', tone: 'bone' },
	{ p: bySlug('rooh-al-jouf'), w: 'w5', h: 'h3', shape: 'wide', tone: 'bone' },
];

/* Category and status are already written in both languages in the site's own
   dictionary; the tray does not get a second one. */
const cat = (c: string) => s(`cat.${c}` as Key);
const stat = (st: string) => s(`status.${st}` as Key);

/* Periods are one string in the data — "Since 2025", "2022 to 2023" — so the
   only Arabic they need is the joining word. Digits stay Western. */
const per = (v: string) =>
	pair(v, v.replace(/^Since /, 'منذ ').replace(/ to /, ' إلى '));

/* The archive tile names real projects and links to their write-ups. */
const archive = projects.filter((p) => !p.featured).slice(0, 10);

const restCount = projects.length - featured.length;

/* 39 shipped, 13 of them on the App Store or Google Play. The matrix draws
   exactly that, one square per project. */
const shipped = 39;
const onStores = 13;
const squares = Array.from({ length: shipped }, (_, i) => i < onStores);

/* Rendered at build time so the tile is never blank; the clock in the page
   corrects it to the reader's own second. */
const ammanTime = new Intl.DateTimeFormat('en-GB', {
	timeZone: 'Asia/Amman',
	hour: '2-digit',
	minute: '2-digit',
}).format(new Date());
const nowISO = new Date().toISOString();
---

<!doctype html>
<html lang="en" dir="ltr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Haitham Assoli — Arabic-first apps, laid out as a tray</title>
		<meta
			name="description"
			content="Haitham Assoli builds Arabic-first web and mobile products from Amman: React Native on both app stores, Next.js and Astro on the web, and AI that runs on the phone. Readable in Arabic or English."
		/>
		<meta name="color-scheme" content="light" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400;12..96,75..100,600;12..96,75..100,800&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap"
		/>
		<LangBoot />
	</head>

	<body>
		<a class="skip" href="#main">
			<T v={s('nav.skip')} />
		</a>

		<div class="tray">
			<header class="topbar">
				<p class="topbar__name">
					<Logo class="topbar__logo" labelled={false} />
					<T class="sr-only" v={pair('Haitham Assoli', 'هيثم العسولي')} />
				</p>
				<nav class="topbar__nav mono">
					<a class="ilink" href="/5/projects"><T v={s('work.all')} /></a>
					<a class="ilink" href="/5/hire"><T v={s('nav.hire')} /></a>
				</nav>
			</header>

			<main id="main">
				<!-- ===================== BOARD ONE: THE POINT ===================== -->
				<section class="board board--hero">
					<!-- thesis -->
					<article class="tile tile--bone w8 h3 thesis" style="--i: 0">
						<p class="mono lbl"><T v={pair('The point', 'الخلاصة')} /></p>
						<h1 class="thesis__h">
							<span data-l="en" lang="en"
								>A mirrored interface is <em>a different interface</em>, not a
								translation. I build both halves.</span
							>
							<span data-l="ar" lang="ar"
								>الواجهة المعكوسة <em>واجهة أخرى</em>، لا ترجمة. وأنا أبني
								نصفيها.</span
							>
						</h1>
						<T
							v={pair(
								'Four years of Arabic-first products out of Amman: React Native and Expo on both app stores, Next.js and Astro on the web, NestJS, Convex and Supabase underneath. Thirty-nine of them shipped.',
								'أربع سنوات من منتجات تبدأ بالعربية، من عمّان: React Native وExpo على المتجرين، وNext.js وAstro على الويب، وتحتها NestJS وConvex وSupabase. تسعة وثلاثون منها صدرت.',
							)}
							as="p"
							class="thesis__sub"
						/>
						<p class="mono thesis__tags">
							<T v={pair('Web', 'ويب')} as="span" />
							<T v={pair('Mobile', 'جوّال')} as="span" />
							<T v={pair('On-device AI', 'ذكاء على الجهاز')} as="span" />
							<T v={pair('Arabic first', 'العربية أولًا')} as="span" />
						</p>
					</article>

					<!-- portrait -->
					<article class="tile tile--cobalt w4 h3 who" style="--i: 1">
						<div class="who__photo">
							<Image
								src={profilePhoto}
								alt="Haitham Assoli"
								widths={[240, 480]}
								sizes="(min-width: 64rem) 15rem, 40vw"
								loading="eager"
							/>
						</div>
						<div class="who__plate">
							<p class="mono lbl lbl--on-dark">
								<T v={pair('Who', 'من')} />
							</p>
							<p class="who__name">
								<span data-l="en" lang="en">Haitham Assoli</span>
								<span data-l="ar" lang="ar">هيثم العسولي</span>
							</p>
							<T v={profile.title} as="p" class="who__role" />
						</div>
					</article>

					<!-- signature: the mirror -->
					<article class="tile tile--bone w5 h4 mirror" style="--i: 2">
						<div class="mirror__head">
							<p class="mono lbl">
								<T
									v={pair('One component, both ways', 'مكوّن واحد باتجاهين')}
								/>
							</p>
						</div>

						<div class="mcard" id="mcard">
							<div class="mcard__bar">
								<span class="mcard__back" aria-hidden="true">
									<svg viewBox="0 0 24 24" width="16" height="16" fill="none"
										><path
											d="M15 5 8 12l7 7"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"></path></svg
									>
								</span>
								<span class="mcard__title"
									><span data-l="en" lang="en">Book a pitch</span><span
										data-l="ar"
										lang="ar">احجز ملعبًا</span
									></span
								>
								<span class="mcard__dots" aria-hidden="true"></span>
							</div>

							<div class="mcard__pitch" aria-hidden="true">
								<span class="mcard__badge">
									<span data-l="en" lang="en">5-a-side</span><span
										data-l="ar"
										lang="ar">خماسي</span
									>
								</span>
								<span class="mcard__crew">
									<span class="mcard__face">HA</span>
									<span class="mcard__face">M</span>
									<span class="mcard__face">Z</span>
									<span class="mcard__face"
										><span data-l="en" lang="en">+3</span><span
											data-l="ar"
											lang="ar">٣+</span
										></span
									>
								</span>
							</div>

							<div class="mcard__body">
								<p class="mcard__venue">
									<span data-l="en" lang="en">Al-Hussein Pitch, Amman</span
									><span data-l="ar" lang="ar">ملعب الحسين، عمّان</span>
								</p>
								<p class="mcard__slot mono">
									<span data-l="en" lang="en">Today 18:00 – 19:00</span><span
										data-l="ar"
										lang="ar">اليوم ٦:٠٠ – ٧:٠٠ م</span
									>
								</p>

								<div class="mcard__row">
									<span class="mcard__players">
										<span data-l="en" lang="en">6 of 10 players in</span><span
											data-l="ar"
											lang="ar">٦ من ١٠ لاعبين</span
										>
									</span>
									<span class="mcard__price mono">
										<span data-l="en" lang="en">12 JOD</span><span
											data-l="ar"
											lang="ar">١٢ دينارًا</span
										>
									</span>
								</div>

								<div class="mcard__bar-track" aria-hidden="true">
									<i></i>
								</div>

								<span class="mcard__cta">
									<span data-l="en" lang="en">Book the slot</span><span
										data-l="ar"
										lang="ar">احجز الموعد</span
									>
									<span class="mcard__arrow" aria-hidden="true">
										<svg viewBox="0 0 24 24" width="15" height="15" fill="none"
											><path
												d="M5 12h13m-5-6 6 6-6 6"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"></path></svg
										>
									</span>
								</span>
							</div>
						</div>

						<T
							v={pair(
								'Nothing here was translated by the switch beside it. The row order reverses, the chevron points the other way, the progress fills from the other edge, the numerals change system. That is the work.',
								'لم يترجم المفتاح المجاور شيئًا من هذا. ترتيب الصفوف ينقلب، والسهم يشير إلى الجهة الأخرى، وشريط التقدم يمتلئ من الحافة المقابلة، والأرقام تغيّر نظامها. هذا هو العمل.',
							)}
							as="p"
							class="mirror__note"
						/>
					</article>

					<!-- the language switch: its own compartment -->
					<article class="tile tile--ink w3 h4 lang" style="--i: 3">
						<p class="mono lbl lbl--on-dark">
							<span dir="ltr">EN</span> / <span lang="ar">ع</span>
						</p>

						<button type="button" class="lidsw" data-lang-toggle>
							<span class="lidsw__slot" aria-hidden="true">
								<span class="lidsw__lid"></span>
								<span class="lidsw__opt"
									>EN<small lang="en">English</small></span
								>
								<span class="lidsw__opt" lang="ar">ع<small>العربية</small></span
								>
							</span>
							<span class="sr-only" data-l="en" lang="en"
								>Read this page in Arabic</span
							>
							<span class="sr-only" data-l="ar" lang="ar"
								>اقرأ هذه الصفحة بالإنجليزية</span
							>
						</button>

						<T
							v={pair(
								'Pull the lid. The whole tray turns over — every tile, every line, the grid itself.',
								'اسحب الغطاء. تنقلب الصينية كلها — كل بلاطة، وكل سطر، والشبكة نفسها.',
							)}
							as="p"
							class="lang__note"
						/>
					</article>

					<!-- ledger -->
					<article class="tile tile--ink w4 h2 ledger" style="--i: 4">
						<p class="mono lbl lbl--on-dark">
							<T v={pair('Ledger', 'السجل')} />
						</p>
						<div class="matrix" aria-hidden="true">
							{
								squares.map((filled) => (
									<span class:list={['matrix__cell', filled && 'is-on']} />
								))
							}
						</div>
						<dl class="ledger__list">
							<div>
								<dt>39</dt><T v={pair('shipped', 'صدرت')} as="dd" />
							</div>
							<div>
								<dt>13</dt><T
									v={pair('on the stores', 'على المتاجر')}
									as="dd"
								/>
							</div>
							<div>
								<dt>8</dt><T v={pair('written up', 'مشروحة')} as="dd" />
							</div>
							<div>
								<dt dir="ltr">~4</dt><T v={pair('years', 'سنوات')} as="dd" />
							</div>
						</dl>
					</article>

					<!-- amman -->
					<article class="tile tile--marigold w4 h2 amman" style="--i: 5">
						<p class="mono lbl"><T v={pair('Amman', 'عمّان')} /></p>
						<svg class="amman__map" viewBox="0 0 140 96" aria-hidden="true">
							<g class="amman__rings">
								<ellipse cx="44" cy="34" rx="34" ry="22"></ellipse>
								<ellipse cx="44" cy="34" rx="24" ry="15"></ellipse>
								<ellipse cx="44" cy="34" rx="14" ry="9"></ellipse>
								<ellipse cx="98" cy="62" rx="38" ry="24"></ellipse>
								<ellipse cx="98" cy="62" rx="27" ry="17"></ellipse>
								<ellipse cx="98" cy="62" rx="16" ry="10"></ellipse>
								<ellipse cx="18" cy="80" rx="26" ry="15"></ellipse>
							</g>
							<path
								class="amman__road"
								d="M0 58 C34 44 58 70 88 52 116 36 140 44 140 44"></path>
							<g class="amman__pin">
								<circle class="amman__pulse" cx="71" cy="49" r="9"></circle>
								<circle cx="71" cy="49" r="3.4"></circle>
							</g>
						</svg>
						<T
							v={pair(
								'A contour sketch of the hills Amman is built on.',
								'رسم كنتوري لتلال عمّان التي بُنيت عليها المدينة.',
							)}
							as="span"
							class="sr-only"
						/>
						<p class="amman__clock mono">
							<time id="clock" datetime={nowISO}>{ammanTime}</time>
							<T
								v={pair('31.95° N, 35.93° E', '31.95° شمالًا، 35.93° شرقًا')}
								as="span"
							/>
						</p>
					</article>

					<!-- on-device -->
					<a
						class="tile tile--ink w12 h2 device"
						href="/5/work/naqi"
						style="--i: 6; --accent: #C6A02C"
					>
						<div class="device__phone" aria-hidden="true">
							<div class="device__screen">
								<span class="device__blur"></span>
								<span class="device__scan"></span>
								<span class="device__wave">
									{
										[9, 17, 28, 14, 22, 33, 19, 11, 25, 15, 30, 12].map((h) => (
											<i style={`--h:${h}px`} />
										))
									}
								</span>
							</div>
						</div>
						<div class="device__copy">
							<p class="mono lbl lbl--on-dark">
								<T v={pair('On-device', 'على الجهاز')} />
							</p>
							<h2 class="device__h">
								<T
									v={pair(
										'The model runs on the phone.',
										'النموذج يعمل على الهاتف نفسه.',
									)}
								/>
							</h2>
							<T
								v={pair(
									'Naqi pulls the music out of a video and blurs what it must — separation and detection, both local. No upload, no account, no telemetry, and the original file is never touched.',
									'يستخرج «نقي» الموسيقى من الفيديو ويطمس ما يجب طمسه — الفصل والكشف كلاهما على الجهاز. بلا رفع، وبلا حساب، وبلا تتبّع، والملف الأصلي لا يُمسّ.',
								)}
								as="p"
								class="device__p"
							/>
							<p class="mono device__go">
								<span data-l="en" lang="en">Read the write-up →</span>
								<span data-l="ar" lang="ar">اقرأ التفاصيل ←</span>
							</p>
						</div>
					</a>
				</section>

				<!-- ===================== BOARD TWO: THE WORK ===================== -->
				<section class="board board--work" aria-labelledby="work-h">
					<div class="board__head">
						<h2 class="board__h" id="work-h">
							<span data-l="en" lang="en">Eight I would show first</span>
							<span data-l="ar" lang="ar">ثمانية أعرضها أولًا</span>
						</h2>
						<T
							v={pair(
								'Each one shipped, each one still standing. A full write-up sits behind every tile.',
								'كلها صدرت، وكلها ما زالت قائمة. خلف كل بلاطة صفحة كاملة.',
							)}
							as="p"
							class="board__lede"
						/>
						<a class="mono board__more" href="/5/projects">
							<span data-l="en" lang="en">All 39 →</span>
							<span data-l="ar" lang="ar">كل الـ 39 ←</span>
						</a>
					</div>

					{
						work.map(({ p, w, h, shape, tone }, i) => (
							<a
								class:list={[
									'tile',
									tone === 'ink' ? 'tile--ink' : 'tile--bone',
									w,
									h,
									'work',
									`work--${shape}`,
								]}
								href={`/5/work/${p.slug}`}
								style={`--i:${i}; --accent:${p.accent}`}
							>
								<span class="work__shot">
									{p.image ? (
										<Image
											src={p.image}
											alt=""
											widths={[320, 640]}
											sizes="(min-width: 64rem) 22rem, 60vw"
											loading="lazy"
										/>
									) : (
										<span class="work__noshot mono">{p.title.en}</span>
									)}
								</span>
								<span class="work__meta">
									<span class="mono work__top">
										<T v={per(p.year)} as="span" class="work__year" />
										<T v={cat(p.category)} as="span" class="work__cat" />
									</span>
									<T v={p.title} as="span" class="work__title" />
									<T v={p.tagline} as="span" class="work__line" />
									<span class="mono work__foot">
										<T v={stat(p.status)} as="span" class="work__status" />
										<span class="work__stack" lang="en" dir="ltr">
											{p.stack.slice(0, 3).join(' · ')}
										</span>
									</span>
								</span>
							</a>
						))
					}

					<article class="tile tile--cobalt w4 h3 archive" style="--i: 8">
						<p class="mono lbl lbl--on-dark">
							<T v={pair('The rest', 'البقية')} />
						</p>
						<T
							v={pair(
								`${restCount} more, from municipal apps to a five-platform desktop build.`,
								`${restCount} مشروعًا آخر، من تطبيقات بلدية إلى برنامج سطح مكتب على خمس منصات.`,
							)}
							as="p"
							class="archive__count"
						/>
						<ul class="archive__list mono">
							{
								archive.map((a) => (
									<li>
										<a href={`/5/work/${a.slug}`}>
											<T v={a.title} />
										</a>
									</li>
								))
							}
							<li>
								<a class="archive__all" href="/5/projects">
									<span data-l="en" lang="en">See all 39 →</span>
									<span data-l="ar" lang="ar">شاهد الـ 39 كلها ←</span>
								</a>
							</li>
						</ul>
					</article>
				</section>

				<!-- ===================== BOARD THREE: THE PERSON ===================== -->
				<section class="board board--about" aria-labelledby="about-h">
					<article class="tile tile--bone w7 h2 about" style="--i: 0">
						<p class="mono lbl">
							<T v={pair('Working method', 'طريقة العمل')} />
						</p>
						<h2 class="about__h" id="about-h">
							<span data-l="en" lang="en"
								>The interesting part is never the framework.</span
							>
							<span data-l="ar" lang="ar"
								>الجزء المثير للاهتمام ليس إطار العمل أبدًا.</span
							>
						</h2>
						<T v={pair(profile.about.en[0], profile.about.ar[0])} as="p" />
						<T v={pair(profile.about.en[2], profile.about.ar[2])} as="p" />
					</article>

					<article class="tile tile--bone w5 h2 record" style="--i: 1">
						<p class="mono lbl"><T v={pair('Record', 'المسار')} /></p>
						<ol class="record__list">
							{
								profile.experience.slice(0, 5).map((job) => (
									<li>
										<T
											v={per(job.period)}
											as="span"
											class="mono record__when"
										/>
										<span class="record__what">
											<T v={job.role} as="span" />
											<span aria-hidden="true">, </span>
											<T v={job.company} as="b" />
										</span>
									</li>
								))
							}
						</ol>
						<p class="record__edu mono">
							<T v={profile.education[0].degree} as="span" />
							<span aria-hidden="true"> — </span>
							<T v={profile.education[0].school} as="span" />
						</p>
					</article>

					<article class="tile tile--ink w12 h1 stack" style="--i: 2">
