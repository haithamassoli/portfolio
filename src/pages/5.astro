		margin-inline-start: -0.5rem;
	}

	.mcard__face:last-child {
		background: var(--marigold);
		color: #2a1c06;
	}

	.mcard__body {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		text-align: start;
	}

	.mcard__venue {
		font-weight: 600;
	}

	.mcard__slot {
		font-size: 0.76rem;
		color: rgba(30, 23, 19, 0.62);
	}

	.mcard__row {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		font-size: 0.78rem;
	}

	.mcard__price {
		margin-inline-start: auto;
		font-weight: 500;
		color: var(--cobalt);
	}

	.mcard__bar-track {
		height: 6px;
		border-radius: 999px;
		background: rgba(30, 23, 19, 0.1);
		overflow: hidden;
		display: flex;
	}

	.mcard__bar-track i {
		display: block;
		width: 60%;
		background: var(--marigold);
		border-radius: 999px;
	}

	.mcard__cta {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		margin-top: 0.15rem;
		padding: 0.5rem 0.8rem;
		border-radius: 10px;
		background: var(--cobalt);
		color: #fff;
		font-weight: 600;
		font-size: 0.82rem;
	}

	html[dir='rtl'] .mcard__arrow svg {
		transform: scaleX(-1);
	}

	/* The mono face carries no Arabic; in RTL the sans takes those lines. */
	html[lang='ar'] .mcard__slot,
	html[lang='ar'] .mcard__price {
		font-family: var(--sans);
	}

	.mirror__note {
		font-size: 0.76rem;
		line-height: 1.5;
		color: rgba(30, 23, 19, 0.68);
	}

	/* ---------------- the language tile ----------------
	   A two-compartment box with a sliding lid. The lid rests on whichever
	   language is current; pressing it slides the lid and turns the tray. */

	.lang {
		justify-content: space-between;
		background:
			radial-gradient(
				120% 90% at 100% 0%,
				rgba(233, 164, 38, 0.22),
				rgba(233, 164, 38, 0) 62%
			),
			var(--ink);
	}

	.lidsw {
		flex: 1;
		min-height: 9rem;
		display: block;
		width: 100%;
		padding: 4px;
		border: 0;
		border-radius: 15px;
		background: rgba(251, 246, 236, 0.07);
		box-shadow: inset 0 0 0 1px rgba(251, 246, 236, 0.16);
		color: inherit;
		font: inherit;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	.lidsw__slot {
		position: relative;
		display: grid;
		grid-template-rows: 1fr 1fr;
		height: 100%;
	}

	.lidsw__lid {
		position: absolute;
		z-index: 0;
		inset-inline: 0;
		top: 0;
		height: 50%;
		border-radius: 11px;
		background: var(--marigold);
		box-shadow: 0 6px 14px -8px rgba(0, 0, 0, 0.8);
		transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.25, 1);
	}

	html[lang='ar'] .lidsw__lid {
		transform: translateY(100%);
	}

	.lidsw__opt {
		position: relative;
		z-index: 1;
		display: grid;
		align-content: center;
		justify-items: center;
		gap: 0.1rem;
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem);
		line-height: 1;
		letter-spacing: -0.03em;
		color: rgba(251, 246, 236, 0.42);
		transition: color 0.25s ease;
	}

	.lidsw__opt small {
		font-family: var(--sans);
		font-weight: 500;
		font-size: 0.68rem;
		letter-spacing: 0;
	}

	html[lang='en'] .lidsw__opt:nth-child(2),
	html[lang='ar'] .lidsw__opt:nth-child(3) {
		color: #2a1c06;
	}

	.lidsw:hover .lidsw__lid {
		filter: brightness(1.07);
	}

	.lang__note {
		font-size: 0.74rem;
		line-height: 1.5;
		color: rgba(251, 246, 236, 0.66);
	}

	/* ---------------- ledger ---------------- */

	.ledger {
		justify-content: space-between;
	}

	.matrix {
		display: grid;
		grid-template-columns: repeat(10, 1fr);
		gap: 4px;
		max-width: 15rem;
	}

	.matrix__cell {
		aspect-ratio: 1;
		border-radius: 3px;
		box-shadow: inset 0 0 0 1px rgba(251, 246, 236, 0.28);
	}

	.matrix__cell.is-on {
		background: var(--marigold);
		box-shadow: none;
	}

	.ledger__list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.2rem;
		margin: 0;
	}

	.ledger__list div {
		display: flex;
		align-items: baseline;
		gap: 0.35rem;
	}

	.ledger__list dt {
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.35rem;
		letter-spacing: -0.03em;
	}

	.ledger__list dd {
		margin: 0;
		font-size: 0.72rem;
		color: rgba(251, 246, 236, 0.62);
	}

	/* ---------------- amman ---------------- */

	.amman {
		justify-content: space-between;
		overflow: hidden;
	}

	.amman__map {
		position: absolute;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		opacity: 0.9;
	}

	.amman__rings ellipse {
		fill: none;
		stroke: rgba(42, 28, 6, 0.35);
		stroke-width: 0.7;
	}

	.amman__road {
		fill: none;
		stroke: rgba(42, 28, 6, 0.55);
		stroke-width: 1.1;
		stroke-dasharray: 3 3;
	}

	.amman__pin circle {
		fill: var(--pomegranate);
	}

	.amman__pulse {
		fill: var(--pomegranate);
		opacity: 0.25;
		transform-box: fill-box;
		transform-origin: center;
		animation: pulse 3.2s ease-out infinite;
	}

	@keyframes pulse {
		0% {
			transform: scale(0.4);
			opacity: 0.4;
		}
		70% {
			transform: scale(1.4);
			opacity: 0;
		}
		100% {
			transform: scale(1.4);
			opacity: 0;
		}
	}

	.amman .lbl,
	.amman__clock {
		position: relative;
		z-index: 1;
	}

	.amman__clock {
		display: flex;
		flex-direction: column;
		font-size: 0.7rem;
	}

	.amman__clock time {
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.3rem);
		letter-spacing: -0.04em;
		line-height: 1;
	}

	.amman__clock span {
		color: rgba(42, 28, 6, 0.66);
	}

	/* ---------------- on-device ---------------- */

	.device {
		flex-direction: row;
		align-items: center;
		gap: 1.1rem;
	}

	.device__phone {
		flex: 0 0 auto;
		width: 6.2rem;
		aspect-ratio: 9 / 17;
		padding: 5px;
		border-radius: 16px;
		background: linear-gradient(160deg, #4a423c, #221b17);
		box-shadow: inset 0 0 0 1px rgba(251, 246, 236, 0.18);
	}

	.device__screen {
		position: relative;
		width: 100%;
		height: 100%;
		border-radius: 12px;
		overflow: hidden;
		background:
			linear-gradient(200deg, rgba(23, 69, 127, 0.9), rgba(30, 23, 19, 0.9)),
			var(--ink);
	}

	.device__blur {
		position: absolute;
		inset: 14% 22% auto;
		height: 22%;
		border-radius: 6px;
		background: repeating-linear-gradient(
			45deg,
			rgba(251, 246, 236, 0.5) 0 3px,
			rgba(251, 246, 236, 0.15) 3px 6px
		);
		filter: blur(1.2px);
	}

	.device__scan {
		position: absolute;
		inset-inline: 0;
		top: 0;
		height: 28%;
		background: linear-gradient(
			to bottom,
			rgba(233, 164, 38, 0),
			rgba(233, 164, 38, 0.42)
		);
		border-bottom: 1px solid var(--marigold);
		animation: scan 3.4s cubic-bezier(0.65, 0, 0.35, 1) infinite;
	}

	@keyframes scan {
		0%,
		100% {
			transform: translateY(-30%);
		}
		50% {
			transform: translateY(290%);
		}
	}

	.device__wave {
		position: absolute;
		inset-inline: 8%;
		bottom: 8%;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		height: 34px;
	}

	.device__wave i {
		display: block;
		width: 3px;
		height: var(--h);
		border-radius: 2px;
		background: rgba(251, 246, 236, 0.5);
		animation: bob 1.5s ease-in-out infinite alternate;
	}

	.device__wave i:nth-child(odd) {
		background: var(--marigold);
		animation-duration: 1.9s;
	}

	.device__wave i:nth-child(3n) {
		animation-delay: 0.25s;
	}

	.device__wave i:nth-child(3n + 1) {
		animation-delay: 0.5s;
	}

	@keyframes bob {
		to {
			transform: scaleY(0.35);
		}
	}

	.device__copy {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 0;
	}

	.device__h {
		margin: 0;
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(1.15rem, 0.9rem + 1vw, 1.65rem);
		letter-spacing: -0.035em;
		line-height: 1.02;
	}

	.device__p {
		font-size: 0.83rem;
		color: rgba(251, 246, 236, 0.74);
		max-width: 52ch;
	}

	.device__go {
		margin-top: 0.15rem;
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		color: var(--marigold);
	}

	/* ---------------- work tiles ---------------- */

	/* Each card takes its temperature from the project's own accent. */
	.work {
		gap: 0;
		padding: 0;
		background: color-mix(in srgb, var(--accent) 7%, var(--bone));
	}

	.work.tile--ink {
		background: color-mix(in srgb, var(--accent) 12%, var(--ink));
	}

	.work.tile--ink .work__title {
		color: var(--bone);
	}

	.work.tile--ink .work__top,
	.work.tile--ink .work__foot {
		color: rgba(251, 246, 236, 0.55);
	}

	.work.tile--ink .work__line {
		color: rgba(251, 246, 236, 0.75);
	}

	.work.tile--ink .work__cat,
	.work.tile--ink .work__status {
		color: color-mix(in srgb, var(--accent) 60%, #ffffff);
	}

	.work__shot {
		display: block;
		position: relative;
		overflow: hidden;
		background: color-mix(in srgb, var(--accent) 16%, #efe6d6);
	}

	.work__shot img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.3, 1);
	}

	.work:hover .work__shot img {
		transform: scale(1.045);
	}

	.work__noshot {
		display: grid;
		place-items: center;
		height: 100%;
		padding: 0.6rem;
		font-size: 0.75rem;
		text-align: center;
		color: rgba(30, 23, 19, 0.55);
	}

	.work__meta {
		display: flex;
		flex-direction: column;
		gap: 0.22rem;
		padding: 0.85rem var(--pad) var(--pad);
		min-width: 0;
	}

	.work__top {
		display: flex;
		gap: 0.5rem;
		font-size: 0.62rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgba(30, 23, 19, 0.5);
	}

	.work__cat {
		color: color-mix(in srgb, var(--accent) 72%, var(--ink));
	}

	.work__title {
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(1.1rem, 0.95rem + 0.6vw, 1.5rem);
		letter-spacing: -0.035em;
		line-height: 1.05;
	}

	.work__line {
		font-size: 0.82rem;
		line-height: 1.42;
		color: rgba(30, 23, 19, 0.72);
	}

	.work__foot {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 0.5rem;
		margin-top: auto;
		padding-top: 0.55rem;
		font-size: 0.63rem;
		letter-spacing: 0.06em;
		color: rgba(30, 23, 19, 0.5);
	}

	.work__status {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.1rem 0.45rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--accent) 20%, transparent);
		color: color-mix(in srgb, var(--accent) 70%, var(--ink));
	}

	.work__stack {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	/* wide: image beside the words */
	.work--wide {
		display: grid;
		grid-template-columns: 1fr 1fr;
	}

	.work--wide .work__shot {
		order: 2;
		height: 100%;
		border-radius: 0 var(--radius) var(--radius) 0;
	}

	.work--wide .work__meta {
		order: 1;
		justify-content: flex-start;
	}

	/* tall: image on top, words beneath */
	.work--tall .work__shot {
		flex: 1 1 auto;
		min-height: 0;
	}

	.work--tall .work__shot img {
		object-position: 50% 12%;
	}

	/* ---------------- archive ---------------- */

	.archive__count {
		font-family: var(--display);
		font-weight: 600;
		font-size: 1.02rem;
		line-height: 1.2;
		letter-spacing: -0.02em;
	}

	.archive__list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		margin: 0.1rem 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.68rem;
	}

	.archive__list a {
		display: inline-block;
		padding: 0.16rem 0.5rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.12);
		text-decoration: none;
		transition: background 0.18s ease;
	}

	.archive__list a:hover {
		background: var(--marigold);
		color: #241905;
	}

	.archive__all {
		background: rgba(233, 164, 38, 0.9) !important;
		color: #241905;
		font-weight: 500;
	}

	/* ---------------- about / record ---------------- */

	.about p {
		font-size: 0.9rem;
		color: rgba(30, 23, 19, 0.78);
		max-width: 58ch;
	}

	.about__h {
		margin: 0;
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(1.25rem, 1rem + 1.2vw, 1.9rem);
		letter-spacing: -0.04em;
		line-height: 1.02;
	}

	.record__list {
		display: flex;
		flex-direction: column;
		gap: 0.32rem;
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: none;
	}

	.record__list li {
		display: grid;
		grid-template-columns: 8.2rem 1fr;
		gap: 0.6rem;
		align-items: baseline;
		padding-bottom: 0.32rem;
		border-bottom: 1px solid var(--rule);
		font-size: 0.82rem;
	}

	.record__when {
		font-size: 0.68rem;
		letter-spacing: 0.04em;
		color: rgba(30, 23, 19, 0.55);
	}

	.record__what b {
		font-weight: 600;
	}

	.record__edu {
		margin-top: auto;
		font-size: 0.7rem;
		color: rgba(30, 23, 19, 0.6);
	}

	/* ---------------- toolbox ticker ---------------- */

	.stack {
		flex-direction: row;
		align-items: center;
		gap: 1rem;
		padding-block: 0;
	}

	.stack__lbl {
		flex: 0 0 auto;
	}

	.ticker {
		position: relative;
		flex: 1;
		min-width: 0;
		overflow: hidden;
		mask-image: linear-gradient(
			90deg,
			transparent,
			#000 4rem,
			#000 calc(100% - 4rem),
			transparent
		);
	}

	.ticker__track {
		display: flex;
		width: max-content;
		animation: ticker 42s linear infinite;
	}

	.stack:hover .ticker__track {
		animation-play-state: paused;
	}

	@keyframes ticker {
		to {
			transform: translateX(-50%);
		}
	}

	.ticker__list {
		display: flex;
		gap: 1rem;
		margin: 0;
		padding: 0 0.5rem 0 0;
		list-style: none;
		font-size: 0.85rem;
		letter-spacing: 0.02em;
		white-space: nowrap;
	}

	.ticker__list li {
		display: flex;
		gap: 1rem;
	}

	.ticker__dot {
		color: var(--marigold);
	}

	/* ---------------- hire / links ---------------- */

	.hire {
		justify-content: center;
		gap: 0.4rem;
		background:
			radial-gradient(
				90% 120% at 100% 0%,
				rgba(255, 240, 200, 0.55),
				transparent 60%
			),
			var(--marigold);
	}

	.hire__h {
		margin: 0;
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(1.4rem, 1rem + 1.8vw, 2.3rem);
		letter-spacing: -0.04em;
		line-height: 1;
	}

	.hire__p {
		font-size: 0.85rem;
		max-width: 42ch;
		color: rgba(42, 28, 6, 0.8);
	}

	.hire__cta {
		align-self: flex-start;
		margin-top: 0.4rem;
		padding: 0.45rem 0.9rem;
		border-radius: 999px;
		background: var(--ink);
		color: var(--bone);
		text-decoration: none;
		font-weight: 600;
		font-size: clamp(0.85rem, 0.78rem + 0.4vw, 1.02rem);
		transition:
			transform 0.18s ease,
			background 0.18s ease;
	}

	.hire__cta:hover {
		transform: translateY(-2px);
		background: var(--pomegranate);
	}

	.hire__mail {
		align-self: flex-start;
		margin-top: 0.1rem;
		font-size: 0.8rem;
		color: rgba(42, 28, 6, 0.8);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		padding: 0.45rem 0.9rem;
		word-break: break-word;
	}

	.hire__mail:hover {
		color: var(--pomegranate);
	}

	.links__list {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.links__list a {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.34rem 0;
		border-bottom: 1px solid rgba(251, 246, 236, 0.14);
		font-size: 0.85rem;
		text-decoration: none;
		transition: color 0.18s ease;
	}

	.links__list a::after {
		content: '↗';
		font-size: 0.75rem;
		color: rgba(251, 246, 236, 0.4);
	}

	.links__list a:hover {
		color: var(--marigold);
	}

	/* ---------------- footer ---------------- */

	.foot {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.4rem 1rem;
		padding: 0.4rem 0.6rem;
		font-size: 0.72rem;
		color: rgba(30, 23, 19, 0.62);
	}

	/* ---------------- arrival ---------------- */

	.js .board .tile {
		opacity: 0;
	}

	.js .board.is-in .tile {
		animation: tile-in 0.6s cubic-bezier(0.2, 0.7, 0.3, 1) backwards;
		animation-delay: calc(var(--i, 0) * 45ms);
		opacity: 1;
	}

	@keyframes tile-in {
		from {
			opacity: 0;
			transform: translateY(14px) scale(0.985);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	/* ---------------- responsive: six columns ---------------- */

	@media (max-width: 68rem) {
		:root {
			--row: 6.75rem;
		}

		.board {
			grid-template-columns: repeat(6, minmax(0, 1fr));
			/* Six columns leave odd gaps; let small tiles backfill them. */
			grid-auto-flow: dense;
		}

		.w3,
		.w4 {
			grid-column: span 3;
		}
		.w5,
		.w6,
		.w7,
		.w8,
		.w12 {
			grid-column: span 6;
		}

		.h4 {
			grid-row: span 3;
		}

		.device {
			grid-row: span 2;
		}

		.hire {
			grid-column: span 4;
		}

		.links {
			grid-column: span 2;
		}

		.lang {
			grid-column: span 3;
			grid-row: span 2;
		}
	}

	/* ---------------- responsive: one column ---------------- */

	@media (max-width: 46rem) {
		:root {
			--gap: 0.6rem;
			--radius: 18px;
		}

		.board,
		.board--work,
		.board--about {
			grid-template-columns: minmax(0, 1fr);
			grid-auto-rows: auto;
