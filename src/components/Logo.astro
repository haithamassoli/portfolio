---
/* The wordmark, هيثم. Colour comes from the page: the letters take
   `currentColor`, the rule under them takes `--logo-rule` (falling back to
   the letters). Every style sets those two and gets its own logo. */

interface Props {
	class?: string;
	/** Set false when a nearby label already names the link. */
	labelled?: boolean;
}

const { class: className, labelled = true } = Astro.props;
---

<svg
	class:list={['logo', className]}
	viewBox="0 0 2763 1324"
	fill="none"
	role={labelled ? 'img' : 'presentation'}
	aria-label={labelled ? 'هيثم' : undefined}
	aria-hidden={labelled ? undefined : 'true'}
>
	<g transform="translate(-20 830)">
		<path
			class="logo__word"
			d="M583 -140 594 -116C614 -70 634 -41 668 -22H748V-188C706 -212 688 -228 671 -269L657 -302C616 -399 550 -450 452 -450C338 -450 259 -380 236 -281C90 -260 20 -153 20 43V245H160V-49C160 -91 181 -111 248 -113H249C281 -42 349 0 431 0C478 0 518 -14 544 -29ZM338 -222C338 -262 383 -290 438 -290C512 -290 541 -238 553 -211L566 -181C530 -172 490 -165 449 -165C379 -165 338 -184 338 -222Z M668 -188V-22C752 25 892 44 1038 44C1154 44 1442 24 1541 -42L1578 -163C1598 -44 1668 0 1762 0C1794 0 1811 -17 1811 -49V-189C1735 -189 1712 -201 1712 -274V-404H1572V-241C1572 -228 1572 -215 1573 -203C1412 -154 1241 -141 1073 -141C937 -141 807 -154 748 -188ZM1552 -484 1627 -560 1702 -484 1793 -576 1702 -667 1627 -592 1552 -667 1461 -576ZM1627 -651 1716 -741 1627 -830 1538 -741Z M1811 -189C1780 -189 1763 -172 1763 -141V0C1798 0 1858 -11 1899 -46L1930 -166C1951 -32 2029 0 2115 0C2147 0 2164 -17 2164 -49V-189C2102 -189 2065 -197 2065 -261V-364H1925V-241C1925 -227 1925 -214 1926 -202C1891 -192 1856 -189 1811 -189ZM1840 254 1915 178 1990 254 2081 162 1990 71 1915 146 1840 71 1749 162Z M2165 -189C2133 -189 2116 -172 2116 -140V0C2165 0 2227 -31 2304 -77C2354 -32 2414 0 2519 0C2699 0 2783 -95 2783 -218C2783 -389 2621 -554 2338 -572L2327 -501C2232 -471 2169 -397 2169 -307C2169 -270 2179 -229 2199 -189C2188 -189 2176 -189 2165 -189ZM2269 -301C2269 -347 2299 -390 2355 -390C2414 -390 2441 -343 2441 -301C2441 -247 2396 -218 2333 -203C2294 -227 2269 -259 2269 -301ZM2541 -317C2541 -332 2539 -347 2536 -361C2633 -302 2663 -235 2663 -211C2663 -166 2565 -160 2534 -160C2513 -160 2493 -161 2473 -163C2514 -207 2541 -258 2541 -317Z"
		></path>
		<rect class="logo__rule" x="20" y="424" width="2763" height="70"></rect>
	</g>
</svg>

<style>
	.logo {
		display: block;
		block-size: auto;
	}

	.logo__word {
		fill: currentColor;
	}

	.logo__rule {
		fill: var(--logo-rule, currentColor);
	}
</style>
