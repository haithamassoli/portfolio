---
/* The one language switch, shared by every design variant.

   Both languages are in the DOM; CSS hides the one that is not current, so
   switching is instant and needs no second route and no reload. Any element
   marked `data-l="en"` or `data-l="ar"` participates. Anything with
   `data-lang-toggle` flips the page.

   ponytail: no routing, no reload, no i18n runtime. Add real /ar routes only
   if these prototypes ever need to be indexed in Arabic. */
---

<script is:inline>
	/* Before first paint: no flash of the wrong language. */
	(function () {
		const el = document.documentElement;
		let l = 'en';
		try {
			l = localStorage.getItem('vx-lang') === 'ar' ? 'ar' : 'en';
		} catch {
			/* private mode: English it is */
		}
		el.lang = l;
		el.dir = l === 'ar' ? 'rtl' : 'ltr';
	})();

	document.addEventListener('click', function (ev) {
		const t = ev.target;
		if (!t || !t.closest) return;
		const btn = t.closest('[data-lang-toggle]');
		if (!btn) return;
		ev.preventDefault();
		const el = document.documentElement;
		const next = el.lang === 'ar' ? 'en' : 'ar';
		el.lang = next;
		el.dir = next === 'ar' ? 'rtl' : 'ltr';
		try {
			localStorage.setItem('vx-lang', next);
		} catch {
			/* nothing to do */
		}
	});
</script>

<style is:global>
	/* Specificity (0,2,1): beats a two-class rule, so a variant's own
	   `display` never resurrects the hidden language. */
	html[lang='ar'] [data-l='en'],
	html[lang='en'] [data-l='ar'] {
		display: none;
	}
</style>
