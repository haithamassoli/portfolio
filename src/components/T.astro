---
/* One bilingual string, in the language of the page it is on.

   The page's language comes from its URL — every design has real /ar routes —
   so nothing has to be threaded through the tree. `lang` stays on the element
   because several hundred CSS rules across the designs select on it to swap
   the Arabic face, its size and its tracking. */
import type { I18n } from '../../content/types';
import { langOf } from '../designs/routes';

interface Props {
	v: I18n;
	/** Tag to render. Defaults to a span. */
	as?: string;
	class?: string;
	[key: string]: unknown;
}

const { v, as = 'span', ...rest } = Astro.props;
const Tag = as;
const lang = langOf(Astro.url.pathname);
---

<Tag {...rest} lang={lang}>{v[lang]}</Tag>
