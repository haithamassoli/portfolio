---
import { useT } from '../i18n';
import Shell from '../designs/main/Shell.astro';
import { byId } from '../designs/registry';

interface Props {
	code: '404' | '500' | '422';
}

const { code } = Astro.props;

/* A static host serves one file for every locale, so the error pages say it
   in both scripts rather than guessing which one you read. */
const en = useT('en');
const ar = useT('ar');
---

<Shell
	design={byId('main')}
	lang="en"
	title={en(`${code}.title`)}
	description={en(`${code}.lede`)}
	noindex
>
	<section class="section wrap lost">
		<p class="eyebrow">{code}</p>
		<h1 class="title">{en(`${code}.title`)}</h1>
		<p class="lede">{en(`${code}.lede`)}</p>
		<p class="lede" lang="ar" dir="rtl">{ar(`${code}.lede`)}</p>
		<a class="btn" href="/">
			{en('error.home')}<span class="arrow" aria-hidden="true">→</span>
		</a>
	</section>
</Shell>

<style>
	.lost {
		display: grid;
		gap: 1.25rem;
		justify-items: start;
		align-content: center;
		min-block-size: 60svh;
	}
</style>
