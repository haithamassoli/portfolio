---
/* Floating switcher for the design variants at /1 … /7. Prototype-only: it is
   deliberately isolated from whatever styles the host page sets, so a variant
   can be as maximalist as it likes without swallowing the navigation.

   It sits closed by default — a <details> disclosure, so it is one small pill
   in the corner rather than a bar lying across the bottom of the content, and
   it opens on click or keyboard with no script at all.
   ponytail: drop this file and the /N pages once a direction is picked. */
import { styleVariants } from '../data/style-variants';

interface Props {
	n: number;
}
const { n } = Astro.props;
---

<details class="sx">
	<summary
		class="sx-tab"
		aria-label={`Open the design switcher. Variant ${n} of ${styleVariants.length}.`}
		>{n}<span class="sx-slash">/</span>{styleVariants.length}</summary
	>
	<nav class="sx-bar" aria-label="Design variants">
		<a class="sx-link sx-index" href="/styles">All</a>
		{
			styleVariants.map((v) => (
				<a
					class="sx-link"
					href={`/${v.n}`}
					data-n={v.n}
					title={`${v.name} — ${v.note}`}
					aria-current={v.n === n ? 'page' : undefined}
				>
					{v.n}
				</a>
			))
		}
	</nav>
</details>

<script is:inline>
	/* On a sub-page, jumping to another variant should land on the same
	   sub-page: comparing /3/projects against /5/projects is the whole point. */
	(function () {
		function retarget() {
			const tail = location.pathname.match(/^\/[1-9](\/.+?)\/?$/);
			for (const a of document.querySelectorAll('.sx-bar .sx-link[data-n]')) {
				a.href = '/' + a.dataset.n + (tail ? tail[1] : '');
			}
		}
		retarget();
		/* Fires on the first load too, so this is the only hook needed. */
		document.addEventListener('astro:page-load', retarget);
	})();
</script>

<style is:global>
	.sx {
		all: revert;
		position: fixed;
		z-index: 2147483647;
		inset-block-end: max(0.75rem, env(safe-area-inset-bottom));
		inset-inline-end: max(0.75rem, env(safe-area-inset-right));
		/* column-reverse so the open bar rises above the tab instead of
		   shoving it up the screen. */
		display: flex;
		flex-direction: column-reverse;
		align-items: flex-end;
		direction: ltr;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.75rem;
		line-height: 1;
	}

	.sx .sx-tab {
		all: unset;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 1.9rem;
		grid-auto-flow: column;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.14);
		background: rgba(14, 14, 18, 0.72);
		-webkit-backdrop-filter: blur(14px) saturate(1.4);
		backdrop-filter: blur(14px) saturate(1.4);
		box-shadow: 0 10px 34px -12px rgba(0, 0, 0, 0.7);
		color: rgba(255, 255, 255, 0.72);
		cursor: pointer;
		opacity: 0.55;
		transition:
			opacity 0.15s,
			color 0.15s;
	}

	.sx .sx-tab::-webkit-details-marker {
		display: none;
	}

	.sx .sx-tab:hover,
	.sx[open] .sx-tab {
		opacity: 1;
		color: #fff;
	}

	.sx .sx-tab:focus-visible {
		opacity: 1;
		outline: 2px solid #fff;
		outline-offset: 2px;
	}

	.sx .sx-slash {
		opacity: 0.4;
		padding-inline: 0.1em;
	}

	.sx .sx-bar {
		all: revert;
		display: flex;
		align-items: center;
		gap: 0.125rem;
		margin-block-end: 0.4rem;
		padding: 0.3rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.14);
		background: rgba(14, 14, 18, 0.86);
		-webkit-backdrop-filter: blur(14px) saturate(1.4);
		backdrop-filter: blur(14px) saturate(1.4);
		box-shadow: 0 10px 34px -12px rgba(0, 0, 0, 0.7);
		direction: ltr;
	}

	.sx .sx-link {
		all: unset;
		display: grid;
		place-items: center;
		min-width: 1.75rem;
		height: 1.75rem;
		padding-inline: 0.4rem;
		border-radius: 999px;
		color: rgba(255, 255, 255, 0.62);
		cursor: pointer;
		transition:
			color 0.15s,
			background-color 0.15s;
	}

	.sx .sx-link:hover {
		color: #fff;
		background: rgba(255, 255, 255, 0.12);
	}

	.sx .sx-link:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 2px;
	}

	.sx .sx-link[aria-current='page'] {
		color: #0e0e12;
		background: #fff;
	}

	.sx .sx-index {
		letter-spacing: 0.04em;
	}

	/* Nine targets do not fit a 380px phone at full size, so the open bar
	   spans the width rather than running off both edges. */
	@media (max-width: 26rem) {
		.sx {
			inset-inline: 0.5rem;
			font-size: 0.7rem;
		}

		.sx .sx-bar {
			align-self: stretch;
			justify-content: space-between;
			gap: 0;
		}

		.sx .sx-link {
			min-width: 1.5rem;
			height: 1.5rem;
			padding-inline: 0.2rem;
		}
	}

	@media print {
		.sx {
			display: none;
		}
	}
</style>
